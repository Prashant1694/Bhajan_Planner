<div class="admin-form-wrapper">

    <div class="admin-page-header">

        <div>

            <h1>
                <%= admin ? "Edit Administrator" : "Create Administrator" %>
            </h1>

            <p>
                Create and manage administrator accounts securely.
            </p>

        </div>

        <a href="/admin/admin-users" class="back-btn">
            ← Back
        </a>

    </div>


    <% if(error){ %>

        <div class="admin-error">

            <%= error %>

        </div>

    <% } %>


    <form
        method="POST"
        action="<%= admin ? '/admin/admin-users/' + admin.id : '/admin/admin-users' %>">


<div class="section-title">
    <span class="section-icon" style="display:inline-flex; align-items:center;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </span>
    <h2>Administrator Information</h2>

</div>

            <div class="admin-card-body">

                <div class="admin-grid">

                    <div class="field">

                        <label>Display Name</label>

                        <input
                            type="text"
                            name="display_name"
                            value="<%= admin ? admin.display_name : '' %>"
                            required>

                    </div>

                    <div class="field">

                        <label>Admin Title (Designation)</label>

                        <input
                            type="text"
                            name="title"
                            placeholder="e.g., Samiti Incharge, President"
                            value="<%= admin ? (admin.title || '') : '' %>">

                    </div>

                    <div class="field">

                        <label>Linked Singer Profile (for My Hub &amp; Bhajan Submissions)</label>

                        <select name="singer_id" style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1.5px solid var(--border, #cbd5e1); font-size: 14px; background: var(--surface, #fff); color: var(--ink, #1e293b);">
                            <option value="">-- Auto-detect by Name --</option>
                            <% if (typeof singers !== 'undefined' && singers) { %>
                                <% singers.forEach(function(s) { %>
                                    <option value="<%= s.id %>" <%= (admin && admin.singer_id === s.id) ? 'selected' : '' %>>
                                        <%= s.name %> <%= s.gender ? `(${s.gender})` : '' %>
                                    </option>
                                <% }); %>
                            <% } %>
                        </select>

                    </div>

                    <div class="field">

                        <label>Username</label>

                        <input
                            type="text"
                            name="username"
                            value="<%= admin ? admin.username : '' %>"
                            required>

                    </div>

                    <div class="field">

                        <label>Google Email</label>

                        <input
                            type="email"
                            name="google_email"
                            value="<%= admin ? admin.google_email : '' %>">

                    </div>

                    <div class="field">

                        <label>Role</label>

                        <select name="role">

                            <option value="admin"
                                <%= admin && admin.role==="admin" ? "selected":"" %>>
                                Administrator
                            </option>

                            <option value="super_admin"
                                <%= admin && admin.role==="super_admin" ? "selected":"" %>>
                                Super Administrator
                            </option>

                        </select>

                    </div>

                </div>

            </div>

        </div>



        <div class="admin-card">

            <div class="admin-card-header">
                <h2 style="display:flex; align-items:center; gap:8px;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  Security
                </h2>
            </div>

            <div class="admin-card-body">

                <div class="field">

                    <label>Temporary Password</label>

                    <input
                        type="password"
                        name="password"
                        <%= admin ? "" : "required" %>>

                    <% if(admin){ %>

                        <small>
                            Leave blank to keep the existing password.
                        </small>

                    <% } %>

                </div>

            </div>

        </div>


        <div class="admin-actions">

            <a
                href="/admin/admin-users"
                class="secondary-btn">

                Cancel

            </a>

            <button
                type="submit"
                class="primary-btn">

                <%= admin ? "Update Administrator" : "Create Administrator" %>

            </button>

        </div>

    </form>

</div>