<div class="session-unified-page" style="padding: 24px 32px; background: var(--bg-app); min-height: 100vh;">

  <!-- Featured Banner Header -->
  <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); border-radius: 14px; padding: 24px 28px; color: white; box-shadow: 0 10px 25px -5px rgba(67, 56, 202, 0.35); margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
      <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; color: #a5b4fc; margin-bottom: 6px;">
        Audit &amp; Telemetry
      </div>
      <h1 style="margin: 0 0 6px 0; font-size: 24px; font-weight: 800; color: #ffffff;">
        Activity Monitor &amp; User Audit
      </h1>
      <p style="margin: 0; font-size: 13px; color: #c7d2fe;">
        Real-time telemetry, singer submissions, admin revisions, and system security logs.
      </p>
    </div>

    <!-- Quick Navigation -->
    <div style="display: flex; gap: 10px; align-items: center;">
      <% if (currentAdmin && (currentAdmin.role === 'super_admin' || currentAdmin.role === 'SUPER_ADMIN')) { %>
        <button type="button" onclick="purgeOldActivityLogs()" class="button outline" style="border-color: rgba(239, 68, 68, 0.4); color: #fca5a5; background: rgba(239, 68, 68, 0.15); font-size: 13px; font-weight: 600; padding: 8px 14px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          Purge (&gt;30d)
        </button>
      <% } %>
      <a href="/admin" class="button outline" style="border-color: rgba(255,255,255,0.25); color: #ffffff; background: rgba(255,255,255,0.08); font-size: 13px; font-weight: 600; padding: 8px 14px; border-radius: 8px; text-decoration: none; display: flex; align-items: center; gap: 6px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Dashboard
      </a>
    </div>
  </div>

  <!-- KPI Overview Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <!-- Online Admins -->
    <div class="kpi-card" style="--accent: #4f46e5;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Online Admins</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div class="kpi-value" id="cardOnlineAdmins"><%= onlineAdminsCount %></div>
      <div class="kpi-subtext">Active dashboard administrators</div>
    </div>

    <!-- Online Singers -->
    <div class="kpi-card" style="--accent: #ec4899;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Online Singers</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/></svg>
      </div>
      <div class="kpi-value" id="cardOnlineSingers"><%= onlineSingersCount %></div>
      <div class="kpi-subtext">Active singer portals</div>
    </div>

    <!-- Devotees -->
    <div class="kpi-card" style="--accent: #0ea5e9;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Guest Devotees</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="kpi-value" id="cardOnlineUsers"><%= onlineUsersCount %></div>
      <div class="kpi-subtext">Public viewers active</div>
    </div>

    <!-- Total Actions -->
    <div class="kpi-card" style="--accent: #10b981;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Total Actions</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>
      <div class="kpi-value" id="cardTotalLogs"><%= totalLogs %></div>
      <div class="kpi-subtext">Tracked system events</div>
    </div>
  </div>

  <!-- User Accounts Hub -->
  <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 24px; box-shadow: var(--shadow-sm);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
      <div>
        <h2 style="margin: 0 0 4px 0; font-size: 15px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          User Accounts Activity Hub
        </h2>
        <p style="margin: 0; font-size: 12.5px; color: var(--text-secondary);">
          Select any user account to filter their specific activity audit trail.
        </p>
      </div>

      <% if (filterUser) { %>
        <a href="/admin/activity-logs" style="background: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          Clear Filter: <strong><%= filterUser %></strong>
        </a>
      <% } %>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px;">
      <% if (userSummaries && userSummaries.length > 0) { %>
        <% userSummaries.forEach(user => { 
          const isSelected = filterUser === user.username;
          let roleBadge = 'Guest';
          let roleBg = '#f1f5f9';
          let roleColor = '#475569';
          let avatarBg = '#64748b';

          if (user.user_type === 'singer') {
            roleBadge = 'Singer';
            roleBg = '#fdf2f8';
            roleColor = '#be185d';
            avatarBg = '#ec4899';
          } else if (user.user_type === 'super_admin' || user.user_type === 'admin') {
            roleBadge = user.user_type === 'super_admin' ? 'Super Admin' : 'Admin';
            roleBg = '#eef2ff';
            roleColor = '#4338ca';
            avatarBg = '#4f46e5';
          }

          const lastActiveStr = user.last_active ? new Date(user.last_active).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Recently';
        %>
          <div 
            onclick="filterByUser('<%= encodeURIComponent(user.username) %>')"
            style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 8px; border: 1px solid <%= isSelected ? 'var(--primary)' : 'var(--border)' %>; background: <%= isSelected ? '#f5f3ff' : '#f8fafc' %>; cursor: pointer; transition: all 0.15s ease;"
          >
            <div style="width: 32px; height: 32px; border-radius: 8px; background: <%= avatarBg %>; color: #fff; font-weight: 700; font-size: 13px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="font-weight: 700; font-size: 13px; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                <%= user.username %>
              </div>
              <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; background: <%= roleBg %>; color: <%= roleColor %>; padding: 1px 6px; border-radius: 4px;">
                  <%= roleBadge %>
                </span>
                <span style="font-size: 11px; color: var(--text-muted);"><%= user.action_count %> acts</span>
              </div>
            </div>
            <div style="font-size: 10.5px; color: var(--text-muted); text-align: right; flex-shrink: 0;">
              <%= lastActiveStr %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="color: var(--text-muted); font-size: 13px; margin: 0;">No active user accounts recorded yet.</p>
      <% } %>
    </div>
  </div>

  <!-- Main Table Container -->
  <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm);">

    <!-- Header & Controls -->
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
      
      <!-- Inset Search Bar -->
      <div style="position: relative; flex: 1; max-width: 380px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="position: absolute; left: 12px; top: 12px;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input 
          type="text" 
          id="activitySearchInput" 
          placeholder="Search user, action, section, or details..." 
          oninput="filterActivityRows()" 
          aria-label="Filter activity records"
          style="width: 100%; height: 38px; border: 1px solid var(--border); border-radius: 6px; font-size: 12.5px; padding: 8px 14px 8px 34px; background: #ffffff; color: var(--text-primary); outline: none;"
        />
      </div>

      <!-- Segmented Capsule Pills -->
      <div class="segmented-control" role="group" aria-label="Event Type Filter">
        <button type="button" class="segmented-pill <%= filterType === 'all' && !filterUser ? 'active' : '' %>" onclick="setActivityTypeFilter('all')">
          All Events
        </button>
        <button type="button" class="segmented-pill <%= filterType === 'singer' ? 'active' : '' %>" onclick="setActivityTypeFilter('singer')">
          Singers
        </button>
        <button type="button" class="segmented-pill <%= filterType === 'admin' ? 'active' : '' %>" onclick="setActivityTypeFilter('admin')">
          Admins
        </button>
        <button type="button" class="segmented-pill <%= filterType === 'guest' ? 'active' : '' %>" onclick="setActivityTypeFilter('guest')">
          Guests
        </button>
      </div>

      <span id="activityCountDisplay" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">
        Showing <%= logs.length %> Records
      </span>
    </div>

    <!-- Table -->
    <div style="overflow-x: auto;">
      <table id="activityLogsTable" style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <thead>
          <tr style="background: #f8fafc; border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
            <th style="padding: 11px 16px; text-align: center; width: 45px;">#</th>
            <th style="padding: 11px 16px; text-align: left; width: 22%;">User Account</th>
            <th style="padding: 11px 16px; text-align: left; width: 34%;">Action &amp; Details</th>
            <th style="padding: 11px 16px; text-align: left; width: 16%;">Section</th>
            <th style="padding: 11px 16px; text-align: left; width: 14%;">Timestamp</th>
            <th style="padding: 11px 16px; text-align: right; width: 14%;">Method &amp; IP</th>
          </tr>
        </thead>
        <tbody id="activityTableBody">
          <% if (logs.length > 0) { %>
            <% logs.forEach((log, idx) => { 
              const isSinger = log.user_type === 'singer';
              const isAdmin = log.user_type === 'super_admin' || log.user_type === 'admin';
              let roleBadge = isSinger ? 'Singer' : (isAdmin ? 'Admin' : 'Guest');
              let roleBg = isSinger ? '#fdf2f8' : (isAdmin ? '#eef2ff' : '#f1f5f9');
              let roleColor = isSinger ? '#be185d' : (isAdmin ? '#4338ca' : '#475569');
              let userInitial = log.username ? log.username.charAt(0).toUpperCase() : 'G';
              let avatarBg = isSinger ? '#ec4899' : (isAdmin ? '#4f46e5' : '#64748b');

              const dateObj = new Date(log.created_at);
              const timeStr = dateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
              const dateStr = dateObj.toLocaleDateString([], { month: 'short', day: 'numeric' });
            %>
            <tr 
              class="activity-row"
              data-search="<%= ((log.username||'') + ' ' + (log.action||'') + ' ' + (log.details||'') + ' ' + (log.section||'')).toLowerCase() %>"
              style="border-bottom: 1px solid var(--border-subtle); background: <%= idx % 2 === 1 ? '#fafbfc' : '#ffffff' %>;"
            >
              <!-- Index -->
              <td style="padding: 10px 16px; text-align: center; color: var(--text-muted); font-weight: 700; font-size: 11px;">
                <%= idx + 1 %>
              </td>

              <!-- User -->
              <td style="padding: 10px 16px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <div style="width: 26px; height: 26px; border-radius: 6px; background: <%= avatarBg %>; color: #fff; font-weight: 700; font-size: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <%= userInitial %>
                  </div>
                  <div>
                    <div style="font-weight: 700; font-size: 13px; color: var(--text-primary);"><%= log.username %></div>
                    <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; background: <%= roleBg %>; color: <%= roleColor %>; padding: 1px 6px; border-radius: 4px; display: inline-block; margin-top: 1px;">
                      <%= roleBadge %>
                    </span>
                  </div>
                </div>
              </td>

              <!-- Action & Details -->
              <td style="padding: 10px 16px;">
                <div style="font-weight: 600; font-size: 13px; color: var(--text-primary);">
                  <%= log.details || log.action %>
                </div>
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px; font-family: monospace;">
                  <%= log.action %>
                </div>
              </td>

              <!-- Section -->
              <td style="padding: 10px 16px;">
                <span class="badge" style="background: #f1f5f9; color: var(--text-secondary); border: 1px solid var(--border); font-size: 11px; padding: 2px 8px; border-radius: 9999px;">
                  <%= log.section %>
                </span>
              </td>

              <!-- Timestamp -->
              <td style="padding: 10px 16px;">
                <div style="font-weight: 600; font-size: 12.5px; color: var(--text-primary);"><%= timeStr %></div>
                <div style="font-size: 11px; color: var(--text-muted);"><%= dateStr %></div>
              </td>

              <!-- Method & IP -->
              <td style="padding: 10px 16px; text-align: right;">
                <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; background: <%= log.method === 'POST' ? '#fef3c7; color: #92400e;' : '#e0f2fe; color: #0369a1;' %>">
                  <%= log.method %>
                </span>
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 3px; font-family: monospace;">
                  <%= log.ip_address || 'Local' %>
                </div>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" style="text-align: center; padding: 36px; color: var(--text-muted);">
                No activity records found.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="activityEmptyState" style="display: none; text-align: center; padding: 40px 20px;">
      <div style="width: 48px; height: 48px; margin: 0 auto 12px; background: #f1f5f9; color: var(--text-muted); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
      <h3 style="margin: 0 0 4px 0; font-size: 15px; font-weight: 700; color: var(--text-primary);">No activities found</h3>
      <p style="margin: 0; font-size: 12.5px; color: var(--text-muted);">No actions match your search query.</p>
    </div>
  </div>

</div>

<script>
function filterByUser(encodedUsername) {
  const user = decodeURIComponent(encodedUsername);
  window.location.href = `/admin/activity-logs?user=${encodeURIComponent(user)}`;
}

function setActivityTypeFilter(type) {
  window.location.href = `/admin/activity-logs?user_type=${type}`;
}

function filterActivityRows() {
  const query = (document.getElementById('activitySearchInput')?.value || '').trim().toLowerCase();
  const rows = document.querySelectorAll('#activityTableBody tr.activity-row');
  let visibleCount = 0;

  rows.forEach(row => {
    const haystack = row.getAttribute('data-search') || '';
    if (!query || haystack.includes(query)) {
      row.style.display = '';
      visibleCount++;
    } else {
      row.style.display = 'none';
    }
  });

  const emptyState = document.getElementById('activityEmptyState');
  if (emptyState) {
    emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  const countDisplay = document.getElementById('activityCountDisplay');
  if (countDisplay) {
    countDisplay.textContent = `Showing ${visibleCount} Record${visibleCount === 1 ? '' : 's'}`;
  }
}

async function purgeOldActivityLogs() {
  const ok = window.BPSheet
    ? await window.BPSheet.confirm("Are you sure you want to purge activity logs older than 30 days?", { isDestructive: true })
    : confirm("Are you sure you want to purge activity logs older than 30 days?");
  if (!ok) return;
  try {
    const res = await fetch("/admin/activity-logs/purge", { method: "POST" });
    const data = await res.json();
    if (data.success) {
      alert(data.message);
      window.location.reload();
    } else {
      alert("Error: " + (data.error || "Purge failed"));
    }
  } catch (err) {
    alert("Purge failed: " + err.message);
  }
}
</script>
