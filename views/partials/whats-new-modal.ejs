<!-- What's New Update Modal (Appears Only Once After Today's Update) -->
<div id="whatsNewOverlay" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.68); backdrop-filter: blur(6px); z-index: 99999; align-items: center; justify-content: center; padding: 16px; opacity: 0; transition: opacity 0.3s ease;">
  <div id="whatsNewCard" style="background: var(--surface, #ffffff); border: 1px solid var(--border, #e2e8f0); border-radius: 22px; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); position: relative; transform: scale(0.92) translateY(15px); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); animation: modalFloat 0.3s ease forwards;">
    
    <!-- Top Gradient Accent Stripe -->
    <div style="height: 5px; background: linear-gradient(90deg, #4f46e5 0%, #7c3aed 100%); border-radius: 22px 22px 0 0;"></div>

    <!-- Close Button -->
    <button type="button" id="whatsNewCloseBtn" aria-label="Close modal" style="position: absolute; top: 16px; right: 16px; background: rgba(0,0,0,0.06); border: none; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; cursor: pointer; color: var(--ink-soft, #64748b); transition: all 0.2s;">
      &times;
    </button>

    <div style="padding: 26px 24px 24px 24px;">
      
      <!-- Modal Header -->
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); display: flex; align-items: center; justify-content: center; color: #fff; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3); flex-shrink: 0;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <h2 style="font-size: 19px; font-weight: 800; color: #0f172a; margin: 0; line-height: 1.2;">What's New in Bhajan Planner</h2>
            <span style="background: rgba(79, 70, 229, 0.12); color: #4f46e5; font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 999px;">v2.8</span>
          </div>
          <p style="font-size: 12.5px; color: #64748b; margin: 3px 0 0 0;">
            Updates for devotees and singers
          </p>
        </div>
      </div>

      <!-- Feature List -->
      <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px;">
        
        <!-- Feature 1: Singer Hub -->
        <div style="display: flex; gap: 13px; align-items: flex-start; padding: 12px; background: #f8fafc; border: 1px solid var(--border); border-radius: 10px;">
          <div style="width: 28px; height: 28px; border-radius: 6px; background: #eef2ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div>
            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a; margin-bottom: 2px;">
              Personal Singer Hub
            </div>
            <div style="font-size: 12px; color: #64748b; line-height: 1.45;">
              Verify your devotee profile with a simple 4-digit PIN (90-day active session). Access upcoming singing dates, song history, statistics, and set your default singing scale.
            </div>
          </div>
        </div>

        <!-- Feature 2: Personal Songbook -->
        <div style="display: flex; gap: 13px; align-items: flex-start; padding: 12px; background: #f8fafc; border: 1px solid var(--border); border-radius: 10px;">
          <div style="width: 28px; height: 28px; border-radius: 6px; background: #ecfeff; color: #0891b2; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div>
            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a; margin-bottom: 2px;">
              Personal Songbook &amp; Quick Picker
            </div>
            <div style="font-size: 12px; color: #64748b; line-height: 1.45;">
              Bookmark your prepared bhajans directly from Master Bank. When submitting a bhajan, tap <strong>"Pick from My Songbook"</strong> to auto-fill title, pitch, and speed!
            </div>
          </div>
        </div>

        <!-- Feature 3: Bhajan Correction Tracking -->
        <div style="display: flex; gap: 13px; align-items: flex-start; padding: 12px; background: #f8fafc; border: 1px solid var(--border); border-radius: 10px;">
          <div style="width: 28px; height: 28px; border-radius: 6px; background: #f0f9ff; color: #0284c7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
          </div>
          <div>
            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a; margin-bottom: 2px;">
              Bhajan Correction &amp; Report Tracker
            </div>
            <div style="font-size: 12px; color: #64748b; line-height: 1.45;">
              Spotted a typo or wrong scale? Devotees can report corrections directly from any bhajan card. Track review status and replies from coordinators directly inside My Hub.
            </div>
          </div>
        </div>

        <!-- Feature 4: Security & Polish -->
        <div style="display: flex; gap: 13px; align-items: flex-start; padding: 12px; background: #f8fafc; border: 1px solid var(--border); border-radius: 10px;">
          <div style="width: 28px; height: 28px; border-radius: 6px; background: #f0fdf4; color: #16a34a; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a; margin-bottom: 2px;">
              End-to-End Security &amp; Native Speed
            </div>
            <div style="font-size: 12px; color: #64748b; line-height: 1.45;">
              Enhanced with brute-force PIN protection, rate limiting, clean deity filters, and instantaneous tab navigation without freezing.
            </div>
          </div>
        </div>

      </div>

      <!-- Action Buttons -->
      <div style="display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap;">
        <button type="button" id="whatsNewDismissBtn" class="btn btn-secondary" style="padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: 6px;">
          Got It
        </button>
        <a href="/my-hub" id="whatsNewHubBtn" class="btn btn-primary" style="padding: 8px 18px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border-radius: 6px;">
          Explore My Hub &rarr;
        </a>
      </div>

    </div>
  </div>
</div>

<script>
(function() {
  const POPUP_STORAGE_KEY = "bp_update_popup_2026_10_03";

  // Check if user already saw today's update popup
  try {
    if (localStorage.getItem(POPUP_STORAGE_KEY) === "true") {
      return;
    }
  } catch(e) {
    return;
  }

  function dismissPopup(callback) {
    try {
      localStorage.setItem(POPUP_STORAGE_KEY, "true");
    } catch(e) {}

    const overlay = document.getElementById("whatsNewOverlay");
    const card = document.getElementById("whatsNewCard");
    if (!overlay || !card) {
      if (callback) callback();
      return;
    }

    overlay.style.opacity = "0";
    card.style.transform = "scale(0.92) translateY(15px)";
    setTimeout(function() {
      overlay.style.display = "none";
      if (callback) callback();
    }, 280);
  }

  function openPopup() {
    const overlay = document.getElementById("whatsNewOverlay");
    const card = document.getElementById("whatsNewCard");
    if (!overlay || !card) return;

    overlay.style.display = "flex";
    setTimeout(function() {
      overlay.style.opacity = "1";
      card.style.transform = "scale(1) translateY(0)";
    }, 20);
  }

  document.addEventListener("DOMContentLoaded", function() {
    setTimeout(openPopup, 500);

    const closeBtn = document.getElementById("whatsNewCloseBtn");
    const dismissBtn = document.getElementById("whatsNewDismissBtn");
    const hubBtn = document.getElementById("whatsNewHubBtn");
    const overlay = document.getElementById("whatsNewOverlay");

    if (closeBtn) closeBtn.addEventListener("click", function() { dismissPopup(); });
    if (dismissBtn) dismissBtn.addEventListener("click", function() { dismissPopup(); });

    if (hubBtn) {
      hubBtn.addEventListener("click", function(e) {
        e.preventDefault();
        const targetUrl = hubBtn.getAttribute("href");
        dismissPopup(function() {
          window.location.href = targetUrl;
        });
      });
    }

    if (overlay) {
      overlay.addEventListener("click", function(e) {
        if (e.target === overlay) {
          dismissPopup();
        }
      });
    }

    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape" && overlay && overlay.style.display === "flex") {
        dismissPopup();
      }
    });
  });
})();
</script>
