<%
    const curPage = typeof page !== 'undefined' ? page : (typeof locals !== 'undefined' && locals.page ? locals.page : '');
%>
<aside class="sidebar" id="adminSidebar">

    <div class="sidebar-header">
        <a href="/admin" class="sidebar-brand-link" title="Bhajan Planner Administration">
            <div class="sidebar-logo-wrap">
                <img src="/images/logo.png" alt="Sri Sathya Sai Emblem" class="sidebar-logo-img">
            </div>
            <div class="sidebar-brand-text">
                <h2>Bhajan Planner</h2>
                <div class="sidebar-brand-sub">
                    <span class="sidebar-admin-pill">Admin Portal</span>
                </div>
            </div>
        </a>
        <button type="button" id="sidebarToggle" class="sidebar-toggle" aria-label="Toggle sidebar collapse" title="Collapse sidebar" onclick="if(typeof window.closeMobileSidebar==='function'&&window.innerWidth<=1024){window.closeMobileSidebar(event);}else if(typeof window.toggleAdminSidebar==='function'){window.toggleAdminSidebar(event);}">
            <svg class="sidebar-desktop-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            <svg class="sidebar-mobile-close-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>

    <nav class="sidebar-nav" aria-label="Admin Navigation">

        <!-- SCHEDULE & SESSIONS -->
        <div class="sidebar-section">
            <div class="sidebar-section-title">Schedule &amp; Sessions</div>

            <a href="/admin" class="<%= curPage === 'dashboard' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Dashboard
            </a>

            <a href="/submit-form?admin=true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="18"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
                New Entry
            </a>

            <a href="/plan-view">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                Plan &amp; Share
            </a>

            <a href="/admin?copy=true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copy Session
            </a>

            <a href="/admin/import-sessions" class="<%= curPage === 'import-sessions' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Import Sessions
            </a>
        </div>

        <!-- DATABASE & CONTENT -->
        <div class="sidebar-section">
            <div class="sidebar-section-title">Database &amp; Content</div>

            <a href="/master-bank" class="<%= curPage === 'bank' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                Master Bank
            </a>

            <a href="/admin/rules" class="<%= curPage === 'rules' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
                Deity Rules
            </a>

            <a href="/admin/missing-bhajans" class="<%= curPage === 'missing-bhajans' ? 'active' : '' %>">
                <span class="nav-icon-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <% if (typeof missingCount !== 'undefined' && missingCount > 0) { %>
                        <b class="sidebar-badge-dot"></b>
                    <% } %>
                </span>
                Missing Catcher
                <% if (typeof missingCount !== 'undefined' && missingCount > 0) { %>
                    <b class="sidebar-badge-count missing-catcher-badge"><%= missingCount %></b>
                <% } %>
            </a>

            <a href="/admin/reports" class="<%= curPage === 'reports' ? 'active' : '' %>">
                <span class="nav-icon-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                    <% if (typeof pendingReportCount !== 'undefined' && pendingReportCount > 0) { %>
                        <b class="sidebar-badge-dot" style="background:#ef4444;"></b>
                    <% } %>
                </span>
                Bhajan Reports
                <% if (typeof pendingReportCount !== 'undefined' && pendingReportCount > 0) { %>
                    <b class="sidebar-badge-count" style="background:#ef4444; color:#fff;"><%= pendingReportCount %></b>
                <% } %>
            </a>

            <a href="/admin/bulletins" class="<%= curPage === 'bulletins' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                Bulletins
            </a>
        </div>

        <!-- PEOPLE & COMMUNITY -->
        <div class="sidebar-section">
            <div class="sidebar-section-title">Singers &amp; Community</div>

            <a href="/admin/singers" class="<%= curPage === 'singers' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Singers Directory
            </a>

            <% if (typeof currentAdmin !== 'undefined' && currentAdmin && currentAdmin.role === "super_admin") { %>
            <a href="/admin/diwali" class="<%= curPage === 'diwali' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c1 3 4 5 4 9a4 4 0 0 1-8 0c0-4 3-6 4-9z"/><path d="M6 18c0 3 3 4 6 4s6-1 6-4H6z"/></svg>
                Diwali Bhajans
            </a>
            <% } %>
        </div>

        <!-- SYSTEM & AUDIT -->
        <div class="sidebar-section">
            <div class="sidebar-section-title">System &amp; Audit</div>

            <a href="/admin/analytics" class="<%= curPage === 'analytics' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                Analytics
            </a>

            <a href="/admin/notifications" class="<%= curPage === 'notifications' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                Notifications
            </a>

            <% if (typeof currentAdmin !== 'undefined' && currentAdmin && currentAdmin.role === "super_admin") { %>
            <a href="/admin/admin-users" class="<%= curPage === 'admins' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Administrators
            </a>

            <a href="/admin/activity-logs" class="<%= curPage === 'activity' ? 'active' : '' %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Activity Monitor
            </a>

            <a href="/admin/download-backup" title="Download SQLite database backup">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                Download Backup
            </a>

            <a href="/admin/danger-reset-history">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Reset History
            </a>
            <% } %>
        </div>

    </nav>

    <div class="sidebar-footer">
        <a href="/?tab=home" target="_top" title="Open Public Devotee View" onclick="if(window.top && window.top !== window && typeof window.top.switchTab === 'function'){ window.top.switchTab('home'); return false; }">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Public Home
        </a>

        <form method="POST" action="/logout" target="_top" style="margin:0; width:100%;">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="logout-link" title="Sign out of Admin Session" style="background:none;border:none;cursor:pointer;width:100%;text-align:left;font:inherit;color:inherit;display:flex;align-items:center;gap:8px;padding:0;" onclick="try{localStorage.removeItem('bp_is_admin');localStorage.removeItem('bp_admin_name');localStorage.removeItem('bp_admin_role');}catch(_){}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Logout
            </button>
        </form>
    </div>

</aside>