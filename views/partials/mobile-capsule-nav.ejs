<%
  const curActiveTab = typeof activeTabKey !== 'undefined' ? activeTabKey : (typeof isAdminPage !== 'undefined' && isAdminPage ? 'admin' : 'home');
  const hasAdmin = (typeof adminObj !== 'undefined' && adminObj) || (typeof currentAdmin !== 'undefined' && currentAdmin);
%>
<nav class="mobile-bottom-capsule native-bottom-nav bp-blur" id="mobileBottomCapsule" aria-label="Mobile Navigation Capsule">
  <div class="capsule-track native-nav-inner" id="capsuleTrack">
    <a href="/" class="capsule-pill nav-tab <%= curActiveTab === 'home' ? 'active' : '' %>" id="tab-btn-home" data-tab="home" onclick="if(typeof handleNavClick==='function'){return handleNavClick('home', '/', event);}" aria-label="Home">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="capsule-icon"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="capsule-label">Home</span>
    </a>

    <a href="/master-bank" class="capsule-pill nav-tab <%= curActiveTab === 'bank' ? 'active' : '' %>" id="tab-btn-bank" data-tab="bank" onclick="if(typeof handleNavClick==='function'){return handleNavClick('bank', '/master-bank', event);}" aria-label="Songbook">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="capsule-icon"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      <span class="capsule-label">Songbook</span>
    </a>

    <a href="/submit-form" class="capsule-pill nav-tab <%= curActiveTab === 'singer' ? 'active' : '' %>" id="tab-btn-singer" data-tab="singer" onclick="if(typeof handleNavClick==='function'){return handleNavClick('singer', '/submit-form', event);}" aria-label="Mark Bhajan">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="capsule-icon"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
      <span class="capsule-label">Mark</span>
    </a>

    <a href="/plan-view" class="capsule-pill nav-tab <%= curActiveTab === 'plan' ? 'active' : '' %>" id="tab-btn-plan" data-tab="plan" onclick="if(typeof handleNavClick==='function'){return handleNavClick('plan', '/plan-view', event);}" aria-label="Live Session Plan">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="capsule-icon"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span class="capsule-label">Plan</span>
    </a>

    <a href="/singer/hub" class="capsule-pill nav-tab <%= curActiveTab === 'hub' ? 'active' : '' %>" id="tab-btn-hub" data-tab="hub" onclick="if(typeof handleNavClick==='function'){return handleNavClick('hub', '/singer/hub', event);}" aria-label="Singer Hub">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="capsule-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span class="capsule-label">Hub</span>
    </a>

    <% if (hasAdmin) { %>
      <a href="/admin" class="capsule-pill nav-tab <%= curActiveTab === 'admin' ? 'active' : '' %>" id="tab-btn-admin" data-tab="admin" data-no-shell="1" onclick="if(typeof handleNavClick==='function'){return handleNavClick('admin', '/admin', event);}" aria-label="Admin Portal">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="capsule-icon"><rect width="7" height="7" x="3" y="3"/><rect width="7" height="7" x="14" y="3"/><rect width="7" height="7" x="14" y="14"/><rect width="7" height="7" x="3" y="14"/></svg>
        <span class="capsule-label">Admin</span>
      </a>
    <% } %>
  </div>
</nav>
