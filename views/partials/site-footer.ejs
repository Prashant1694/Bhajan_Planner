<!-- Home Page Contact & Support Footer -->
<div class="home-footer-wrapper">
  <div class="footer-card">
    <div class="footer-grid">
      <!-- Col 1: Organisation & Help Info -->
      <div class="footer-col footer-col-brand">
        <div class="footer-brand-header">
          <img src="/images/logo.png" alt="Sri Sathya Sai Seva Organisation" class="footer-logo"
            onerror="this.style.display='none'">
          <div>
            <h4 class="footer-brand-title">Sri Sathya Sai Seva Organisation</h4>
            <p class="footer-brand-subtitle">Gandhinagar Samiti &bull; Bhajan Scheduler</p>
          </div>
        </div>
        <p class="footer-desc">
          Dedicated to organizing devotional sessions with sanctity, discipline, and unity. Singers and devotees are
          warmly encouraged to reach out for any scheduling or technical assistance.
        </p>
        <div class="footer-quote">
          <span>&ldquo;Love All, Serve All &bull; Help Ever, Hurt Never&rdquo;</span>
        </div>
      </div>

      <!-- Col 2: Contact Card & Support -->
      <div class="footer-col footer-col-contact">
        <h4 class="footer-heading">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:6px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Contact &amp; Support
        </h4>
        <p class="footer-help-note">Reach out to the Samiti coordination team for any assistance or inquiries:</p>
        <div class="contact-card">
          <a href="tel:+919265056242" class="contact-item">
            <span class="contact-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </span>
            <div>
              <span class="contact-label">Helpline / Coordinator 1</span>
              <strong class="contact-val">+91 9265056242</strong>
            </div>
          </a>
          <a href="tel:+919624888795" class="contact-item">
            <span class="contact-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </span>
            <div>
              <span class="contact-label">Helpline / Coordinator 2</span>
              <strong class="contact-val">+91 9624888795</strong>
            </div>
          </a>
          <a href="mailto:ssso.gandhinagar@gmail.com" class="contact-item">
            <span class="contact-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <div>
              <span class="contact-label">Official Email</span>
              <strong class="contact-val">ssso.gandhinagar@gmail.com</strong>
            </div>
          </a>
          <a href="https://maps.app.goo.gl/DEn3bQ5FbULzEQEE7" target="_blank" rel="noopener noreferrer"
            class="contact-item contact-item-address" title="Open location in Google Maps">
            <span class="contact-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div>
              <span class="contact-label">Centre Address</span>
              <span class="contact-val contact-address">Satyadeep, 20, Gayatri Society, Vasna Hadmatiya, Sargasan,
                Gandhinagar - 382015</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Col 3: PWA App Download -->
      <div class="footer-col footer-col-pwa">
        <h4 class="footer-heading">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:6px;"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          Install Bhajan Planner App
        </h4>
        <p class="footer-pwa-desc">
          Install the web app on your phone or tablet for offline schedule access, fast loading, and native full-screen
          experience.
        </p>
        <div class="footer-pwa-card">
          <div class="footer-pwa-badges">
            <span class="pwa-badge">Apple iOS</span>
            <span class="pwa-badge">Android</span>
            <span class="pwa-badge">Desktop Web</span>
          </div>
          <button type="button" id="footerPwaInstallBtn" class="footer-btn-install">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:6px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Install Bhajan Planner App
          </button>
          <div class="footer-pwa-subtext">No app store download needed &bull; Instant &amp; Lightweight (&lt; 2 MB)</div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="footer-bottom-bar">
      <div class="footer-copyright">
        &copy; <%= new Date().getFullYear() %> Sri Sathya Sai Seva Organisation, Gandhinagar.
        <span id="footerAdminLinkWrap" style="<%= (typeof currentAdmin !== 'undefined' && currentAdmin) ? '' : 'display:none;' %>">
          &bull; <a href="/admin" class="footer-admin-link" style="color: inherit; text-decoration: underline;">Admin Portal</a>
        </span>
      </div>
      <script>
        try {
          if (localStorage.getItem('bp_is_admin') === 'true') {
            var el = document.getElementById('footerAdminLinkWrap');
            if (el) el.style.display = 'inline';
          }
        } catch (_) {}
      </script>
    </div>
  </div>
</div>