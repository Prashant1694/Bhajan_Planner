<header class="native-top-bar admin-topbar" id="adminTopBar" role="banner">

    <div class="native-top-left" style="display:flex; align-items:center; gap:8px;">
        <button type="button" id="mobileSidebarToggle" class="native-action-btn admin-sidebar-toggle-btn" aria-label="Open Admin Menu" title="Admin Navigation Menu" style="margin-right:2px;" onclick="if(typeof window.toggleMobileSidebar==='function'){window.toggleMobileSidebar(event);}">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <a href="/admin" class="native-top-brand-link" style="display:flex; align-items:center; gap:10px; text-decoration:none; color:inherit;">
            <div class="native-top-logo-wrap" style="width:32px; height:32px; min-width:32px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                <img src="/images/logo.png" alt="Sri Sathya Sai Emblem" class="native-top-logo" style="width:32px; height:32px; max-width:32px; max-height:32px; object-fit:contain; display:block;">
            </div>
            <div class="native-top-brand">
                <div class="native-top-title-row">
                    <span class="native-top-title">Bhajan Planner</span>
                </div>
                <span class="native-top-subtitle">SSSO - GANDHINAGAR</span>
            </div>
        </a>
    </div>

    <div class="native-top-actions">
        <!-- Quick Public Devotee View Link -->
        <a href="/?tab=home" target="_top" class="topbar-quick-link" title="Open Public Devotee Portal" onclick="if(window.top && window.top !== window && typeof window.top.switchTab === 'function'){ window.top.switchTab('home'); return false; }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <span class="quick-link-text">Public App</span>
            <span class="quick-link-arrow">&rarr;</span>
        </a>

        <!-- Topbar Theme Toggle Button -->
        <button
            type="button"
            class="native-action-btn header-icon-btn admin-theme-toggle-btn theme-toggle"
            id="topbarThemeToggle"
            aria-label="Toggle dark mode"
            title="Toggle dark / light mode"
            onclick="if(typeof window.toggleTheme==='function'){window.toggleTheme(event);}else if(window.top&&typeof window.top.toggleTheme==='function'){window.top.toggleTheme(event);}"
        >
            <span class="icon-moon" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </span>
            <span class="icon-sun" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </span>
        </button>

        <!-- Admin Profile Badge -->
        <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
        <div class="admin-profile-badge">
            <div class="admin-avatar-bubble" title="<%= currentAdmin.displayName || currentAdmin.username %>">
                <%= (currentAdmin.displayName || currentAdmin.username || "A").charAt(0).toUpperCase() %>
            </div>
            <div class="admin-profile-info">
                <span class="admin-name"><%= currentAdmin.displayName || currentAdmin.username %></span>
                <span class="role-badge <%= currentAdmin.role === 'super_admin' ? 'role-super' : 'role-admin' %>">
                    <%= currentAdmin.role === "super_admin" ? "Super Admin" : "Admin" %>
                </span>
            </div>
        </div>
        <% } %>
    </div>

</header>
