  // ═══ SESSION AUDIO & TIMESTAMPS MODAL JS ═══
  const sessionDateStr = '<%= date %>';
  let cachedScheduledBhajans = <%- JSON.stringify(submissions.map(s => ({ id: s.id, title: s.title, singer_name: s.singer_name, deity: s.deity }))) %>;
  let currentAudioRecord = <%- JSON.stringify(sessionAudio ? { id: sessionAudio.id, title: sessionAudio.title, audio_url: sessionAudio.audio_url, storage_key: sessionAudio.storage_key, is_published: sessionAudio.is_published, duration_seconds: sessionAudio.duration_seconds, timestamps: sessionAudio.timestamps || [] } : null) %>;

  function formatSecToMMSS(seconds) {
    if (isNaN(seconds) || seconds < 0) return '00:00';
    seconds = Math.floor(seconds);
    const hrs = Math.floor(seconds / 3600);
    const mins = Math.floor((seconds % 3600) / 60);
    const secs = seconds % 60;
    if (hrs > 0) {
      return `${hrs}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  function parseMMSSToSec(str) {
    if (!str) return 0;
    if (typeof str === 'number') return Math.floor(str);
    const parts = String(str).trim().split(':').map(Number);
    if (parts.some(isNaN)) return 0;
    if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
    if (parts.length === 2) return parts[0] * 60 + parts[1];
    return parts[0] || 0;
  }

  function updateSessionAudioTagUI() {
    const tag = document.getElementById('sessionAudioTag');
    const tagText = document.getElementById('sessionAudioTagText');
    if (!tag) return;
    if (currentAudioRecord && currentAudioRecord.audio_url) {
      tag.style.display = 'inline-flex';
      const count = (currentAudioRecord.timestamps && currentAudioRecord.timestamps.length) || 0;
      tagText.textContent = count > 0 ? `Audio (${count} Bhajans)` : 'Audio Linked';
    } else {
      tag.style.display = 'none';
    }
  }

  window.openAudioModal = function() {
    const modal = document.getElementById('sessionAudioModal');
    if (!modal) return;
    modal.classList.add('show');
    // Synchronously populate immediately (0ms lag, no waiting for network)
    populateAudioFields(currentAudioRecord);
    renderTimestampsTable((currentAudioRecord && currentAudioRecord.timestamps) || []);
    // Fetch fresh data in background
    loadSessionAudioData();
    loadCloudflareFiles(false);
  };

  window.closeAudioModal = function() {
    const modal = document.getElementById('sessionAudioModal');
    if (modal) modal.classList.remove('show');
    const preview = document.getElementById('adminAudioPreview');
    if (preview) preview.pause();
  };

  window.loadSessionAudioData = function() {
    fetch(`/admin/api/sessions/${sessionDateStr}/audio`)
      .then(res => res.json())
      .then(data => {
        if (!data.success) return;
        if (data.scheduledBhajans) cachedScheduledBhajans = data.scheduledBhajans;
        currentAudioRecord = data.audio;
        populateAudioFields(data.audio);
        renderTimestampsTable((data.audio && data.audio.timestamps) || []);
        updateSessionAudioTagUI();
      })
      .catch(err => {
        console.warn('Could not load session audio data:', err);
      });
  };

  function populateAudioFields(audio) {
    const badge = document.getElementById('audioStatusBadge');
    const titleInput = document.getElementById('audioTitleInput');
    const urlInput = document.getElementById('audioUrlInput');
    const pubCheck = document.getElementById('audioIsPublished');
    const playerWrap = document.getElementById('adminAudioPlayerWrap');
    const previewAudio = document.getElementById('adminAudioPreview');
    const unlinkBtn = document.getElementById('btnUnlinkAudio');
    const errNotice = document.getElementById('adminAudioErrorNotice');
    if (errNotice) errNotice.style.display = 'none';

    if (audio && audio.audio_url) {
      badge.textContent = audio.storage_key ? 'Cloudflare R2 Linked' : 'Direct Audio Linked';
      badge.style.background = 'rgba(16, 185, 129, 0.15)';
      badge.style.color = '#059669';
      titleInput.value = audio.title || `Session Recording – ${sessionDateStr}`;
      urlInput.value = audio.audio_url || '';
      pubCheck.checked = audio.is_published !== false;
      unlinkBtn.style.display = 'inline-block';

      if (previewAudio) {
        if (previewAudio.src !== audio.audio_url) {
          previewAudio.src = audio.audio_url;
          try { previewAudio.load(); } catch(e) {}
        }
      }
      if (playerWrap) playerWrap.style.display = 'block';
    } else {
      badge.textContent = 'Not Linked';
      badge.style.background = 'rgba(100, 116, 139, 0.12)';
      badge.style.color = 'var(--text-light)';
      titleInput.value = `Session Recording – ${sessionDateStr}`;
      urlInput.value = '';
      pubCheck.checked = true;
      unlinkBtn.style.display = 'none';
      if (playerWrap) playerWrap.style.display = 'none';
      if (previewAudio) {
        previewAudio.removeAttribute('src');
        try { previewAudio.load(); } catch(e) {}
      }
    }
  }

  window.loadCloudflareFiles = function(forceRefresh) {
    const select = document.getElementById('audioR2Select');
    const help = document.getElementById('r2StatusHelp');
    if (forceRefresh) help.textContent = 'Checking Cloudflare R2 bucket...';

    fetch('/admin/api/cloudflare/audio-files')
      .then(res => res.json())
      .then(data => {
        select.innerHTML = '<option value="">-- Choose file from Cloudflare R2 --</option>';
        if (data.configured && data.files && data.files.length > 0) {
          data.files.forEach(f => {
            const name = f.name || f.filename || f.key || 'Audio File';
            const sizeFormatted = f.size_formatted || (f.sizeBytes ? (f.sizeBytes / (1024 * 1024)).toFixed(1) + ' MB' : '');
            const url = f.url || f.publicUrl || '';
            const opt = document.createElement('option');
            opt.value = f.key;
            opt.dataset.url = url;
            opt.dataset.size = f.sizeBytes || f.size || 0;
            opt.textContent = sizeFormatted ? `${name} (${sizeFormatted})` : name;
            if (currentAudioRecord && currentAudioRecord.storage_key === f.key) {
              opt.selected = true;
            }
            select.appendChild(opt);
          });
          help.textContent = `Found ${data.files.length} recording(s) in Cloudflare R2 bucket.`;
          help.style.color = '#059669';
        } else {
          help.textContent = data.message || 'Cloudflare R2 not configured yet. You can paste any direct audio URL below.';
          help.style.color = 'var(--text-muted)';
        }
      })
      .catch(err => {
        help.textContent = 'Could not connect to Cloudflare R2.';
        help.style.color = '#ef4444';
      });
  };

  window.onSelectR2File = function(key) {
    if (!key) return;
    const select = document.getElementById('audioR2Select');
    const selectedOpt = select.options[select.selectedIndex];
    const url = selectedOpt ? selectedOpt.dataset.url : '';
    const name = selectedOpt ? selectedOpt.textContent.split(' (')[0] : '';

    if (url) {
      document.getElementById('audioUrlInput').value = url;
    }
    const currentTitle = document.getElementById('audioTitleInput').value;
    if (!currentTitle || currentTitle.startsWith('Session Recording –')) {
      document.getElementById('audioTitleInput').value = name || `Session Recording – ${sessionDateStr}`;
    }

    const preview = document.getElementById('adminAudioPreview');
    const playerWrap = document.getElementById('adminAudioPlayerWrap');
    const badge = document.getElementById('audioStatusBadge');
    const errNotice = document.getElementById('adminAudioErrorNotice');
    if (errNotice) errNotice.style.display = 'none';

    if (url) {
      badge.textContent = 'Cloudflare R2 Selected (Click Save)';
      badge.style.background = 'rgba(79, 70, 229, 0.15)';
      badge.style.color = '#4338ca';
      if (preview) {
        preview.src = url;
        try { preview.load(); } catch(e) {}
      }
      if (playerWrap) playerWrap.style.display = 'block';
    }
  };

  window.onAudioUrlDirectChange = function(val) {
    const url = (val || '').trim();
    const preview = document.getElementById('adminAudioPreview');
    const playerWrap = document.getElementById('adminAudioPlayerWrap');
    const badge = document.getElementById('audioStatusBadge');
    const errNotice = document.getElementById('adminAudioErrorNotice');
    if (errNotice) errNotice.style.display = 'none';

    if (url && (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('/'))) {
      badge.textContent = 'Audio URL Entered (Click Save)';
      badge.style.background = 'rgba(217, 119, 6, 0.15)';
      badge.style.color = '#b45309';
      if (preview) {
        if (preview.src !== url) {
          preview.src = url;
          try { preview.load(); } catch(e) {}
        }
      }
      if (playerWrap) playerWrap.style.display = 'block';
    } else if (!url) {
      if (!currentAudioRecord || !currentAudioRecord.audio_url) {
        badge.textContent = 'Not Linked';
        badge.style.background = 'rgba(100, 116, 139, 0.12)';
        badge.style.color = 'var(--text-light)';
        if (preview) {
          preview.removeAttribute('src');
          try { preview.load(); } catch(e) {}
        }
        if (playerWrap) playerWrap.style.display = 'none';
      }
    }
  };

  window.saveAudioFileLink = function() {
    const btn = document.getElementById('btnSaveAudioLink');
    const url = document.getElementById('audioUrlInput').value.trim();
    const r2Select = document.getElementById('audioR2Select');
    const storageKey = r2Select ? r2Select.value : null;
    const title = document.getElementById('audioTitleInput').value.trim() || `Session Recording – ${sessionDateStr}`;
    const isPublished = document.getElementById('audioIsPublished').checked;
    const preview = document.getElementById('adminAudioPreview');
    const duration = preview && preview.duration && !isNaN(preview.duration) ? Math.floor(preview.duration) : 0;

    if (!url && !storageKey) {
      alert('Please select an audio file from Cloudflare R2 or enter a direct audio URL.');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Saving...';

    fetch(`/admin/api/sessions/${sessionDateStr}/audio`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        audio_url: url,
        storage_key: storageKey || null,
        title,
        duration_seconds: duration,
        is_published: isPublished
      })
    })
    .then(res => res.json())
    .then(data => {
      btn.disabled = false;
      btn.textContent = 'Save Audio File';
      if (data.success) {
        currentAudioRecord = data.audio;
        populateAudioFields(data.audio);
        updateSessionAudioTagUI();
        alert(data.audio && data.audio.is_published ? 'Audio recording saved and broadcast notification sent to everyone!' : 'Audio recording saved successfully!');
      } else {
        alert(data.error || 'Failed to save audio file.');
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.textContent = 'Save Audio File';
      alert('Network error saving audio file.');
    });
  };

  window.unlinkSessionAudio = function() {
    if (!confirm('Are you sure you want to remove the audio file and all timestamps for this session? Devotees will no longer be able to listen to this session.')) {
      return;
    }
    const btn = document.getElementById('btnUnlinkAudio');
    btn.disabled = true;

    fetch(`/admin/api/sessions/${sessionDateStr}/audio`, {
      method: 'DELETE'
    })
    .then(res => res.json())
    .then(data => {
      btn.disabled = false;
      if (data.success) {
        currentAudioRecord = null;
        populateAudioFields(null);
        renderTimestampsTable([]);
        updateSessionAudioTagUI();
        alert('Session audio removed.');
      } else {
        alert(data.error || 'Could not remove audio.');
      }
    })
    .catch(() => {
      btn.disabled = false;
      alert('Network error removing audio.');
    });
  };

  // Preview Player playhead observer & error listener
  const previewAudioEl = document.getElementById('adminAudioPreview');
  const playheadBadge = document.getElementById('adminPlayerTimeDisplay');
  const audioErrNotice = document.getElementById('adminAudioErrorNotice');
  if (previewAudioEl) {
    if (playheadBadge) {
      previewAudioEl.addEventListener('timeupdate', () => {
        playheadBadge.textContent = formatSecToMMSS(previewAudioEl.currentTime);
      });
    }
    previewAudioEl.addEventListener('error', () => {
      if (audioErrNotice && previewAudioEl.src) {
        const err = previewAudioEl.error;
        let msg = 'Could not stream preview audio.';
        if (err) {
          if (err.code === 2) msg = 'Network error streaming audio.';
          else if (err.code === 3) msg = 'Audio decoding error or unsupported audio format.';
          else if (err.code === 4) msg = 'Audio file not accessible or URL blocked. Please check that the Cloudflare R2 bucket has Public Access turned ON.';
        }
        audioErrNotice.textContent = msg;
        audioErrNotice.style.display = 'block';
      }
    });
    previewAudioEl.addEventListener('canplay', () => {
      if (audioErrNotice) audioErrNotice.style.display = 'none';
    });
  }

  // Timestamps Table Rendering & Manipulation
  function renderTimestampsTable(timestamps) {
    const tbody = document.getElementById('timestampsTableBody');
    const prompt = document.getElementById('noTimestampsPrompt');
    if (!tbody) return;

    tbody.innerHTML = '';
    var list = (timestamps && Array.isArray(timestamps)) ? timestamps.slice() : [];

    if (list.length === 0) {
      if (prompt) prompt.style.display = 'block';
      return;
    }
    if (prompt) prompt.style.display = 'none';

    // Verify Aarthi is present as the default closing entry
    const hasAarti = list.some(t => {
      const title = (t.bhajan_title || '').toLowerCase();
      const deity = (t.deity || '').toLowerCase();
      return title.includes('aarti') || title.includes('aarthi') || deity === 'aarti' || deity === 'aarthi';
    });
    if (!hasAarti) {
      list.push({
        submission_id: null,
        bhajan_title: 'Aarthi',
        singer_name: 'All Devotees',
        deity: 'Aarthi',
        start_seconds: 0,
        start_formatted: '00:00'
      });
    }

    list.forEach((t, idx) => {
      addTimestampRowElement(t, idx + 1);
    });
  }

  function addTimestampRowElement(data, indexNum) {
    const tbody = document.getElementById('timestampsTableBody');
    const prompt = document.getElementById('noTimestampsPrompt');
    if (prompt) prompt.style.display = 'none';

    const row = document.createElement('tr');
    row.style.borderBottom = '1px solid var(--border)';
    row.className = 'timestamp-entry-row';

    const num = indexNum || tbody.children.length + 1;
    const titleVal = data.bhajan_title || '';
    const singerVal = data.singer_name || '';
    const subIdVal = data.submission_id || '';
    const deityVal = data.deity || '';
    const startVal = data.start_formatted || formatSecToMMSS(data.start_seconds != null ? data.start_seconds : 0);

    // Build bhajan dropdown / autocomplete options
    let bhajanOptionsHtml = '<option value="">-- Choose from Lineup or type below --</option>';
    cachedScheduledBhajans.forEach(b => {
      const isSel = (subIdVal && String(b.id) === String(subIdVal)) || (titleVal && b.title.trim().toLowerCase() === titleVal.trim().toLowerCase());
      bhajanOptionsHtml += `<option value="${b.id}" data-title="${encodeURIComponent(b.title)}" data-singer="${encodeURIComponent(b.singer_name || '')}" data-deity="${encodeURIComponent(b.deity || '')}" ${isSel ? 'selected' : ''}>${b.title} (${b.singer_name || 'No Singer'})</option>`;
    });

    const isAartiSel = !subIdVal && (titleVal.toLowerCase().includes('aarti') || titleVal.toLowerCase().includes('aarthi') || deityVal.toLowerCase() === 'aarti' || deityVal.toLowerCase() === 'aarthi');
    bhajanOptionsHtml += `<option value="AARTI" data-title="Aarthi" data-singer="All Devotees" data-deity="Aarthi" ${isAartiSel ? 'selected' : ''}>Aarthi</option>`;

    row.innerHTML = `
      <td style="padding:8px 6px; font-weight:700; color:var(--text-muted); font-size:12px;" class="ts-row-num">${num}</td>
      <td style="padding:8px 6px;">
        <select class="workspace-search-input ts-bhajan-select" onchange="onBhajanSelectChange(this)" style="width:100%; max-width:none; padding:6px 8px; font-size:12.5px; margin-bottom:4px;">
          ${bhajanOptionsHtml}
        </select>
        <input type="text" class="workspace-search-input ts-bhajan-title" value="${titleVal.replace(/"/g, '&quot;')}" placeholder="Bhajan Title" style="width:100%; max-width:none; padding:5px 8px; font-size:12px;">
        <input type="hidden" class="ts-submission-id" value="${subIdVal}">
        <input type="hidden" class="ts-deity" value="${deityVal}">
      </td>
      <td style="padding:8px 6px;">
        <input type="text" class="workspace-search-input ts-singer-name" value="${singerVal.replace(/"/g, '&quot;')}" placeholder="Lead Singer" style="width:100%; max-width:none; padding:6px 8px; font-size:12.5px;">
      </td>
      <td style="padding:8px 6px;">
        <div style="display:flex; align-items:center; gap:6px;">
          <input type="text" class="workspace-search-input ts-start-time" value="${startVal}" placeholder="MM:SS" style="width:72px; padding:6px 8px; font-size:12.5px; font-family:monospace; text-align:center;">
          <button type="button" class="action-tool-btn-capture" onclick="captureTimeForRow(this)" title="Capture audio playhead time into this box">
            Capture
          </button>
        </div>
      </td>
      <td style="padding:8px 6px; text-align:center;">
        <div style="display:flex; justify-content:center; align-items:center; gap:6px;">
          <button type="button" class="action-tool-btn-play" onclick="testPlayRow(this)" title="Test seek audio to this timestamp">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
          <button type="button" onclick="deleteTimestampRow(this)" title="Remove row" style="background:none; border:none; color:#ef4444; font-size:18px; cursor:pointer; padding:2px 6px; line-height:1; border-radius:4px;">
            &times;
          </button>
        </div>
      </td>
    `;

    tbody.appendChild(row);
  }

  window.onBhajanSelectChange = function(selectEl) {
    const selectedOpt = selectEl.options[selectEl.selectedIndex];
    const row = selectEl.closest('tr');
    if (!row) return;

    if (selectedOpt && selectedOpt.value) {
      const title = decodeURIComponent(selectedOpt.dataset.title || '');
      const singer = decodeURIComponent(selectedOpt.dataset.singer || '');
      const deity = decodeURIComponent(selectedOpt.dataset.deity || '');
      const subId = selectedOpt.value;

      row.querySelector('.ts-bhajan-title').value = title;
      row.querySelector('.ts-singer-name').value = singer;
      row.querySelector('.ts-submission-id').value = (subId === 'AARTI') ? '' : subId;
      row.querySelector('.ts-deity').value = deity;
    }
  };

  window.captureTimeForRow = function(btn) {
    const row = btn.closest('tr');
    if (!row) return;
    const preview = document.getElementById('adminAudioPreview');
    if (!preview || isNaN(preview.currentTime)) {
      alert('Start playing the audio above first to capture its current time.');
      return;
    }
    const currentFormatted = formatSecToMMSS(preview.currentTime);
    const input = row.querySelector('.ts-start-time');
    if (input) {
      input.value = currentFormatted;
      input.style.borderColor = '#10b981';
      setTimeout(() => input.style.borderColor = '', 1500);
    }
  };

  window.testPlayRow = function(btn) {
    const row = btn.closest('tr');
    if (!row) return;
    const timeStr = row.querySelector('.ts-start-time').value;
    const seconds = parseMMSSToSec(timeStr);
    const preview = document.getElementById('adminAudioPreview');
    if (!preview || !preview.src) {
      alert('Please link or select an audio file first.');
      return;
    }
    preview.currentTime = seconds;
    preview.play().catch(() => {});
  };

  window.deleteTimestampRow = function(btn) {
    const row = btn.closest('tr');
    if (!row) return;
    row.remove();

    // Renumber
    const tbody = document.getElementById('timestampsTableBody');
    const rows = tbody.querySelectorAll('tr');
    rows.forEach((r, idx) => {
      const numCell = r.querySelector('.ts-row-num');
      if (numCell) numCell.textContent = idx + 1;
    });

    if (rows.length === 0) {
      const prompt = document.getElementById('noTimestampsPrompt');
      if (prompt) prompt.style.display = 'block';
    }
  };

  window.addEmptyTimestampRow = function() {
    addTimestampRowElement({
      bhajan_title: '',
      singer_name: '',
      submission_id: null,
      deity: '',
      start_seconds: 0
    });
  };

  window.autoPopulateFromLineup = function() {
    if (!cachedScheduledBhajans || cachedScheduledBhajans.length === 0) {
      alert('No scheduled bhajans found for this session date.');
      return;
    }

    const tbody = document.getElementById('timestampsTableBody');
    if (tbody.children.length > 0) {
      if (!confirm('Replace current rows with the session lineup?')) {
        return;
      }
    }

    tbody.innerHTML = '';
    cachedScheduledBhajans.forEach((b, idx) => {
      addTimestampRowElement({
        submission_id: b.id,
        bhajan_title: b.title,
        singer_name: b.singer_name || '',
        deity: b.deity || '',
        start_seconds: 0,
        start_formatted: '00:00'
      }, idx + 1);
    });

    // Default Last Entry: Aarthi (not linked to any single user)
    addTimestampRowElement({
      submission_id: null,
      bhajan_title: 'Aarthi',
      singer_name: 'All Devotees',
      deity: 'Aarthi',
      start_seconds: 0,
      start_formatted: '00:00'
    }, cachedScheduledBhajans.length + 1);
  };

  window.saveAllTimestampsAjax = function() {
    const rows = document.querySelectorAll('#timestampsTableBody tr');
    if (rows.length === 0) {
      alert('Please add at least one bhajan timestamp before saving.');
      return;
    }

    if (!currentAudioRecord || !currentAudioRecord.id) {
      alert('Please save the audio file recording first before saving timestamps.');
      return;
    }

    const timestampsPayload = [];
    rows.forEach((r, idx) => {
      const title = r.querySelector('.ts-bhajan-title').value.trim();
      const singer = r.querySelector('.ts-singer-name').value.trim();
      const subId = r.querySelector('.ts-submission-id').value.trim() || null;
      const deity = r.querySelector('.ts-deity').value.trim() || null;
      const timeStr = r.querySelector('.ts-start-time').value.trim();
      const startSec = parseMMSSToSec(timeStr);

      if (title && singer) {
        timestampsPayload.push({
          submission_id: subId ? parseInt(subId, 10) : null,
          bhajan_title: title,
          singer_name: singer,
          deity: deity,
          start_seconds: startSec,
          order_index: idx
        });
      }
    });

    if (timestampsPayload.length === 0) {
      alert('Each timestamp row requires a Bhajan Title and Singer Name.');
      return;
    }

    const btn = document.getElementById('btnSaveTimestamps');
    btn.disabled = true;
    btn.textContent = 'Saving Timestamps...';

    fetch(`/admin/api/sessions/${sessionDateStr}/audio/timestamps`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ timestamps: timestampsPayload })
    })
    .then(res => res.json())
    .then(data => {
      btn.disabled = false;
      btn.textContent = 'Save All Timestamps';
      if (data.success) {
        if (currentAudioRecord) {
          currentAudioRecord.timestamps = data.timestamps;
        }
        updateSessionAudioTagUI();
        alert(`Successfully saved ${data.count} timestamps!`);
        closeAudioModal();
      } else {
        alert(data.error || 'Failed to save timestamps.');
      }
    })
    .catch(err => {
      btn.disabled = false;
      btn.textContent = 'Save All Timestamps';
      alert('Network error saving timestamps.');
    });
  };

  // On DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    captureInitialOrder();
    initDragDrop();

    try {
      const saved = localStorage.getItem('bp-seq-view');
      if (saved === 'cards') {
        setSequencerView('cards');
      } else {
        setSequencerView('table');
      }
    } catch(e) {
      setSequencerView('table');
    }

    populateAudioFields(currentAudioRecord);
    updateSessionAudioTagUI();
  });

})();
</script>
