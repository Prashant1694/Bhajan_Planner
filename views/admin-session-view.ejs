<style>
  /* Guaranteed Action & Modal Button Styles (Cache-proof) */
  .session-modal-footer .action-tool-btn,
  .action-tool-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 7px !important;
    height: 38px !important;
    padding: 0 18px !important;
    border-radius: 9px !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    background: var(--surface, #ffffff) !important;
    color: var(--text, #1f2937) !important;
    border: 1px solid var(--border, #d1d5db) !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
    transition: all 0.15s ease !important;
    white-space: nowrap !important;
    text-decoration: none !important;
    line-height: 1 !important;
    box-sizing: border-box !important;
  }
  .session-modal-footer .action-tool-btn:hover,
  .action-tool-btn:hover {
    background: var(--surface-raised, #f9fafb) !important;
    border-color: #6366f1 !important;
    color: #4f46e5 !important;
  }
  .action-tool-btn-primary,
  .session-modal-footer button[type="submit"] {
    background: linear-gradient(135deg, #4f46e5, #4338ca) !important;
    color: #ffffff !important;
    border: 1px solid #4338ca !important;
    box-shadow: 0 2px 4px rgba(79, 70, 229, 0.25) !important;
    text-decoration: none !important;
  }
  .action-tool-btn-primary:hover,
  .session-modal-footer button[type="submit"]:hover {
    background: linear-gradient(135deg, #4338ca, #3730a3) !important;
    color: #ffffff !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 4px 8px rgba(79, 70, 229, 0.35) !important;
    text-decoration: none !important;
  }
  .action-tool-btn-whatsapp,
  .session-modal-footer a.action-tool-btn-whatsapp {
    background: #25D366 !important;
    color: #ffffff !important;
    border: 1px solid #1ebd59 !important;
    box-shadow: 0 2px 6px rgba(37, 211, 102, 0.28) !important;
    text-decoration: none !important;
  }
  .action-tool-btn-whatsapp:hover,
  .session-modal-footer a.action-tool-btn-whatsapp:hover {
    background: #20bd5a !important;
    color: #ffffff !important;
    border-color: #1a9e4b !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 4px 10px rgba(37, 211, 102, 0.4) !important;
    text-decoration: none !important;
  }
  .action-tool-btn-whatsapp svg,
  .session-modal-footer a.action-tool-btn-whatsapp svg {
    color: #ffffff !important;
    stroke: #ffffff !important;
  }

  /* Compact Executive Action Buttons (Sleek, Refined, Non-stretching) */
  .session-actions-command-bar {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end !important;
    gap: 7px !important;
    width: auto !important;
    max-width: 100% !important;
    margin-top: 0 !important;
  }
  @media (max-width: 900px) {
    .session-actions-command-bar {
      width: 100% !important;
      align-items: flex-start !important;
      margin-top: 10px !important;
    }
  }
  .session-primary-actions {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    flex-wrap: wrap !important;
    width: auto !important;
    max-width: 100% !important;
  }
  .cmd-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    height: 33px !important;
    padding: 0 14px !important;
    border-radius: 7px !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 12.5px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: all 0.15s ease !important;
    border: 1px solid transparent !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08) !important;
    white-space: nowrap !important;
    width: auto !important;
    flex: 0 0 auto !important;
    box-sizing: border-box !important;
    letter-spacing: 0.1px !important;
  }
  .cmd-btn:hover {
    transform: translateY(-1px) !important;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.12) !important;
  }
  .cmd-btn:active {
    transform: translateY(0) !important;
  }
  .cmd-btn-add {
    background: linear-gradient(135deg, #d97706, #b45309) !important;
    color: #ffffff !important;
    border-color: #b45309 !important;
  }
  .cmd-btn-add:hover {
    background: linear-gradient(135deg, #b45309, #92400e) !important;
  }
  .cmd-btn-audio {
    background: linear-gradient(135deg, #4f46e5, #4338ca) !important;
    color: #ffffff !important;
    border-color: #4338ca !important;
  }
  .cmd-btn-audio:hover {
    background: linear-gradient(135deg, #4338ca, #3730a3) !important;
  }
  .cmd-btn-share {
    background: linear-gradient(135deg, #059669, #047857) !important;
    color: #ffffff !important;
    border-color: #047857 !important;
  }
  .cmd-btn-share:hover {
    background: linear-gradient(135deg, #047857, #065f46) !important;
  }
  .session-secondary-tools {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    flex-wrap: wrap !important;
    width: auto !important;
  }
  .sec-tool-btn {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 5px !important;
    height: 29px !important;
    padding: 0 11px !important;
    border-radius: 7px !important;
    border: 1px solid var(--border) !important;
    background: var(--surface-raised) !important;
    color: var(--text) !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 11.5px !important;
    font-weight: 500 !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: all 0.15s ease !important;
    white-space: nowrap !important;
    box-sizing: border-box !important;
  }
  .sec-tool-btn .sec-tool-icon svg {
    width: 13px !important;
    height: 13px !important;
  }
</style>

<div class="session-unified-page">

  <!-- ═══ 1. UNIFIED EXECUTIVE HEADER (Merged Hero, Actions, Stats & Diagnostics) ═══ -->
  <header class="session-unified-header">
    
    <!-- Top Row: Identity & Action Toolbar -->
    <div class="session-header-top-row">
      <div class="session-header-identity">
        <% 
          let monthShort = 'SES';
          let dayNum = '01';
          try {
            const parts = date.split('-');
            const dObj = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
            monthShort = dObj.toLocaleDateString('en-US', { month: 'short' });
            dayNum = dObj.toLocaleDateString('en-US', { day: '2-digit' });
          } catch(e) {}

          const safeSpeedBreakdown = (typeof speedBreakdown !== 'undefined' && speedBreakdown) 
            ? speedBreakdown 
            : {
                med: (typeof speedCounts !== 'undefined' && speedCounts) ? (speedCounts.medium || 0) : 0,
                fast: (typeof speedCounts !== 'undefined' && speedCounts) ? (speedCounts.fast || 0) : 0,
                slow: (typeof speedCounts !== 'undefined' && speedCounts) ? (speedCounts.slow || 0) : 0
              };
          const safeUniqueDeities = (typeof uniqueDeities !== 'undefined') 
            ? uniqueDeities 
            : (typeof deityCounts !== 'undefined' && deityCounts ? Object.keys(deityCounts).length : 0);
        %>
        <div class="session-date-tile" title="Session Date">
          <span class="session-date-tile-month"><%= monthShort %></span>
          <span class="session-date-tile-day"><%= dayNum %></span>
        </div>

        <div class="session-title-block">
          <h1>
            <span><%= humanDate || date %></span>
            <span style="font-size:15px; font-weight:500; color:var(--text-light); font-family:var(--font-body);">
              (<%= dayOfWeek || 'Session' %>)
            </span>
          </h1>

          <div class="session-tags-row">
            <% if (sessionPerm && sessionPerm.type === 'festival') { %>
              <span class="session-tag session-tag-festival">
                Festival: <%= sessionPerm.description || 'Special Celebration' %>
              </span>
            <% } else if (sessionPerm && sessionPerm.type === 'special') { %>
              <span class="session-tag session-tag-special">
                Special: <%= sessionPerm.description || 'Special Session' %>
              </span>
            <% } else { %>
              <span class="session-tag session-tag-regular">
                Regular Mandir Session
              </span>
            <% } %>

            <span id="sessionLockBadge" class="session-lock-tag <%= isLocked ? 'is-locked' : 'is-open' %>">
              <span class="session-pulse-indicator"></span>
              <span id="sessionLockText"><%= isLocked ? 'Submissions Locked' : 'Submissions Open' %></span>
            </span>

            <% if (isUpcoming) { %>
              <span class="session-tag session-tag-regular" style="color:var(--primary); font-weight:700;">
                Upcoming
              </span>
            <% } else { %>
              <span class="session-tag session-tag-regular" style="color:var(--text-light);">
                Past
              </span>
            <% } %>

            <span id="sessionAudioTag" class="session-tag" style="display:none; background:rgba(79, 70, 229, 0.12); color:#4338ca; border:1px solid rgba(79, 70, 229, 0.25); font-weight:700;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display:inline; vertical-align:middle; margin-right:4px;"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              <span id="sessionAudioTagText">Audio Linked</span>
            </span>
          </div>
        </div>
      </div>

      <!-- 2-Tier Cohesive Action Command Bar -->
      <div class="session-actions-command-bar">
        <!-- Tier 1: Primary High-Priority Actions -->
        <div class="session-primary-actions">
          <a href="/submit-form?admin=true&session_date=<%= date %>" class="cmd-btn cmd-btn-add" title="Add a new bhajan to this date">
            <span class="cmd-btn-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
            <span class="cmd-btn-text">Add Bhajan</span>
          </a>

          <button type="button" class="cmd-btn cmd-btn-audio" onclick="openAudioModal()" title="Link audio recording & manage bhajan timestamps">
            <span class="cmd-btn-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            </span>
            <span class="cmd-btn-text">Session Audio</span>
          </button>

          <button type="button" class="cmd-btn cmd-btn-share" onclick="openShareModal()" title="Share program via WhatsApp">
            <span class="cmd-btn-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </span>
            <span class="cmd-btn-text">Share Lineup</span>
          </button>
        </div>

        <!-- Tier 2: Secondary Tools Grid (Equal column, balanced layout) -->
        <div class="session-secondary-tools">
          <button type="button" id="toggleLockBtn" onclick="toggleLockAjax('<%= date %>')" 
                  class="sec-tool-btn <%= isLocked ? 'is-unlocked-state' : 'is-locked-state' %>"
                  title="<%= isLocked ? 'Unlock submissions' : 'Lock session submissions' %>">
            <span class="sec-tool-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <span class="sec-tool-label" id="toggleLockBtnText"><%= isLocked ? 'Unlock' : 'Lock' %></span>
          </button>

          <a href="/plan-view?session_date=<%= date %>" class="sec-tool-btn" title="View live devotee program">
            <span class="sec-tool-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </span>
            <span class="sec-tool-label">Live Plan</span>
          </a>

          <a href="/admin/rules?date=<%= date %>" class="sec-tool-btn" title="Session sequence rules">
            <span class="sec-tool-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </span>
            <span class="sec-tool-label">Rules</span>
          </a>

          <button type="button" class="sec-tool-btn" onclick="openCopyModal()" title="Duplicate lineup from past session">
            <span class="sec-tool-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </span>
            <span class="sec-tool-label">Duplicate</span>
          </button>

          <button type="button" class="sec-tool-btn" onclick="window.print()" title="Print physical session schedule">
            <span class="sec-tool-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            </span>
            <span class="sec-tool-label">Print</span>
          </button>

          <a href="/admin" class="sec-tool-btn" title="Back to session calendar">
            <span class="sec-tool-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </span>
            <span class="sec-tool-label">Calendar</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Executive Session Metrics & Quality Diagnostics (Compact Chips) -->
    <div class="session-metrics-deck">
      <div class="metrics-grid">
        <div class="session-stat-chip">
          <div class="session-stat-icon-wrap" style="background:#eef2ff; color:#4f46e5;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          </div>
          <div class="session-stat-data">
            <span class="session-stat-val"><%= submissions.length %> Bhajans <%= submissions.length > 0 ? '(~' + Math.round(submissions.length * 4.5) + ' min)' : '' %></span>
            <span class="session-stat-lbl">Program Size</span>
          </div>
        </div>

        <div class="session-stat-chip">
          <div class="session-stat-icon-wrap" style="background:#ecfeff; color:#0ea5e9;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          </div>
          <div class="session-stat-data">
            <span class="session-stat-val"><%= uniqueSingers %> Singer<%= uniqueSingers === 1 ? '' : 's' %></span>
            <span class="session-stat-lbl">Singers Lineup</span>
          </div>
        </div>

        <div class="session-stat-chip">
          <div class="session-stat-icon-wrap" style="background:#fffbeb; color:#f59e0b;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="session-stat-data">
            <span class="session-stat-val" style="font-size:13.5px !important;">
              <span style="color:#d97706; font-weight:700;"><%= safeSpeedBreakdown.med %> Medium</span>
              <span style="color:var(--text-light); opacity:0.6; margin:0 3px;">·</span>
              <span style="color:#ef4444; font-weight:700;"><%= safeSpeedBreakdown.fast %> Fast</span>
              <span style="color:var(--text-light); opacity:0.6; margin:0 3px;">·</span>
              <span style="color:#0284c7; font-weight:700;"><%= safeSpeedBreakdown.slow %> Slow</span>
            </span>
            <span class="session-stat-lbl">Tempo Distribution</span>
          </div>
        </div>

        <div class="session-stat-chip">
          <div class="session-stat-icon-wrap" style="background:#ecfdf5; color:#10b981;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </div>
          <div class="session-stat-data">
            <span class="session-stat-val"><%= safeUniqueDeities %> Deities</span>
            <span class="session-stat-lbl">Flow Diversity</span>
          </div>
        </div>
      </div>

      <!-- Quick Checklist Diagnostics Strip -->
      <% if (submissions.length > 0) { %>
        <div class="metrics-diagnostics-bar">
          <% if (ganeshaOpening) { %>
            <span class="diag-chip pass" title="Starts with Ganesha as prescribed">
              <strong>Ganesha #1</strong>: OK
            </span>
          <% } else { %>
            <span class="diag-chip warn" title="Opening song is not Ganesha">
              <strong>Opening</strong>: <%= submissions[0].deity %>
            </span>
          <% } %>

          <% if (saiIncluded) { %>
            <span class="diag-chip pass" title="Sai bhajan included in lineup">
              <strong>Sai Bhajan</strong>: Included
            </span>
          <% } else { %>
            <span class="diag-chip warn" title="No Sai bhajan found yet">
              <strong>Sai Bhajan</strong>: Missing
            </span>
          <% } %>

          <% if (consecutiveRepeats && consecutiveRepeats.length > 0) { %>
            <span class="diag-chip warn" title="Repeated deity in adjacent sequence">
              <strong>Repeat</strong>: <%= consecutiveRepeats[0].deity %> (#<%= consecutiveRepeats[0].index1 %> &amp; #<%= consecutiveRepeats[0].index2 %>)
            </span>
          <% } else { %>
            <span class="diag-chip pass" title="Balanced deity distribution">
              <strong>Flow</strong>: Balanced
            </span>
          <% } %>
        </div>
      <% } %>
    </div>

  </header>

  <!-- ═══ 2. MAIN UNIFIED WORKSPACE (Full-Width Sequencer Data Grid & Cards) ═══ -->
  <main id="sessionWorkspace" class="session-unified-workspace view-mode-table">

    <!-- Workspace Controls Bar -->
    <div class="workspace-header-bar">
      <div class="workspace-filter-box">
        <input type="text" id="sequencerSearch" class="workspace-search-input" 
               placeholder="Search singer, bhajan title, deity, scale..." 
               oninput="filterSequencer(this.value)" 
               aria-label="Filter bhajans">
        
        <span class="workspace-meta-text" id="sequencerCountDisplay">
          <%= submissions.length %> Bhajans • Drag handle or use arrows to sequence
        </span>
      </div>

      <div class="workspace-view-controls">
        <button type="button" class="action-tool-btn" style="padding:5px 11px; font-size:12px; display:inline-flex; align-items:center; gap:6px;" onclick="resetDeityOrder()" title="Reset sequence to traditional deity order">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          <span>Deity Order</span>
        </button>

        <div class="view-switcher-pill" role="group" aria-label="View mode switch">
          <button type="button" class="view-switch-btn active" id="btnViewTable" onclick="setSequencerView('table')" title="Dense full-width sequence table (Recommended)">
            <span>Table</span>
          </button>
          <button type="button" class="view-switch-btn" id="btnViewCards" onclick="setSequencerView('cards')" title="Card list view">
            <span>Cards</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ═══ VIEW 1: STUDIO TABLE (Default Primary View) ═══ -->
    <div id="sequencerTableWrapper" class="workspace-table-scroll">
      <% if (submissions.length > 0) { %>
        <table class="sequencer-studio-table">
          <thead>
            <tr>
              <th width="80" style="text-align:center;">Seq #</th>
              <th width="20%">Singer / Accompanist</th>
              <th width="14%">Deity</th>
              <th width="28%">Bhajan Title</th>
              <th width="12%">Scale / Pitch</th>
              <th width="14%">Tempo &amp; Raag</th>
              <th width="12%" style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody id="sortable-body">
            <% submissions.forEach((s, idx) => { %>
              <tr data-id="<%= s.id %>" 
                  class="draggable-row" 
                  data-deity="<%= (s.deity || '').toLowerCase() %>"
                  data-singer="<%= (s.singer_name || '').toLowerCase() %>"
                  data-title="<%= (s.title || '').toLowerCase() %>"
                  data-scale="<%= (s.scale || '').toLowerCase() %>"
                  draggable="true">
                
                <td style="text-align:center;">
                  <div class="table-order-cell">
                    <span class="table-drag-handle" title="Drag row to reorder">:::</span>
                    <button type="button" class="table-order-badge" 
                            onclick="promptMoveToPosition(<%= s.id %>, <%= idx + 1 %>)" 
                            title="Click to jump to specific position">
                      <span class="row-index"><%= idx + 1 %></span>
                    </button>
                    <div style="display:flex; flex-direction:column; gap:1px;">
                      <button type="button" class="table-arrow-btn" onclick="moveItemStep(this, 'up')" <%= idx === 0 ? 'disabled' : '' %> title="Move up">▲</button>
                      <button type="button" class="table-arrow-btn" onclick="moveItemStep(this, 'down')" <%= idx === submissions.length - 1 ? 'disabled' : '' %> title="Move down">▼</button>
                    </div>
                  </div>
                </td>

                <td>
                  <strong><%= s.singer_name %></strong>
                  <% if (s.partner_name) { %>
                    <br><small style="color:var(--text-light);">&amp; <%= s.partner_name %></small>
                  <% } %>
                  <% if (s.gender) { %>
                    <span class="card-gender-pill" style="margin-left:4px;"><%= s.gender %></span>
                  <% } %>
                </td>

                <td>
                  <span class="card-deity-pill">
                    <span><%= s.deity %></span>
                  </span>
                </td>

                <td>
                  <% if (s.master_id) { %>
                    <a href="/bhajan/<%= s.master_id %>" class="card-bhajan-title" title="Open lyrics & audio recording">
                      <%= s.title %>
                    </a>
                  <% } else { %>
                    <span class="card-bhajan-title"><%= s.title %></span>
                  <% } %>
                  <% if (s.sheet_filename) { %>
                    <a href="/sheets/<%= encodeURIComponent(s.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="card-sheet-link" style="margin-left:6px;" title="Official music sheet PDF">
                      Sheet
                    </a>
                  <% } %>
                </td>

                <td>
                  <strong><%= s.scale || '-' %></strong>
                  <% if (s.westernScale && s.westernScale !== '-') { %>
                    <small style="color:var(--text-light);"> (<%= s.westernScale %>)</small>
                  <% } %>
                </td>

                <td>
                  <% 
                    const sp = (s.speed || 'medium').toLowerCase();
                    const pillClass = sp === 'slow' ? 'card-tempo-slow' : (sp === 'fast' ? 'card-tempo-fast' : 'card-tempo-med');
                  %>
                  <span class="card-meta-chip <%= pillClass %>">
                    <%= (s.speed || 'Medium').charAt(0).toUpperCase() + (s.speed || 'Medium').slice(1) %>
                  </span>
                  <% if (s.raga) { %>
                    <br><small style="color:var(--text-light); font-size:11.5px;"><%= s.raga %></small>
                  <% } %>
                </td>

                <td style="text-align:right; white-space:nowrap;">
                  <div style="display:inline-flex; gap:6px; justify-content:flex-end;">
                    <a href="/admin/edit/<%= s.id %>" class="action-tool-btn" style="padding:4px 9px; font-size:12px;" title="Edit entry">
                      Edit
                    </a>
                    <form action="/admin/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Delete this bhajan from session?');" style="margin:0; display:inline;">
                      <button type="submit" class="action-tool-btn" style="padding:4px 9px; font-size:12px; color:var(--danger); border-color:rgba(178,59,50,0.3);" title="Delete entry">
                        Delete
                      </button>
                    </form>
                  </div>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="sequencer-empty-state">
          <div style="width:48px; height:48px; margin:0 auto 12px; background:#e0e7ff; color:var(--primary); border-radius:12px; display:flex; align-items:center; justify-content:center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          </div>
          <h3 style="margin-top:0; font-size:18px; font-weight:700;">No Bhajans Scheduled Yet</h3>
          <p style="font-size:13.5px; color:var(--text-light); margin-bottom:20px;">
            This session currently has no bhajan submissions.
          </p>
          <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
            <a href="/submit-form?admin=true&session_date=<%= date %>" class="action-tool-btn action-tool-btn-primary">
              Add First Bhajan
            </a>
            <button type="button" class="action-tool-btn" onclick="openCopyModal()">
              Duplicate Past Session
            </button>
          </div>
        </div>
      <% } %>
    </div>

    <!-- ═══ VIEW 2: CARDS LIST (Spacious, Executive Card Deck) ═══ -->
    <div id="sequencerCardsWrapper" class="workspace-cards-list" style="display:none;">
      <% if (submissions.length > 0) { %>
        <div id="cardsListContainer" class="cards-deck-container">
          <% submissions.forEach((s, idx) => { %>
            <article class="sequencer-card draggable-card" 
                     data-id="<%= s.id %>" 
                     data-deity="<%= (s.deity || '').toLowerCase() %>"
                     data-singer="<%= (s.singer_name || '').toLowerCase() %>"
                     data-title="<%= (s.title || '').toLowerCase() %>"
                     data-scale="<%= (s.scale || '').toLowerCase() %>"
                     draggable="true">
              
              <!-- Card Top Header: Stepper Badge & Song Title & Deity -->
              <div class="card-top-header">
                <div class="card-reorder-group">
                  <span class="card-drag-handle" title="Drag to reorder sequence">:::</span>
                  <button type="button" class="card-order-badge" onclick="promptMoveToPosition(<%= s.id %>, <%= idx + 1 %>)" title="Jump to position">
                    <span class="row-index"><%= idx + 1 %></span>
                  </button>
                  <div class="card-arrow-btns">
                    <button type="button" class="card-arrow-btn" onclick="moveItemStep(this, 'up')" <%= idx === 0 ? 'disabled' : '' %> title="Move up">▲</button>
                    <button type="button" class="card-arrow-btn" onclick="moveItemStep(this, 'down')" <%= idx === submissions.length - 1 ? 'disabled' : '' %> title="Move down">▼</button>
                  </div>
                </div>

                <div class="card-header-main">
                  <div class="card-title-wrap">
                    <% if (s.master_id) { %>
                      <a href="/bhajan/<%= s.master_id %>" class="card-bhajan-title"><%= s.title %></a>
                    <% } else { %>
                      <span class="card-bhajan-title"><%= s.title %></span>
                    <% } %>
                  </div>

                  <div class="card-header-pills">
                    <span class="card-deity-pill">
                      <span><%= s.deity %></span>
                    </span>

                    <% if (s.sheet_filename) { %>
                      <a href="/sheets/<%= encodeURIComponent(s.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="card-sheet-link">
                        Sheet PDF
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Card Middle Body: Singer Details & Musical Info -->
              <div class="card-middle-details">
                <div class="card-singer-box">
                  <div class="card-singer-names">
                    <strong class="card-singer-main"><%= s.singer_name %></strong>
                    <% if (s.partner_name) { %>
                      <span class="card-partner-sub">& <%= s.partner_name %></span>
                    <% } %>
                    <% if (s.gender) { %>
                      <span class="card-gender-chip">(<%= s.gender %>)</span>
                    <% } %>
                  </div>
                </div>

                <div class="card-metadata-row">
                  <span class="card-meta-chip chip-pitch" title="Scale / Pitch">
                    <span><%= s.scale || 'Scale N/A' %><%= s.westernScale && s.westernScale !== '-' ? ' (' + s.westernScale + ')' : '' %></span>
                  </span>

                  <% 
                    const sp = (s.speed || 'medium').toLowerCase();
                    const pillClass = sp === 'slow' ? 'card-tempo-slow' : (sp === 'fast' ? 'card-tempo-fast' : 'card-tempo-med');
                  %>
                  <span class="card-meta-chip <%= pillClass %>" title="Tempo / Speed">
                    <span><%= (s.speed || 'Medium').charAt(0).toUpperCase() + (s.speed || 'Medium').slice(1) %></span>
                  </span>

                  <% if (s.raga) { %>
                    <span class="card-meta-chip chip-raag" title="Classical Raag">
                      <span><%= s.raga %></span>
                    </span>
                  <% } %>
                </div>
              </div>

              <!-- Card Bottom Actions: Spacious, Touch-friendly Buttons -->
              <div class="card-bottom-actions">
                <a href="/admin/edit/<%= s.id %>" class="card-touch-btn btn-edit" title="Edit entry">
                  <span>Edit</span>
                </a>
                <form action="/admin/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Delete this bhajan from session?');" style="margin:0;">
                  <button type="submit" class="card-touch-btn btn-delete" title="Delete entry">
                    <span>Delete</span>
                  </button>
                </form>
              </div>

            </article>
          <% }) %>
        </div>
      <% } %>
    </div>

  </main>

  <!-- ═══ FLOATING STICKY SAVE BAR ═══ -->
  <aside id="sequencerSaveBar" class="sequencer-save-bar" role="region" aria-label="Sequence changes bar">
    <div class="save-bar-info">
      <span id="saveBarMsg">Unsaved sequence changes</span>
    </div>
    <div class="save-bar-actions">
      <button type="button" class="save-bar-btn save-bar-btn-cancel" onclick="discardSequenceChanges()">
        <span>Discard</span>
      </button>
      <button type="button" id="saveSequenceBtn" class="save-bar-btn save-bar-btn-save" onclick="saveReorderSequence()">
        <span>Save Sequence</span>
      </button>
    </div>
  </aside>

  <!-- ═══ MODAL 1: SHARE ON WHATSAPP ═══ -->
  <div id="shareModal" class="session-modal-overlay" onclick="if(event.target===this) closeShareModal()">
    <div class="session-modal-card">
      <div class="session-modal-header">
        <h3>Share Session Schedule</h3>
        <button type="button" class="close-btn" onclick="closeShareModal()" style="border:none; background:none; font-size:22px; cursor:pointer;" aria-label="Close modal">&times;</button>
      </div>
      <div class="session-modal-body">
        <p style="font-size:13px; color:var(--text-light); margin-top:0; margin-bottom:12px;">
          Preformatted for WhatsApp groups with singer lineup, keys, and live plan link.
        </p>
        <textarea id="whatsappShareBox" readonly 
                  style="width:100%; height:220px; font-family:monospace; font-size:12.5px; padding:12px; border-radius:12px; border:1px solid var(--border); background:var(--surface-raised); color:var(--text); resize:vertical;" 
                  aria-label="WhatsApp schedule text"><%= whatsappText %></textarea>
      </div>
      <div class="session-modal-footer">
        <button type="button" class="action-tool-btn" onclick="copyShareText()" id="copyShareBtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span>Copy Text</span>
        </button>
        <a href="https://api.whatsapp.com/send?text=<%= whatsappEncoded %>" target="_blank" rel="noopener noreferrer" class="action-tool-btn action-tool-btn-whatsapp">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          <span>Open WhatsApp</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ═══ MODAL 2: DUPLICATE PAST SESSION ═══ -->
  <div id="copyModal" class="session-modal-overlay" onclick="if(event.target===this) closeCopyModal()">
    <div class="session-modal-card">
      <div class="session-modal-header">
        <h3>Copy Lineup from Past Session</h3>
        <button type="button" class="close-btn" onclick="closeCopyModal()" style="border:none; background:none; font-size:22px; cursor:pointer;" aria-label="Close modal">&times;</button>
      </div>
      <form action="/admin/copy-session" method="POST">
        <input type="hidden" name="target_date" value="<%= date %>">
        <div class="session-modal-body">
          <p style="font-size:13px; color:var(--text-light); margin-top:0; margin-bottom:16px;">
            Duplicate singers and their bhajans from an earlier session into <strong><%= humanDate || date %></strong>. This appends to the current date.
          </p>

          <label style="display:block; font-size:13px; font-weight:700; margin-bottom:6px; color:var(--text);">
            Choose Source Session Date:
          </label>

          <% if (recentSessions && recentSessions.length > 0) { %>
            <select name="source_date" required class="workspace-search-input" style="width:100%; max-width:none; padding:10px 14px; margin-bottom:14px;">
              <option value="">-- Select Recent Session --</option>
              <% recentSessions.forEach(rs => { %>
                <option value="<%= rs.session_date %>">
                  <%= rs.session_date %> (<%= rs.bhajan_count %> bhajan<%= rs.bhajan_count === 1 ? '' : 's' %>)
                </option>
              <% }) %>
            </select>
          <% } else { %>
            <input type="date" name="source_date" required class="workspace-search-input" style="width:100%; max-width:none; padding:10px 14px; margin-bottom:14px;">
          <% } %>

          <div style="font-size:12px; color:var(--text-light); background:var(--surface-raised); padding:10px 14px; border-radius:10px; border:1px solid var(--border);">
            All duplicated entries will appear in this session and can be reordered or edited freely.
          </div>
        </div>
        <div class="session-modal-footer">
          <button type="button" class="action-tool-btn" onclick="closeCopyModal()">Cancel</button>
          <button type="submit" class="action-tool-btn action-tool-btn-primary" onclick="return confirm('Copy all submissions from selected date into this session?');">
            Copy Lineup
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ═══ MODAL 3: SESSION AUDIO & TIMESTAMPS ═══ -->
  <div id="sessionAudioModal" class="session-modal-overlay" onclick="if(event.target===this) closeAudioModal()">
    <div class="session-modal-card" style="max-width:880px; width:95%; max-height:92vh; display:flex; flex-direction:column; overflow:hidden;">
      <div class="session-modal-header" style="flex-shrink:0;">
        <div>
          <h3 style="margin:0; font-size:17px; font-weight:700;">Session Audio & Bhajan Timestamps</h3>
          <p style="margin:4px 0 0; font-size:12.5px; color:var(--text-light);">
            Link recording from Cloudflare R2 and tag timestamps so devotees can listen to specific bhajans
          </p>
        </div>
        <button type="button" class="close-btn" onclick="closeAudioModal()" style="border:none; background:none; font-size:22px; cursor:pointer;" aria-label="Close modal">&times;</button>
      </div>

      <div class="session-modal-body" style="flex:1; overflow-y:auto; padding:18px 24px;">
        <!-- SECTION 1: AUDIO SOURCE & CLOUDFLARE -->
        <div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:12px; padding:16px; margin-bottom:20px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h4 style="margin:0; font-size:14px; font-weight:700; color:var(--text); display:flex; align-items:center; gap:8px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
              1. Cloudflare R2 / Audio Recording File
            </h4>
            <span id="audioStatusBadge" class="session-tag" style="background:rgba(100,116,139,0.12); color:var(--text-light); font-size:11px;">
              Not Linked
            </span>
          </div>

          <div style="display:grid; grid-template-columns:1fr; gap:12px;">
            <div>
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <label style="font-size:12px; font-weight:700; color:var(--text-light);">
                  Select from Cloudflare R2 Bucket:
                </label>
                <button type="button" onclick="loadCloudflareFiles(true)" style="background:none; border:none; font-size:11.5px; color:var(--primary); cursor:pointer; text-decoration:underline;">
                  Refresh Cloudflare Files
                </button>
              </div>
              <select id="audioR2Select" onchange="onSelectR2File(this.value)" class="workspace-search-input" style="width:100%; max-width:none; padding:9px 12px; font-size:13px;">
                <option value="">-- Choose file from Cloudflare R2 --</option>
              </select>
              <div id="r2StatusHelp" style="font-size:11.5px; color:var(--text-muted); margin-top:4px;"></div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div>
                <label style="display:block; font-size:12px; font-weight:700; color:var(--text-light); margin-bottom:6px;">
                  Audio Title:
                </label>
                <input type="text" id="audioTitleInput" class="workspace-search-input" placeholder="e.g. Bhajan Session – <%= date %>" style="width:100%; max-width:none; padding:9px 12px; font-size:13px;" value="Session Recording – <%= date %>">
              </div>

              <div>
                <label style="display:block; font-size:12px; font-weight:700; color:var(--text-light); margin-bottom:6px;">
                  Direct Audio URL / Stream:
                </label>
                <input type="text" id="audioUrlInput" oninput="onAudioUrlDirectChange(this.value)" class="workspace-search-input" placeholder="https://pub-xxxx.r2.dev/recording.mp3" style="width:100%; max-width:none; padding:9px 12px; font-size:13px;">
              </div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-top:4px;">
              <label style="display:flex; align-items:center; gap:8px; font-size:13px; font-weight:600; cursor:pointer;">
                <input type="checkbox" id="audioIsPublished" checked>
                <span>Publish to Devotees (Visible in Live Plan & Singer Hub)</span>
              </label>

              <button type="button" id="btnSaveAudioLink" onclick="saveAudioFileLink()" class="action-tool-btn action-tool-btn-primary">
                Save Audio File
              </button>
            </div>
          </div>

          <!-- Audio Preview Player -->
          <div id="adminAudioPlayerWrap" style="margin-top:14px; padding-top:14px; border-top:1px dashed var(--border); display:none;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
              <span style="font-size:12px; font-weight:700; color:var(--text);">Preview Player:</span>
              <span style="font-size:12px; font-family:monospace; background:var(--surface); padding:2px 8px; border-radius:6px; border:1px solid var(--border);">
                Playhead: <strong id="adminPlayerTimeDisplay" style="color:var(--primary);">00:00</strong>
              </span>
            </div>
            <audio id="adminAudioPreview" controls preload="metadata" style="width:100%; height:40px; border-radius:8px;"></audio>
            <div id="adminAudioErrorNotice" style="display:none; margin-top:8px; font-size:12px; color:#ef4444; background:rgba(239,68,68,0.1); padding:6px 12px; border-radius:6px; border:1px solid rgba(239,68,68,0.25);"></div>
            <div style="font-size:11.5px; color:var(--text-muted); margin-top:6px; display:flex; align-items:center; gap:6px;">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span>Play the audio to find where each bhajan starts, then click "Capture" below to snap the second automatically.</span>
            </div>
          </div>
        </div>

        <!-- SECTION 2: BHAJAN TIMESTAMPS -->
        <div style="background:var(--surface-raised); border:1px solid var(--border); border-radius:12px; padding:16px;">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:14px;">
            <div>
              <h4 style="margin:0; font-size:14px; font-weight:700; color:var(--text); display:flex; align-items:center; gap:8px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                2. Bhajan Timestamps & Singers
              </h4>
              <p style="margin:2px 0 0; font-size:12px; color:var(--text-light);">
                Link each scheduled bhajan with its exact start time
              </p>
            </div>
            <div style="display:flex; gap:8px;">
              <button type="button" onclick="autoPopulateFromLineup()" class="action-tool-btn action-tool-btn-secondary action-tool-btn-sm">
                Auto-fill from Lineup
              </button>
              <button type="button" onclick="addEmptyTimestampRow()" class="action-tool-btn action-tool-btn-sm">
                + Add Marker
              </button>
            </div>
          </div>

          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
              <thead>
                <tr style="border-bottom:1px solid var(--border); text-align:left; color:var(--text-light); font-size:11.5px; text-transform:uppercase;">
                  <th style="padding:8px 6px; width:36px;">#</th>
                  <th style="padding:8px 6px; min-width:200px;">Bhajan Title</th>
                  <th style="padding:8px 6px; min-width:150px;">Singer</th>
                  <th style="padding:8px 6px; width:190px;">Start Time</th>
                  <th style="padding:8px 6px; width:90px; text-align:center;">Action</th>
                </tr>
              </thead>
              <tbody id="timestampsTableBody">
                <!-- Dynamically populated rows -->
              </tbody>
            </table>
          </div>

          <div id="noTimestampsPrompt" style="text-align:center; padding:24px 12px; color:var(--text-muted); font-size:12.5px;">
            No timestamps added yet. Click <strong>"Auto-fill from Lineup"</strong> to load all session bhajans instantly!
          </div>
        </div>
      </div>

      <div class="session-modal-footer" style="flex-shrink:0; display:flex; justify-content:space-between; align-items:center; padding:14px 24px; border-top:1px solid var(--border);">
        <div>
          <button type="button" id="btnUnlinkAudio" onclick="unlinkSessionAudio()" class="action-tool-btn action-tool-btn-danger" style="display:none;">
            Remove Audio Link
          </button>
        </div>
        <div style="display:flex; gap:10px;">
          <button type="button" class="action-tool-btn" onclick="closeAudioModal()">Close</button>
          <button type="button" id="btnSaveTimestamps" onclick="saveAllTimestampsAjax()" class="action-tool-btn action-tool-btn-primary" style="padding:0 22px;">
            Save All Timestamps
          </button>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- ═══ CLIENT-SIDE SEQUENCER SCRIPT ═══ -->
<script>
(function() {
  'use strict';

  let isDirty = false;
  let initialOrder = [];

  // Capture initial order on load
  function captureInitialOrder() {
    const rows = document.querySelectorAll('#sortable-body tr[data-id]');
    initialOrder = Array.from(rows).map(r => r.getAttribute('data-id'));
  }

  // Update visual numbers across both Table and Cards views
  function syncOrderNumbers() {
    const rows = document.querySelectorAll('#sortable-body tr[data-id]');
    rows.forEach((row, idx) => {
      const num = row.querySelector('.row-index');
      if (num) num.textContent = idx + 1;
      const upBtn = row.querySelector('.table-arrow-btn[title="Move up"]');
      const downBtn = row.querySelector('.table-arrow-btn[title="Move down"]');
      if (upBtn) upBtn.disabled = (idx === 0);
      if (downBtn) downBtn.disabled = (idx === rows.length - 1);
    });

    const cards = document.querySelectorAll('#cardsListContainer .sequencer-card');
    cards.forEach((card, idx) => {
      const badge = card.querySelector('.row-index');
      if (badge) badge.textContent = idx + 1;
      const upBtn = card.querySelector('.card-arrow-btn[title="Move up"]');
      const downBtn = card.querySelector('.card-arrow-btn[title="Move down"]');
      if (upBtn) upBtn.disabled = (idx === 0);
      if (downBtn) downBtn.disabled = (idx === cards.length - 1);
    });

    // Check if order differs from initial
    const currentOrder = Array.from(rows).map(r => r.getAttribute('data-id'));
    const hasChanged = currentOrder.some((id, i) => id !== initialOrder[i]);
    setDirtyState(hasChanged);
  }

  function setDirtyState(dirty) {
    isDirty = dirty;
    const saveBar = document.getElementById('sequencerSaveBar');
    if (!saveBar) return;
    if (dirty) {
      saveBar.classList.add('show');
    } else {
      saveBar.classList.remove('show');
    }
  }

  // Move item up or down via button
  window.moveItemStep = function(btn, direction) {
    const item = btn.closest('tr[data-id]') || btn.closest('.sequencer-card');
    if (!item) return;

    const id = item.getAttribute('data-id');
    const tableRow = document.querySelector(`#sortable-body tr[data-id="${id}"]`);
    const cardEl = document.querySelector(`#cardsListContainer .sequencer-card[data-id="${id}"]`);

    if (direction === 'up') {
      if (tableRow && tableRow.previousElementSibling) {
        tableRow.parentNode.insertBefore(tableRow, tableRow.previousElementSibling);
      }
      if (cardEl && cardEl.previousElementSibling) {
        cardEl.parentNode.insertBefore(cardEl, cardEl.previousElementSibling);
      }
    } else if (direction === 'down') {
      if (tableRow && tableRow.nextElementSibling) {
        tableRow.parentNode.insertBefore(tableRow.nextElementSibling, tableRow);
      }
      if (cardEl && cardEl.nextElementSibling) {
        cardEl.parentNode.insertBefore(cardEl.nextElementSibling, cardEl);
      }
    }

    syncOrderNumbers();
  };

  // Direct Position Editing via click prompt
  window.promptMoveToPosition = function(id, currentPos) {
    const rows = document.querySelectorAll('#sortable-body tr[data-id]');
    const total = rows.length;
    const input = prompt(`Move this bhajan to sequence position (1 to ${total}):`, currentPos);
    if (!input) return;
    const targetPos = parseInt(input, 10);
    if (isNaN(targetPos) || targetPos < 1 || targetPos > total || targetPos === currentPos) return;

    const tableBody = document.getElementById('sortable-body');
    const cardsContainer = document.getElementById('cardsListContainer');
    const row = document.querySelector(`#sortable-body tr[data-id="${id}"]`);
    const card = document.querySelector(`#cardsListContainer .sequencer-card[data-id="${id}"]`);

    if (!row || !tableBody) return;
    const allRows = Array.from(tableBody.querySelectorAll('tr[data-id]'));
    const targetRow = allRows[targetPos - 1];

    if (targetPos < currentPos) {
      tableBody.insertBefore(row, targetRow);
      if (card && cardsContainer) {
        const allCards = Array.from(cardsContainer.querySelectorAll('.sequencer-card'));
        cardsContainer.insertBefore(card, allCards[targetPos - 1]);
      }
    } else {
      tableBody.insertBefore(row, targetRow.nextSibling);
      if (card && cardsContainer) {
        const allCards = Array.from(cardsContainer.querySelectorAll('.sequencer-card'));
        cardsContainer.insertBefore(card, allCards[targetPos - 1].nextSibling);
      }
    }

    syncOrderNumbers();
  };

  // Drag and Drop implementation for Table & Cards
  let draggedEl = null;

  function initDragDrop() {
    const tableBody = document.getElementById('sortable-body');
    if (tableBody) {
      tableBody.addEventListener('dragstart', (e) => {
        draggedEl = e.target.closest('tr[data-id]');
        if (!draggedEl) return;
        e.dataTransfer.effectAllowed = 'move';
        draggedEl.classList.add('is-dragging');
      });

      tableBody.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!draggedEl) return;
        const targetRow = e.target.closest('tr[data-id]');
        if (targetRow && targetRow !== draggedEl && targetRow.parentNode === tableBody) {
          const rect = targetRow.getBoundingClientRect();
          const next = (e.clientY - rect.top) / (rect.bottom - rect.top) > 0.5;
          tableBody.insertBefore(draggedEl, next ? targetRow.nextSibling : targetRow);
        }
      });

      tableBody.addEventListener('dragend', () => {
        if (draggedEl) draggedEl.classList.remove('is-dragging');
        draggedEl = null;
        syncCardsFromTable();
        syncOrderNumbers();
      });
    }

    // Cards Drag & Drop
    const cardsContainer = document.getElementById('cardsListContainer');
    if (cardsContainer) {
      cardsContainer.addEventListener('dragstart', (e) => {
        draggedEl = e.target.closest('.sequencer-card');
        if (!draggedEl) return;
        e.dataTransfer.effectAllowed = 'move';
        draggedEl.classList.add('is-dragging');
      });

      cardsContainer.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!draggedEl) return;
        const targetCard = e.target.closest('.sequencer-card');
        if (targetCard && targetCard !== draggedEl && targetCard.parentNode === cardsContainer) {
          const rect = targetCard.getBoundingClientRect();
          const next = (e.clientY - rect.top) / (rect.bottom - rect.top) > 0.5;
          cardsContainer.insertBefore(draggedEl, next ? targetCard.nextSibling : targetCard);
        }
      });

      cardsContainer.addEventListener('dragend', () => {
        if (draggedEl) draggedEl.classList.remove('is-dragging');
        draggedEl = null;
        syncTableFromCards();
        syncOrderNumbers();
      });
    }
  }

  function syncCardsFromTable() {
    const rows = document.querySelectorAll('#sortable-body tr[data-id]');
    const cardsContainer = document.getElementById('cardsListContainer');
    if (!cardsContainer) return;
    rows.forEach(r => {
      const id = r.getAttribute('data-id');
      const card = cardsContainer.querySelector(`.sequencer-card[data-id="${id}"]`);
      if (card) cardsContainer.appendChild(card);
    });
  }

  function syncTableFromCards() {
    const cards = document.querySelectorAll('#cardsListContainer .sequencer-card');
    const tableBody = document.getElementById('sortable-body');
    if (!tableBody) return;
    cards.forEach(card => {
      const id = card.getAttribute('data-id');
      const row = tableBody.querySelector(`tr[data-id="${id}"]`);
      if (row) tableBody.appendChild(row);
    });
  }

  // Save reordered sequence to backend
  window.saveReorderSequence = function() {
    const saveBtn = document.getElementById('saveSequenceBtn');
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
    }

    const rows = document.querySelectorAll('#sortable-body tr[data-id]');
    const orderData = Array.from(rows).map((row, index) => ({
      id: parseInt(row.getAttribute('data-id'), 10),
      order: index + 1
    }));

    fetch('/api/admin/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ orderData })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Could not save sequence: ' + (data.error || 'Server error'));
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Sequence';
        }
      }
    })
    .catch(() => {
      alert('Network error saving sequence');
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Sequence';
      }
    });
  };

  // Discard Sequence Changes
  window.discardSequenceChanges = function() {
    if (!confirm('Discard all sequence changes and reload original lineup?')) return;
    location.reload();
  };

  // Reset to Traditional Deity Order
  window.resetDeityOrder = function() {
    const DEITY_ORDER = ["ganesha", "guru", "mata", "sarvadharma", "sai", "shiva", "krishna", "rama", "narayana", "vitthala", "hanuman"];
    function getDeityKey(d) {
      if (!d) return 99;
      let val = d.toLowerCase().trim();
      if (val === 'vittala' || val === 'vithala') val = 'vitthala';
      if (val === 'anjaneya' || val === 'maruti') val = 'hanuman';
      const idx = DEITY_ORDER.indexOf(val);
      return idx !== -1 ? idx : 50;
    }

    const tableBody = document.getElementById('sortable-body');
    if (!tableBody) return;
    const rows = Array.from(tableBody.querySelectorAll('tr[data-id]'));
    rows.sort((a, b) => {
      const d1 = getDeityKey(a.getAttribute('data-deity'));
      const d2 = getDeityKey(b.getAttribute('data-deity'));
      if (d1 !== d2) return d1 - d2;
      return (a.getAttribute('data-singer') || '').localeCompare(b.getAttribute('data-singer') || '');
    });

    rows.forEach(r => tableBody.appendChild(r));
    syncCardsFromTable();
    syncOrderNumbers();
  };

  // Search filter
  window.filterSequencer = function(query) {
    const q = (query || '').toLowerCase().trim();
    const rows = document.querySelectorAll('#sortable-body tr[data-id]');
    const cards = document.querySelectorAll('#cardsListContainer .sequencer-card');

    let visibleCount = 0;
    rows.forEach(r => {
      const match = !q || 
        r.getAttribute('data-title').includes(q) || 
        r.getAttribute('data-singer').includes(q) || 
        r.getAttribute('data-deity').includes(q) || 
        r.getAttribute('data-scale').includes(q);
      r.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    cards.forEach(c => {
      const match = !q || 
        c.getAttribute('data-title').includes(q) || 
        c.getAttribute('data-singer').includes(q) || 
        c.getAttribute('data-deity').includes(q) || 
        c.getAttribute('data-scale').includes(q);
      c.style.display = match ? 'flex' : 'none';
    });

    const countDisplay = document.getElementById('sequencerCountDisplay');
    if (countDisplay) {
      countDisplay.textContent = q ? `${visibleCount} of ${rows.length} Bhajans filtered` : `${rows.length} Bhajans • Drag ⠿ handle or use ▲/▼ to sequence`;
    }
  };

  // View switch: Table (Default) vs Cards
  window.setSequencerView = function(mode) {
    const workspace = document.getElementById('sessionWorkspace');
    const tableWrap = document.getElementById('sequencerTableWrapper');
    const cardsWrap = document.getElementById('sequencerCardsWrapper');
    const btnTable = document.getElementById('btnViewTable');
    const btnCards = document.getElementById('btnViewCards');

    if (mode === 'cards') {
      if (workspace) {
        workspace.classList.remove('view-mode-table');
        workspace.classList.add('view-mode-cards');
      }
      if (tableWrap) tableWrap.style.cssText = 'display: none !important;';
      if (cardsWrap) cardsWrap.style.cssText = 'display: block !important;';
      if (btnCards) btnCards.classList.add('active');
      if (btnTable) btnTable.classList.remove('active');
      try { localStorage.setItem('bp-seq-view', 'cards'); } catch(e) {}
    } else {
      // Table is default
      if (workspace) {
        workspace.classList.remove('view-mode-cards');
        workspace.classList.add('view-mode-table');
      }
      if (tableWrap) tableWrap.style.cssText = 'display: block !important;';
      if (cardsWrap) cardsWrap.style.cssText = 'display: none !important;';
      if (btnTable) btnTable.classList.add('active');
      if (btnCards) btnCards.classList.remove('active');
      try { localStorage.setItem('bp-seq-view', 'table'); } catch(e) {}
    }
  };

