<div class="session-unified-page" style="padding: 24px 32px; background: var(--bg-app); min-height: 100vh;">

  <!-- Featured Banner Header -->
  <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); border-radius: 14px; padding: 24px 28px; color: white; box-shadow: 0 10px 25px -5px rgba(67, 56, 202, 0.35); margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
      <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; color: #a5b4fc; margin-bottom: 6px;">
        Analytics &amp; Intelligence
      </div>
      <h1 style="margin: 0 0 6px 0; font-size: 24px; font-weight: 800; color: #ffffff;">
        Mandir Bhajan Analytics
      </h1>
      <p style="margin: 0; font-size: 13px; color: #c7d2fe;">
        Performance history, deity distribution, rhythm flow, and devotion statistics.
      </p>
    </div>

    <!-- Quick Navigation -->
    <div style="display: flex; gap: 10px; align-items: center;">
      <a href="/admin/singers" class="button outline" style="border-color: rgba(255,255,255,0.25); color: #ffffff; background: rgba(255,255,255,0.08); font-size: 13px; font-weight: 600; padding: 8px 14px; border-radius: 8px; text-decoration: none; display: flex; align-items: center; gap: 6px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Singers
      </a>
      <a href="/admin" class="button outline" style="border-color: rgba(255,255,255,0.25); color: #ffffff; background: rgba(255,255,255,0.08); font-size: 13px; font-weight: 600; padding: 8px 14px; border-radius: 8px; text-decoration: none; display: flex; align-items: center; gap: 6px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Dashboard
      </a>
    </div>
  </div>

  <!-- KPI Overview Cards (4px Top Colored Accent Lines) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <!-- Card 1 -->
    <div class="kpi-card" style="--accent: #4f46e5;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Bhajans Sung</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </div>
      <div class="kpi-value"><%= kpis.totalSung %></div>
      <div class="kpi-subtext">Total recorded performances</div>
    </div>

    <!-- Card 2 -->
    <div class="kpi-card" style="--accent: #0ea5e9;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Unique Titles</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </div>
      <div class="kpi-value"><%= kpis.uniqueSongsCount %></div>
      <div class="kpi-subtext">Master repository titles</div>
    </div>

    <!-- Card 3 -->
    <div class="kpi-card" style="--accent: #10b981;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Sessions Held</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <div class="kpi-value"><%= kpis.totalSessions %></div>
      <div class="kpi-subtext">Archived Mandir sessions</div>
    </div>

    <!-- Card 4 -->
    <div class="kpi-card" style="--accent: #f59e0b;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Active Singers</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="kpi-value"><%= kpis.uniqueSingers %></div>
      <div class="kpi-subtext">Devotee contributors</div>
    </div>

    <!-- Card 5 -->
    <div class="kpi-card" style="--accent: #8b5cf6;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Avg / Session</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>
      <div class="kpi-value"><%= kpis.avgPerSession %></div>
      <div class="kpi-subtext">Bhajans per gathering</div>
    </div>
  </div>

  <!-- Visual Breakdowns: Deity Flow & Tempo Distribution -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 20px; margin-bottom: 24px;">

    <!-- Deity Breakdown Card -->
    <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; padding: 20px; box-shadow: var(--shadow-sm);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          Deity Flow Breakdown
        </h3>
        <span style="font-size: 12px; font-weight: 600; color: var(--text-muted);"><%= deityStats.length %> Deities</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 10px;">
        <% deityStats.forEach(d => { %>
          <div style="display: flex; flex-direction: column; gap: 4px;">
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px;">
              <span style="font-weight: 600; color: var(--text-primary);">
                <%= d.name %>
              </span>
              <span style="font-weight: 700; color: var(--text-secondary); font-size: 12px;">
                <%= d.count %> <span style="font-weight: 500; color: var(--text-muted);">(<%= d.pct %>%)</span>
              </span>
            </div>
            <div style="width: 100%; height: 6px; background: #f1f5f9; border-radius: 6px; overflow: hidden;">
              <div style="width: <%= Math.max(d.pct, 4) %>%; height: 100%; background: linear-gradient(90deg, #4f46e5, #7c3aed); border-radius: 6px;"></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Tempo & Rhythm Energy Flow -->
    <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; padding: 20px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Tempo &amp; Energy Distribution
          </h3>
          <span style="font-size: 12px; font-weight: 600; color: var(--text-muted);">Session Balance</span>
        </div>

        <!-- Segmented Bar -->
        <div style="width: 100%; height: 14px; background: #e2e8f0; border-radius: 8px; overflow: hidden; display: flex; margin-bottom: 16px;">
          <div style="width: <%= tempoStats.slowPct %>%; background: #10b981;" title="Slow: <%= tempoStats.slow %> (<%= tempoStats.slowPct %>%)"></div>
          <div style="width: <%= tempoStats.medPct %>%; background: #4f46e5;" title="Medium: <%= tempoStats.medium %> (<%= tempoStats.medPct %>%)"></div>
          <div style="width: <%= tempoStats.fastPct %>%; background: #f59e0b;" title="Fast: <%= tempoStats.fast %> (<%= tempoStats.fastPct %>%)"></div>
        </div>

        <!-- Three Mini Stat Boxes -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
          <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 12px; text-align: center;">
            <strong style="color: #166534; font-size: 18px; display: block; font-weight: 800;"><%= tempoStats.slow %></strong>
            <span style="font-size: 11px; color: #15803d; font-weight: 700; text-transform: uppercase;">Slow (<%= tempoStats.slowPct %>%)</span>
          </div>

          <div style="background: #eef2ff; border: 1px solid #c7d2fe; border-radius: 8px; padding: 12px; text-align: center;">
            <strong style="color: #3730a3; font-size: 18px; display: block; font-weight: 800;"><%= tempoStats.medium %></strong>
            <span style="font-size: 11px; color: #4338ca; font-weight: 700; text-transform: uppercase;">Medium (<%= tempoStats.medPct %>%)</span>
          </div>

          <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 12px; text-align: center;">
            <strong style="color: #92400e; font-size: 18px; display: block; font-weight: 800;"><%= tempoStats.fast %></strong>
            <span style="font-size: 11px; color: #b45309; font-weight: 700; text-transform: uppercase;">Fast (<%= tempoStats.fastPct %>%)</span>
          </div>
        </div>
      </div>

      <div style="margin-top: 20px; padding: 12px 14px; background: #f8fafc; border-radius: 8px; border: 1px solid var(--border); font-size: 12px; color: var(--text-secondary); line-height: 1.5;">
        A balanced Bhajan session maintains <strong>~10% Slow opening, ~75% Medium devotional flow, and ~15% Fast ecstatic bhajans</strong>.
      </div>
    </div>

  </div>

  <!-- Leaderboards: Top 15 Bhajans & Top Singers -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">

    <!-- Top 15 Bhajans -->
    <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm);">
      <div style="padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.45 1-1 1H7v4h10v-4h-2c-.55 0-1-.45-1-1v-2.34"/><path d="M18 9a6 6 0 0 0-12 0v2c0 2.21 1.79 4 4 4h4c2.21 0 4-1.79 4-4V9z"/></svg>
          Top 15 Most Sung Bhajans
        </h3>
        <span style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.5px;">Repertoire</span>
      </div>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
          <thead>
            <tr style="background: #f8fafc; border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
              <th style="padding: 10px 16px; text-align: center; width: 50px;">Rank</th>
              <th style="padding: 10px 16px; text-align: left;">Bhajan Title</th>
              <th style="padding: 10px 16px; text-align: left;">Deity</th>
              <th style="padding: 10px 16px; text-align: center; width: 70px;">Times</th>
            </tr>
          </thead>
          <tbody>
            <% topBhajans.forEach((b, i) => { %>
              <tr style="border-bottom: 1px solid var(--border-subtle); background: <%= i % 2 === 1 ? '#fafbfc' : '#ffffff' %>;">
                <td style="padding: 10px 16px; text-align: center;">
                  <span style="display: inline-block; width: 24px; height: 24px; line-height: 24px; border-radius: 6px; font-weight: 800; font-size: 11px; text-align: center; background: <%= i === 0 ? '#fef3c7; color: #92400e;' : i === 1 ? '#e2e8f0; color: #334155;' : i === 2 ? '#ffedd5; color: #9a3412;' : '#f1f5f9; color: #64748b;' %>">
                    <%= i + 1 %>
                  </span>
                </td>
                <td style="padding: 10px 16px;">
                  <span style="font-weight: 600; color: var(--text-primary);"><%= b.title %></span>
                </td>
                <td style="padding: 10px 16px;">
                  <span class="badge" style="background: #f1f5f9; color: var(--text-secondary); border: 1px solid var(--border); font-size: 11px; padding: 2px 8px; border-radius: 9999px;">
                    <%= b.deity || 'Devotional' %>
                  </span>
                </td>
                <td style="padding: 10px 16px; text-align: center;">
                  <span style="font-weight: 700; color: var(--primary); background: #eef2ff; padding: 2px 8px; border-radius: 6px;">
                    <%= b.count %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Top Singers Leaderboard -->
    <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm);">
      <div style="padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Singer Participation Leaderboard
        </h3>
        <span style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.5px;">Devotees</span>
      </div>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
          <thead>
            <tr style="background: #f8fafc; border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
              <th style="padding: 10px 16px; text-align: center; width: 50px;">Rank</th>
              <th style="padding: 10px 16px; text-align: left;">Devotee</th>
              <th style="padding: 10px 16px; text-align: center; width: 90px;">Sung</th>
              <th style="padding: 10px 16px; text-align: left; width: 110px;">Last Active</th>
            </tr>
          </thead>
          <tbody>
            <% topSingers.forEach((s, i) => { %>
              <tr style="border-bottom: 1px solid var(--border-subtle); background: <%= i % 2 === 1 ? '#fafbfc' : '#ffffff' %>;">
                <td style="padding: 10px 16px; text-align: center;">
                  <span style="display: inline-block; width: 24px; height: 24px; line-height: 24px; border-radius: 6px; font-weight: 800; font-size: 11px; text-align: center; background: <%= i === 0 ? '#fef3c7; color: #92400e;' : i === 1 ? '#e2e8f0; color: #334155;' : i === 2 ? '#ffedd5; color: #9a3412;' : '#f1f5f9; color: #64748b;' %>">
                    <%= i + 1 %>
                  </span>
                </td>
                <td style="padding: 10px 16px;">
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 26px; height: 26px; border-radius: 6px; background: #e0e7ff; color: var(--primary); font-weight: 700; font-size: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                      <%= (s.singer_name || 'S').charAt(0).toUpperCase() %>
                    </div>
                    <strong style="color: var(--text-primary); font-size: 13px;"><%= s.singer_name %></strong>
                  </div>
                </td>
                <td style="padding: 10px 16px; text-align: center;">
                  <span style="font-weight: 700; color: #059669; background: #ecfdf5; padding: 2px 8px; border-radius: 6px;">
                    <%= s.count %>
                  </span>
                </td>
                <td style="padding: 10px 16px;">
                  <span style="font-size: 12px; color: var(--text-secondary); font-weight: 500;"><%= s.last_sung || '—' %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

</div>
