<% const uid = 'sl_' + Math.random().toString(36).slice(2, 9); %>
<div class="container" data-singer-login-root id="<%= uid %>_root" style="max-width: 520px; margin: 40px auto; padding: 24px 20px 32px 20px;">

  <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 32px 28px; box-shadow: var(--shadow); position: relative; overflow: hidden;">
    
    <!-- Top Accent Bar -->
    <div style="position: absolute; top: 0; left: 0; right: 0; height: 5px; background: linear-gradient(90deg, #ea580c 0%, #f59e0b 100%);"></div>

    <!-- Header -->
    <div style="text-align: center; margin-bottom: 26px;">
      <div style="width: 48px; height: 48px; margin: 0 auto 12px; background: var(--saffron-bg); color: var(--primary); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="8" y1="22" x2="16" y2="22"/></svg>
      </div>
      <h1 style="font-size: 24px; font-weight: 800; color: var(--ink); margin: 0 0 6px 0;">Singer Verification</h1>
      <p style="font-size: 13.5px; color: var(--ink-soft); margin: 0; line-height: 1.5;">
        Sri Sathya Sai Seva Organisation, Gandhinagar
      </p>
    </div>

    <% if (isExpired) { %>
      <div style="background: var(--warning-light); border: 1px solid var(--warning-border); color: var(--warning-text); padding: 12px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>For your security, 90 days have elapsed since your last PIN verification. Please re-enter your 4-digit PIN to continue.</span>
      </div>
    <% } %>

    <div id="<%= uid %>_alertBox" data-role="login-alert-box" style="display: none; padding: 12px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 20px;"></div>

    <form id="<%= uid %>_form" data-role="singer-login-form">
      <input type="hidden" id="<%= uid %>_redirect" data-role="login-redirect" value="<%= redirectUrl %>">

      <!-- Singer Select -->
      <div class="form-group" style="margin-bottom: 20px;">
        <label for="<%= uid %>_singerSelect" style="display: block; font-weight: 700; font-size: 13.5px; color: var(--ink); margin-bottom: 8px;">
          Select Your Name <span style="color: #ef4444;">*</span>
        </label>
        <select
          id="<%= uid %>_singerSelect"
          data-role="singer-select"
          required
          style="width: 100%; padding: 11px 14px; border-radius: 10px; border: 1px solid var(--border); font-size: 14.5px; background: var(--surface); color: var(--ink);"
        >
          <option value="">— Search or Select Singer —</option>
          <% singers.forEach(function(s) { %>
            <option value="<%= s.id %>" data-has-pin="<%= s.hasPin ? '1' : '0' %>" data-gender="<%= s.gender || '' %>">
              <%= s.name %> <%= s.gender ? `(${s.gender})` : '' %>
            </option>
          <% }); %>
        </select>
        <small style="color: var(--ink-soft); font-size: 12px; margin-top: 4px; display: block;">
          Select your name as listed in the Samiti Singer Dictionary.
        </small>
      </div>

      <!-- PIN Input Section (Shown after singer selected) -->
      <div id="<%= uid %>_pinSection" data-role="pin-section" style="display: none; margin-bottom: 22px;">
        <div style="background: var(--paper); border: 1px solid var(--border); border-radius: 12px; padding: 16px; margin-bottom: 16px;">
          <div id="<%= uid %>_pinTitle" data-role="pin-title" style="font-weight: 700; font-size: 14px; color: var(--ink); margin-bottom: 4px;">
            Enter Your 4-Digit PIN
          </div>
          <div id="<%= uid %>_pinSubtitle" data-role="pin-subtitle" style="font-size: 12.5px; color: var(--muted); line-height: 1.4;">
            Please enter your private 4-digit security PIN.
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 14px;">
          <label for="<%= uid %>_singerPin" style="display: block; font-weight: 700; font-size: 13px; color: var(--ink); margin-bottom: 6px;">
            4-Digit PIN <span style="color: #ef4444;">*</span>
          </label>
          <div style="position: relative;">
            <input
              type="password"
              id="<%= uid %>_singerPin"
              data-role="singer-pin"
              inputmode="numeric"
              pattern="[0-9]{4}"
              maxlength="4"
              placeholder="••••"
              required
              autocomplete="current-password"
              style="width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--border); font-size: 20px; letter-spacing: 8px; text-align: center; font-family: monospace; font-weight: 800; background: var(--surface); color: var(--ink);"
            >
          </div>
        </div>

        <!-- Confirm PIN (Only for first-time creation) -->
        <div id="<%= uid %>_confirmGroup" data-role="confirm-pin-group" style="display: none; margin-bottom: 14px;">
          <label for="<%= uid %>_confirmPin" style="display: block; font-weight: 700; font-size: 13px; color: var(--ink); margin-bottom: 6px;">
            Confirm 4-Digit PIN <span style="color: #ef4444;">*</span>
          </label>
          <input
            type="password"
            id="<%= uid %>_confirmPin"
            data-role="confirm-pin"
            inputmode="numeric"
            pattern="[0-9]{4}"
            maxlength="4"
            placeholder="••••"
            style="width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--border); font-size: 20px; letter-spacing: 8px; text-align: center; font-family: monospace; font-weight: 800; background: var(--surface); color: var(--ink);"
          >
          <small style="color: #16a34a; font-size: 11.5px; margin-top: 4px; display: block;">
            Remember this PIN. You will use it whenever submitting bhajans or opening your Singer Hub.
          </small>
        </div>

        <!-- 90-day badge reminder -->
        <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); background: var(--paper); border: 1px solid var(--border-soft); padding: 8px 12px; border-radius: 8px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Your login stays secure and remembered on this device for <strong>90 days</strong>.</span>
        </div>
      </div>

      <!-- Action Button -->
      <button
        type="submit"
        id="<%= uid %>_submitBtn"
        data-role="login-submit-btn"
        disabled
        style="width: 100%; padding: 12px; font-size: 15px; font-weight: 700; border-radius: 10px; justify-content: center;"
      >
        Select your name to continue
      </button>

    </form>

    <!-- Footer Help -->
    <div style="margin-top: 24px; text-align: center; font-size: 12.5px; color: var(--ink-soft); border-top: 1px solid var(--border); padding-top: 16px;">
      Forgot your PIN or don't see your name?
      <div style="margin-top: 4px; font-weight: 600; color: #ea580c;">
        Please speak to the Bhajan Coordinator or Admin to reset or register your name.
      </div>
    </div>

  </div>
</div>

<script>
(function() {
  const root = (document.currentScript && document.currentScript.closest('[data-singer-login-root]'))
    || document.getElementById('<%= uid %>_root')
    || document.querySelector('[data-singer-login-root]:not([data-initialized])');

  if (!root || root.hasAttribute('data-initialized')) return;
  root.setAttribute('data-initialized', 'true');

  let currentSingerHasPin = false;

  const alertBox = root.querySelector('[data-role="login-alert-box"]');
  const form = root.querySelector('[data-role="singer-login-form"]');
  const redirectInput = root.querySelector('[data-role="login-redirect"]');
  const singerSelect = root.querySelector('[data-role="singer-select"]');
  const pinSection = root.querySelector('[data-role="pin-section"]');
  const pinTitle = root.querySelector('[data-role="pin-title"]');
  const pinSubtitle = root.querySelector('[data-role="pin-subtitle"]');
  const pinInput = root.querySelector('[data-role="singer-pin"]');
  const confirmGroup = root.querySelector('[data-role="confirm-pin-group"]');
  const confirmInput = root.querySelector('[data-role="confirm-pin"]');
  const btn = root.querySelector('[data-role="login-submit-btn"]');

  function showAlert(msg, type) {
    if (!alertBox) return;
    alertBox.textContent = msg;
    alertBox.style.display = 'block';
    if (type === 'error') {
      alertBox.style.background = 'var(--danger-light)';
      alertBox.style.border = '1px solid var(--danger-border)';
      alertBox.style.color = 'var(--danger-text)';
    } else {
      alertBox.style.background = 'var(--success-light)';
      alertBox.style.border = '1px solid var(--success-border)';
      alertBox.style.color = 'var(--success-text)';
    }
  }

  function onSingerSelected(singerId) {
    if (alertBox) alertBox.style.display = 'none';

    if (!singerId) {
      if (pinSection) pinSection.style.display = 'none';
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Select your name to continue';
      }
      return;
    }

    const selectedOption = singerSelect ? singerSelect.options[singerSelect.selectedIndex] : null;
    currentSingerHasPin = selectedOption ? selectedOption.getAttribute('data-has-pin') === '1' : false;

    if (pinSection) pinSection.style.display = 'block';
    if (btn) btn.disabled = false;
    if (pinInput) pinInput.value = '';
    if (confirmInput) confirmInput.value = '';

    if (currentSingerHasPin) {
      if (pinTitle) pinTitle.textContent = 'Enter Your 4-Digit PIN';
      if (pinSubtitle) pinSubtitle.textContent = 'Please enter your registered 4-digit PIN for ' + (selectedOption ? selectedOption.text.split('(')[0].trim() : '') + '.';
      if (confirmGroup) confirmGroup.style.display = 'none';
      if (confirmInput) confirmInput.removeAttribute('required');
      if (btn) btn.textContent = 'Verify PIN & Enter';
    } else {
      if (pinTitle) pinTitle.textContent = 'Create Your 4-Digit PIN';
      if (pinSubtitle) pinSubtitle.textContent = 'Welcome! This name does not have a PIN yet. Choose any 4-digit PIN you can easily remember to secure your Singer Hub.';
      if (confirmGroup) confirmGroup.style.display = 'block';
      if (confirmInput) confirmInput.setAttribute('required', 'required');
      if (btn) btn.textContent = 'Create PIN & Enter';
    }

    if (pinInput) setTimeout(() => pinInput.focus(), 100);
  }

  async function handleSingerLogin(e) {
    e.preventDefault();
    if (alertBox) alertBox.style.display = 'none';

    const singerId = singerSelect ? singerSelect.value : '';
    const pin = pinInput ? pinInput.value.trim() : '';
    const confirmPinVal = confirmInput ? confirmInput.value.trim() : '';
    const redirect = redirectInput ? redirectInput.value : '';

    if (!singerId) {
      showAlert('Please select your name.', 'error');
      return;
    }

    if (!/^\d{4}$/.test(pin)) {
      showAlert('PIN must be exactly 4 digits (e.g. 1234).', 'error');
      return;
    }

    if (!currentSingerHasPin && pin !== confirmPinVal) {
      showAlert('PINs do not match. Please verify both entries.', 'error');
      return;
    }

    try {
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Verifying...';
      }

      const res = await fetch('/api/singer/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          singer_id: singerId,
          pin: pin,
          confirm_pin: confirmPinVal || pin,
          redirect: redirect
        })
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Verification failed');
      }

      // Save singer name in localStorage & sync Single-DOM AppShell
      try {
        localStorage.setItem('bp_singer_id', data.singer.id);
        localStorage.setItem('bp_singer_name', data.singer.name);
        localStorage.setItem('bp_singer_gender', data.singer.gender || '');
        localStorage.setItem('bp_singer_login_time', Date.now());
      } catch (_) {}

      let target = data.redirect || '/my-hub';
      if (data.showIntro) {
        target = '/my-hub?welcome=true&redirect=' + encodeURIComponent(data.redirect || '/submit-form');
      }

      if (window.AppShell && typeof window.AppShell.onAuthChange === 'function') {
        window.AppShell.onAuthChange(data.singer);
        window.AppShell.navigate(target, { replace: true, forceReload: true });
        return;
      }

      window.location.href = target;

    } catch (err) {
      showAlert(err.message, 'error');
      if (btn) {
        btn.disabled = false;
        btn.textContent = currentSingerHasPin ? 'Verify PIN & Enter' : 'Create PIN & Enter';
      }
    }
  }

  if (singerSelect) {
    singerSelect.addEventListener('change', function() {
      onSingerSelected(this.value);
    });
  }

  if (form) {
    form.addEventListener('submit', handleSingerLogin);
  }
})();
</script>
