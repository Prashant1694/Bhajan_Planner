<div class="container" style="max-width:540px; margin:28px auto; padding:32px 24px; text-align:center;">
  <div style="width:52px; height:52px; margin:0 auto 16px; border-radius:16px; background:rgba(217,119,6,0.12); color:var(--saffron); display:flex; align-items:center; justify-content:center;">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
  </div>

  <h2 style="font-family:var(--font-serif, 'Fraunces', Georgia, serif); color:var(--ink); margin:0 0 12px; font-size:22px;"><%= heading || 'Select Session' %></h2>
  <p style="color:var(--ink-soft); margin:0 0 24px; line-height:1.6; font-size:14.5px;"><%- messageHtml %></p>

  <% if (options && options.length > 0) { %>
    <div style="background:var(--surface-subtle, rgba(0,0,0,0.03)); padding:18px; border-radius:14px; border:1px solid var(--border); display:flex; flex-direction:column; gap:10px;">
      <% options.forEach((opt) => { %>
        <a href="<%= opt.href %>" class="button <%= opt.variant === 'secondary' ? 'secondary' : '' %>" style="width:100%; display:flex; align-items:center; justify-content:center; gap:8px; text-decoration:none;">
          <span><%= opt.label %></span>
        </a>
      <% }); %>
    </div>
  <% } %>

  <div style="margin-top:20px;">
    <a href="<%= isAdmin ? '/admin' : '/' %>" class="button secondary" style="text-decoration:none;">
      <%= isAdmin ? 'Return to Dashboard' : 'Return Home' %>
    </a>
  </div>
</div>

