<div class="container" style="max-width:540px; margin:28px auto; padding:32px 24px; text-align:center;">
  <div style="width:52px; height:52px; margin:0 auto 16px; border-radius:16px; background:<%= variant === 'danger' ? 'rgba(225,29,72,0.12)' : 'rgba(217,119,6,0.12)' %>; color:<%= variant === 'danger' ? '#e11d48' : 'var(--saffron)' %>; display:flex; align-items:center; justify-content:center;">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
  </div>

  <h2 style="font-family:var(--font-serif, 'Fraunces', Georgia, serif); color:var(--ink); margin:0 0 12px; font-size:22px;"><%= heading %></h2>
  <p style="color:var(--ink-soft); margin:0 0 20px; line-height:1.6; font-size:14.5px;"><%- messageHtml %></p>

  <% if (details) { %>
    <div style="text-align:left; background:var(--surface-subtle, rgba(0,0,0,0.03)); border:1px solid var(--border); border-radius:12px; padding:14px 16px; margin-bottom:22px; font-size:13.5px; line-height:1.7;">
      <% if (details.singer_name) { %><div><strong>Taken by:</strong> <%= details.singer_name %></div><% } %>
      <% if (details.title) { %><div><strong>Bhajan:</strong> <%= details.title %></div><% } %>
      <% if (details.time) { %><div><strong>Time:</strong> <%= details.time %></div><% } %>
    </div>
  <% } %>

  <div style="display:flex; justify-content:center; gap:10px; flex-wrap:wrap;">
    <a class="button secondary" href="<%= backHref || '/submit-form' %>" style="text-decoration:none;"><%= backLabel || 'Go Back' %></a>
  </div>
</div>

