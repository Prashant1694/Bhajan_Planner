<div class="container">

    <h2
        style="
        text-align:center;
        color:var(--primary);
        margin-bottom:16px;">
        Password Recovery
    </h2>

    <p class="subtitle">
        Enter your username to continue.
    </p>

    <% if(error){ %>

        <div class="error-box">
            <%= error %>
        </div>

    <% } %>

    <form method="POST" action="/forgot-password">

        <div class="form-group">

            <label>Username</label>

            <input
                type="text"
                name="username"
                required
                autofocus>

        </div>

        <button
            type="submit"
            class="submit-btn">

            Continue

        </button>

    </form>

    <div class="back-link">
        <a href="/admin-login">
            ← Back to Login
        </a>
    </div>

</div>
