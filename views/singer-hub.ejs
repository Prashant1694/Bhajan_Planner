<%
  const safeDaysRemaining = typeof daysRemaining !== 'undefined' ? daysRemaining : 90;
  const safeSongbook = typeof songbook !== 'undefined' ? songbook : (typeof bookmarks !== 'undefined' ? bookmarks : []);
  const safePastHistory = typeof pastHistory !== 'undefined' ? pastHistory : (typeof pastSubmissions !== 'undefined' ? pastSubmissions : []);
  const safeMyReports = typeof myReports !== 'undefined' ? myReports : (typeof reports !== 'undefined' ? reports : []);
  const safeMyReportsCount = typeof myReportsCount !== 'undefined' ? myReportsCount : safeMyReports.length;
  const safeDeitySummary = typeof deitySummary !== 'undefined' && deitySummary ? deitySummary : {};
  const safeShowWelcome = typeof showWelcome !== 'undefined' ? showWelcome : false;
%>

<link rel="stylesheet" href="/css/session-audio.css">

<div class="container singer-hub-container">

  <!-- Profile Actions Bar -->
  <div class="singer-hub-top-nav">
    <div class="singer-hub-actions-group">
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <button type="button" onclick="openAdminSwitchModal()" class="singer-hub-action-btn btn-switch-singer" data-haptic="light" title="Switch to another singer profile">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          <span class="hub-btn-text">Switch Singer</span>
        </button>
      <% } %>
      <button type="button" onclick="openChangePinModal()" class="singer-hub-action-btn btn-change-pin" data-haptic="light" title="Change your 4-digit security PIN">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span class="hub-btn-text">Change PIN</span>
      </button>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <form method="POST" action="/logout" target="_top" style="margin:0;display:inline;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="singer-hub-action-btn btn-logout" data-haptic="medium" title="Logout from Admin Mode" onclick="try{localStorage.removeItem('bp_is_admin');localStorage.removeItem('bp_admin_name');localStorage.removeItem('bp_admin_role');}catch(_){}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span class="hub-btn-text">Admin Logout</span>
          </button>
        </form>
      <% } else { %>
        <form method="POST" action="/singer/logout" target="_top" style="margin:0;display:inline;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="singer-hub-action-btn btn-logout" data-haptic="medium" title="Logout" onclick="try{localStorage.removeItem('bp_singer_id');localStorage.removeItem('bp_singer_name');localStorage.removeItem('bp_is_admin');}catch(_){}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span class="hub-btn-text">Logout</span>
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- Profile Hero Banner (Native Indigo Style) -->
  <div class="banner-hero hub-hero-banner">
    <div class="hub-hero-body">
      
      <!-- Avatar & Info -->
      <div class="hub-hero-main">
        <div class="hub-hero-avatar">
          <%= singer.name.charAt(0).toUpperCase() %>
        </div>
        <div class="hub-hero-text">
          <div class="hub-hero-title-row">
            <h1 class="hub-hero-name"><%= singer.name %></h1>
            <% if (singer.gender) { %>
              <span class="hub-hero-badge hub-gender-badge">
                <%= singer.gender %>
              </span>
            <% } %>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
              <span class="hub-hero-badge hub-admin-badge">
                Admin Linked
              </span>
            <% } %>
          </div>

          <div class="hub-hero-meta-grid">
            <div class="hub-hero-chip">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>4-Digit PIN Security</span>
            </div>
            <div class="hub-hero-chip">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span><strong><%= safeDaysRemaining %>d active</strong> on browser</span>
            </div>
            <button type="button" onclick="openPreferredScaleModal()" class="hub-hero-chip hub-chip-pitch" title="Change preferred singing pitch">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              <span>Pitch: <strong id="displayPreferredScale"><%= singer.preferred_scale || 'Not configured' %></strong></span>
              <span class="hub-pitch-change-tag">Change</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Action CTA -->
      <div class="hub-hero-cta-box">
        <a href="/submit-form" class="btn hub-hero-cta-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
          <span>Mark Bhajan Slot</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Key Metrics Row (4 KPI Cards with top colored accent lines) -->
  <div class="kpi-grid hub-kpi-grid">
    
    <div class="kpi-card hub-kpi-card">
      <div class="kpi-accent-bar" style="background: #d97706;"></div>
      <div class="hub-kpi-card-header">
        <span class="hub-kpi-card-title">Upcoming Slots</span>
        <div class="hub-kpi-card-icon" style="background: #fef3c7; color: #b45309;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
      </div>
      <div class="hub-kpi-card-value">
        <%= upcomingSubmissions.length %>
      </div>
      <div class="hub-kpi-card-sub">Scheduled in next session</div>
    </div>

    <div class="kpi-card hub-kpi-card">
      <div class="kpi-accent-bar" style="background: #0891b2;"></div>
      <div class="hub-kpi-card-header">
        <span class="hub-kpi-card-title">My Songbook</span>
        <div class="hub-kpi-card-icon" style="background: #ecfeff; color: #0891b2;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
      </div>
      <div class="hub-kpi-card-value">
        <%= safeSongbook.length %>
      </div>
      <div class="hub-kpi-card-sub">Prepared repertoire</div>
    </div>

    <div class="kpi-card hub-kpi-card">
      <div class="kpi-accent-bar" style="background: #ea580c;"></div>
      <div class="hub-kpi-card-header">
        <span class="hub-kpi-card-title">Past Bhajans</span>
        <div class="hub-kpi-card-icon" style="background: #fff7ed; color: #ea580c;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
      </div>
      <div class="hub-kpi-card-value">
        <%= safePastHistory.length %>
      </div>
      <div class="hub-kpi-card-sub">In Samiti records</div>
    </div>

    <div class="kpi-card hub-kpi-card">
      <div class="kpi-accent-bar" style="background: #0284c7;"></div>
      <div class="hub-kpi-card-header">
        <span class="hub-kpi-card-title">Correction Tickets</span>
        <div class="hub-kpi-card-icon" style="background: #f0f9ff; color: #0284c7;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
        </div>
      </div>
      <div class="hub-kpi-card-value">
        <%= safeMyReportsCount %>
      </div>
      <a href="/my-reports" style="font-size: 12px; color: #0284c7; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
        Track reports &rarr;
      </a>
    </div>

  </div>

  <!-- Interactive Segmented Capsule Tab Control -->
  <div class="hub-tabs-scroll-wrap">
    <div class="segmented-control hub-segmented-tabs">
      <button type="button" class="hub-tab-btn active" onclick="switchHubTab('upcoming', this)" data-haptic="light">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span>Upcoming (<%= upcomingSubmissions.length %>)</span>
      </button>
      <button type="button" class="hub-tab-btn" onclick="switchHubTab('songbook', this)" data-haptic="light">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <span>Songbook (<%= safeSongbook.length %>)</span>
      </button>
      <button type="button" class="hub-tab-btn" onclick="switchHubTab('history', this)" data-haptic="light">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>History (<%= safePastHistory.length %>)</span>
      </button>
      <button type="button" class="hub-tab-btn" onclick="switchHubTab('reports', this)" data-haptic="light">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
        <span>Reports (<%= safeMyReportsCount %>)</span>
      </button>
    </div>
  </div>

  <style>
    .hub-tab-btn.active {
      background: #ffffff !important;
      color: #4f46e5 !important;
      font-weight: 700 !important;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.1) !important;
    }
    .kpi-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08) !important;
    }
  </style>

  <!-- ========================================== -->
  <!-- TAB 1: UPCOMING SCHEDULE                   -->
  <!-- ========================================== -->
  <div id="tab-upcoming" class="hub-tab-pane" style="display: block;">
    <% if (upcomingSubmissions && upcomingSubmissions.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <% upcomingSubmissions.forEach(function(sub) { %>
          <div class="hub-card hub-upcoming-card" style="border-left: 4px solid #4f46e5;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 10px;">
              <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <span style="background: rgba(79, 70, 229, 0.12); color: #4338ca; border: 1px solid rgba(79, 70, 229, 0.25); font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 4px;">
                  <%= sub.session_date %>
                </span>
                <% if (sub.list_order) { %>
                  <span style="background: var(--border-soft); color: var(--ink); font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 4px;">
                    Slot #<%= sub.list_order %>
                  </span>
                <% } %>
                <span style="background: var(--surface); color: var(--ink-soft); font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: 4px; border: 1px solid var(--border);">
                  <%= sub.deity %>
                </span>
              </div>
              <span style="font-size: 12px; font-weight: 700; color: <%= sub.singer_name.toLowerCase() === singer.name.toLowerCase() ? '#16a34a' : '#0284c7' %>;">
                <%= sub.singer_name.toLowerCase() === singer.name.toLowerCase() ? 'Lead Singer' : 'Partner Singer' %>
              </span>
            </div>

            <h3 style="font-size: 17px; font-weight: 800; color: var(--ink); margin: 0 0 10px 0;">
              <%= sub.title %>
            </h3>

            <div style="display: flex; gap: 8px; flex-wrap: wrap; font-size: 13px; color: var(--muted); margin-bottom: 14px; align-items: center;">
              <span>Tempo: <strong style="color: var(--ink);"><%= sub.speed || 'Medium' %></strong></span>
              <span>&bull;</span>
              <span>Scale: <strong style="color: var(--ink);"><%= sub.scale || 'Standard' %></strong></span>
              <% if (sub.partner_name) { %>
                <span>&bull;</span>
                <span>Partner: <strong style="color: var(--ink);"><%= sub.partner_name %></strong></span>
              <% } %>
            </div>

            <div style="display: flex; gap: 10px; align-items: center; border-top: 1px solid var(--border); padding-top: 12px;">
              <a href="/plan-view?session_date=<%= sub.session_date %>" class="btn btn-secondary hub-btn-block-mobile" style="padding: 6px 14px; font-size: 12.5px; text-decoration: none; border-radius: 6px;">
                View Full Session Plan &rarr;
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="hub-card" style="border: 1px dashed var(--border); padding: 40px 20px; text-align: center;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: var(--border-soft); color: var(--muted); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <h3 style="font-size: 16px; font-weight: 700; color: var(--ink); margin: 0 0 6px 0;">No Upcoming Bhajans Scheduled</h3>
        <p style="font-size: 13.5px; color: var(--muted); max-width: 440px; margin: 0 auto 18px auto; line-height: 1.5;">
          You have not submitted a bhajan for the upcoming session yet. Submissions open every Thursday after 8:00 PM.
        </p>
        <a href="/submit-form" class="btn btn-primary hub-btn-block-mobile" style="padding: 9px 18px; font-size: 13px; font-weight: 700; text-decoration: none; border-radius: 6px;">
          Submit Bhajan for Thursday
        </a>
      </div>
    <% } %>
  </div>

  <!-- ========================================== -->
  <!-- TAB 2: MY SONGBOOK & REPERTOIRE           -->
  <!-- ========================================== -->
  <div id="tab-songbook" class="hub-tab-pane" style="display: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
      <div>
        <h3 style="font-size: 17px; font-weight: 800; color: var(--ink); margin: 0;">My Prepared Repertoire</h3>
        <p style="font-size: 13px; color: var(--muted); margin: 2px 0 0 0;">
          Bhajans you have prepared, along with your personal singing pitch and notes.
        </p>
      </div>
      <a href="/master-bank" class="btn btn-secondary hub-btn-block-mobile" style="padding: 7px 14px; font-size: 12.5px; text-decoration: none; border-radius: 6px;">
        + Browse &amp; Add Bhajans
      </a>
    </div>

    <% if (safeSongbook && safeSongbook.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px;">
        <% safeSongbook.forEach(function(item) { %>
          <% const b = item.masterBhajan; %>
          <% if (!b) return; %>
          <div class="hub-card" style="padding: 16px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="background: var(--border-soft); color: var(--ink-soft); font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 4px; text-transform: uppercase;">
                  <%= b.deity %>
                </span>
                <button type="button" class="sb-remove-btn" data-id="<%= b.id %>" data-title="<%= b.title %>" title="Remove from Songbook" style="background: none; border: none; font-size: 14px; cursor: pointer; color: var(--muted); padding: 2px 4px;">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </button>
              </div>

              <h4 style="font-size: 15.5px; font-weight: 700; color: var(--ink); margin: 0 0 8px 0; line-height: 1.4;">
                <a href="/bhajan/<%= b.id %>" style="color: inherit; text-decoration: none;">
                  <%= b.title %> &rarr;
                </a>
              </h4>

              <div style="background: var(--border-soft); border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px; font-size: 12.5px; margin-bottom: 10px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                  <span style="color: var(--muted);">My Singing Pitch:</span>
                  <strong style="color: #4f46e5;"><%= item.custom_scale || b.shruti || 'Not specified' %></strong>
                </div>
                <% if (item.notes) { %>
                  <div style="color: var(--ink-soft); font-style: italic; font-size: 12px; margin-top: 4px; border-top: 1px dashed var(--border); padding-top: 4px;">
                    &ldquo;<%= item.notes %>&rdquo;
                  </div>
                <% } %>
              </div>
            </div>

            <div style="display: flex; gap: 8px; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 10px; margin-top: 8px;">
              <a href="/bhajan/<%= b.id %>" class="btn btn-secondary" style="flex: 1; text-align: center; justify-content: center; padding: 6px 10px; font-size: 12px; text-decoration: none; border-radius: 6px;">
                Practice Lyrics
              </a>
              <button type="button" class="btn btn-secondary sb-edit-btn" data-id="<%= b.id %>" data-title="<%= b.title %>" data-scale="<%= item.custom_scale || b.shruti || '' %>" data-notes="<%= item.notes || '' %>" style="flex: 1; text-align: center; justify-content: center; padding: 6px 10px; font-size: 12px; border-radius: 6px;">
                Edit Pitch
              </button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="hub-card" style="border: 1px dashed var(--border); padding: 40px 20px; text-align: center;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: var(--border-soft); color: var(--muted); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <h3 style="font-size: 16px; font-weight: 700; color: var(--ink); margin: 0 0 6px 0;">Your Songbook is Empty</h3>
        <p style="font-size: 13.5px; color: var(--muted); max-width: 440px; margin: 0 auto 18px auto; line-height: 1.5;">
          Build your personal repertoire! When viewing any bhajan in the Master Bank, click <strong>"Add to My Songbook"</strong> to bookmark it with your personal vocal pitch.
        </p>
        <a href="/master-bank" class="btn btn-primary hub-btn-block-mobile" style="padding: 9px 18px; font-size: 13px; font-weight: 700; text-decoration: none; border-radius: 6px;">
          Explore Master Bhajan Bank
        </a>
      </div>
    <% } %>
  </div>

  <!-- ========================================== -->
  <!-- TAB 3: SINGING HISTORY                     -->
  <!-- ========================================== -->
  <div id="tab-history" class="hub-tab-pane" style="display: none;">
    <div style="margin-bottom: 18px;">
      <h3 style="font-size: 17px; font-weight: 800; color: var(--ink); margin: 0 0 6px 0;">My Samiti Bhajan History</h3>
      <p style="font-size: 13px; color: var(--muted); margin: 0 0 14px 0;">
        Every bhajan you have sung in Gandhinagar sessions, with deity breakdown to help you maintain variety.
      </p>

      <!-- Deity Summary Badges -->
      <% const deityKeys = Object.keys(safeDeitySummary); %>
      <% if (deityKeys.length > 0) { %>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
          <% deityKeys.forEach(function(d) { %>
            <span style="background: var(--surface); border: 1px solid var(--border); font-size: 12px; font-weight: 700; color: var(--ink); padding: 4px 10px; border-radius: 6px;">
              <%= d %>: <span style="color: #4f46e5;"><%= safeDeitySummary[d] %></span>
            </span>
          <% }); %>
        </div>
      <% } %>
    </div>

    <% if (safePastHistory && safePastHistory.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <% safePastHistory.forEach(function(item) { %>
          <div class="hub-card hub-history-row" style="padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; flex-wrap: wrap;">
                <span style="font-size: 12px; font-weight: 700; color: var(--muted); font-family: monospace;">
                  <%= item.session_date %>
                </span>
                <span style="background: var(--border-soft); color: var(--ink-soft); font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 4px;">
                  <%= item.deity %>
                </span>
                <span style="font-size: 11px; font-weight: 700; color: <%= item.singer_name.toLowerCase() === singer.name.toLowerCase() ? '#16a34a' : '#0284c7' %>;">
                  <%= item.singer_name.toLowerCase() === singer.name.toLowerCase() ? 'Lead' : 'Partner' %>
                </span>
              </div>
              <div style="font-size: 15px; font-weight: 700; color: var(--ink);">
                <%= item.title %>
              </div>
            </div>

            <div class="hub-history-row-actions" style="display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--muted); flex-wrap: wrap;">
              <span>Pitch: <strong style="color: var(--ink);"><%= item.scale || '-' %></strong></span>
              <% 
                const audioTs = item.audioTimestamp || (item.dataValues && item.dataValues.audioTimestamp);
              %>
              <% if (audioTs && audioTs.sessionAudio && audioTs.sessionAudio.audio_url) { 
                const startM = Math.floor(audioTs.start_seconds / 60);
                const startS = audioTs.start_seconds % 60;
                const timeFormatted = String(startM).padStart(2, '0') + ':' + String(startS).padStart(2, '0');
              %>
                <button type="button" class="btn-play-bhajan" data-start="<%= audioTs.start_seconds %>" data-title="<%= (item.title || '').replace(/"/g, '&quot;') %>" data-singer="<%= (item.singer_name || '').replace(/"/g, '&quot;') %>" data-url="<%= (audioTs.sessionAudio.audio_url || '').replace(/"/g, '&quot;') %>" onclick="window.playSessionAudioBtn(this)" title="Listen to bhajan recording from <%= item.session_date %>">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                  <span><%= timeFormatted %></span>
                </button>
              <% } %>
              <a href="/database?search=<%= encodeURIComponent(item.title) %>" class="btn btn-secondary" style="padding: 4px 10px; font-size: 12px; text-decoration: none; border-radius: 6px;">
                Session Details &rarr;
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="background: #ffffff; border: 1px dashed var(--border); border-radius: 10px; padding: 36px 20px; text-align: center;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #f8fafc; color: #64748b; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 6px 0;">No Past Sessions Recorded</h3>
        <p style="font-size: 13.5px; color: #64748b; margin: 0;">
          Past bhajans sung under &ldquo;<%= singer.name %>&rdquo; will automatically show up here after each session.
        </p>
      </div>
    <% } %>
  </div>

  <!-- ========================================== -->
  <!-- TAB 4: MY REPORTS & TICKETS               -->
  <!-- ========================================== -->
  <div id="tab-reports" class="hub-tab-pane" style="display: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
      <div>
        <h3 style="font-size: 17px; font-weight: 800; color: var(--ink); margin: 0 0 4px 0;">Correction Tickets &amp; Feedback</h3>
        <p style="font-size: 13px; color: var(--muted); margin: 0;">Track bhajan issues reported by you and responses from coordinators.</p>
      </div>
      <a href="/master-bank" class="btn btn-secondary hub-btn-block-mobile" style="font-size: 12.5px; padding: 6px 14px; text-decoration: none; border-radius: 6px;">
        Browse &amp; Report Bhajan
      </a>
    </div>

    <% if (safeMyReports && safeMyReports.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <% safeMyReports.forEach(function(r) { %>
          <%
            let statusBg = 'var(--warning-light)'; let statusColor = 'var(--warning-text)'; let statusBorder = 'var(--warning-border)'; let statusLabel = 'Pending Review';
            if (r.status === 'under_review') {
              statusBg = 'var(--info-light)'; statusColor = '#0369a1'; statusBorder = 'var(--info-border)'; statusLabel = 'Under Review';
            } else if (r.status === 'resolved') {
              statusBg = 'var(--success-light)'; statusColor = 'var(--success-text)'; statusBorder = 'var(--success-border)'; statusLabel = 'Resolved';
            } else if (r.status === 'closed') {
              statusBg = 'var(--border-soft)'; statusColor = 'var(--ink-soft)'; statusBorder = 'var(--border)'; statusLabel = 'Closed';
            }

            const catMap = {
              lyrics: 'Lyrics', scale: 'Scale', raga: 'Raga',
              deity: 'Deity', tempo: 'Tempo', sheet: 'Sheet',
              spelling: 'Typo', other: 'Other'
            };
          %>
          <div class="hub-card" style="padding: 16px;">
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; margin-bottom: 10px;">
              <div>
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px;">
                  <span style="background: #1e293b; color: #f8fafc; font-family: monospace; font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 4px; letter-spacing: 0.5px;">
                    <%= r.ticket_code %>
                  </span>
                  <span style="background: <%= statusBg %>; color: <%= statusColor %>; border: 1px solid <%= statusBorder %>; font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 9999px; text-transform: uppercase;">
                    <%= statusLabel %>
                  </span>
                  <span style="font-size: 12px; color: var(--muted);">
                    <%= new Date(r.created_at).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %>
                  </span>
                </div>

                <h4 style="font-size: 15.5px; font-weight: 800; color: var(--ink); margin: 0 0 6px 0;">
                  <% if (r.master_id) { %>
                    <a href="/bhajan/<%= r.master_id %>" style="color: inherit; text-decoration: none;">
                      <%= r.bhajan_title %> &rarr;
                    </a>
                  <% } else { %>
                    <%= r.bhajan_title %>
                  <% } %>
                </h4>
              </div>

              <% if (r.master_id) { %>
                <a href="/bhajan/<%= r.master_id %>" class="btn btn-secondary" style="padding: 5px 12px; font-size: 12px; text-decoration: none; border-radius: 6px;">
                  View Bhajan
                </a>
              <% } %>
            </div>

            <!-- Categories tags -->
            <% if (r.categories && r.categories.length > 0) { %>
              <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px;">
                <% r.categories.forEach(function(cat) { %>
                  <span style="background: var(--border-soft); border: 1px solid var(--border); font-size: 11px; padding: 2px 8px; border-radius: 4px; color: var(--ink-soft); font-weight: 600;">
                    <%= catMap[cat] || cat %>
                  </span>
                <% }); %>
              </div>
            <% } %>

            <!-- Issue Description -->
            <div style="background: var(--border-soft); border-radius: 6px; padding: 10px 12px; font-size: 13px; color: var(--ink); margin-bottom: 8px; line-height: 1.45;">
              <strong>Reported Issue:</strong> <%= r.description %>
              <% if (r.suggested_correction) { %>
                <div style="margin-top: 6px; color: #16a34a; font-weight: 600;">
                  <em>Suggested Correction:</em> <%= r.suggested_correction %>
                </div>
              <% } %>
            </div>

            <!-- Admin Response Callout -->
            <% if (r.admin_response) { %>
              <div style="background: rgba(22, 163, 74, 0.08); border: 1px solid rgba(22, 163, 74, 0.25); border-left: 4px solid #16a34a; border-radius: 6px; padding: 10px 14px; margin-top: 10px; font-size: 13px;">
                <div style="font-weight: 800; color: #166534; display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                  <span>Response from Coordinator <%= r.reviewed_by ? `(${r.reviewed_by})` : '' %></span>
                  <% if (r.reviewed_at) { %>
                    <span style="font-size: 11.5px; font-weight: normal; color: #15803d;">
                      <%= new Date(r.reviewed_at).toLocaleDateString("en-IN", { month: "short", day: "numeric" }) %>
                    </span>
                  <% } %>
                </div>
                <div style="color: var(--ink); line-height: 1.45;"><%= r.admin_response %></div>
              </div>
            <% } else { %>
              <div style="font-size: 12px; color: var(--muted); font-style: italic; margin-top: 6px;">
                Under queue for coordinator verification.
              </div>
            <% } %>

          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="hub-card" style="border: 1px dashed var(--border); padding: 36px 20px; text-align: center;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: var(--border-soft); color: var(--muted); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
