<script>
function switchHubTab(tabName, btn) {
  document.querySelectorAll('.hub-tab-pane').forEach(el => el.style.display = 'none');
  document.querySelectorAll('.hub-tab-btn').forEach(el => el.classList.remove('active'));

  const targetPane = document.getElementById('tab-' + tabName);
  if (targetPane) targetPane.style.display = 'block';
  if (btn) btn.classList.add('active');
}

function openChangePinModal() {
  document.getElementById('changePinModal').style.display = 'flex';
  document.getElementById('pinChangeAlert').style.display = 'none';
  document.getElementById('currentPin').value = '';
  document.getElementById('newPin').value = '';
}

function closeChangePinModal() {
  document.getElementById('changePinModal').style.display = 'none';
}

async function handleChangePinSubmit(e) {
  e.preventDefault();
  const alertBox = document.getElementById('pinChangeAlert');
  const btn = document.getElementById('changePinBtn');
  const currentPin = document.getElementById('currentPin').value.trim();
  const newPin = document.getElementById('newPin').value.trim();

  alertBox.style.display = 'none';

  if (!/^\d{4}$/.test(newPin)) {
    alertBox.textContent = 'New PIN must be exactly 4 digits.';
    alertBox.style.background = '#fee2e2';
    alertBox.style.color = '#991b1b';
    alertBox.style.display = 'block';
    return;
  }

  try {
    btn.disabled = true;
    btn.textContent = 'Updating...';

    const res = await fetch('/api/singer/change-pin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ current_pin: currentPin, new_pin: newPin })
    });

    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to update PIN');

    alertBox.textContent = data.message || 'PIN updated successfully!';
    alertBox.style.background = '#ecfdf5';
    alertBox.style.color = '#065f46';
    alertBox.style.display = 'block';

    setTimeout(() => {
      closeChangePinModal();
    }, 1500);

  } catch (err) {
    alertBox.textContent = err.message;
    alertBox.style.background = '#fee2e2';
    alertBox.style.color = '#991b1b';
    alertBox.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Update PIN';
  }
}

function editSongbookDetails(masterId, title, scale, notes) {
  document.getElementById('modalMasterId').value = masterId;
  document.getElementById('modalBhajanTitle').textContent = 'Bhajan: ' + title;
  document.getElementById('modalCustomScale').value = scale;
  document.getElementById('modalNotes').value = notes;
  document.getElementById('editSongbookModal').style.display = 'flex';
}

function closeEditSongbookModal() {
  document.getElementById('editSongbookModal').style.display = 'none';
}

async function handleSongbookUpdateSubmit(e) {
  e.preventDefault();
  const masterId = document.getElementById('modalMasterId').value;
  const scale = document.getElementById('modalCustomScale').value;
  const notes = document.getElementById('modalNotes').value;
  const btn = document.getElementById('saveSongbookBtn');

  try {
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const res = await fetch('/api/singer/songbook/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ master_id: masterId, custom_scale: scale, notes: notes })
    });

    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to update details');

    location.reload();
  } catch (err) {
    alert('Error saving details: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Save Details';
  }
}

async function removeSongbookEntry(masterId, title) {
  if (!confirm('Remove "' + title + '" from your Songbook?')) return;

  try {
    const res = await fetch('/api/singer/songbook/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ master_id: masterId })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to remove');
    location.reload();
  } catch (err) {
    alert('Error: ' + err.message);
  }
}

// Event delegation for songbook remove and edit buttons
document.addEventListener('click', function(e) {
  const removeBtn = e.target.closest('.sb-remove-btn');
  if (removeBtn) {
    const id = removeBtn.getAttribute('data-id');
    const title = removeBtn.getAttribute('data-title');
    removeSongbookEntry(id, title);
    return;
  }

  const editBtn = e.target.closest('.sb-edit-btn');
  if (editBtn) {
    const id = editBtn.getAttribute('data-id');
    const title = editBtn.getAttribute('data-title');
    const scale = editBtn.getAttribute('data-scale') || '';
    const notes = editBtn.getAttribute('data-notes') || '';
    editSongbookDetails(id, title, scale, notes);
    return;
  }
});

function openPreferredScaleModal() {
  document.getElementById('preferredScaleModal').style.display = 'flex';
  document.getElementById('preferredScaleAlert').style.display = 'none';
}

function closePreferredScaleModal() {
  document.getElementById('preferredScaleModal').style.display = 'none';
}

async function handlePreferredScaleSubmit(e) {
  e.preventDefault();
  const alertBox = document.getElementById('preferredScaleAlert');
  const btn = document.getElementById('savePreferredScaleBtn');
  const scale = document.getElementById('inputPreferredScale').value.trim();

  alertBox.style.display = 'none';

  try {
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const res = await fetch('/api/singer/profile/scale', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ preferred_scale: scale })
    });

    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to update pitch');

    document.getElementById('displayPreferredScale').textContent = data.preferred_scale || 'Not configured';
    alertBox.textContent = data.message || 'Saved successfully!';
    alertBox.style.background = '#ecfdf5';
    alertBox.style.color = '#065f46';
    alertBox.style.display = 'block';

    setTimeout(() => {
      closePreferredScaleModal();
    }, 1200);

  } catch (err) {
    alertBox.textContent = err.message;
    alertBox.style.background = '#fee2e2';
    alertBox.style.color = '#991b1b';
    alertBox.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Save Default Pitch';
  }
}
</script>

<% if (typeof isAdmin !== 'undefined' && isAdmin && typeof allSingers !== 'undefined' && allSingers.length > 0) { %>
<!-- Admin Switch Singer Modal -->
<div id="adminSwitchModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #ffffff; border-radius: 14px; max-width: 440px; width: 100%; padding: 24px; box-shadow: var(--shadow-xl); text-align: left; border: 1px solid var(--border);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
      <h3 style="margin: 0; font-size: 17px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        Switch Singer Profile
      </h3>
      <button type="button" onclick="closeAdminSwitchModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #64748b;">✕</button>
    </div>
    <p style="font-size: 13px; color: #64748b; margin-top: 0; margin-bottom: 16px; line-height: 1.5;">
      As an administrator, switch to any singer profile to manage songbooks, examine singing analytics, or submit bhajans on their behalf.
    </p>
    <form id="adminSwitchForm" onsubmit="handleAdminSwitchSubmit(event)">
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 12.5px; font-weight: 700; color: #0f172a; margin-bottom: 6px;">Select Devotee Singer:</label>
        <select id="adminSwitchSingerSelect" required style="width: 100%; height: 40px; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); font-size: 13.5px; background: #ffffff; color: #0f172a;">
          <% allSingers.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= s.id === singer.id ? 'selected' : '' %>>
              <%= s.name %> <%= s.gender ? `(${s.gender})` : '' %>
            </option>
          <% }); %>
        </select>
      </div>
      <div style="margin-bottom: 20px;">
        <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #475569; cursor: pointer;">
          <input type="checkbox" id="adminSwitchSavePermanent" value="1" checked style="width: 16px; height: 16px; accent-color: #4f46e5;">
          <span>Set as my permanent linked singer profile</span>
        </label>
      </div>
      <div id="adminSwitchAlert" style="display: none; padding: 10px 14px; border-radius: 6px; font-size: 13px; margin-bottom: 14px;"></div>
      <div style="display: flex; gap: 10px; justify-content: flex-end;">
        <button type="button" onclick="closeAdminSwitchModal()" class="btn btn-secondary" style="padding: 7px 16px; font-size: 13px; border-radius: 6px;">Cancel</button>
        <button type="submit" id="adminSwitchSubmitBtn" class="btn btn-primary" style="padding: 7px 18px; font-size: 13px; font-weight: 700; border-radius: 6px;">Switch Profile</button>
      </div>
    </form>
  </div>
</div>

<script>
function openAdminSwitchModal() {
  const modal = document.getElementById('adminSwitchModal');
  if (modal) modal.style.display = 'flex';
  const alert = document.getElementById('adminSwitchAlert');
  if (alert) alert.style.display = 'none';
}
function closeAdminSwitchModal() {
  const modal = document.getElementById('adminSwitchModal');
  if (modal) modal.style.display = 'none';
}
async function handleAdminSwitchSubmit(e) {
  e.preventDefault();
  const select = document.getElementById('adminSwitchSingerSelect');
  const permCheck = document.getElementById('adminSwitchSavePermanent');
  const alertBox = document.getElementById('adminSwitchAlert');
  const btn = document.getElementById('adminSwitchSubmitBtn');

  btn.disabled = true;
  btn.textContent = 'Switching...';
  alertBox.style.display = 'none';

  try {
    const res = await fetch('/api/admin/switch-singer', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        singer_id: select.value,
        save_permanent: permCheck.checked
      })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to switch profile');

    alertBox.textContent = data.message || 'Profile switched!';
    alertBox.style.background = '#ecfdf5';
    alertBox.style.color = '#065f46';
    alertBox.style.display = 'block';

    setTimeout(() => {
      window.location.reload();
    }, 600);
  } catch (err) {
    alertBox.textContent = err.message;
    alertBox.style.background = '#fee2e2';
    alertBox.style.color = '#991b1b';
    alertBox.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Switch Profile';
  }
}
</script>
<% } %>

