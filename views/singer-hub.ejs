        <p style="font-size: 13.5px; color: var(--muted); margin: 0 0 16px 0;">
          Notice incorrect lyrics, shruti, or sheet notation? Use the "Report" button on any bhajan page to notify coordinators.
        </p>
        <a href="/master-bank" class="btn btn-primary hub-btn-block-mobile" style="text-decoration: none; padding: 8px 18px; font-size: 13px; border-radius: 6px;">
          Explore Master Bhajan Bank
        </a>
      </div>
    <% } %>
  </div>

</div>

<!-- Edit Songbook Details Modal -->
