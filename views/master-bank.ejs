            <select id="editBhajanShrutiMale" name="shruti" class="admin-input-control">
              <option value="">Select Male Pitch</option>
              <% allMaleShrutis.forEach(p => { 
                const note = getWesternScale(p);
              %>
                <option value="<%= p %>"><%= p %><%= (note && note !== '-' ? ' (' + note + ')' : '') %></option>
