  <!-- Admin Edit Master Bhajan Modal -->
  <% if (isAdmin) { %>
  <div id="adminEditBhajanModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="adminEditBhajanTitle" style="display:none;">
    <div class="modal-content admin-edit-bhajan-sheet">
      <div class="sheet-drag-handle" onclick="closeAdminEditBhajanModal()" title="Close editor"></div>
      
      <div class="modal-header">
        <div class="admin-edit-title-wrap">
          <span class="admin-edit-badge">Master Catalog Editor</span>
          <h2 id="adminEditBhajanTitle" class="admin-edit-title">Edit Bhajan</h2>
        </div>
        <button type="button" class="close-btn" onclick="closeAdminEditBhajanModal()" aria-label="Close">&times;</button>
      </div>

      <form id="adminEditBhajanForm" onsubmit="submitAdminEditBhajan(event)" class="admin-edit-form">
