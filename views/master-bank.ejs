    // Singer Bookmarking integration
    window.BOOKMARKED_BHAJAN_IDS = new Set();

    function saveLocalBookmarks() {
      try {
        localStorage.setItem('bj_bookmarks', JSON.stringify(Array.from(window.BOOKMARKED_BHAJAN_IDS)));
      } catch (e) {}
    }

    function updateBookmarkStarsOnPage(id, isBookmarked) {
      var starSvg = isBookmarked
        ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>'
        : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
      document.querySelectorAll('.btn-card-bookmark[data-id="' + id + '"]').forEach(function(b) {
        b.classList.toggle('active', isBookmarked);
        var star = b.querySelector('.bookmark-star');
        if (star) star.innerHTML = starSvg;
      });

      document.querySelectorAll('.admin-btn-star[data-id="' + id + '"]').forEach(function(b) {
        b.classList.toggle('active', isBookmarked);
        var svg = b.querySelector('svg');
        if (svg) {
          svg.setAttribute('fill', isBookmarked ? '#f59e0b' : 'none');
          svg.setAttribute('stroke', isBookmarked ? '#f59e0b' : 'currentColor');
        }
      });

      if (activeQuickBhajan && String(activeQuickBhajan.id) === String(id)) {
        var quickBmBtn = document.getElementById('quickBookmarkBtn');
        if (quickBmBtn) {
          quickBmBtn.textContent = isBookmarked ? 'In Songbook' : 'Save in Songbook';
          quickBmBtn.classList.toggle('bookmarked', isBookmarked);
        }
      }
    }

    window.toggleSongbookBookmark = async function(id, btnElem) {
      var numId = Number(id);
      var wasBookmarked = window.BOOKMARKED_BHAJAN_IDS.has(numId);
      var isNowBookmarked = !wasBookmarked;
      if (isNowBookmarked) {
        window.BOOKMARKED_BHAJAN_IDS.add(numId);
      } else {
        window.BOOKMARKED_BHAJAN_IDS.delete(numId);
      }
      updateBookmarkStarsOnPage(numId, isNowBookmarked);

      var csrf = window.csrfToken || (document.querySelector('meta[name="csrf-token"]') ? document.querySelector('meta[name="csrf-token"]').getAttribute('content') : '');

      try {
        var res = await fetch('/api/singer/songbook/toggle', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrf
          },
          body: JSON.stringify({ master_id: numId })
        });
        if (res.status === 401) {
          // Revert optimistic state and prompt Singer PIN verification
          if (wasBookmarked) window.BOOKMARKED_BHAJAN_IDS.add(numId);
          else window.BOOKMARKED_BHAJAN_IDS.delete(numId);
          updateBookmarkStarsOnPage(numId, wasBookmarked);
          window.showToast('Please verify your Singer PIN to save to your Songbook');
          setTimeout(function() {
            var loginUrl = '/singer/login?redirect=' + encodeURIComponent('/master-bank');
            if (window.AppShell) window.AppShell.navigate(loginUrl);
            else window.location.href = loginUrl;
          }, 900);
          return;
        }
        if (!res.ok) throw new Error('Failed');
        saveLocalBookmarks();
        window.showToast(isNowBookmarked ? 'Saved to your Personal Songbook!' : 'Removed from Personal Songbook');
        if (window.AppShell) window.AppShell.markStale(['hub']);
      } catch (err) {
        if (wasBookmarked) window.BOOKMARKED_BHAJAN_IDS.add(numId);
        else window.BOOKMARKED_BHAJAN_IDS.delete(numId);
        updateBookmarkStarsOnPage(numId, wasBookmarked);
        window.showToast('Unable to update Songbook right now');
      }
    };

    window.toggleQuickBookmark = function() {
      if (!activeQuickBhajan) return;
      window.toggleSongbookBookmark(activeQuickBhajan.id);
    };

    // Load initial bookmarks from localStorage & server
    (async function loadUserBookmarks() {
      try {
        var local = localStorage.getItem('bj_bookmarks');
        if (local) {
          var parsed = JSON.parse(local);
          if (Array.isArray(parsed)) {
            parsed.forEach(function(bid) { window.BOOKMARKED_BHAJAN_IDS.add(Number(bid)); });
          }
        }
      } catch (e) {}

      try {
        var res = await fetch('/api/singer/songbook');
        var data = await res.json();
        if (data && data.bookmarks && Array.isArray(data.bookmarks)) {
          data.bookmarks.forEach(function(bm) {
            window.BOOKMARKED_BHAJAN_IDS.add(Number(bm.master_id));
          });
          saveLocalBookmarks();
        }
      } catch (e) {}

      document.querySelectorAll('.btn-card-bookmark').forEach(function(b) {
        var bid = Number(b.getAttribute('data-id'));
        if (window.BOOKMARKED_BHAJAN_IDS.has(bid)) {
          b.classList.add('active');
          var star = b.querySelector('.bookmark-star');
          if (star) star.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
        }
      });

      document.querySelectorAll('.admin-btn-star').forEach(function(b) {
        var bid = Number(b.getAttribute('data-id'));
        if (window.BOOKMARKED_BHAJAN_IDS.has(bid)) {
          b.classList.add('active');
          var svg = b.querySelector('svg');
          if (svg) {
            svg.setAttribute('fill', '#f59e0b');
            svg.setAttribute('stroke', '#f59e0b');
          }
        }
      });
    })();

    // Restore state upon page load / back navigation (Bug 2 Fix)
    restoreBankFilterState();

    // Initialize saved view mode preference (Cards Grid vs Minimalist Song Feed)
    try {
      var savedView = localStorage.getItem('bp_catalog_view') || 'grid';
      window.setCatalogViewMode(savedView);
    } catch (_) {}

    observeBankInfiniteScroll();
  })();
  </script>

