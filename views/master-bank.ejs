  <!-- Toast Notification -->
  <div id="bankToast" class="bank-toast" style="display:none;" role="status" aria-live="polite"></div>

  <!-- Master Bhajans Data Cache for Instant Zero-Latency Filtering -->
  <script id="allMasterBhajansData" type="application/json">
    <%- JSON.stringify(bhajans.map(b => ({
      id: b.id,
      title: b.title,
      deity: b.deity || '',
      tempo: b.tempo || '',
      raga: b.raga || '',
      shruti: b.shruti || '',
      shruti_female: b.shruti_female || '',
      wm: getWesternScale(b.shruti),
      wf: getWesternScale(b.shruti_female),
      level: b.level || '',
      language: b.language || '',
      sheet_filename: b.sheet_filename || '',
      has_lyrics: !!b.has_lyrics
    }))) %>
  </script>

  <script>
  (function() {
    var dataElem = document.getElementById('allMasterBhajansData');
    if (!dataElem) return;
    var allData = [];
    try { allData = JSON.parse(dataElem.textContent); } catch (e) { return; }
    window.ALL_MASTER_BHAJANS = allData;
    window.IS_ADMIN_MASTER_BANK = <%= isAdmin ? 'true' : 'false' %>;

    var catalogContainer = document.getElementById('masterBankCatalog');
    var loadMoreBtn = document.getElementById('bankLoadMoreBtn');
    var loadMoreDiv = document.getElementById('masterBankLoadMore');
    var remCount = document.getElementById('bankRemainingCount');
    var renderedCountDisplay = document.getElementById('renderedCountDisplay');
    var totalMatchingDisplay = document.getElementById('totalMatchingDisplay');
    var clearSearchBtn = document.getElementById('clearBankSearchBtn');

    var currentMatches = allData;
    var INITIAL_RENDER = 24;
    var renderedCount = Math.min(INITIAL_RENDER, allData.length);
    var BATCH_SIZE = 24;

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // ── Filter & Scroll State Persistence (Supports both Single-DOM Shell Pane & Standalone Window) ──
    function getBankScrollEl() {
      var pane = document.getElementById('pane-bank');
      if (pane && pane.contains(document.getElementById('filterBankTitle'))) return pane;
      return null;
    }

    function getBankScrollTop() {
      var pane = getBankScrollEl();
      return pane ? pane.scrollTop : (window.scrollY || document.documentElement.scrollTop || 0);
    }

    function setBankScrollTop(y) {
      var pane = getBankScrollEl();
      if (pane) pane.scrollTop = y;
      else window.scrollTo({ top: y, behavior: 'instant' });
    }

    function saveBankFilterState(lastId) {
      try {
        var titleIn = document.getElementById('filterBankTitle');
        var deityIn = document.getElementById('filterBankDeity');
        var tempoIn = document.getElementById('filterBankTempo');
        var ragaIn = document.getElementById('filterBankRaga');

        var scrollY = getBankScrollTop();
        var existing = {};
        try {
          existing = JSON.parse(sessionStorage.getItem('bp_bank_filter_state') || '{}');
        } catch (_) {}

        var state = {
          search: titleIn ? titleIn.value : '',
          deity: deityIn ? deityIn.value : '',
          tempo: tempoIn ? tempoIn.value : '',
          raga: ragaIn ? ragaIn.value : '',
          scrollY: scrollY,
          lastBhajanId: (lastId !== undefined) ? lastId : (existing.lastBhajanId || null),
          timestamp: Date.now()
        };
        sessionStorage.setItem('bp_bank_filter_state', JSON.stringify(state));
      } catch (_) {}
    }

    window.recordBhajanClick = function(id) {
      saveBankFilterState(id);
    };

    function restoreBankFilterState() {
      try {
        var raw = sessionStorage.getItem('bp_bank_filter_state');
        if (!raw) return;
        var state = JSON.parse(raw);
        if (!state) return;

        var titleIn = document.getElementById('filterBankTitle');
        var deityIn = document.getElementById('filterBankDeity');
        var tempoIn = document.getElementById('filterBankTempo');
        var ragaIn = document.getElementById('filterBankRaga');

        var applied = false;
        if (titleIn && state.search) {
          titleIn.value = state.search;
          if (clearSearchBtn) clearSearchBtn.style.display = 'block';
          applied = true;
        }
        if (deityIn && state.deity) {
          deityIn.value = state.deity;
          applied = true;
        }
        if (tempoIn && state.tempo) {
          tempoIn.value = state.tempo;
          applied = true;
        }
        if (ragaIn && state.raga) {
          ragaIn.value = state.raga;
          applied = true;
        }

        if (applied) {
          window.filterMasterBank(true);
        }

        // Only restore initial scroll when not already preserved by cached AppShell pane
        if (window.AppShell && getBankScrollTop() > 0) return;

        if (state.lastBhajanId && !window.AppShell) {
          setTimeout(function() {
            var target = document.getElementById('card-' + state.lastBhajanId) || document.getElementById('row-' + state.lastBhajanId);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'center' });
              target.classList.add('highlight-pulse');
              setTimeout(function() {
                target.classList.remove('highlight-pulse');
              }, 2500);
            } else if (state.scrollY) {
              setBankScrollTop(state.scrollY);
            }
          }, 150);
        } else if (state.scrollY) {
          setBankScrollTop(state.scrollY);
        }
      } catch (_) {}
    }

    function getDeityJewelClient(deityStr) {
      var d = (deityStr || '').toLowerCase();
      if (d.includes('ganesha') || d.includes('vinayaka') || d.includes('vighnesh')) {
        return { initial: 'G', className: 'jewel-ganesha' };
      } else if (d.includes('shiva') || d.includes('shankara') || d.includes('nataraja') || d.includes('rudra')) {
        return { initial: 'S', className: 'jewel-shiva' };
      } else if (d.includes('krishna') || d.includes('gopala') || d.includes('govinda') || d.includes('madhava')) {
        return { initial: 'K', className: 'jewel-krishna' };
      } else if (d.includes('rama') || d.includes('raghu') || d.includes('ram')) {
        return { initial: 'R', className: 'jewel-rama' };
      } else if (d.includes('narayana') || d.includes('vishnu') || d.includes('hari')) {
        return { initial: 'N', className: 'jewel-narayana' };
      } else if (d.includes('sai') || d.includes('baba')) {
        return { initial: 'S', className: 'jewel-sai' };
      } else if (d.includes('mata') || d.includes('devi') || d.includes('durga') || d.includes('amma') || d.includes('sarada') || d.includes('lakshmi')) {
        return { initial: 'M', className: 'jewel-mata' };
      } else if (d.includes('hanuman') || d.includes('anjaneya') || d.includes('maruti')) {
        return { initial: 'H', className: 'jewel-hanuman' };
      } else if (d.includes('guru')) {
        return { initial: 'G', className: 'jewel-guru' };
      } else if (d.includes('sarva') || d.includes('dharma')) {
        return { initial: 'Ω', className: 'jewel-sarva' };
      }
      return { initial: 'ॐ', className: 'jewel-default' };
    }

    function createGlassBhajanCardHtml(b) {
      var isAdmin = window.IS_ADMIN_MASTER_BANK;
      var jewel = getDeityJewelClient(b.deity);
      var deityTokens = (b.deity || 'Devotional').split(/[,;&\/]+/).map(function(s) { return s.trim(); }).filter(Boolean);
      var deityPills = deityTokens.map(function(d) { return '<span class="deity-pill">' + escapeHtml(d) + '</span>'; }).join('');
      var tempoClass = (b.tempo || '').toLowerCase().replace(/\s+/g, '-');
      var tempoPill = b.tempo ? '<span class="meta-tag tempo-tag tempo-' + tempoClass + '"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> ' + escapeHtml(b.tempo) + '</span>' : '';

      var wM = (b.wm && b.wm !== '-') ? '<span class="pitch-capsule-key">' + escapeHtml(b.wm) + '</span>' : '';
      var wF = (b.wf && b.wf !== '-') ? '<span class="pitch-capsule-key">' + escapeHtml(b.wf) + '</span>' : '';
      var scaleM = escapeHtml(b.shruti || '-');
      var scaleF = escapeHtml(b.shruti_female || '-');

      var ragaTag = b.raga ? '<span class="meta-tag raga-tag">Raag ' + escapeHtml(b.raga) + '</span>' : '';
      var langTag = b.language ? '<span class="meta-tag lang-tag">' + escapeHtml(b.language) + '</span>' : '';
      var levelTag = b.level ? '<span class="meta-tag level-tag">' + escapeHtml(b.level.charAt(0).toUpperCase() + b.level.slice(1)) + '</span>' : '';

      var sheetBtn = b.sheet_filename ? '<a href="/sheets/' + encodeURIComponent(b.sheet_filename) + '" target="_blank" rel="noopener noreferrer" class="card-sheet-btn-sm" title="Open music sheet (PDF)" onclick="event.stopPropagation();"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><span>Sheet</span></a>' : '';

      var isBookmarked = window.BOOKMARKED_BHAJAN_IDS && window.BOOKMARKED_BHAJAN_IDS.has(Number(b.id));
      var starFill = isBookmarked ? '#f59e0b' : 'none';
      var starStroke = isBookmarked ? '#f59e0b' : 'currentColor';

      var adminActionsTrio = '<div class="admin-actions-trio" onclick="event.stopPropagation();">' +
        '<button type="button" class="admin-action-btn admin-btn-star' + (isBookmarked ? ' active' : '') + '" data-id="' + b.id + '" onclick="event.stopPropagation(); window.toggleSongbookBookmark(' + b.id + ', this)" title="Save in Songbook" aria-label="Bookmark">' +
          '<svg width="14" height="14" viewBox="0 0 24 24" fill="' + starFill + '" stroke="' + starStroke + '" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>' +
        '</button>' +
        '<button type="button" class="admin-action-btn admin-btn-edit" onclick="event.stopPropagation(); window.openAdminEditBhajanModal(' + b.id + ')" title="Edit Master Bhajan" aria-label="Edit">' +
          '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>' +
        '</button>' +
        '<button type="button" class="admin-action-btn admin-btn-delete" onclick="event.stopPropagation(); window.deleteMasterRow(' + b.id + ')" title="Delete Bhajan" aria-label="Delete">' +
          '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>' +
        '</button>' +
      '</div>';

