    // Admin Master Bhajan Edit Modal Logic
    window.openAdminEditBhajanModal = function(id) {
      if (!window.IS_ADMIN_MASTER_BANK || !document.getElementById('adminEditBhajanModal')) return;
      var b = allData.find(function(x) { return x.id === id || String(x.id) === String(id); });
      if (!b) return;

      var idField = document.getElementById('editBhajanId');
      var titleField = document.getElementById('editBhajanTitle');
      var deityField = document.getElementById('editBhajanDeity');
      var tempoField = document.getElementById('editBhajanTempo');
      var ragaField = document.getElementById('editBhajanRaga');
      var levelField = document.getElementById('editBhajanLevel');
      var shrutiMaleField = document.getElementById('editBhajanShrutiMale');
      var shrutiFemField = document.getElementById('editBhajanShrutiFemale');
      var langField = document.getElementById('editBhajanLanguage');
      var sheetField = document.getElementById('editBhajanSheet');
      var lyricsField = document.getElementById('editBhajanLyrics');

      function setSelectVal(sel, val) {
        if (!sel) return;
        if (!val) { sel.value = ''; return; }
        var v = String(val).trim();
        if (!v) { sel.value = ''; return; }

        // 1. Exact match
        for (var i = 0; i < sel.options.length; i++) {
          if (sel.options[i].value === v) {
            sel.selectedIndex = i;
            return;
          }
        }

        // 2. Case-insensitive match (e.g. gavati -> Gavati, sanskrit / hindi -> Sanskrit / Hindi)
        var vLow = v.toLowerCase();
        for (var j = 0; j < sel.options.length; j++) {
          if (sel.options[j].value.toLowerCase() === vLow) {
            sel.selectedIndex = j;
            return;
          }
        }

        // 2b. Level mapping (basic -> simple)
        if (vLow === 'basic') {
          for (var k = 0; k < sel.options.length; k++) {
            if (sel.options[k].value === 'simple') {
              sel.selectedIndex = k;
              return;
            }
          }
        }

        // 2c. Strip leading '~ '
        if (v.startsWith('~')) {
          var stripTilde = v.replace(/^~\s*/, '').toLowerCase();
          for (var m = 0; m < sel.options.length; m++) {
            if (sel.options[m].value.toLowerCase() === stripTilde) {
              sel.selectedIndex = m;
              return;
            }
          }
        }

        // 3. Fallback: dynamically add and select option so no data is ever lost
        var opt = document.createElement('option');
        opt.value = v;
        opt.textContent = v;
        sel.appendChild(opt);
        sel.value = v;
      }

      if (idField) idField.value = b.id;
      if (titleField) titleField.value = b.title || '';
      if (deityField) setSelectVal(deityField, b.deity);
      if (tempoField) setSelectVal(tempoField, b.tempo);
      if (ragaField) setSelectVal(ragaField, b.raga);
      if (levelField) setSelectVal(levelField, b.level);
      if (shrutiMaleField) setSelectVal(shrutiMaleField, b.shruti);
      if (shrutiFemField) setSelectVal(shrutiFemField, b.shruti_female);
      if (langField) setSelectVal(langField, b.language);
      if (sheetField) setSelectVal(sheetField, b.sheet_filename);
      if (lyricsField) {
        if (typeof b.lyrics === 'string') {
          lyricsField.value = b.lyrics;
          lyricsField.disabled = false;
        } else {
          lyricsField.value = 'Loading lyrics...';
          lyricsField.disabled = true;
          fetch('/api/bhajan/' + encodeURIComponent(b.id) + '/lyrics')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              b.lyrics = (data && typeof data.lyrics === 'string') ? data.lyrics : '';
              if (idField && String(idField.value) === String(b.id)) {
                lyricsField.value = b.lyrics;
                lyricsField.disabled = false;
              }
            })
            .catch(function() {
              lyricsField.value = '';
              lyricsField.disabled = false;
            });
        }
      }

      var modal = document.getElementById('adminEditBhajanModal');
      if (modal) {
        modal.style.display = 'flex';
        modal.classList.add('show');
      }
    };

    window.closeAdminEditBhajanModal = function() {
      var modal = document.getElementById('adminEditBhajanModal');
      if (modal) {
        modal.classList.remove('show');
        modal.style.display = 'none';
      }
    };

    window.submitAdminEditBhajan = async function(e) {
      e.preventDefault();
      var id = document.getElementById('editBhajanId').value;
      var saveBtn = document.getElementById('btnSaveAdminEdit');
      var origText = saveBtn ? saveBtn.textContent : 'Save Changes';
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
      }

      var updatedData = {
        title: document.getElementById('editBhajanTitle').value.trim(),
        deity: document.getElementById('editBhajanDeity').value.trim(),
        tempo: document.getElementById('editBhajanTempo').value.trim(),
        raga: document.getElementById('editBhajanRaga').value.trim(),
        level: document.getElementById('editBhajanLevel').value.trim(),
        shruti: document.getElementById('editBhajanShrutiMale').value.trim(),
        shruti_female: document.getElementById('editBhajanShrutiFemale').value.trim(),
        language: document.getElementById('editBhajanLanguage').value.trim(),
        sheet_filename: document.getElementById('editBhajanSheet').value.trim(),
        lyrics: document.getElementById('editBhajanLyrics').value.trim()
      };

      var csrf = window.csrfToken || (document.querySelector('meta[name="csrf-token"]') ? document.querySelector('meta[name="csrf-token"]').getAttribute('content') : '');

      try {
        var res = await fetch('/api/admin/update-master-bhajan/' + id, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrf
          },
          body: JSON.stringify(updatedData)
        });
        var data = await res.json();
        if (data.success) {
          var b = allData.find(function(x) { return String(x.id) === String(id); });
          if (b) {
            Object.assign(b, updatedData);
            b.wm = getWesternScale(b.shruti);
            b.wf = getWesternScale(b.shruti_female);
          }
          var cEntry = searchCatalog.find(function(x) { return String(x.item.id) === String(id); });
          if (cEntry) {
            cEntry.item = b;
            cEntry.titleWords = normalizeSearch(b.title).split(' ').filter(Boolean);
            cEntry.titleNorm = cEntry.titleWords.join(' ');
            cEntry.deityLower = (b.deity || '').toLowerCase().trim();
            cEntry.deityList = b.deity ? b.deity.split(/[,;&\/]+/).map(function(s) { return s.trim().toLowerCase(); }).filter(Boolean) : [];
            cEntry.tempoLower = (b.tempo || '').toLowerCase().trim();
          }

          window.filterMasterBank(true);
          window.closeAdminEditBhajanModal();
          window.showToast('Master Bhajan updated successfully!');
        } else {
          alert('Failed to update: ' + (data.error || 'Unknown error'));
        }
      } catch (err) {
        alert('Failed to save changes. Please try again.');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = origText;
        }
      }
    };

    window.deleteMasterRow = async function(id) {
      const ok = window.BPSheet
        ? await window.BPSheet.confirm("Are you sure you want to permanently delete/archive this bhajan from the Master Database?", { isDestructive: true })
        : confirm("Are you sure you want to permanently delete/archive this bhajan from the Master Database?");
      if (!ok) return;
      var csrf = window.csrfToken || (document.querySelector('meta[name="csrf-token"]') ? document.querySelector('meta[name="csrf-token"]').getAttribute('content') : '');

      try {
        var res = await fetch('/api/admin/delete-master-bhajan/' + id, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrf
          }
        });
        var data = await res.json();
        if (data.success) {
          var row = document.getElementById('row-' + id);
          if (row) row.remove();
          var card = document.getElementById('card-' + id);
          if (card) card.remove();

          allData = allData.filter(function(x) { return String(x.id) !== String(id); });
          searchCatalog = searchCatalog.filter(function(x) { return String(x.item.id) !== String(id); });
          window.filterMasterBank(true);
          window.showToast('Bhajan archived successfully.');
        } else {
          alert('Error: ' + (data.error || 'Failed to delete'));
        }
      } catch (err) {
        alert('Failed to delete bhajan.');
      }
    };

    window.editMasterRow = function(id) {
      window.openAdminEditBhajanModal(id);
