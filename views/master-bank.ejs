          <div class="admin-form-group full-width">
            <label for="editBhajanTitle">Bhajan Title <span class="req">*</span></label>
            <input type="text" id="editBhajanTitle" name="title" required class="admin-input-control" placeholder="e.g. Vinayaka Vinayaka" />
          </div>

          <div class="admin-form-group">
            <label for="editBhajanDeity">Deity / Deities <span class="req">*</span></label>
            <select id="editBhajanDeity" name="deity" required class="admin-input-control">
              <option value="">Select Deity</option>
              <optgroup label="Primary Deities">
                <% singleDeitiesList.forEach(d => { %>
                  <option value="<%= d %>"><%= d %></option>
                <% }) %>
              </optgroup>
              <optgroup label="Multi-Deity Combinations">
                <% comboDeitiesList.forEach(d => { %>
                  <option value="<%= d %>"><%= d %></option>
                <% }) %>
              </optgroup>
            </select>
          </div>

          <div class="admin-form-group">
            <label for="editBhajanTempo">Tempo / Speed</label>
            <select id="editBhajanTempo" name="tempo" class="admin-input-control">
