    window.openQuickLyrics = function(id) {
      var b = allData.find(function(x) { return x.id === id || String(x.id) === String(id); });
      if (!b) return;
      activeQuickBhajan = b;

      var modal = document.getElementById('quickLyricsModal');
      var titleElem = document.getElementById('quickLyricsTitle');
      var deityBadge = document.getElementById('quickDeityBadge');
      var tempoBadge = document.getElementById('quickTempoBadge');
      var ragaBadge = document.getElementById('quickRagaBadge');
      var maleElem = document.getElementById('quickScaleMale');
      var femaleElem = document.getElementById('quickScaleFemale');
      var textElem = document.getElementById('quickLyricsText');
      var scheduleBtn = document.getElementById('quickScheduleBtn');
      var fullPageBtn = document.getElementById('quickFullPageBtn');
      var bookmarkBtn = document.getElementById('quickBookmarkBtn');

      if (titleElem) titleElem.textContent = b.title;
      var badgeStrip = document.querySelector('.quick-lyrics-badge-strip');
      if (badgeStrip) {
        var existingDeityPills = badgeStrip.querySelectorAll('.quick-deity-pill');
        existingDeityPills.forEach(function(p) { p.remove(); });
        var deityTokens = (b.deity || 'Devotional').split(/[,;&\/]+/).map(function(s) { return s.trim(); }).filter(Boolean);
        var firstEl = badgeStrip.firstChild;
        deityTokens.forEach(function(dt) {
          var sp = document.createElement('span');
          sp.className = 'hero-pill deity-pill quick-deity-pill';
          sp.textContent = dt;
          badgeStrip.insertBefore(sp, firstEl);
        });
      }
      if (tempoBadge) {
        if (b.tempo) {
          tempoBadge.textContent = b.tempo;
          tempoBadge.style.display = 'inline-block';
        } else {
          tempoBadge.style.display = 'none';
        }
      }
      if (ragaBadge) {
        if (b.raga) {
          ragaBadge.textContent = 'Raag ' + b.raga;
          ragaBadge.style.display = 'inline-block';
        } else {
          ragaBadge.style.display = 'none';
        }
      }

      var scaleM = (b.shruti || '-') + (b.wm && b.wm !== '-' ? ' (' + b.wm + ')' : '');
      var scaleF = (b.shruti_female || '-') + (b.wf && b.wf !== '-' ? ' (' + b.wf + ')' : '');
      if (maleElem) maleElem.textContent = scaleM;
      if (femaleElem) femaleElem.textContent = scaleF;

      function renderQuickLyricsText(lyricsStr) {
        if (!textElem) return;
        if (lyricsStr && lyricsStr.trim().length > 0) {
          var stanzas = lyricsStr.trim().split(/\r?\n\s*\r?\n/);
          textElem.innerHTML = stanzas.map(function(st) {
            return '<div class="quick-lyrics-stanza">' + escapeHtml(st).replace(/\n/g, '<br/>') + '</div>';
          }).join('');
        } else {
          textElem.innerHTML = '<div class="empty-lyrics-prompt">' +
            '<p>Lyrics are being synchronized into the master catalog.</p>' +
            '<a href="/bhajan/' + b.id + '" onclick="window.closeQuickLyrics()" class="button secondary" style="display:inline-block; font-size:12px; margin-top:8px;">Open Full Details</a>' +
            '</div>';
        }
      }

      function renderLyricsSkeleton() {
        if (!textElem) return;
        textElem.innerHTML = '<div class="bp-skeleton-lyrics" aria-busy="true" aria-label="Loading lyrics">' +
          '<div class="bp-skeleton-line" style="width:75%;height:16px;margin:8px 0;background:var(--border,#e2e8f0);border-radius:4px;opacity:0.6;"></div>' +
          '<div class="bp-skeleton-line" style="width:90%;height:16px;margin:8px 0;background:var(--border,#e2e8f0);border-radius:4px;opacity:0.6;"></div>' +
          '<div class="bp-skeleton-line" style="width:65%;height:16px;margin:8px 0 20px;background:var(--border,#e2e8f0);border-radius:4px;opacity:0.6;"></div>' +
          '<div class="bp-skeleton-line" style="width:80%;height:16px;margin:8px 0;background:var(--border,#e2e8f0);border-radius:4px;opacity:0.6;"></div>' +
          '<div class="bp-skeleton-line" style="width:70%;height:16px;margin:8px 0;background:var(--border,#e2e8f0);border-radius:4px;opacity:0.6;"></div>' +
          '</div>';
      }

      function renderLyricsError() {
        if (!textElem) return;
        textElem.innerHTML = '<div class="empty-lyrics-prompt bp-lyrics-error">' +
          '<p>Unable to load lyrics at this time.</p>' +
          '<button type="button" class="button secondary" style="display:inline-block; font-size:12px; margin-top:8px;" onclick="window.retryQuickLyrics(' + b.id + ')">Retry</button>' +
          '</div>';
      }

      if (textElem) {
        if (typeof b.lyrics === 'string') {
          renderQuickLyricsText(b.lyrics);
        } else {
          renderLyricsSkeleton();
          fetch('/api/bhajan/' + encodeURIComponent(b.id) + '/lyrics')
            .then(function(r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.json();
            })
            .then(function(data) {
              b.lyrics = (data && typeof data.lyrics === 'string') ? data.lyrics : '';
              if (activeQuickBhajan && String(activeQuickBhajan.id) === String(b.id)) {
                renderQuickLyricsText(b.lyrics);
              }
            })
            .catch(function() {
              if (activeQuickBhajan && String(activeQuickBhajan.id) === String(b.id)) {
                renderLyricsError();
              }
            });
        }
      }

      if (scheduleBtn) {
        scheduleBtn.href = '/submit-form?prefill_title=' + encodeURIComponent(b.title) +
          '&prefill_deity=' + encodeURIComponent(b.deity || '') +
          '&prefill_scale=' + encodeURIComponent(b.shruti || '') +
          '&prefill_speed=' + encodeURIComponent(b.tempo || '') +
          '&master_id=' + b.id;
      }
      if (fullPageBtn) {
        fullPageBtn.href = '/bhajan/' + b.id;
      }

      var isBookmarked = window.BOOKMARKED_BHAJAN_IDS && window.BOOKMARKED_BHAJAN_IDS.has(Number(b.id));
      if (bookmarkBtn) {
        bookmarkBtn.textContent = isBookmarked ? 'In Songbook' : 'Save in Songbook';
        bookmarkBtn.classList.toggle('bookmarked', isBookmarked);
      }

      if (modal) modal.classList.add('show');
    };

