<%
    // Use precomputed catalogCache aggregates when available (0ms), with safe fallback
    let uniqueDeities, uniqueTempos, uniqueRagas;
    if (locals.aggregates && locals.aggregates.uniqueDeities) {
      uniqueDeities = locals.aggregates.uniqueDeities;
      uniqueTempos = locals.aggregates.uniqueTempos;
      uniqueRagas = locals.aggregates.uniqueRagas;
    } else {
      const deityMap = new Map();
      bhajans.forEach(b => {
        if (!b.deity) return;
        const parts = b.deity.split(',').map(s => s.trim()).filter(Boolean);
        parts.forEach(d => {
          let name = d;
          let key = d.toLowerCase();
          if (key === 'vittala' || key === 'vithhala' || key === 'vithala' || key === 'vitthala') {
            name = 'Vitthala';
            key = 'vitthala';
          }
          if (key === 'anjaneya' || key === 'aanjaneya' || key === 'hanuman' || key === 'maruti' || key === 'maruthi') {
            name = 'Hanuman';
            key = 'hanuman';
          }
          if (!deityMap.has(key)) {
            deityMap.set(key, { name: name, count: 0 });
          }
          deityMap.get(key).count++;
        });
      });
      uniqueDeities = Array.from(deityMap.values()).sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));
      uniqueTempos = [...new Set(bhajans.map(b => (b.tempo || '').trim()).filter(Boolean))].sort((a,b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));
      const ragaMap = new Map();
      bhajans.forEach(b => {
        if (!b.raga) return;
        const cleanRaga = b.raga.replace(/~/g, '').trim();
        const parts = cleanRaga.split(',').map(s => s.trim()).filter(Boolean);
        parts.forEach(r => {
          const key = r.toLowerCase();
          if (!ragaMap.has(key)) {
            ragaMap.set(key, { name: r, count: 0 });
          }
          ragaMap.get(key).count++;
        });
      });
      uniqueRagas = Array.from(ragaMap.values()).sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));
    }

    // Canonical lists for Admin Edit Modal dropdowns to prevent discrepancies
    const primaryDeities = ['Ganesha', 'Guru', 'Hanuman', 'Krishna', 'Mata', 'Narasimha', 'Narayana', 'Rama', 'Sai', 'SarvaDharma', 'Shiva', 'Subrahmanya', 'Surya', 'Vitthala', 'Ayyappa'];
    const dbDeitiesRaw = [...new Set(bhajans.map(b => (b.deity || '').trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));
    const singleDeitiesList = primaryDeities.filter(d => dbDeitiesRaw.some(x => x.toLowerCase() === d.toLowerCase()) || true);
    const comboDeitiesList = dbDeitiesRaw.filter(d => d.includes(',') || !singleDeitiesList.some(s => s.toLowerCase() === d.toLowerCase()));

    const modalRagasMap = new Map();
    uniqueRagas.forEach(r => {
      const key = r.name.toLowerCase().trim();
      if (!modalRagasMap.has(key)) modalRagasMap.set(key, r.name);
    });
    bhajans.forEach(b => {
      if (!b.raga) return;
      const cleaned = b.raga.replace(/^~\s*/, '').trim();
      if (!cleaned) return;
      const key = cleaned.toLowerCase();
      if (!modalRagasMap.has(key)) {
        const words = cleaned.split(/([\s/,-]+)/).map(w => /^[a-zA-Z]+$/.test(w) ? w.charAt(0).toUpperCase() + w.slice(1).toLowerCase() : w).join('');
        modalRagasMap.set(key, words);
      }
    });
    const sortedModalRagas = Array.from(modalRagasMap.values()).sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

    const standardShrutis = [
      '1P', '1.5P', '2P', '2.5P', '3P', '4P', '4.5P', '5P', '5.5P', '6P', '6.5P', '7P',
      '1M', '1.5M', '2M', '2.5M', '3M', '4M', '4.5M', '5M', '5.5M', '6M', '6.5M', '7M'
    ];
    const maleShrutisFromDb = [...new Set(bhajans.map(b => (b.shruti || '').trim()).filter(Boolean))];
    const femaleShrutisFromDb = [...new Set(bhajans.map(b => (b.shruti_female || '').trim()).filter(Boolean))];
    const allMaleShrutis = [...new Set([...standardShrutis, ...maleShrutisFromDb])].sort((a, b) => {
      const numA = parseFloat(a) || 0;
      const numB = parseFloat(b) || 0;
      return numA === numB ? a.localeCompare(b) : numA - numB;
    });
    const allFemaleShrutis = [...new Set([...standardShrutis, ...femaleShrutisFromDb])].sort((a, b) => {
      const numA = parseFloat(a) || 0;
      const numB = parseFloat(b) || 0;
      return numA === numB ? a.localeCompare(b) : numA - numB;
    });

    const standardLangs = ['Sanskrit / Hindi', 'Hindi', 'Sanskrit', 'Telugu', 'Tamil', 'Kannada', 'Marathi', 'Malayalam', 'Gujarati', 'Bengali', 'English'];
    const dbLangs = [...new Set(bhajans.map(b => (b.language || '').trim()).filter(Boolean))];
    const modalLanguagesMap = new Map();
    standardLangs.forEach(l => modalLanguagesMap.set(l.toLowerCase(), l));
    dbLangs.forEach(l => {
      const key = l.toLowerCase();
      if (!modalLanguagesMap.has(key)) {
        const titleCased = l.split(/([\s/,-]+)/).map(w => /^[a-zA-Z]+$/.test(w) ? w.charAt(0).toUpperCase() + w.slice(1).toLowerCase() : w).join('');
        modalLanguagesMap.set(key, titleCased);
      }
    });
    const sortedModalLanguages = Array.from(modalLanguagesMap.values()).sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

    const sortedModalSheets = [...new Set(bhajans.map(b => (b.sheet_filename || '').trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

    function getWesternScale(indianScale) {
      if (!indianScale || indianScale === '-' || indianScale === 'Not specified') return '-';
      const match = indianScale.toString().trim().match(/^([\d\.]+)\s*([PMpm])?.*$/);
      if (!match) return '-';
      const numMap = {'1':0, '1.5':1, '2':2, '2.5':3, '3':4, '4':5, '4.5':6, '5':7, '5.5':8, '6':9, '6.5':10, '7':11};
      if (numMap[match[1]] === undefined) return '-';
      let index = numMap[match[1]];
      if ((match[2] || '').toUpperCase() === 'M') index = (index + 5) % 12;
      return ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"][index];
    }

    function getDeityJewel(deityStr) {
      if (!deityStr) return { initial: 'D', className: 'jewel-default' };
      const first = deityStr.split(/[,;&\/]+/)[0].trim().toLowerCase();
      if (first.includes('ganesh') || first.includes('vinayak')) return { initial: 'G', className: 'jewel-ganesha' };
      if (first.includes('guru')) return { initial: 'G', className: 'jewel-guru' };
      if (first.includes('hanuman') || first.includes('anjaneya') || first.includes('maruti')) return { initial: 'H', className: 'jewel-hanuman' };
      if (first.includes('krishna')) return { initial: 'K', className: 'jewel-krishna' };
      if (first.includes('mata') || first.includes('devi') || first.includes('durga')) return { initial: 'M', className: 'jewel-mata' };
      if (first.includes('narayan')) return { initial: 'N', className: 'jewel-narayana' };
      if (first.includes('rama')) return { initial: 'R', className: 'jewel-rama' };
      if (first.includes('sai')) return { initial: 'S', className: 'jewel-sai' };
      if (first.includes('sarva')) return { initial: 'S', className: 'jewel-sarvadharma' };
      if (first.includes('shiva')) return { initial: 'S', className: 'jewel-shiva' };
      if (first.includes('vitt') || first.includes('vith')) return { initial: 'V', className: 'jewel-vitthala' };
      return { initial: (deityStr.trim().charAt(0) || 'D').toUpperCase(), className: 'jewel-default' };
    }
  %>

  <div class="master-bank-page">

      <!-- Glassmorphic Command & Filter Deck -->
      <section class="bank-glass-deck" aria-label="Master Bhajan Bank Search & Filters">
        <!-- Top Row: Compact Title, View Switcher & Minimalist Tools -->
        <div class="bank-glass-header-row">
          <div class="bank-glass-title-group">
            <h1 class="bank-glass-title">Master Bhajan Bank</h1>
            <span class="bank-glass-badge" id="heroCountBadge">
              <span class="badge-dot"></span>
              <%= bhajans.length %> Verified Bhajans
            </span>
          </div>

          <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <!-- View Switcher (Cards vs Minimalist List) -->
            <div class="glass-view-switcher" role="group" aria-label="Catalog view mode">
              <button type="button" class="view-switch-btn active" id="btnViewGrid" onclick="setCatalogViewMode('grid')" title="Glass Cards View" aria-label="Cards view">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                <span>Cards</span>
              </button>
              <button type="button" class="view-switch-btn" id="btnViewList" onclick="setCatalogViewMode('list')" title="Minimalist List View" aria-label="List view">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                <span>List</span>
              </button>
            </div>

            <% if (isAdmin) { %>
              <div class="bank-glass-admin-tools" aria-label="Admin catalog tools">
                <a href="/admin/archived-master-bhajans" class="glass-btn-sm" title="View deactivated master bhajans">
                  Archived
                </a>
                <a href="/admin/export-master" class="glass-btn-sm" title="Download Master Catalog JSON">
                  Export JSON
                </a>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Integrated Glassmorphic Search Bar -->
        <div class="bank-glass-search-wrap">
          <span class="search-glass-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            type="search"
            id="filterBankTitle"
            class="bank-glass-search-input"
            placeholder="Search <%= bhajans.length %> bhajans by title, raag, deity, tempo, or scale..."
            autocomplete="off"
            enterkeyhint="search"
            oninput="handleBankSearchInput(this)"
          />
          <button type="button" id="clearBankSearchBtn" class="clear-search-btn" style="display:none;" onclick="clearBankSearch()" aria-label="Clear search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <!-- Minimalist Frosted Deity Filter Chips Scroll -->
        <div class="bank-deity-chips-scroll" id="bankDeityChipsScroll" role="tablist" aria-label="Filter by Deity">
          <button type="button" class="deity-chip active-chip" data-deity="" onclick="selectDeityChip(this, '')">
            <span>All</span> <span class="chip-count"><%= bhajans.length %></span>
          </button>
          <% uniqueDeities.forEach(d => { %>
            <button type="button" class="deity-chip" data-deity="<%= d.name.toLowerCase() %>" onclick="selectDeityChip(this, '<%= d.name.toLowerCase() %>')">
              <span><%= d.name %></span> <span class="chip-count"><%= d.count %></span>
            </button>
          <% }) %>
        </div>

        <!-- Translucent Filter & Info Strip (Tempo, Raag, Reset & Live Count) -->
        <div class="bank-filter-controls-row">
          <div class="bank-dropdowns-strip">
            <!-- Hidden Deity select for script synchronization -->
            <select id="filterBankDeity" class="filter-select-control glass-select" style="display:none;" onchange="filterMasterBank()">
              <option value="">All Deities</option>
              <% uniqueDeities.forEach(d => { %>
                <option value="<%= d.name.toLowerCase() %>"><%= d.name %></option>
              <% }) %>
            </select>

            <!-- Tempo Dropdown -->
            <div class="filter-field-group">
              <select id="filterBankTempo" class="filter-select-control glass-select" onchange="filterMasterBank()" aria-label="Filter by Tempo">
                <option value="">All Tempos</option>
                <% uniqueTempos.forEach(t => { %>
                  <option value="<%= t.toLowerCase() %>"><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
                <% }) %>
              </select>
            </div>

            <!-- Raga Dropdown -->
            <div class="filter-field-group">
              <select id="filterBankRaga" class="filter-select-control glass-select" onchange="filterMasterBank()" aria-label="Filter by Raag">
                <option value="">All Ragas (<%= uniqueRagas.length %>)</option>
                <% uniqueRagas.forEach(r => { %>
                  <option value="<%= r.name.toLowerCase() %>"><%= r.name %> (<%= r.count %>)</option>
                <% }) %>
              </select>
            </div>

            <!-- Reset Button -->
            <button type="button" class="filter-reset-action-btn glass-reset-btn" onclick="resetAllBankFilters()" title="Reset all search filters">
              <span class="reset-icon">↺</span> Reset
            </button>
          </div>

          <!-- Aligned Result Count Indicator -->
          <% const INITIAL_RENDER = 24; %>
          <div class="bank-count-pill glass-pill" id="bankCountPill">
            Showing <strong id="renderedCountDisplay"><%= Math.min(INITIAL_RENDER, bhajans.length) %></strong> of <strong id="totalMatchingDisplay"><%= bhajans.length %></strong> bhajans
          </div>
        </div>
      </section>

      <!-- Master Bhajan Glassmorphic Songbook Catalog (Replaces Generic Table) -->
      <div id="masterBankCatalog" class="master-catalog-view mode-grid" aria-label="Master Bhajan Catalog">
        <% const initialBhajans = bhajans.slice(0, INITIAL_RENDER); %>
        <% if (initialBhajans.length > 0) { %>
          <% initialBhajans.forEach(b => { %>
            <%
              const jewel = getDeityJewel(b.deity);
              const wM = getWesternScale(b.shruti);
              const wF = getWesternScale(b.shruti_female);
              const deityTokens = (b.deity || '').split(/[,;&\/]+/).map(d => d.trim()).filter(Boolean);
              const tempoClass = (b.tempo || '').toLowerCase().replace(/\s+/g, '-');
            %>
            <div class="glass-bhajan-card" id="card-<%= b.id %>" data-id="<%= b.id %>" data-deity="<%= (b.deity || '').toLowerCase() %>" onclick="recordBhajanClick(<%= b.id %>); window.openQuickLyrics(<%= b.id %>)">
              
              <!-- GRID VIEW MODE CONTENT -->
              <div class="card-grid-content">
                <div class="card-head-bar">
                  <div class="card-deity-group">
                    <% deityTokens.forEach(d => { %>
                      <span class="deity-pill"><%= d %></span>
                    <% }) %>
                  </div>
                  <div class="card-top-actions">
                    <% if (isAdmin) { %>
                      <div class="admin-actions-trio" onclick="event.stopPropagation();">
                        <button type="button" class="admin-action-btn admin-btn-star" data-id="<%= b.id %>" onclick="event.stopPropagation(); window.toggleSongbookBookmark(<%= b.id %>, this)" title="Save in Songbook" aria-label="Bookmark">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        </button>
                        <button type="button" class="admin-action-btn admin-btn-edit" onclick="event.stopPropagation(); window.openAdminEditBhajanModal(<%= b.id %>)" title="Edit Master Bhajan" aria-label="Edit">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>
                        <button type="button" class="admin-action-btn admin-btn-delete" onclick="event.stopPropagation(); window.deleteMasterRow(<%= b.id %>)" title="Delete Bhajan" aria-label="Delete">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        </button>
                      </div>
                    <% } else { %>
                      <button type="button" class="btn-card-bookmark" data-id="<%= b.id %>" onclick="event.stopPropagation(); window.toggleSongbookBookmark(<%= b.id %>, this)" title="Add to My Songbook" aria-label="Bookmark">
                        <span class="bookmark-star">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        </span>
                      </button>
                    <% } %>
                  </div>
                </div>

                <h3 class="card-title">
                  <a href="/bhajan/<%= b.id %>" class="card-title-link" onclick="event.preventDefault(); event.stopPropagation(); recordBhajanClick(<%= b.id %>); window.openQuickLyrics(<%= b.id %>);">
                    <%= b.title %>
                  </a>
                </h3>

                <div class="card-pitch-capsule">
                  <div class="pitch-capsule-item">
                    <span class="pitch-capsule-lbl">Male:</span>
                    <span class="pitch-capsule-val"><%= b.shruti || '-' %></span>
                    <% if (wM !== '-') { %><span class="pitch-capsule-key"><%= wM %></span><% } %>
                    <% if (b.shruti && b.shruti !== '-') { %>
                      <button type="button" class="btn-pitch-drone-play" onclick="event.stopPropagation(); window.playTanpuraPitch('<%= (wM && wM !== "-") ? wM : b.shruti %>');" title="Play Tanpura in pitch <%= (wM && wM !== "-") ? wM : b.shruti %>" aria-label="Play Tanpura">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
                      </button>
                    <% } %>
                  </div>
                  <div class="pitch-capsule-item">
                    <span class="pitch-capsule-lbl">Female:</span>
                    <span class="pitch-capsule-val"><%= b.shruti_female || '-' %></span>
                    <% if (wF !== '-') { %><span class="pitch-capsule-key"><%= wF %></span><% } %>
                    <% if (b.shruti_female && b.shruti_female !== '-') { %>
                      <button type="button" class="btn-pitch-drone-play" onclick="event.stopPropagation(); window.playTanpuraPitch('<%= (wF && wF !== "-") ? wF : b.shruti_female %>');" title="Play Tanpura in pitch <%= (wF && wF !== "-") ? wF : b.shruti_female %>" aria-label="Play Tanpura">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
                      </button>
                    <% } %>
                  </div>
                </div>

                <div class="card-subtags-row">
                  <% if (b.raga) { %><span class="meta-tag raga-tag">Raag <%= b.raga %></span><% } %>
                  <% if (b.tempo) { %>
                    <span class="meta-tag tempo-tag tempo-<%= tempoClass %>">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      <%= b.tempo %>
                    </span>
                  <% } %>
                  <% if (b.language) { %><span class="meta-tag lang-tag"><%= b.language %></span><% } %>
                  <% if (b.level) { %><span class="meta-tag level-tag"><%= b.level.charAt(0).toUpperCase() + b.level.slice(1) %></span><% } %>
                </div>

                <div class="card-bottom-actions-row">
                  <div class="card-actions-left">
                    <button type="button" class="card-action-btn-primary" onclick="event.stopPropagation(); recordBhajanClick(<%= b.id %>); window.openQuickLyrics(<%= b.id %>);">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                      <span>Lyrics</span>
                    </button>
                    <% if (b.sheet_filename) { %>
                      <a href="/sheets/<%= encodeURIComponent(b.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="card-sheet-btn-sm" title="Open music sheet (PDF)" onclick="event.stopPropagation();">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        <span>Sheet</span>
                      </a>
                    <% } %>
                  </div>
                  <a href="/bhajan/<%= b.id %>" class="card-details-arrow-btn" onclick="event.stopPropagation(); recordBhajanClick(<%= b.id %>);" title="Full devotion details" aria-label="Details">↗</a>
                </div>
              </div>

              <!-- LIST VIEW MODE CONTENT -->
              <div class="card-list-content">
                <div class="list-main-col">
                  <div class="list-title-group">
                    <a href="/bhajan/<%= b.id %>" class="card-title-link" onclick="event.preventDefault(); event.stopPropagation(); recordBhajanClick(<%= b.id %>); window.openQuickLyrics(<%= b.id %>);">
                      <%= b.title %>
                    </a>
                    <div class="list-meta-subtitle">
                      <% deityTokens.forEach(d => { %><span class="deity-pill"><%= d %></span><% }) %>
                      <% if (b.raga) { %><span class="meta-tag raga-tag">Raag <%= b.raga %></span><% } %>
                    </div>
                  </div>
                </div>

                <div class="list-pitches-col">
                  <div class="card-pitch-capsule">
                    <div class="pitch-capsule-item">
                      <span class="pitch-capsule-lbl">M:</span>
                      <span class="pitch-capsule-val"><%= b.shruti || '-' %></span>
                      <% if (wM !== '-') { %><span class="pitch-capsule-key"><%= wM %></span><% } %>
                    </div>
                    <div class="pitch-capsule-item">
                      <span class="pitch-capsule-lbl">F:</span>
                      <span class="pitch-capsule-val"><%= b.shruti_female || '-' %></span>
                      <% if (wF !== '-') { %><span class="pitch-capsule-key"><%= wF %></span><% } %>
                    </div>
                  </div>
                  <% if (b.tempo) { %>
                    <span class="tempo-cell tempo-<%= tempoClass %>"><%= b.tempo %></span>
                  <% } %>
                </div>

                <div class="list-actions-col">
                  <% if (b.sheet_filename) { %>
                    <a href="/sheets/<%= encodeURIComponent(b.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="card-sheet-btn-sm" title="Open music sheet" onclick="event.stopPropagation();">
                      <span>Sheet</span>
                    </a>
                  <% } %>
                  <button type="button" class="card-action-btn-primary" onclick="event.stopPropagation(); recordBhajanClick(<%= b.id %>); window.openQuickLyrics(<%= b.id %>);">
                    Lyrics
                  </button>
                  <% if (isAdmin) { %>
                    <div class="admin-actions-trio" onclick="event.stopPropagation();">
                      <button type="button" class="admin-action-btn admin-btn-star" data-id="<%= b.id %>" onclick="event.stopPropagation(); window.toggleSongbookBookmark(<%= b.id %>, this)" title="Save in Songbook" aria-label="Bookmark">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      </button>
                      <button type="button" class="admin-action-btn admin-btn-edit" onclick="event.stopPropagation(); window.openAdminEditBhajanModal(<%= b.id %>)" title="Edit Master Bhajan" aria-label="Edit">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>
                      <button type="button" class="admin-action-btn admin-btn-delete" onclick="event.stopPropagation(); window.deleteMasterRow(<%= b.id %>)" title="Delete Bhajan" aria-label="Delete">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                      </button>
                    </div>
                  <% } else { %>
                    <button type="button" class="btn-card-bookmark" data-id="<%= b.id %>" onclick="event.stopPropagation(); window.toggleSongbookBookmark(<%= b.id %>, this)" title="Add to My Songbook" aria-label="Bookmark">
                      <span class="bookmark-star">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      </span>
                    </button>
                  <% } %>
                  <a href="/bhajan/<%= b.id %>" class="card-details-arrow-btn" onclick="event.stopPropagation(); recordBhajanClick(<%= b.id %>);" title="Full devotion details" aria-label="Details">↗</a>
                </div>
              </div>

            </div>
          <% }) %>
        <% } else { %>
          <div class="catalog-empty-state">
            <div class="catalog-empty-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
            </div>
            <h3 class="catalog-empty-title">No Bhajans Found</h3>
            <p class="catalog-empty-desc">No master bhajans matched the current filters.</p>
          </div>
        <% } %>
      </div>

      <!-- Load More Button -->
      <% if (bhajans.length > 60) { %>
        <div id="masterBankLoadMore" class="bank-load-more-wrap">
          <button type="button" id="bankLoadMoreBtn" class="bank-load-more-btn">
            Load More Bhajans (<span id="bankRemainingCount"><%= bhajans.length - 60 %></span> remaining)
          </button>
        </div>
      <% } %>

  </div>

  <!-- App-First Quick Lyrics Bottom Sheet Modal (Zero Emoji) -->
  <div id="quickLyricsModal" class="modal bp-blur" role="dialog" aria-modal="true" aria-labelledby="quickLyricsTitle">
