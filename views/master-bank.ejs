        if (btnList) { btnList.classList.add('active'); btnList.setAttribute('aria-pressed', 'true'); }
        try { localStorage.setItem('bp_catalog_view', 'list'); } catch (_) {}
      } else {
        catalog.classList.remove('mode-list');
        catalog.classList.add('mode-grid');
        if (btnGrid) { btnGrid.classList.add('active'); btnGrid.setAttribute('aria-pressed', 'true'); }
        if (btnList) { btnList.classList.remove('active'); btnList.setAttribute('aria-pressed', 'false'); }
        try { localStorage.setItem('bp_catalog_view', 'grid'); } catch (_) {}
      }
    };

    function updateLoadMoreUI() {
      if (renderedCountDisplay) renderedCountDisplay.textContent = Math.min(renderedCount, currentMatches.length);
      if (totalMatchingDisplay) totalMatchingDisplay.textContent = currentMatches.length;

      if (!loadMoreDiv) return;
      var remaining = currentMatches.length - renderedCount;
      if (remaining > 0) {
        loadMoreDiv.style.display = '';
        if (remCount) remCount.textContent = remaining;
      } else {
        loadMoreDiv.style.display = 'none';
      }
    }

    var bankObserver = null;
    function observeBankInfiniteScroll() {
      if (!('IntersectionObserver' in window) || !loadMoreDiv) return;
      if (bankObserver) {
        bankObserver.disconnect();
      }
      var scrollRoot = getBankScrollEl();
      bankObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting && renderedCount < currentMatches.length) {
            if (bankObserver && loadMoreDiv) bankObserver.unobserve(loadMoreDiv);
            window.renderMoreMasterBank();
          }
        });
      }, {
        root: scrollRoot,
        rootMargin: '700px 0px'
      });

      if (renderedCount < currentMatches.length) {
        bankObserver.observe(loadMoreDiv);
      }
    }

    window.renderMoreMasterBank = function() {
      var nextBatch = currentMatches.slice(renderedCount, renderedCount + BATCH_SIZE);
      if (nextBatch.length === 0) {
        updateLoadMoreUI();
        return;
      }
      if (catalogContainer) {
        var cardsHtml = nextBatch.map(createGlassBhajanCardHtml).join('');
        catalogContainer.insertAdjacentHTML('beforeend', cardsHtml);
      }
      renderedCount += nextBatch.length;
      updateLoadMoreUI();
      if (bankObserver && loadMoreDiv) {
        bankObserver.unobserve(loadMoreDiv);
        if (renderedCount < currentMatches.length) {
          bankObserver.observe(loadMoreDiv);
        }
      }
    };

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', window.renderMoreMasterBank);
    }

    function getWords(str) {
      return (str || '')
        .toLowerCase()
        .replace(/[''`".,;:!?()\[\]{}\/\\~-]/g, ' ')
        .split(/\s+/)
        .filter(Boolean);
    }

    function normalizeSearch(str) {
      return (str || '')
        .toLowerCase()
        .replace(/[''`".,;:!?()\[\]{}\/\\~-]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    // Pre-index catalog for instant sub-millisecond, highly accurate search
    var searchCatalog = allData.map(function(b) {
      var titleWords = getWords(b.title);
      var deityWords = getWords(b.deity);
      var ragaWords = getWords(b.raga);
      var tempoWords = getWords(b.tempo);
      var langWords = getWords(b.language);
      var allWords = titleWords.concat(deityWords, ragaWords, tempoWords, langWords);

      var rawDeityTokens = (b.deity || '')
        .toLowerCase()
        .split(/[,;&\/]+/)
        .map(function(s) { return s.trim(); })
        .filter(Boolean);
      var deityList = [];
      for (var dt = 0; dt < rawDeityTokens.length; dt++) {
        var dTok = rawDeityTokens[dt];
        if (deityList.indexOf(dTok) === -1) deityList.push(dTok);
        if (dTok === 'vittala' || dTok === 'vithhala' || dTok === 'vithala') {
          if (deityList.indexOf('vitthala') === -1) deityList.push('vitthala');
        }
        if (dTok === 'vitthala') {
          if (deityList.indexOf('vittala') === -1) deityList.push('vittala');
        }
        if (dTok === 'devi') {
          if (deityList.indexOf('mata') === -1) deityList.push('mata');
        }
        if (dTok === 'mata') {
          if (deityList.indexOf('devi') === -1) deityList.push('devi');
        }
        if (dTok === 'anjaneya') {
          if (deityList.indexOf('hanuman') === -1) deityList.push('hanuman');
        }
        if (dTok === 'hanuman') {
          if (deityList.indexOf('anjaneya') === -1) deityList.push('anjaneya');
        }
        if (dTok === 'sarva dharma') {
          if (deityList.indexOf('sarvadharma') === -1) deityList.push('sarvadharma');
        }
        if (dTok === 'sarvadharma') {
          if (deityList.indexOf('sarva dharma') === -1) deityList.push('sarva dharma');
        }
      }

      var ragaList = (b.raga || '')
        .replace(/~/g, '')
        .toLowerCase()
        .split(',')
        .map(function(s) { return s.trim(); })
        .filter(Boolean);

      return {
        item: b,
        titleWords: titleWords,
        titleNorm: titleWords.join(' '),
        deityWords: deityWords,
        ragaWords: ragaWords,
        tempoWords: tempoWords,
        allWords: allWords,
        deityLower: (b.deity || '').toLowerCase().trim(),
        deityList: deityList,
        tempoLower: (b.tempo || '').toLowerCase().trim(),
        ragaList: ragaList
      };
    });

