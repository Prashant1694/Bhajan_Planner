<script>
let currentEditingReport = null;

function openReportModal(report) {
  currentEditingReport = report;
  document.getElementById('modalReportId').value = report.id;
  document.getElementById('modalTicketCode').innerText = report.ticket_code;
  document.getElementById('modalBhajanTitle').innerText = report.bhajan_title;
  document.getElementById('modalReporterName').innerText = report.reporter_name || 'Anonymous';
  document.getElementById('modalReporterContact').innerText = report.reporter_contact || 'No contact provided';
  document.getElementById('modalCreatedAt').innerText = new Date(report.created_at).toLocaleString();
  document.getElementById('modalDescription').innerText = report.description || '-';

  if (report.suggested_correction) {
    document.getElementById('modalSuggestedCorrection').innerText = report.suggested_correction;
    document.getElementById('modalCorrectionBox').style.display = 'block';
  } else {
    document.getElementById('modalCorrectionBox').style.display = 'none';
  }

  const masterLink = document.getElementById('modalMasterLink');
  if (report.master_id) {
    masterLink.href = '/bhajan/' + report.master_id;
    masterLink.style.display = 'inline-flex';
  } else {
    masterLink.style.display = 'none';
  }

  // Categories tags
  const catContainer = document.getElementById('modalCategoriesList');
  catContainer.innerHTML = '';
  const catLabels = {
    lyrics: 'Lyrics',
    scale: 'Scale',
    raga: 'Raga',
    deity: 'Deity',
    tempo: 'Tempo',
    sheet: 'Sheet',
    spelling: 'Typo',
    other: 'Other'
  };
  (report.categories || []).forEach(cat => {
    const span = document.createElement('span');
    span.className = 'reports-cat-chip';
    span.innerText = catLabels[cat] || cat;
    catContainer.appendChild(span);
  });

  // Status & Fields
  document.getElementById('modalStatusSelect').value = report.status || 'pending';
  document.getElementById('modalAdminResponse').value = report.admin_response || '';
  document.getElementById('modalAdminNotes').value = report.admin_notes || '';

  const badge = document.getElementById('modalStatusBadge');
  badge.className = 'rep-status-badge';
  if (report.status === 'under_review') {
    badge.innerText = 'In Progress';
    badge.classList.add('rep-badge-progress');
  } else if (report.status === 'resolved') {
    badge.innerText = 'Resolved';
    badge.classList.add('rep-badge-resolved');
  } else if (report.status === 'closed') {
    badge.innerText = 'Closed';
    badge.classList.add('rep-badge-closed');
  } else {
    badge.innerText = 'Pending';
    badge.classList.add('rep-badge-pending');
  }

  const modal = document.getElementById('reviewModal');
  modal.style.display = 'flex';
}

function closeReportModal() {
  document.getElementById('reviewModal').style.display = 'none';
}

function applyQuickReply(type) {
  const resp = document.getElementById('modalAdminResponse');
  const statusSel = document.getElementById('modalStatusSelect');
  if (type === 'lyrics') {
    resp.value = 'Sai Ram! Thank you for pointing this out. We have corrected the lyrics and updated the master bank.';
    statusSel.value = 'resolved';
  } else if (type === 'scale') {
    resp.value = 'Sai Ram! The singing pitch / scale has been updated in the master database.';
    statusSel.value = 'resolved';
  } else if (type === 'accurate') {
    resp.value = 'Sai Ram! We verified the bhajan with official Prashanti Mandir audio records. Details are confirmed accurate.';
    statusSel.value = 'closed';
  } else if (type === 'sheet') {
    resp.value = 'Sai Ram! We have re-uploaded the official sheet music PDF with correct notation.';
    statusSel.value = 'resolved';
  }
}

async function submitReportUpdate(e) {
  e.preventDefault();
  const id = document.getElementById('modalReportId').value;
  const status = document.getElementById('modalStatusSelect').value;
  const admin_response = document.getElementById('modalAdminResponse').value;
  const admin_notes = document.getElementById('modalAdminNotes').value;
  const saveBtn = document.getElementById('saveReportBtn');

  try {
    saveBtn.disabled = true;
    saveBtn.innerText = 'Saving...';

    const res = await fetch('/admin/reports/' + id + '/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status, admin_response, admin_notes })
    });

    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to update report');

    closeReportModal();
    window.location.reload();
  } catch (err) {
    alert('Error updating report: ' + err.message);
    saveBtn.disabled = false;
    saveBtn.innerText = 'Save & Notify User';
  }
}
</script>
