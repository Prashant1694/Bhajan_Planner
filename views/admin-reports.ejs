<div class="admin-reports-view">
  <!-- Page Header -->
  <header class="admin-reports-header">
    <div class="admin-reports-header-content">
      <div class="admin-reports-title-group">
        <span class="admin-reports-badge">Devotee Care &amp; Feedback</span>
        <h1 class="admin-reports-title">Bhajan Issue &amp; Correction Reports</h1>
        <p class="admin-reports-subtitle">
          Review devotee-submitted feedback, verify lyrics or pitch corrections, and communicate ticket resolutions.
        </p>
      </div>
      <div class="admin-reports-header-actions">
        <a href="/master-bank" class="sec-tool-btn" style="min-height:36px; padding:0 14px; text-decoration:none;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span>Master Bank</span>
        </a>
        <a href="/my-reports" target="_blank" class="sec-tool-btn" style="min-height:36px; padding:0 14px; text-decoration:none;" title="Preview devotee ticket tracker portal">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          <span>User Portal &rarr;</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Stat Cards Overview Grid -->
  <% const totalCount = (counts.total !== undefined ? counts.total : counts.all) || 0; %>
  <div class="reports-kpi-grid">
    <!-- Card 1: Total Tickets -->
    <a href="/admin/reports" class="reports-kpi-card <%= !selectedStatus ? 'kpi-card-active' : '' %>" data-kpi="all">
      <div class="kpi-card-stripe kpi-stripe-all"></div>
      <div class="kpi-card-header">
        <span class="kpi-card-label">Total Tickets</span>
        <span class="kpi-pill kpi-pill-all">All</span>
      </div>
      <div class="kpi-card-number"><%= totalCount %></div>
      <div class="kpi-card-meta">Lifetime submissions</div>
    </a>

    <!-- Card 2: Needs Review -->
    <a href="/admin/reports?status=pending" class="reports-kpi-card <%= selectedStatus === 'pending' ? 'kpi-card-active' : '' %>" data-kpi="pending">
      <div class="kpi-card-stripe kpi-stripe-pending"></div>
      <div class="kpi-card-header">
        <span class="kpi-card-label">Needs Review</span>
        <span class="kpi-pill kpi-pill-pending">Pending</span>
      </div>
      <div class="kpi-card-number kpi-num-pending"><%= counts.pending || 0 %></div>
      <div class="kpi-card-meta">Awaiting response</div>
    </a>

    <!-- Card 3: In Progress -->
    <a href="/admin/reports?status=under_review" class="reports-kpi-card <%= selectedStatus === 'under_review' ? 'kpi-card-active' : '' %>" data-kpi="progress">
      <div class="kpi-card-stripe kpi-stripe-progress"></div>
      <div class="kpi-card-header">
        <span class="kpi-card-label">In Progress</span>
        <span class="kpi-pill kpi-pill-progress">Active</span>
      </div>
      <div class="kpi-card-number kpi-num-progress"><%= counts.under_review || 0 %></div>
      <div class="kpi-card-meta">Under verification</div>
    </a>

    <!-- Card 4: Resolved -->
    <a href="/admin/reports?status=resolved" class="reports-kpi-card <%= selectedStatus === 'resolved' ? 'kpi-card-active' : '' %>" data-kpi="resolved">
      <div class="kpi-card-stripe kpi-stripe-resolved"></div>
      <div class="kpi-card-header">
        <span class="kpi-card-label">Resolved</span>
        <span class="kpi-pill kpi-pill-resolved">Fixed</span>
      </div>
      <div class="kpi-card-number kpi-num-resolved"><%= counts.resolved || 0 %></div>
      <div class="kpi-card-meta">Resolved &amp; notified</div>
    </a>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="reports-toolbar-card">
    <form method="GET" action="/admin/reports" class="reports-toolbar-form">
      <div class="reports-search-box">
        <svg class="reports-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          type="search"
          name="search"
          value="<%= searchQuery %>"
          placeholder="Search ticket #, title, lyrics snippet, or reporter..."
          class="reports-search-input"
          aria-label="Search reports"
        >
        <% if (searchQuery) { %>
          <a href="/admin/reports<%= selectedStatus ? '?status=' + selectedStatus : '' %>" class="reports-clear-search" title="Clear search">
            &times;
          </a>
        <% } %>
      </div>

      <div class="reports-filter-group">
        <!-- Status Filter Dropdown -->
        <div class="reports-select-wrap">
          <select name="status" onchange="this.form.submit()" class="reports-select" aria-label="Filter by status">
            <option value="">All Statuses (<%= totalCount %>)</option>
            <option value="pending" <%= selectedStatus === 'pending' ? 'selected' : '' %>>Needs Review (<%= counts.pending || 0 %>)</option>
            <option value="under_review" <%= selectedStatus === 'under_review' ? 'selected' : '' %>>In Progress (<%= counts.under_review || 0 %>)</option>
            <option value="resolved" <%= selectedStatus === 'resolved' ? 'selected' : '' %>>Resolved (<%= counts.resolved || 0 %>)</option>
            <option value="closed" <%= selectedStatus === 'closed' ? 'selected' : '' %>>Closed (<%= counts.closed || 0 %>)</option>
          </select>
        </div>

        <!-- Category Filter Dropdown -->
        <div class="reports-select-wrap">
          <select name="category" onchange="this.form.submit()" class="reports-select" aria-label="Filter by category">
            <option value="">All Categories</option>
            <option value="lyrics" <%= selectedCategory === 'lyrics' ? 'selected' : '' %>>Lyrics</option>
            <option value="scale" <%= selectedCategory === 'scale' ? 'selected' : '' %>>Scale / Pitch</option>
            <option value="raga" <%= selectedCategory === 'raga' ? 'selected' : '' %>>Raga</option>
            <option value="deity" <%= selectedCategory === 'deity' ? 'selected' : '' %>>Deity</option>
            <option value="tempo" <%= selectedCategory === 'tempo' ? 'selected' : '' %>>Tempo</option>
            <option value="sheet" <%= selectedCategory === 'sheet' ? 'selected' : '' %>>Music Sheet</option>
            <option value="spelling" <%= selectedCategory === 'spelling' ? 'selected' : '' %>>Spelling / Title</option>
            <option value="other" <%= selectedCategory === 'other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>

        <button type="submit" class="reports-btn-submit">
          <span>Search</span>
        </button>

        <% if (selectedStatus || selectedCategory || searchQuery) { %>
          <a href="/admin/reports" class="reports-btn-clear" title="Reset all filters">
            <span>Clear</span>
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Main Content Container: Table (Desktop) & Cards (Mobile) -->
  <div class="reports-content-box">
    <% if (reports && reports.length > 0) { %>
      <!-- Desktop Table View -->
      <div class="reports-table-container">
        <table class="reports-table">
          <thead>
            <tr>
              <th style="width: 130px;">Ticket #</th>
              <th style="width: 220px;">Bhajan Title</th>
              <th style="width: 150px;">Categories</th>
              <th>Issue Details</th>
              <th style="width: 170px;">Reporter</th>
              <th style="width: 120px; text-align:center;">Status</th>
              <th style="width: 130px; text-align:right;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% reports.forEach(r => { %>
              <%
                let badgeClass = "rep-badge-pending";
                let statusLabel = "Pending";
                if (r.status === 'under_review') {
                  badgeClass = "rep-badge-progress";
                  statusLabel = "In Progress";
                } else if (r.status === 'resolved') {
                  badgeClass = "rep-badge-resolved";
                  statusLabel = "Resolved";
                } else if (r.status === 'closed') {
                  badgeClass = "rep-badge-closed";
                  statusLabel = "Closed";
                }

                const catLabels = {
                  lyrics: 'Lyrics',
                  scale: 'Scale',
                  raga: 'Raga',
                  deity: 'Deity',
                  tempo: 'Tempo',
                  sheet: 'Sheet',
                  spelling: 'Typo',
                  other: 'Other'
                };
              %>
              <tr id="report-row-<%= r.id %>" class="reports-tr">
                <td>
                  <span class="reports-ticket-code"><%= r.ticket_code %></span>
                  <div class="reports-ticket-date">
                    <%= new Date(r.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </div>
                </td>

                <td>
                  <% if (r.master_id) { %>
                    <a href="/bhajan/<%= r.master_id %>" target="_blank" class="reports-bhajan-link" title="Open live bhajan page">
                      <span><%= r.bhajan_title %></span>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                  <% } else { %>
                    <span class="reports-bhajan-title"><%= r.bhajan_title %></span>
                  <% } %>
                </td>

                <td>
                  <div class="reports-cats-wrap">
                    <% (r.categories || []).forEach(cat => { %>
                      <span class="reports-cat-chip">
                        <%= catLabels[cat] || cat %>
                      </span>
                    <% }) %>
                  </div>
                </td>

                <td>
                  <div class="reports-desc-preview">
                    <%= r.description %>
                  </div>
                  <% if (r.suggested_correction) { %>
                    <div class="reports-suggestion-preview">
                      <strong>Suggestion:</strong> <%= r.suggested_correction %>
                    </div>
                  <% } %>
                </td>

                <td>
                  <div class="reports-reporter-info">
                    <span class="reports-reporter-name"><%= r.reporter_name || 'Anonymous' %></span>
                    <% if (r.singer_id) { %>
                      <span class="reports-singer-tag">Singer</span>
                    <% } %>
                  </div>
                  <% if (r.reporter_contact) { %>
                    <div class="reports-reporter-contact"><%= r.reporter_contact %></div>
                  <% } %>
                </td>

                <td style="text-align:center;">
                  <span class="rep-status-badge <%= badgeClass %>">
                    <%= statusLabel %>
                  </span>
                  <% if (r.admin_response) { %>
                    <div class="reports-replied-indicator">Replied</div>
                  <% } %>
                </td>

                <td style="text-align:right;">
                  <button
                    type="button"
                    class="reports-action-btn"
                    onclick='openReportModal(<%= JSON.stringify(r) %>)'
                    aria-label="Review and reply to report <%= r.ticket_code %>"
                  >
                    <span>Review &amp; Reply</span>
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards View -->
      <div class="reports-cards-container">
        <% reports.forEach(r => { %>
          <%
            let badgeClass = "rep-badge-pending";
            let statusLabel = "Pending";
            if (r.status === 'under_review') {
              badgeClass = "rep-badge-progress";
              statusLabel = "In Progress";
            } else if (r.status === 'resolved') {
              badgeClass = "rep-badge-resolved";
              statusLabel = "Resolved";
            } else if (r.status === 'closed') {
              badgeClass = "rep-badge-closed";
              statusLabel = "Closed";
            }

            const catLabels = {
              lyrics: 'Lyrics',
              scale: 'Scale',
              raga: 'Raga',
              deity: 'Deity',
              tempo: 'Tempo',
              sheet: 'Sheet',
              spelling: 'Typo',
              other: 'Other'
            };
          %>
          <div class="report-mobile-card" id="mobile-report-card-<%= r.id %>">
            <div class="report-mobile-card-top">
              <div class="reports-ticket-code"><%= r.ticket_code %></div>
              <span class="rep-status-badge <%= badgeClass %>"><%= statusLabel %></span>
            </div>

            <h3 class="report-mobile-title">
              <% if (r.master_id) { %>
                <a href="/bhajan/<%= r.master_id %>" target="_blank" class="reports-bhajan-link">
                  <%= r.bhajan_title %>
                </a>
              <% } else { %>
                <%= r.bhajan_title %>
              <% } %>
            </h3>

            <div class="reports-cats-wrap" style="margin-bottom: 8px;">
              <% (r.categories || []).forEach(cat => { %>
                <span class="reports-cat-chip"><%= catLabels[cat] || cat %></span>
              <% }) %>
            </div>

            <div class="reports-desc-preview" style="-webkit-line-clamp: 3; margin-bottom: 8px;">
              <%= r.description %>
            </div>

            <% if (r.suggested_correction) { %>
              <div class="reports-suggestion-preview" style="margin-bottom: 10px;">
                <strong>Suggestion:</strong> <%= r.suggested_correction %>
              </div>
            <% } %>

            <div class="report-mobile-card-meta">
              <div class="reports-reporter-info">
                <span class="reports-reporter-name"><%= r.reporter_name || 'Anonymous' %></span>
                <% if (r.singer_id) { %>
                  <span class="reports-singer-tag">Singer</span>
                <% } %>
                <span class="reports-ticket-date" style="margin-left: 6px;">
                  &bull; <%= new Date(r.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %>
                </span>
              </div>
              <% if (r.admin_response) { %>
                <div class="reports-replied-indicator">Replied</div>
              <% } %>
            </div>

            <div class="report-mobile-card-actions">
              <button
                type="button"
                class="reports-action-btn reports-action-btn-block"
                onclick='openReportModal(<%= JSON.stringify(r) %>)'
              >
                Review &amp; Reply
              </button>
            </div>
          </div>
        <% }) %>
      </div>

    <% } else { %>
      <!-- Clean Empty State -->
      <div class="reports-empty-state">
        <div class="reports-empty-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
          </svg>
        </div>
        <h3 class="reports-empty-title">No Reports Found</h3>
        <p class="reports-empty-desc">
          <% if (selectedStatus || selectedCategory || searchQuery) { %>
            There are no reports matching the selected filters.
          <% } else { %>
            All bhajan feedback tickets have been cleared! Great job keeping the bhajan bank pristine.
          <% } %>
        </p>
        <% if (selectedStatus || selectedCategory || searchQuery) { %>
          <a href="/admin/reports" class="reports-btn-submit" style="text-decoration:none; display:inline-flex; align-items:center; margin-top: 10px;">
            <span>Clear Filters</span>
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<!-- ========================================================== -->
<!-- MODAL: REVIEW & REPLY TICKET                               -->
<!-- ========================================================== -->
<div id="reviewModal" class="reports-modal-backdrop" style="display:none;" onclick="if(event.target === this) closeReportModal();">
  <div class="reports-modal-dialog">
    <!-- Modal Header -->
    <div class="reports-modal-header">
      <div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="reports-ticket-code" id="modalTicketCode">REP-0000</span>
          <span id="modalStatusBadge" class="rep-status-badge rep-badge-pending">Pending</span>
        </div>
        <h2 class="reports-modal-title" id="modalBhajanTitle">Bhajan Title</h2>
      </div>
      <button type="button" onclick="closeReportModal()" class="reports-modal-close" aria-label="Close modal">&times;</button>
    </div>

    <!-- Modal Body -->
    <div class="reports-modal-body">
      <!-- Issue Categories & Reporter Box -->
      <div class="reports-modal-info-box">
        <div class="reports-modal-info-row">
          <div>
            <strong>Reported By:</strong> 
            <span id="modalReporterName">Devotee</span> 
            (<span id="modalReporterContact">No contact</span>)
          </div>
          <div id="modalCreatedAt" style="color: var(--muted); font-size: 11.5px;">Date</div>
        </div>
        <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
          <strong style="font-size: 11.5px; color: var(--ink-soft);">Issue Types:</strong>
          <div id="modalCategoriesList" style="display: flex; gap: 4px; flex-wrap: wrap;"></div>
        </div>
      </div>

      <!-- Devotee Description -->
      <div style="margin-bottom: 16px;">
        <label class="reports-modal-label">Devotee's Description:</label>
        <div id="modalDescription" class="reports-modal-text-box"></div>
      </div>

      <!-- Suggested Correction (if provided) -->
      <div id="modalCorrectionBox" style="margin-bottom: 16px; display: none;">
        <label class="reports-modal-label" style="color: #15803d;">Suggested Correction / Lyrics:</label>
        <div id="modalSuggestedCorrection" class="reports-modal-suggestion-box"></div>
      </div>

      <div style="margin-bottom: 16px; text-align: right;">
        <a id="modalMasterLink" href="#" target="_blank" class="reports-bhajan-link" style="display: inline-flex; font-size: 12.5px;">
          <span>Open Live Bhajan Details</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>

      <hr class="reports-modal-hr">

      <!-- Admin Actions Form -->
      <form id="updateReportForm" onsubmit="submitReportUpdate(event)">
        <input type="hidden" id="modalReportId">

        <div class="reports-modal-status-row">
          <div>
            <label for="modalStatusSelect" class="reports-modal-label">Update Status *</label>
            <select id="modalStatusSelect" required class="reports-select" style="width: 100%;">
              <option value="pending">Needs Review (Pending)</option>
              <option value="under_review">In Progress (Under Review)</option>
              <option value="resolved">Resolved (Fixed in Database)</option>
              <option value="closed">Closed (No Action Needed)</option>
            </select>
          </div>
          <div style="display: flex; align-items: center;">
            <p style="font-size: 11.5px; color: var(--muted); margin: 0; line-height: 1.4;">
              Marking <strong>Resolved</strong> timestamps the ticket and updates the user&#39;s tracker status.
            </p>
          </div>
        </div>

        <!-- Admin Response to Devotee -->
        <div style="margin-bottom: 16px;">
          <label for="modalAdminResponse" class="reports-modal-label">
            Response to Devotee <span style="font-weight: 400; color: var(--muted);">(User will see this on their ticket tracker)</span>
          </label>
          <textarea
            id="modalAdminResponse"
            rows="3"
            placeholder="e.g. Sai Ram! Thank you for pointing this out. We have corrected the lyrics and updated the pitch in the master bank."
            class="reports-modal-textarea"
          ></textarea>
          <!-- Quick Reply Presets -->
          <div class="reports-preset-chips">
            <button type="button" class="reports-chip-btn" onclick="applyQuickReply('lyrics')">Lyrics Corrected</button>
            <button type="button" class="reports-chip-btn" onclick="applyQuickReply('scale')">Scale / Pitch Updated</button>
            <button type="button" class="reports-chip-btn" onclick="applyQuickReply('accurate')">Verified Accurate</button>
            <button type="button" class="reports-chip-btn" onclick="applyQuickReply('sheet')">Sheet Music Updated</button>
          </div>
        </div>

        <!-- Admin Internal Notes -->
        <div style="margin-bottom: 20px;">
          <label for="modalAdminNotes" class="reports-modal-label">
            Internal Admin Notes <span style="font-weight: 400; color: var(--muted);">(Only visible to admins)</span>
          </label>
          <input
            type="text"
            id="modalAdminNotes"
            placeholder="e.g. Cross-referenced with Sathya Sai Bhajan Avali audio book page 42"
            class="reports-search-input"
            style="width: 100%; height: 38px;"
          >
        </div>

        <div class="reports-modal-actions">
          <button type="button" onclick="closeReportModal()" class="reports-btn-clear">Cancel</button>
          <button type="submit" id="saveReportBtn" class="reports-btn-submit" style="min-width: 160px;">
            Save &amp; Notify User
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
/* ==========================================================================
   Admin Reports & Feedback Dashboard - Clean Devotional Styling
   ========================================================================== */
.admin-reports-view {
  max-width: 1320px;
  margin: 0 auto;
  padding: 18px 16px 40px 16px;
}

/* Page Header */
.admin-reports-header {
  margin-bottom: 22px;
}
.admin-reports-header-content {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}
.admin-reports-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--saffron-dk, #b26a1b);
  background: var(--surface-2, rgba(217, 138, 43, 0.1));
  border: 1px solid rgba(217, 138, 43, 0.25);
  padding: 3px 9px;
  border-radius: 999px;
  margin-bottom: 6px;
}
.admin-reports-title {
  font-family: "Cinzel", "Fraunces", Georgia, serif;
  font-size: 24px;
  font-weight: 800;
  color: var(--ink, #1f2937);
  margin: 0 0 6px 0;
  line-height: 1.2;
}
.admin-reports-subtitle {
  font-size: 13.5px;
  color: var(--muted, #64748b);
  margin: 0;
  max-width: 680px;
  line-height: 1.5;
}
.admin-reports-header-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

/* KPI Cards Grid */
.reports-kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 20px;
}
@media (max-width: 900px) {
  .reports-kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 480px) {
  .reports-kpi-grid {
    gap: 10px;
  }
}

.reports-kpi-card {
  position: relative;
  overflow: hidden;
  background: var(--surface, #ffffff);
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 12px;
  padding: 16px 18px;
  text-decoration: none;
  color: inherit;
  display: block;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}
.reports-kpi-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
  border-color: rgba(217, 138, 43, 0.4);
}
.reports-kpi-card.kpi-card-active {
  border-color: var(--saffron, #d98a2b);
  box-shadow: 0 0 0 2px rgba(217, 138, 43, 0.25), 0 4px 12px rgba(15, 23, 42, 0.08);
}
.kpi-card-stripe {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
}
.kpi-stripe-all { background: linear-gradient(90deg, #6366f1, #818cf8); }
.kpi-stripe-pending { background: linear-gradient(90deg, #d97706, #f59e0b); }
.kpi-stripe-progress { background: linear-gradient(90deg, #0284c7, #38bdf8); }
.kpi-stripe-resolved { background: linear-gradient(90deg, #16a34a, #22c55e); }

.kpi-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
