<div class="session-unified-page" style="padding: 24px 32px; background: var(--bg-app); min-height: 100vh;">

  <%
    const totalCount = admins.length;
    const superCount = admins.filter(a => ['SUPER_ADMIN', 'super_admin', 'superadmin'].includes(a.role)).length;
    const standardCount = totalCount - superCount;
    const activeCount = admins.filter(a => a.is_active).length;
    const disabledCount = totalCount - activeCount;
    const googleCount = admins.filter(a => a.google_sub).length;
  %>

  <!-- Featured Banner Header -->
  <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); border-radius: 14px; padding: 24px 28px; color: white; box-shadow: 0 10px 25px -5px rgba(67, 56, 202, 0.35); margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
      <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; color: #a5b4fc; margin-bottom: 6px;">
        Access Control &amp; Security
      </div>
      <h1 style="margin: 0 0 6px 0; font-size: 24px; font-weight: 800; color: #ffffff;">
        Admin Management
      </h1>
      <p style="margin: 0; font-size: 13px; color: #c7d2fe;">
        Manage authorized coordinators, super admins, login credentials, and singer profiles.
      </p>
    </div>

    <!-- Quick Navigation -->
    <div style="display: flex; gap: 10px; align-items: center;">
      <a href="/admin/admin-users/new" class="button primary" style="background: #ffffff; color: var(--primary); font-size: 13px; font-weight: 700; padding: 8px 16px; border-radius: 8px; text-decoration: none; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Create Admin
      </a>
      <a href="/admin" class="button outline" style="border-color: rgba(255,255,255,0.25); color: #ffffff; background: rgba(255,255,255,0.08); font-size: 13px; font-weight: 600; padding: 8px 14px; border-radius: 8px; text-decoration: none; display: flex; align-items: center; gap: 6px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Dashboard
      </a>
    </div>
  </div>

  <!-- KPI Overview Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <!-- Total Admins -->
    <div class="kpi-card" onclick="setAdminFilter('all')" style="--accent: #4f46e5; cursor: pointer;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Total Admins</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="kpi-value"><%= totalCount %></div>
      <div class="kpi-subtext">Registered administrators</div>
    </div>

    <!-- Super Admins -->
    <div class="kpi-card" onclick="setAdminFilter('super')" style="--accent: #f59e0b; cursor: pointer;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Super Admins</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      </div>
      <div class="kpi-value"><%= superCount %></div>
      <div class="kpi-subtext">Full system access</div>
    </div>

    <!-- Active Logins -->
    <div class="kpi-card" onclick="setAdminFilter('active')" style="--accent: #10b981; cursor: pointer;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Active Logins</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <div class="kpi-value"><%= activeCount %></div>
      <div class="kpi-subtext">Enabled accounts</div>
    </div>

    <!-- Google SSO -->
    <div class="kpi-card" onclick="setAdminFilter('google')" style="--accent: #0ea5e9; cursor: pointer;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span class="kpi-label">Google Linked</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </div>
      <div class="kpi-value"><%= googleCount %></div>
      <div class="kpi-subtext">Single sign-on enabled</div>
    </div>
  </div>

  <!-- Main Table Container -->
  <div style="background: #ffffff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm);">

    <!-- Header & Controls -->
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
      
      <!-- Inset Search Bar -->
      <div style="position: relative; flex: 1; max-width: 380px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="position: absolute; left: 12px; top: 12px;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input 
          type="text" 
          id="adminSearchInput" 
          placeholder="Search admin name, username, title, singer..." 
          oninput="filterAdmins()" 
          aria-label="Filter administrators"
          style="width: 100%; height: 38px; border: 1px solid var(--border); border-radius: 6px; font-size: 12.5px; padding: 8px 14px 8px 34px; background: #ffffff; color: var(--text-primary); outline: none;"
        />
      </div>

      <!-- Segmented Capsule Pills -->
      <div class="segmented-control" role="group" aria-label="Role & Status Filter">
        <button type="button" class="segmented-pill active" data-filter="all" onclick="setAdminFilter('all')">
          All (<%= totalCount %>)
        </button>
        <button type="button" class="segmented-pill" data-filter="super" onclick="setAdminFilter('super')">
          Super (<%= superCount %>)
        </button>
        <button type="button" class="segmented-pill" data-filter="standard" onclick="setAdminFilter('standard')">
          Standard (<%= standardCount %>)
        </button>
        <button type="button" class="segmented-pill" data-filter="active" onclick="setAdminFilter('active')">
          Active (<%= activeCount %>)
        </button>
        <% if (disabledCount > 0) { %>
        <button type="button" class="segmented-pill" data-filter="disabled" onclick="setAdminFilter('disabled')">
          Disabled (<%= disabledCount %>)
        </button>
        <% } %>
      </div>

      <span id="adminCountDisplay" style="font-size: 12px; font-weight: 600; color: var(--text-muted);">
        Showing <%= totalCount %> Administrators
      </span>
    </div>

    <!-- Table -->
    <div style="overflow-x: auto;">
      <table id="adminUsersTable" style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <thead>
          <tr style="background: #f8fafc; border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">
            <th style="padding: 11px 16px; text-align: center; width: 45px;">#</th>
            <th style="padding: 11px 16px; text-align: left; width: 30%;">Administrator</th>
            <th style="padding: 11px 16px; text-align: left; width: 16%;">Username</th>
            <th style="padding: 11px 16px; text-align: left; width: 14%;">Role</th>
            <th style="padding: 11px 16px; text-align: left; width: 15%;">Auth Mode</th>
            <th style="padding: 11px 16px; text-align: left; width: 11%;">Status</th>
            <th style="padding: 11px 16px; text-align: right; width: 14%;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (admins.length > 0) { %>
            <% admins.forEach((admin, idx) => { 
              const isSuper = ['SUPER_ADMIN', 'super_admin', 'superadmin'].includes(admin.role);
              const roleKey = isSuper ? 'super' : 'standard';
              const statusKey = admin.is_active ? 'active' : 'disabled';
            %>
            <tr 
              class="admin-table-row"
              data-role="<%= roleKey %>"
              data-status="<%= statusKey %>"
              data-google="<%= admin.google_sub ? 'google' : 'none' %>"
              data-search="<%= ((admin.display_name||'') + ' ' + (admin.username||'') + ' ' + (admin.title||'') + ' ' + (admin.singer ? admin.singer.name : '')).toLowerCase() %>"
              style="border-bottom: 1px solid var(--border-subtle); background: <%= idx % 2 === 1 ? '#fafbfc' : '#ffffff' %>;"
            >
              <!-- Index -->
              <td style="padding: 10px 16px; text-align: center; color: var(--text-muted); font-weight: 700; font-size: 11px;">
                <%= idx + 1 %>
              </td>

              <!-- Administrator Details -->
              <td style="padding: 10px 16px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div style="width: 32px; height: 32px; border-radius: 8px; background: <%= isSuper ? '#fef3c7; color: #92400e;' : '#e0e7ff; color: #4338ca;' %>; font-weight: 700; font-size: 13px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <%= admin.display_name ? admin.display_name.charAt(0).toUpperCase() : 'A' %>
                  </div>
                  <div>
                    <div style="font-weight: 700; font-size: 13px; color: var(--text-primary); display: flex; align-items: center; gap: 6px;">
                      <span><%= admin.display_name %></span>
                      <% if (admin.title) { %>
                        <span style="font-size: 10.5px; font-weight: 600; background: #f1f5f9; color: var(--text-secondary); padding: 1px 6px; border-radius: 4px;">
                          <%= admin.title %>
                        </span>
                      <% } %>
                    </div>
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                      <span>ID #<%= admin.id %></span>
                      <% if (admin.singer) { %>
                        <span style="color: #7c3aed; font-weight: 600; margin-left: 6px;">
                          Linked: <%= admin.singer.name %>
                        </span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </td>

              <!-- Username -->
              <td style="padding: 10px 16px;">
                <span style="font-family: monospace; font-size: 12px; font-weight: 600; background: #f8fafc; padding: 2px 6px; border: 1px solid var(--border); border-radius: 4px; color: var(--text-primary);">
                  <%= admin.username %>
                </span>
              </td>

              <!-- Role -->
              <td style="padding: 10px 16px;">
                <% if (isSuper) { %>
                  <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 9999px;">
                    Super Admin
                  </span>
                <% } else { %>
                  <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 9999px;">
                    Administrator
                  </span>
                <% } %>
              </td>

              <!-- Google SSO -->
              <td style="padding: 10px 16px;">
                <% if (admin.google_sub) { %>
                  <span style="font-size: 11px; font-weight: 600; color: #059669; display: inline-flex; align-items: center; gap: 4px;" title="<%= admin.google_email || 'Google SSO linked' %>">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    Linked
                  </span>
                <% } else { %>
                  <span style="font-size: 11px; color: var(--text-muted); display: inline-flex; align-items: center; gap: 4px;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Password
                  </span>
                <% } %>
              </td>

              <!-- Status -->
              <td style="padding: 10px 16px;">
                <% if (admin.is_active) { %>
                  <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #15803d; background: #f0fdf4; padding: 2px 8px; border-radius: 9999px; display: inline-flex; align-items: center; gap: 5px;">
                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #16a34a;"></span>
                    Active
                  </span>
                <% } else { %>
                  <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #b91c1c; background: #fef2f2; padding: 2px 8px; border-radius: 9999px; display: inline-flex; align-items: center; gap: 5px;">
                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #dc2626;"></span>
                    Disabled
                  </span>
                <% } %>
              </td>

              <!-- Actions -->
              <td style="padding: 10px 16px; text-align: right;">
                <div style="display: inline-flex; gap: 6px; justify-content: flex-end; align-items: center;">
                  <a href="/admin/admin-users/<%= admin.id %>/edit" class="button outline" style="padding: 5px 8px; font-size: 11px; text-decoration: none; border-radius: 6px; display: inline-flex; align-items: center;" title="Edit Administrator">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                  </a>
                  <a href="/admin/admin-users/<%= admin.id %>/reset-password" class="button outline" style="padding: 5px 8px; font-size: 11px; text-decoration: none; border-radius: 6px; display: inline-flex; align-items: center;" title="Reset Password">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  </a>
                  <form method="POST" action="/admin/admin-users/<%= admin.id %>/toggle-active" style="margin: 0; display: inline;">
                    <button type="submit" class="button outline" style="padding: 5px 8px; font-size: 11px; border-radius: 6px; display: inline-flex; align-items: center; cursor: pointer; color: <%= admin.is_active ? '#dc2626' : '#16a34a' %>; border-color: <%= admin.is_active ? '#fca5a5' : '#86efac' %>;" title="<%= admin.is_active ? 'Disable account' : 'Enable account' %>">
                      <% if (admin.is_active) { %>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                      <% } else { %>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                      <% } %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: 36px; color: var(--text-muted);">
                No administrator accounts registered yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="adminEmptyState" style="display: none; text-align: center; padding: 40px 20px;">
      <div style="width: 48px; height: 48px; margin: 0 auto 12px; background: #f1f5f9; color: var(--text-muted); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
      <h3 style="margin: 0 0 4px 0; font-size: 15px; font-weight: 700; color: var(--text-primary);">No administrators found</h3>
      <p style="margin: 0; font-size: 12.5px; color: var(--text-muted);">No records match your selected filter or query.</p>
    </div>
  </div>

</div>

<script>
let currentFilter = 'all';

function setAdminFilter(filterKey) {
  currentFilter = filterKey;
  document.querySelectorAll('.segmented-pill').forEach(btn => {
    btn.classList.toggle('active', btn.getAttribute('data-filter') === filterKey);
  });
  filterAdmins();
}

function filterAdmins() {
  const query = (document.getElementById('adminSearchInput')?.value || '').trim().toLowerCase();
  const rows = document.querySelectorAll('#adminUsersTable tbody tr.admin-table-row');
  let visibleCount = 0;

  rows.forEach(row => {
    const role = row.getAttribute('data-role');
    const status = row.getAttribute('data-status');
    const google = row.getAttribute('data-google');
    const haystack = row.getAttribute('data-search') || '';

    let matchesFilter = false;
    if (currentFilter === 'all') matchesFilter = true;
    else if (currentFilter === 'super') matchesFilter = (role === 'super');
    else if (currentFilter === 'standard') matchesFilter = (role === 'standard');
    else if (currentFilter === 'active') matchesFilter = (status === 'active');
    else if (currentFilter === 'disabled') matchesFilter = (status === 'disabled');
    else if (currentFilter === 'google') matchesFilter = (google === 'google');

    const matchesSearch = !query || haystack.includes(query);

    if (matchesFilter && matchesSearch) {
      row.style.display = '';
      visibleCount++;
    } else {
      row.style.display = 'none';
    }
  });

  const emptyState = document.getElementById('adminEmptyState');
  if (emptyState) {
    emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  const countDisplay = document.getElementById('adminCountDisplay');
  if (countDisplay) {
    countDisplay.textContent = `Showing ${visibleCount} Administrator${visibleCount === 1 ? '' : 's'}`;
  }
}
</script>
