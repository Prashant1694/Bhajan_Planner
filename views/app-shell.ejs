          <% if (activeTabKey === 'bank' && typeof initialFragmentHtml !== 'undefined' && initialFragmentHtml) { %>
            <%- initialFragmentHtml %>
          <% } %>
        </section>
        <section id="pane-singer" class="shell-pane <%= activeTabKey === 'singer' ? 'active-pane' : '' %>" aria-label="Mark Bhajan" aria-hidden="<%= activeTabKey === 'singer' ? 'false' : 'true' %>">
          <% if (activeTabKey === 'singer' && typeof initialFragmentHtml !== 'undefined' && initialFragmentHtml) { %>
            <%- initialFragmentHtml %>
          <% } %>
        </section>
        <section id="pane-plan" class="shell-pane <%= activeTabKey === 'plan' ? 'active-pane' : '' %>" aria-label="Live Session Plan" aria-hidden="<%= activeTabKey === 'plan' ? 'false' : 'true' %>">
          <% if (activeTabKey === 'plan' && typeof initialFragmentHtml !== 'undefined' && initialFragmentHtml) { %>
            <%- initialFragmentHtml %>
          <% } %>
        </section>
        <section id="pane-hub" class="shell-pane <%= activeTabKey === 'hub' ? 'active-pane' : '' %>" aria-label="Singer Hub" aria-hidden="<%= activeTabKey === 'hub' ? 'false' : 'true' %>">
          <% if (activeTabKey === 'hub' && typeof initialFragmentHtml !== 'undefined' && initialFragmentHtml) { %>
            <%- initialFragmentHtml %>
          <% } %>
        </section>

        <!-- Native Slide-Over Detail Sheet (Preserves underlying tab DOM & exact scrollTop!) -->
        <aside id="shellDetailSheet" class="shell-detail-sheet" aria-hidden="true" aria-label="Detail View">
          <header class="shell-detail-header" id="shellDetailHeader">
            <button type="button" class="shell-detail-back-btn" id="shellDetailBackBtn" aria-label="Go back">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              <span>Back</span>
            </button>
            <h2 class="shell-detail-title" id="shellDetailTitle">Details</h2>
            <div class="shell-detail-spacer"></div>
          </header>
          <div class="shell-detail-body" id="shellDetailBody"></div>
        </aside>
      </main>

      <!-- ═════════════════════════════════════════════════════════════ -->
