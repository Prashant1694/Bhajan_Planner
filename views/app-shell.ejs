          <% if (adminObj) { %>
            <a href="/admin" class="capsule-pill nav-tab" id="tab-btn-admin" data-tab="admin" data-no-shell="1" aria-label="Admin Portal">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="capsule-icon"><rect width="7" height="7" x="3" y="3"/><rect width="7" height="7" x="14" y="3"/><rect width="7" height="7" x="14" y="14"/><rect width="7" height="7" x="3" y="14"/></svg>
              <span class="capsule-label">Admin</span>
            </a>
          <% } %>
        </div>
      </nav>

    </div>
  </div>

