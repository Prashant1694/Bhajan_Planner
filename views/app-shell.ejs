      <nav class="mobile-bottom-capsule native-bottom-nav bp-blur" id="mobileBottomCapsule" aria-label="Mobile Navigation Capsule">
        <div class="capsule-track native-nav-inner" id="capsuleTrack">
          <a href="/" class="capsule-pill nav-tab <%= activeTabKey === 'home' ? 'active' : '' %>" id="tab-btn-home" data-tab="home" onclick="return handleNavClick('home', '/', event)" aria-label="Home">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="capsule-icon"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span class="capsule-label">Home</span>
          </a>

          <a href="/master-bank" class="capsule-pill nav-tab <%= activeTabKey === 'bank' ? 'active' : '' %>" id="tab-btn-bank" data-tab="bank" onclick="return handleNavClick('bank', '/master-bank', event)" aria-label="Songbook">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="capsule-icon"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            <span class="capsule-label">Songbook</span>
