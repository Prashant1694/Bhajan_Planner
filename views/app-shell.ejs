  <!-- Global Persistent Tanpura Shruti Drone (Never interrupted across tab switches) -->
  <%- include('partials/tanpura-widget') %>

  <!-- Unified Notification Panel & One-Time First-Visit Prompt -->
  <%- include('partials/notification-bell') %>

  <!-- What's New Modal -->
  <%- include('partials/whats-new-modal') %>

  <!-- Initial Shell Boot Configuration & Session Sync -->
  <script>
    window.__SHELL_BOOT__ = {
      initialTab: <%- JSON.stringify(activeTabKey) %>,
      initialRoute: <%- JSON.stringify(initRoute) %>,
      hasSinger: <%- Boolean(singerObj) %>,
      hasAdmin: <%- Boolean(adminObj) %>
    };
    try {
      <% if (singerObj) { %>
        localStorage.setItem('bp_singer_id', <%- JSON.stringify(String(singerObj.id)) %>);
        localStorage.setItem('bp_singer_name', <%- JSON.stringify(singerObj.name || '') %>);
        localStorage.setItem('bp_singer_gender', <%- JSON.stringify(singerObj.gender || '') %>);
        localStorage.setItem('bp_singer_login_time', String(Date.now()));
      <% } else { %>
        localStorage.removeItem('bp_singer_id');
        localStorage.removeItem('bp_singer_name');
        localStorage.removeItem('bp_singer_gender');
      <% } %>
      <% if (adminObj) { %>
        localStorage.setItem('bp_is_admin', 'true');
        localStorage.setItem('bp_admin_name', <%- JSON.stringify(adminObj.display_name || adminObj.displayName || adminObj.username || 'Admin') %>);
        localStorage.setItem('bp_admin_role', <%- JSON.stringify(adminObj.role || 'admin') %>);
      <% } else { %>
        localStorage.removeItem('bp_is_admin');
        localStorage.removeItem('bp_admin_name');
        localStorage.removeItem('bp_admin_role');
      <% } %>
    } catch (_) {}
  </script>

  <!-- Global Persistent Engines (v6.5) -->
  <script src="/js/haptics.js?v=6.5"></script>
  <script src="/js/tanpura.js?v=6.5"></script>
  <script src="/js/session-audio-player.js?v=6.5"></script>
  <script src="/js/script.js?v=6.5"></script>
  <script src="/js/pwa.js?v=6.5"></script>
  <script src="/js/notifications.js?v=6.5"></script>
  <script src="/js/app-shell-router.js?v=6.5"></script>
</body>

