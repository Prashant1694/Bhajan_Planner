<%
  const activeTabKey = (typeof initialTab !== 'undefined' && initialTab) ? initialTab : 'home';
  const initRoute = (typeof initialRoute !== 'undefined' && initialRoute) ? initialRoute : '/';
  const singerObj = (typeof currentSinger !== 'undefined' && currentSinger) ? currentSinger : null;
  const adminObj = (typeof currentAdmin !== 'undefined' && currentAdmin) ? currentAdmin : null;
%>
<!DOCTYPE html>
<html lang="en" class="shell-root">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Bhajan Planner | Sri Sathya Sai Seva Organisation' %></title>
  <meta name="description" content="Sri Sathya Sai Seva Organisations, Gandhinagar — Devotional Bhajan Management & Satsang Scheduling System">
  <meta name="theme-color" content="#FAF7F2">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">

  <link rel="icon" type="image/png" sizes="192x192" href="/images/icons/icon-192x192.png">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">

  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <script>window.csrfToken = "<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>";</script>

  <!-- Clean Native Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Core Shell & Component Stylesheets (v6.2) -->
  <link rel="stylesheet" href="/css/style.css?v=6.2">
  <link rel="stylesheet" href="/css/pwa.css?v=6.2">
  <link rel="stylesheet" href="/css/notifications.css?v=6.2">
  <link rel="stylesheet" href="/css/bulletin.css?v=6.2">
  <link rel="stylesheet" href="/css/tanpura.css?v=6.2">
  <link rel="stylesheet" href="/css/session-audio.css?v=6.2">
  <link rel="stylesheet" href="/css/app-shell.css?v=6.2">
  <% if (typeof initialPageCss !== 'undefined' && initialPageCss) { %>
    <link rel="stylesheet" href="/css/<%= initialPageCss %>?v=6.2">
  <% } else if (activeTabKey === 'home') { %>
    <link rel="stylesheet" href="/css/dashboard-glass.css?v=6.2">
  <% } %>

  <!-- Early Anti-FOUC Theme Initialization & Resilient Navigation Handlers -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('bp-theme');
        if (t === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.classList.add('dark');
          if (document.body) {
            document.body.setAttribute('data-theme', 'dark');
            document.body.classList.add('dark');
          }
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#12100E');
        } else if (t === 'light') {
          document.documentElement.removeAttribute('data-theme');
          document.documentElement.classList.remove('dark');
          if (document.body) {
            document.body.removeAttribute('data-theme');
            document.body.classList.remove('dark');
          }
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#FAF7F2');
        }
      } catch (e) {}
    })();

    window.applyTheme = function (isDark) {
      try {
        if (isDark) {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.classList.add('dark');
          if (document.body) {
            document.body.setAttribute('data-theme', 'dark');
            document.body.classList.add('dark');
          }
          localStorage.setItem('bp-theme', 'dark');
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#12100E');
        } else {
          document.documentElement.removeAttribute('data-theme');
          document.documentElement.classList.remove('dark');
          if (document.body) {
            document.body.removeAttribute('data-theme');
            document.body.classList.remove('dark');
          }
          localStorage.setItem('bp-theme', 'light');
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#FAF7F2');
        }
        var btns = document.querySelectorAll('.theme-toggle, #themeToggle, #shellThemeToggle, #topbarThemeToggle, #themeToggleBtn, .admin-theme-toggle-btn');
        btns.forEach(function (btn) {
          btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
          btn.setAttribute('data-tooltip', isDark ? 'Switch to Light' : 'Switch to Dark');
          btn.setAttribute('title', isDark ? 'Switch to Light' : 'Switch to Dark');
        });
        window.dispatchEvent(new CustomEvent('themechange', { detail: { isDark: isDark } }));
      } catch (e) {}
    };

    window.toggleTheme = function (e) {
      if (e) {
        if (e.preventDefault) e.preventDefault();
        if (e.stopPropagation) e.stopPropagation();
      }
      var now = Date.now();
      if (window._lastThemeToggle && (now - window._lastThemeToggle < 250)) return;
      window._lastThemeToggle = now;
      var stored = null;
      try { stored = localStorage.getItem('bp-theme'); } catch (_) {}
      var isDark = stored === 'dark' || (stored !== 'light' && (document.documentElement.getAttribute('data-theme') === 'dark' || document.documentElement.classList.contains('dark')));
      window.applyTheme(!isDark);
      if (window.haptics && typeof window.haptics.light === 'function') {
        window.haptics.light();
      }
      if (typeof triggerToast === 'function') {
        triggerToast(!isDark ? 'Switched to Dark Sanctum Theme' : 'Switched to Ivory Prasanthi Theme');
      }
    };

    // Delegated click handler on document for resilient theme toggle clicks
    document.addEventListener('click', function (e) {
      var themeBtn = e.target && e.target.closest ? e.target.closest('#shellThemeToggle, #topbarThemeToggle, .theme-toggle, .admin-theme-toggle-btn') : null;
      if (themeBtn) {
        window.toggleTheme(e);
      }
    });

    window.toggleShellSidebar = function () {
      var s = document.getElementById('shellSidebar');
      var o = document.getElementById('shellSidebarOverlay');
      if (s) s.classList.toggle('open');
      if (o) o.classList.toggle('open');
    };
    window.closeShellSidebar = function () {
      var s = document.getElementById('shellSidebar');
      var o = document.getElementById('shellSidebarOverlay');
      if (s) s.classList.remove('open');
      if (o) o.classList.remove('open');
    };
    window.handleNavClick = function (tab, url, evt) {
      if (evt && evt.preventDefault) evt.preventDefault();
      window.closeShellSidebar();
      if (window.AppShell && typeof window.AppShell.switchTab === "function") {
        window.AppShell.switchTab(tab, url);
        return false;
      }
      window.__pendingNavTab = tab;
      setTimeout(function () {
        if (!window.AppShell || typeof window.AppShell.switchTab !== "function") {
          window.location.href = url || '/';
        }
      }, 250);
      return false;
    };
    window.handleDeepLink = function (route, parentTab, evt) {
      if (evt && evt.preventDefault) evt.preventDefault();
      window.closeShellSidebar();
      if (window.AppShell && typeof window.AppShell.navigate === "function") {
        window.AppShell.navigate(route);
        return false;
      }
      window.__pendingNavRoute = { route: route, tab: parentTab };
      setTimeout(function () {
        if (!window.AppShell || typeof window.AppShell.navigate !== "function") {
          window.location.href = route;
        }
      }, 250);
      return false;
    };
  </script>
</head>

<body class="shell-body">

  <!-- Universal SSSO Print Letterhead -->
  <%- include('partials/universal-print-header') %>

  <div class="shell-app-layout" id="shellAppLayout">

    <!-- ═════════════════════════════════════════════════════════════ -->
    <!-- 1. DESKTOP PERSISTENT SIDEBAR & MOBILE NAVIGATION DRAWER      -->
    <!-- ═════════════════════════════════════════════════════════════ -->
    <aside class="shell-sidebar" id="shellSidebar" aria-label="Primary Navigation">
      <div class="shell-sidebar-brand">
        <a href="/" class="shell-sidebar-logo-link">
          <img src="/images/logo.png" alt="Sri Sathya Sai Emblem" width="38" height="38" class="shell-sidebar-emblem">
          <div class="shell-sidebar-brand-text">
            <span class="shell-sidebar-title">Bhajan Planner</span>
            <span class="shell-sidebar-sub">SSSO · GANDHINAGAR</span>
          </div>
        </a>
        <button type="button" class="shell-sidebar-close" aria-label="Close navigation menu" onclick="closeShellSidebar()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <nav class="shell-sidebar-nav">
        <div class="shell-nav-section-label">Primary Workspace</div>

        <a href="/" class="sidebar-nav-item <%= activeTabKey === 'home' ? 'active' : '' %>" id="side-tab-home" data-tab="home" onclick="return handleNavClick('home', '/', event)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Home Dashboard</span>
        </a>

        <a href="/master-bank" class="sidebar-nav-item <%= activeTabKey === 'bank' ? 'active' : '' %>" id="side-tab-bank" data-tab="bank" onclick="return handleNavClick('bank', '/master-bank', event)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <span>Master Songbook</span>
        </a>

        <a href="/submit-form" class="sidebar-nav-item <%= activeTabKey === 'singer' ? 'active' : '' %>" id="side-tab-singer" data-tab="singer" onclick="return handleNavClick('singer', '/submit-form', event)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
          <span>Mark Bhajan</span>
        </a>

        <a href="/plan-view" class="sidebar-nav-item <%= activeTabKey === 'plan' ? 'active' : '' %>" id="side-tab-plan" data-tab="plan" onclick="return handleNavClick('plan', '/plan-view', event)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>Live Session Plan</span>
        </a>

        <a href="/singer/hub" class="sidebar-nav-item <%= activeTabKey === 'hub' ? 'active' : '' %>" id="side-tab-hub" data-tab="hub" onclick="return handleNavClick('hub', '/singer/hub', event)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Singer Hub</span>
        </a>

        <div class="shell-nav-section-label">Samiti Resources</div>

        <a href="/database" class="sidebar-nav-item" data-route="/database" data-tab-parent="plan" onclick="return handleDeepLink('/database', 'plan', event)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
          <span>Session Archives</span>
        </a>

        <a href="/bulletins" class="sidebar-nav-item" data-route="/bulletins" data-tab-parent="home" onclick="return handleDeepLink('/bulletins', 'home', event)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          <span>Samiti Bulletins</span>
        </a>

        <% if (adminObj) { %>
          <a href="/admin/singers" class="sidebar-nav-item" data-no-shell="1">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Singers Directory</span>
          </a>
        <% } else { %>
          <a href="/singers" class="sidebar-nav-item" data-route="/singers" data-tab-parent="hub" onclick="return handleDeepLink('/singers', 'hub', event)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Singers Directory</span>
          </a>
        <% } %>

        <a href="/my-reports" class="sidebar-nav-item" data-route="/my-reports" data-tab-parent="home" onclick="return handleDeepLink('/my-reports', 'home', event)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
          <span>Reported Tickets</span>
        </a>

        <a href="/notification-settings" class="sidebar-nav-item" data-route="/notification-settings" data-tab-parent="home" onclick="return handleDeepLink('/notification-settings', 'home', event)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span>Notification Settings</span>
        </a>
      </nav>

      <div class="shell-sidebar-footer">
        <% if (adminObj) { %>
          <a href="/admin" class="shell-sidebar-admin-link" data-no-shell="1">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3"/><rect width="7" height="7" x="14" y="3"/><rect width="7" height="7" x="14" y="14"/><rect width="7" height="7" x="3" y="14"/></svg>
            <span>Open Admin Portal</span>
          </a>
        <% } else { %>
          <a href="/admin-login" class="shell-sidebar-coord-link" data-no-shell="1">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>Coordinator Login</span>
          </a>
        <% } %>
      </div>
    </aside>

    <div class="shell-sidebar-overlay" id="shellSidebarOverlay" onclick="closeShellSidebar()"></div>

    <!-- ═════════════════════════════════════════════════════════════ -->
    <!-- 2. MAIN COLUMN (HEADER + SINGLE-DOM VIEWPORT + BOTTOM NAV)    -->
    <!-- ═════════════════════════════════════════════════════════════ -->
    <div class="shell-main-column">

      <!-- Top Header Bar -->
      <header class="shell-top-header" id="shellTopHeader" role="banner">
        <div class="header-left">
          <button type="button" class="header-icon-btn shell-menu-btn" id="shellMenuBtn" aria-label="Open menu" onclick="toggleShellSidebar()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>

          <div class="header-brand-wrap" title="Go to Home Dashboard">
            <div class="header-logo-box">
              <img src="/images/logo.png" alt="Sri Sathya Sai Emblem" width="34" height="34">
            </div>
            <div class="header-titles-box">
              <h1 class="header-page-title" id="headerPageTitle">Bhajan Planner</h1>
              <span class="header-breadcrumb" id="headerBreadcrumb">SSSO · GANDHINAGAR</span>
            </div>
          </div>
        </div>

        <div class="header-right">
          <!-- Singer Identity Pill -->
          <button type="button"
            class="singer-profile-pill"
            id="shellSingerPill"
            title="Open My Singer Hub"
            style="<%= singerObj ? 'display:inline-flex;' : 'display:none;' %>">
            <span class="singer-avatar-dot" id="shellSingerPillInitial"><%= singerObj && singerObj.name ? singerObj.name.charAt(0).toUpperCase() : 'S' %></span>
            <span class="singer-pill-name" id="shellSingerPillName"><%= singerObj && singerObj.name ? singerObj.name.split(' ')[0] : 'Singer' %></span>
          </button>

          <% if (adminObj) { %>
            <a href="/admin" class="admin-profile-pill" data-no-shell="1" title="Logged in as <%= adminObj.displayName || adminObj.username %> — Open Admin Portal">
              <span class="admin-avatar-dot"><%= (adminObj.displayName || adminObj.username || "A").charAt(0).toUpperCase() %></span>
              <span class="admin-pill-name"><%= adminObj.displayName || adminObj.username %></span>
            </a>
          <% } %>

          <!-- Dark / Light Theme Toggle -->
          <button type="button" class="header-icon-btn" id="shellThemeToggle" aria-label="Toggle dark mode" title="Toggle theme" onclick="if(typeof window.toggleTheme==='function'){window.toggleTheme(event);}">
            <span class="icon-moon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </span>
            <span class="icon-sun" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            </span>
          </button>

          <!-- Notification Bell -->
          <button type="button" class="header-icon-btn" id="shellNotifBtn" aria-label="Notifications" title="Notifications">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
              <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
            </svg>
            <span class="notif-badge" id="shellNotifBadge" style="display:none"></span>
          </button>
        </div>
      </header>

      <!-- GPU-Composited Top Loading Progress Bar -->
      <div class="shell-load-bar" id="shellLoadBar" aria-hidden="true"></div>

      <!-- ═════════════════════════════════════════════════════════════ -->
      <!-- 3. SINGLE-DOM WORKSPACE (5 CACHED PANES + SLIDE-OVER SHEET)   -->
      <!-- ═════════════════════════════════════════════════════════════ -->
      <main class="shell-workspace-container" id="shellViewport">
        <section id="pane-home" class="shell-pane <%= activeTabKey === 'home' ? 'active-pane' : '' %>" aria-label="Home Dashboard" aria-hidden="<%= activeTabKey === 'home' ? 'false' : 'true' %>">
          <% if (activeTabKey === 'home' && typeof initialFragmentHtml !== 'undefined' && initialFragmentHtml) { %>
            <%- initialFragmentHtml %>
          <% } %>
        </section>
        <section id="pane-bank" class="shell-pane <%= activeTabKey === 'bank' ? 'active-pane' : '' %>" aria-label="Master Songbook" aria-hidden="<%= activeTabKey === 'bank' ? 'false' : 'true' %>">
          <% if (activeTabKey === 'bank' && typeof initialFragmentHtml !== 'undefined' && initialFragmentHtml) { %>
            <%- initialFragmentHtml %>
          <% } %>
        </section>
        <section id="pane-singer" class="shell-pane <%= activeTabKey === 'singer' ? 'active-pane' : '' %>" aria-label="Mark Bhajan" aria-hidden="<%= activeTabKey === 'singer' ? 'false' : 'true' %>">
          <% if (activeTabKey === 'singer' && typeof initialFragmentHtml !== 'undefined' && initialFragmentHtml) { %>
            <%- initialFragmentHtml %>
          <% } %>
        </section>
        <section id="pane-plan" class="shell-pane <%= activeTabKey === 'plan' ? 'active-pane' : '' %>" aria-label="Live Session Plan" aria-hidden="<%= activeTabKey === 'plan' ? 'false' : 'true' %>">
          <% if (activeTabKey === 'plan' && typeof initialFragmentHtml !== 'undefined' && initialFragmentHtml) { %>
            <%- initialFragmentHtml %>
          <% } %>
        </section>
        <section id="pane-hub" class="shell-pane <%= activeTabKey === 'hub' ? 'active-pane' : '' %>" aria-label="Singer Hub" aria-hidden="<%= activeTabKey === 'hub' ? 'false' : 'true' %>">
          <% if (activeTabKey === 'hub' && typeof initialFragmentHtml !== 'undefined' && initialFragmentHtml) { %>
            <%- initialFragmentHtml %>
          <% } %>
        </section>

        <!-- Native Slide-Over Detail Sheet (Preserves underlying tab DOM & exact scrollTop!) -->
        <aside id="shellDetailSheet" class="shell-detail-sheet" aria-hidden="true" aria-label="Detail View">
          <header class="shell-detail-header" id="shellDetailHeader">
            <button type="button" class="shell-detail-back-btn" id="shellDetailBackBtn" aria-label="Go back">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              <span>Back</span>
            </button>
            <h2 class="shell-detail-title" id="shellDetailTitle">Details</h2>
            <div class="shell-detail-spacer"></div>
          </header>
          <div class="shell-detail-body" id="shellDetailBody"></div>
        </aside>
      </main>

      <!-- ═════════════════════════════════════════════════════════════ -->
      <!-- 4. NATIVE MOBILE BOTTOM NAVIGATION BAR                        -->
      <!-- ═════════════════════════════════════════════════════════════ -->
      <nav class="native-bottom-nav" id="nativeBottomNav" aria-label="Bottom Navigation">
        <div class="native-nav-inner">
          <a href="/" class="nav-tab <%= activeTabKey === 'home' ? 'active' : '' %>" id="tab-btn-home" data-tab="home" onclick="return handleNavClick('home', '/', event)" aria-label="Home Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <span class="tab-label">Home</span>
          </a>

          <a href="/master-bank" class="nav-tab <%= activeTabKey === 'bank' ? 'active' : '' %>" id="tab-btn-bank" data-tab="bank" onclick="return handleNavClick('bank', '/master-bank', event)" aria-label="Songbook Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <span class="tab-label">Songbook</span>
          </a>

          <a href="/submit-form" class="nav-tab <%= activeTabKey === 'singer' ? 'active' : '' %>" id="tab-btn-singer" data-tab="singer" onclick="return handleNavClick('singer', '/submit-form', event)" aria-label="Mark Bhajan Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
            </div>
            <span class="tab-label">Mark</span>
          </a>

          <a href="/plan-view" class="nav-tab <%= activeTabKey === 'plan' ? 'active' : '' %>" id="tab-btn-plan" data-tab="plan" onclick="return handleNavClick('plan', '/plan-view', event)" aria-label="Live Plan Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <span class="tab-label">Plan</span>
          </a>

          <a href="/singer/hub" class="nav-tab <%= activeTabKey === 'hub' ? 'active' : '' %>" id="tab-btn-hub" data-tab="hub" onclick="return handleNavClick('hub', '/singer/hub', event)" aria-label="My Hub Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <span class="tab-label">Hub</span>
          </a>

          <% if (adminObj) { %>
            <a href="/admin" class="nav-tab" id="tab-btn-admin" data-tab="admin" data-no-shell="1" aria-label="Admin Portal Tab">
              <div class="tab-icon-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3"/><rect width="7" height="7" x="14" y="3"/><rect width="7" height="7" x="14" y="14"/><rect width="7" height="7" x="3" y="14"/></svg>
              </div>
              <span class="tab-label">Admin</span>
            </a>
          <% } %>
        </div>
      </nav>

    </div>
  </div>

  <!-- Universal SSSO Print Footer -->
  <%- include('partials/universal-print-footer') %>

  <!-- PWA Install Banner -->
  <div class="pwa-install-overlay" id="pwaInstallOverlay">
    <div class="pwa-install-banner">
      <div class="pwa-banner-header">
        <img src="/images/icons/icon-192x192.png" alt="Bhajan Planner" width="48" height="48" class="pwa-banner-icon">
        <div class="pwa-banner-info">
          <h3>Install Bhajan Planner</h3>
          <p class="pwa-banner-size">App size <span class="size-dot"></span> <span id="pwaBannerSize">calculating…</span></p>
        </div>
        <button class="pwa-banner-close" id="pwaBannerClose" aria-label="Close">✕</button>
      </div>
      <div class="pwa-banner-divider"></div>
      <div class="pwa-banner-benefits">
        <div class="pwa-benefit"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span> Faster loading</div>
        <div class="pwa-benefit"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg></span> Works like a native app</div>
        <div class="pwa-benefit"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span> Home screen access</div>
      </div>
      <div class="pwa-banner-actions">
        <button class="pwa-btn-install" id="pwaBtnInstall">Install App</button>
        <button class="pwa-btn-dismiss" id="pwaBtnDismiss">Not Now</button>
      </div>
      <div class="pwa-manual-instructions" id="pwaManualInstructions" style="display:none">
        <p id="pwaManualInstructionsText">Tap your browser menu (<strong>&vellip;</strong>) and select <strong>"Add to Home screen"</strong> or <strong>"Install app"</strong>.</p>
      </div>
      <div class="pwa-ios-instructions" id="pwaIosInstructions" style="display:none">
        <p>Tap <strong>Share</strong> <span class="pwa-ios-share-icon">&uarr;</span> then <strong>"Add to Home Screen"</strong></p>
      </div>
    </div>
  </div>

  <!-- Global Persistent Tanpura Shruti Drone (Never interrupted across tab switches) -->
  <%- include('partials/tanpura-widget') %>

  <!-- Unified Notification Panel & One-Time First-Visit Prompt -->
  <%- include('partials/notification-bell') %>

  <!-- What's New Modal -->
  <%- include('partials/whats-new-modal') %>

  <!-- Initial Shell Boot Configuration & Session Sync -->
  <script>
    window.__SHELL_BOOT__ = {
      initialTab: <%- JSON.stringify(activeTabKey) %>,
      initialRoute: <%- JSON.stringify(initRoute) %>,
      hasSinger: <%- Boolean(singerObj) %>,
      hasAdmin: <%- Boolean(adminObj) %>
    };
    try {
      <% if (singerObj) { %>
        localStorage.setItem('bp_singer_id', <%- JSON.stringify(String(singerObj.id)) %>);
        localStorage.setItem('bp_singer_name', <%- JSON.stringify(singerObj.name || '') %>);
        localStorage.setItem('bp_singer_gender', <%- JSON.stringify(singerObj.gender || '') %>);
        localStorage.setItem('bp_singer_login_time', String(Date.now()));
      <% } else { %>
        localStorage.removeItem('bp_singer_id');
        localStorage.removeItem('bp_singer_name');
        localStorage.removeItem('bp_singer_gender');
      <% } %>
      <% if (adminObj) { %>
        localStorage.setItem('bp_is_admin', 'true');
        localStorage.setItem('bp_admin_name', <%- JSON.stringify(adminObj.display_name || adminObj.displayName || adminObj.username || 'Admin') %>);
        localStorage.setItem('bp_admin_role', <%- JSON.stringify(adminObj.role || 'admin') %>);
      <% } else { %>
        localStorage.removeItem('bp_is_admin');
        localStorage.removeItem('bp_admin_name');
        localStorage.removeItem('bp_admin_role');
      <% } %>
    } catch (_) {}
  </script>

  <!-- Global Persistent Engines (v6.2) -->
  <script src="/js/haptics.js?v=6.2"></script>
  <script src="/js/tanpura.js?v=6.2"></script>
  <script src="/js/session-audio-player.js?v=6.2"></script>
  <script src="/js/script.js?v=6.2"></script>
  <script src="/js/pwa.js?v=6.2"></script>
  <script src="/js/notifications.js?v=6.2"></script>
  <script src="/js/app-shell-router.js?v=6.2"></script>
</body>

