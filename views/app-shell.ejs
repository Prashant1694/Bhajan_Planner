<!DOCTYPE html>
<html lang="en" class="shell-root">

<head>
  <meta charset="UTF-8">
  <meta name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>
    <%= typeof pageTitle !=='undefined' ? pageTitle : 'Bhajan Planner | Sri Sathya Sai Seva Organisation' %>
  </title>
  <meta name="description"
    content="Sri Sathya Sai Seva Organisations, Gandhinagar - Devotional Bhajan Management & Satsang Scheduling System">
  <meta name="theme-color" content="#4f46e5">
  <link rel="icon" type="image/png" href="/images/icons/icon-192x192.png">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <script>window.csrfToken = "<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>";</script>

  <!-- Frame Guard: Prevent app-shell from ever nesting inside an iframe -->
  <script>
    if (window.self !== window.top) {
      window.location.replace('/?_embed=1');
    }
  </script>

  <!-- Clean Native Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800&family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    rel="stylesheet">

  <!-- Core CSS -->
  <link rel="stylesheet" href="/css/style.css?v=5.0">
  <link rel="stylesheet" href="/css/notifications.css?v=5.0">
  <link rel="stylesheet" href="/css/app-shell.css?v=5.0">

  <!-- Native Micro-Haptics Engine -->
  <script src="/js/haptics.js"></script>

  <!-- Theme Preference Initialization -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('bp-theme');
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) { }
    })();
  </script>
</head>

<body class="shell-body">

  <div class="shell-app-layout" id="shellAppLayout">

    <!-- ═════════════════════════════════════════════════════════ -->
    <div class="shell-main-column">

      <!-- Top Header Bar (Height: 64px) -->
      <header class="shell-top-header" id="shellTopHeader" role="banner">
        <div class="header-left">
          <!-- Mobile Drawer Toggle -->
          <div class="header-brand-wrap" style="display:flex; align-items:center; gap:12px; cursor:pointer;" onclick="switchTab('home')" title="Go to Dashboard">
            <div class="header-logo-box" style="width:36px; height:36px; min-width:36px; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
              <img src="/images/logo.png" alt="Sri Sathya Sai Emblem" style="width:36px; height:36px; object-fit:contain; display:block;">
            </div>

          <!-- Breadcrumb & Page Title (Fixed branding) -->
          <div class="header-titles-box">
            <h1 class="header-page-title" id="headerPageTitle">Bhajan Planner</h1>
            <span class="header-breadcrumb" id="headerBreadcrumb">SSSO - GANDHINAGAR</span>
          </div>
          </div>
        </div>

        <!-- Right Side Global Actions -->
        <div class="header-right">

          <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
            <div class="admin-profile-pill" title="Logged in as <%= currentAdmin.displayName || currentAdmin.username %>">
              <span class="admin-avatar-dot"><%= (currentAdmin.displayName || currentAdmin.username || "A").charAt(0).toUpperCase() %></span>
              <span class="admin-pill-name"><%= currentAdmin.displayName || currentAdmin.username %></span>
            </div>
          <% } %>

          <!-- Dark / Light Theme Toggle (Clean SVG Sun/Moon) -->
          <button type="button" class="header-icon-btn" id="shellThemeToggle" aria-label="Toggle theme" title="Toggle dark mode">
            <span class="icon-moon" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </span>
            <span class="icon-sun" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
            </span>
          </button>

          <!-- Notification Bell -->
          <button type="button" class="header-icon-btn" id="shellNotifBtn" aria-label="Notifications" title="Notifications">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
              <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
            </svg>
            <span class="notif-badge" id="shellNotifBadge" style="display:none"></span>
          </button>
        </div>
      </header>

      <!-- Hardware GPU Top Loading Progress Bar -->
      <div class="shell-load-bar" id="shellLoadBar"></div>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!-- 3. WORKSPACE CONTAINER (Viewport Stack with Zero-Lag)     -->
      <!-- ═════════════════════════════════════════════════════════ -->
      <main class="shell-workspace-container" id="shellViewport">
        <% 
          const activeTabKey = typeof initialTab !== 'undefined' && initialTab ? initialTab : 'home'; 
          const initRoute = (typeof initialRoute !== 'undefined' && initialRoute) ? initialRoute : '';

          function getTabSrc(tabKey, defaultPath) {
            if (activeTabKey === tabKey && initRoute) {
              return initRoute.includes('?') ? (initRoute + '&_embed=1') : (initRoute + '?_embed=1');
            }
            return defaultPath + '?_embed=1';
          }
        %>
        <!-- Tab 0: Home -->
        <iframe id="frame-home"
          class="shell-frame <%= activeTabKey === 'home' ? 'active-frame' : '' %>"
          <% if (activeTabKey === 'home') { %>src="<%= getTabSrc('home', '/') %>"<% } else { %>data-src="/?_embed=1"<% } %>
          title="Home Dashboard" scrolling="yes" allow="autoplay" <%= activeTabKey === 'home' ? 'aria-hidden="false"' : 'aria-hidden="true" tabindex="-1"' %>></iframe>

        <!-- Tab 1: Singer Zone (Mark Bhajan) -->
        <iframe id="frame-singer"
          class="shell-frame <%= activeTabKey === 'singer' ? 'active-frame' : '' %>"
          <% if (activeTabKey === 'singer') { %>src="<%= getTabSrc('singer', '/submit-form') %>"<% } else { %>data-src="/submit-form?_embed=1"<% } %>
          title="Singer Zone" scrolling="yes" allow="autoplay" <%= activeTabKey === 'singer' ? 'aria-hidden="false"' : 'aria-hidden="true" tabindex="-1"' %>></iframe>

        <!-- Tab 2: Songbook (Master Bank) -->
        <iframe id="frame-bank"
          class="shell-frame <%= activeTabKey === 'bank' ? 'active-frame' : '' %>"
          <% if (activeTabKey === 'bank') { %>src="<%= getTabSrc('bank', '/master-bank') %>"<% } else { %>data-src="/master-bank?_embed=1"<% } %>
          title="Master Songbook" scrolling="yes" allow="autoplay" <%= activeTabKey === 'bank' ? 'aria-hidden="false"' : 'aria-hidden="true" tabindex="-1"' %>></iframe>

        <!-- Tab 3: Live Plan -->
        <iframe id="frame-plan"
          class="shell-frame <%= activeTabKey === 'plan' ? 'active-frame' : '' %>"
          <% if (activeTabKey === 'plan') { %>src="<%= getTabSrc('plan', '/plan-view') %>"<% } else { %>data-src="/plan-view?_embed=1"<% } %>
          title="Live Session Plan" scrolling="yes" allow="autoplay" <%= activeTabKey === 'plan' ? 'aria-hidden="false"' : 'aria-hidden="true" tabindex="-1"' %>></iframe>

        <!-- Tab 4: My Hub -->
        <iframe id="frame-hub"
          class="shell-frame <%= activeTabKey === 'hub' ? 'active-frame' : '' %>"
          <% if (activeTabKey === 'hub') { %>src="<%= getTabSrc('hub', '/my-hub') %>"<% } else { %>data-src="/my-hub?_embed=1"<% } %>
          title="Singer Hub" scrolling="yes" allow="autoplay" <%= activeTabKey === 'hub' ? 'aria-hidden="false"' : 'aria-hidden="true" tabindex="-1"' %>></iframe>

        <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
          <!-- Tab 5: Admin Portal -->
          <iframe id="frame-admin"
            class="shell-frame <%= activeTabKey === 'admin' ? 'active-frame' : '' %>"
            <% if (activeTabKey === 'admin') { %>src="<%= getTabSrc('admin', '/admin') %>"<% } else { %>data-src="/admin?_embed=1"<% } %>
            title="Admin Portal" scrolling="yes" allow="autoplay" <%= activeTabKey === 'admin' ? 'aria-hidden="false"' : 'aria-hidden="true" tabindex="-1"' %>></iframe>
        <% } %>
      </main>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!-- 4. NATIVE MOBILE BOTTOM NAVIGATION BAR (Phones only)      -->
      <!-- ═════════════════════════════════════════════════════════ -->
      <nav class="native-bottom-nav" id="nativeBottomNav" aria-label="Bottom Navigation">
        <div class="native-nav-inner">
          <!-- 1. Home -->
          <button type="button"
            class="nav-tab <%= (typeof initialTab === 'undefined' || initialTab === 'home' || !initialTab) ? 'active' : '' %>"
            id="tab-btn-home" data-tab="home" onclick="switchTab('home')" aria-label="Home Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <span class="tab-label">Home</span>
          </button>

          <!-- 2. Songbook -->
          <button type="button"
            class="nav-tab <%= (typeof initialTab !== 'undefined' && initialTab === 'bank') ? 'active' : '' %>"
            id="tab-btn-bank" data-tab="bank" onclick="switchTab('bank')" aria-label="Songbook Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
            </div>
            <span class="tab-label">Songbook</span>
          </button>

          <!-- 3. Mark Bhajan -->
          <button type="button"
            class="nav-tab <%= (typeof initialTab !== 'undefined' && initialTab === 'singer') ? 'active' : '' %>"
            id="tab-btn-singer" data-tab="singer" onclick="switchTab('singer')" aria-label="Mark Bhajan Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <line x1="12" x2="12" y1="19" y2="22"></line>
              </svg>
            </div>
            <span class="tab-label">Mark</span>
          </button>

          <!-- 4. Live Plan -->
          <button type="button"
            class="nav-tab <%= (typeof initialTab !== 'undefined' && initialTab === 'plan') ? 'active' : '' %>"
            id="tab-btn-plan" data-tab="plan" onclick="switchTab('plan')" aria-label="Live Plan Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <span class="tab-label">Plan</span>
          </button>

          <!-- 5. My Hub -->
          <button type="button"
            class="nav-tab <%= (typeof initialTab !== 'undefined' && initialTab === 'hub') ? 'active' : '' %>"
            id="tab-btn-hub" data-tab="hub" onclick="switchTab('hub')" aria-label="My Hub Tab">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <span class="tab-label">Hub</span>
          </button>

          <!-- 6. Admin Portal (when active/logged in) -->
          <button type="button"
            class="nav-tab <%= (typeof initialTab !== 'undefined' && initialTab === 'admin') ? 'active' : '' %>"
            id="tab-btn-admin" data-tab="admin" onclick="switchTab('admin')" aria-label="Admin Portal Tab"
            style="<%= (typeof currentAdmin !== 'undefined' && currentAdmin) ? '' : 'display: none;' %>">
            <div class="tab-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="7" height="7" x="3" y="3"></rect>
                <rect width="7" height="7" x="14" y="3"></rect>
                <rect width="7" height="7" x="14" y="14"></rect>
                <rect width="7" height="7" x="3" y="14"></rect>
              </svg>
            </div>
            <span class="tab-label">Admin</span>
          </button>
        </div>
      </nav>

    </div>
  </div>

  <!-- Notification Center Panel & Overlay (Zero Emoji) -->
  <div class="notif-panel" id="notifPanel">
    <div class="notif-panel-header">
      <div class="notif-panel-title-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
        </svg>
        <h3>Notifications</h3>
      </div>
      <div class="notif-panel-actions">
        <button class="notif-mark-all" id="notifMarkAllRead" title="Mark all as read">Mark All Read</button>
        <button class="notif-close-btn" id="notifCloseBtn" aria-label="Close notifications">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    <div class="notif-panel-body" id="notifPanelBody">
      <div class="notif-loading">Loading notifications...</div>
    </div>
  </div>
  <div class="notif-overlay" id="notifOverlay" onclick="closeNotifPanel()"></div>

  <!-- Session to LocalStorage Auto-Sync -->
  <script>
    try {
      <% if (typeof currentSinger !== 'undefined' && currentSinger) { %>
        localStorage.setItem('bp_singer_id', <%= JSON.stringify(currentSinger.id) %>);
        localStorage.setItem('bp_singer_name', <%= JSON.stringify(currentSinger.name) %>);
        localStorage.setItem('bp_singer_gender', <%= JSON.stringify(currentSinger.gender || '') %>);
        localStorage.setItem('bp_singer_login_time', Date.now());
      <% } %>
      <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
        localStorage.setItem('bp_is_admin', 'true');
        localStorage.setItem('bp_admin_name', <%= JSON.stringify(currentAdmin.display_name || currentAdmin.displayName || currentAdmin.username) %>);
        localStorage.setItem('bp_admin_role', <%= JSON.stringify(currentAdmin.role || 'admin') %>);
      <% } else { %>
        localStorage.removeItem('bp_is_admin');
        localStorage.removeItem('bp_admin_name');
        localStorage.removeItem('bp_admin_role');
      <% } %>
    } catch (_) { }
  </script>

  <!-- PWA Script -->
  <script src="/js/pwa.js"></script>

  <!-- Shell Controller Script: Ultra Fast, Zero-Lag, Instant Tab Switching -->
  <script>
    (function () {
      const TAB_KEYS = ['home', 'singer', 'bank', 'plan', 'hub', 'admin'];
      const TAB_ROUTES = {
        home: '/',
        singer: '/submit-form',
        bank: '/master-bank',
        plan: '/plan-view',
        hub: '/my-hub',
        admin: '/admin'
      };

      function mapPathToTab(p) {
        if (!p) return 'home';
        var lower = p.toLowerCase();
        if (lower.startsWith('/submit-form')) return 'singer';
        if (lower.startsWith('/master-bank') || lower.startsWith('/bhajan/')) return 'bank';
        if (lower.startsWith('/plan-view')) return 'plan';
        if (lower.startsWith('/my-hub') || lower.startsWith('/singer/')) return 'hub';
        if (lower.startsWith('/admin')) return 'admin';
        return 'home';
      }

      let currentTab = '<%= typeof initialTab !== "undefined" && initialTab ? initialTab : "home" %>';
      if (!TAB_KEYS.includes(currentTab)) currentTab = 'home';

      function updateHeaderTitles() {
        const titleEl = document.getElementById('headerPageTitle');
        const subEl = document.getElementById('headerBreadcrumb');
        if (titleEl) titleEl.textContent = 'Bhajan Planner';
        if (subEl) subEl.textContent = 'SSSO - GANDHINAGAR';
      }
      updateHeaderTitles();

      // Frame navigation callback from child iframes
      window.onFrameNavigated = function (cleanUrl, pathname) {
        if (!cleanUrl) return;
        try { sessionStorage.setItem('bp_current_path', cleanUrl); } catch (_) {}

        if (window.history && window.history.replaceState) {
          window.history.replaceState({ path: cleanUrl, tab: currentTab }, '', cleanUrl);
        }

        var expectedTab = mapPathToTab(pathname || cleanUrl);
        if (expectedTab && expectedTab !== currentTab && TAB_KEYS.includes(expectedTab)) {
          currentTab = expectedTab;
          syncActiveNavStyles(expectedTab);
          updateHeaderTitles(expectedTab);
        }
      };

      // Progress bar controller (Hardware accelerated, never locks UI)
      let progressTimer = null;
      function startLoadProgress() {
        clearTimeout(progressTimer);
        const bar = document.getElementById('shellLoadBar');
        if (bar) {
          bar.classList.remove('is-done');
          bar.classList.add('is-loading');
        }
        // Safety timeout to auto dismiss in case of slow assets
        progressTimer = setTimeout(finishLoadProgress, 1200);
      }

      function finishLoadProgress() {
        clearTimeout(progressTimer);
        const bar = document.getElementById('shellLoadBar');
        if (bar) {
          bar.classList.remove('is-loading');
          bar.classList.add('is-done');
          setTimeout(function () {
            bar.classList.remove('is-done');
          }, 250);
        }
      }

      function syncActiveNavStyles(tabKey) {
        // Bottom nav buttons
        document.querySelectorAll('.nav-tab').forEach(function (btn) {
          btn.classList.toggle('active', btn.getAttribute('data-tab') === tabKey);
        });
        // Sidebar nav buttons
        document.querySelectorAll('.sidebar-nav-item').forEach(function (btn) {
          btn.classList.remove('active');
        });
        const activeSide = document.getElementById('side-tab-' + tabKey);
        if (activeSide) activeSide.classList.add('active');
      }

      // 0ms Zero-Lag Tab Switching Function
      function switchTab(tabKey, targetUrl, skipHistory) {
        if (tabKey === 'admin') { window.location.href = '/admin'; return; }
        if (!TAB_KEYS.includes(tabKey)) return;
        const previousTab = currentTab;
        currentTab = tabKey;
        try { sessionStorage.setItem('bp_active_tab', tabKey); } catch (_) {}

        if (window.haptics && typeof window.haptics.light === 'function') {
          window.haptics.light();
        }

        syncActiveNavStyles(tabKey);
        updateHeaderTitles(tabKey);

        TAB_KEYS.forEach(function (k) {
          const frame = document.getElementById('frame-' + k);
          if (!frame) return;

          if (k === tabKey) {
            frame.classList.add('active-frame');
            frame.setAttribute('aria-hidden', 'false');
            frame.removeAttribute('tabindex');

            // If frame has not yet been loaded, load it on demand now
            const pendingSrc = frame.getAttribute('data-src');
            if (pendingSrc && !frame.getAttribute('src')) {
              startLoadProgress();
              frame.setAttribute('src', pendingSrc);
              frame.removeAttribute('data-src');
              frame.addEventListener('load', function () {
                finishLoadProgress();
              }, { once: true });
            } else if (!frame.getAttribute('src')) {
              startLoadProgress();
              frame.src = TAB_ROUTES[tabKey] + '?_embed=1';
              frame.addEventListener('load', function () {
                finishLoadProgress();
              }, { once: true });
            } else {
              // Frame was already loaded in memory: 0ms switch without network touch!
              finishLoadProgress();
            }

            // If a specific target route was requested (e.g. from session click)
            if (targetUrl) {
              const currentSrc = frame.getAttribute('src') || '';
              const sep = targetUrl.includes('?') ? '&' : '?';
              const fullEmbedUrl = targetUrl.includes('_embed') ? targetUrl : (targetUrl + sep + '_embed=1');
              if (currentSrc !== fullEmbedUrl) {
                startLoadProgress();
                frame.src = fullEmbedUrl;
              }
            }
          } else {
            frame.classList.remove('active-frame');
            frame.setAttribute('aria-hidden', 'true');
            frame.setAttribute('tabindex', '-1');
          }
        });

        // Sync browser address bar smoothly
        const browserPath = (targetUrl && !targetUrl.includes('_embed')) ? targetUrl : TAB_ROUTES[tabKey];
        try { sessionStorage.setItem('bp_current_path', browserPath); } catch (_) {}

        if (!skipHistory && window.history && window.history.pushState) {
          if (window.location.pathname + window.location.search !== browserPath) {
            window.history.pushState({ tab: tabKey, path: browserPath }, '', browserPath);
          }
        } else if (window.history && window.history.replaceState) {
          window.history.replaceState({ tab: tabKey, path: browserPath }, '', browserPath);
        }
      }

      window.switchTab = switchTab;

      // Handle navigation from sidebar items
      window.handleNavClick = function (tabKey) {
        closeShellSidebar();
        switchTab(tabKey);
      };

      // Handle deep links from sidebar (e.g. /bulletins, /my-reports, /admin/reports)
      window.handleDeepLink = function (routePath, tabKey) {
        closeShellSidebar();
        switchTab(tabKey, routePath);
      };

      // Responsive Mobile Sidebar Drawer Toggle
      window.toggleShellSidebar = function () {
        const sidebar = document.getElementById('shellSidebar');
        const overlay = document.getElementById('shellSidebarOverlay');
        if (!sidebar || !overlay) return;
        const isOpen = sidebar.classList.contains('open');
        if (isOpen) {
          window.closeShellSidebar();
        } else {
          sidebar.classList.add('open');
          overlay.classList.add('open');
          if (window.haptics && typeof window.haptics.light === 'function') window.haptics.light();
        }
      };

      window.closeShellSidebar = function () {
        const sidebar = document.getElementById('shellSidebar');
        const overlay = document.getElementById('shellSidebarOverlay');
        if (sidebar) sidebar.classList.remove('open');
        if (overlay) overlay.classList.remove('open');
      };

      // Browser popstate handler (Hardware & Browser Back Button)
      window.addEventListener('popstate', function (e) {
        const activeFrame = document.getElementById('frame-' + currentTab);
        // If navigating within the active frame, allow child to manage history
        if (activeFrame && activeFrame.contentWindow && activeFrame.contentWindow.history.length > 1) {
          try {
            // Keep current tab active
            return;
          } catch (_) {}
        }

        const path = window.location.pathname;
        const routeToTab = {
          '/': 'home',
          '/submit-form': 'singer',
          '/master-bank': 'bank',
          '/plan-view': 'plan',
          '/my-hub': 'hub',
          '/admin': 'admin'
        };
        const targetTab = (e.state && e.state.tab) || routeToTab[path] || mapPathToTab(path);
        switchTab(targetTab, null, true);
      });

      // Child iframes postMessage listener
      window.addEventListener('message', function (e) {
        if (!e.data) return;
        if (e.data.type === 'bp_navigated' && e.data.path) {
          window.onFrameNavigated(e.data.path, e.data.path.split('?')[0]);
        }
      });

      // Theme Toggle Controller
      const themeBtn = document.getElementById('shellThemeToggle');
      function syncThemeToFrames(theme) {
        document.querySelectorAll('.shell-frame').forEach(function (f) {
          try {
            if (f.contentDocument && f.contentDocument.documentElement) {
              if (theme === 'dark') {
                f.contentDocument.documentElement.setAttribute('data-theme', 'dark');
              } else {
                f.contentDocument.documentElement.removeAttribute('data-theme');
              }
            }
          } catch (e) { }
        });
      }

      if (themeBtn) {
        themeBtn.addEventListener('click', function (e) {
          e.preventDefault();
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          const next = isDark ? 'light' : 'dark';
          if (next === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            try { localStorage.setItem('bp-theme', 'dark'); } catch (_) { }
          } else {
            document.documentElement.removeAttribute('data-theme');
            try { localStorage.setItem('bp-theme', 'light'); } catch (_) { }
          }
          syncThemeToFrames(next);
        });
      }

      // Propagate theme when frames load
      document.querySelectorAll('.shell-frame').forEach(function (f) {
        f.addEventListener('load', function () {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          syncThemeToFrames(isDark ? 'dark' : 'light');
        });
      });

      // Check admin status from localStorage if currentAdmin wasn't present at render time
      try {
        const isAdminLoggedIn = <%= (typeof currentAdmin !== 'undefined' && Boolean(currentAdmin)) ? 'true' : 'false' %> || (localStorage.getItem('bp_is_admin') === 'true');
        if (isAdminLoggedIn) {
          const adminTabBtn = document.getElementById('tab-btn-admin');
          if (adminTabBtn) adminTabBtn.style.display = '';
        }
      } catch (_) {}

      // ── Notification Center Panel ──
      const notifBtn = document.getElementById('shellNotifBtn');
      const notifPanel = document.getElementById('notifPanel');
      const notifOverlay = document.getElementById('notifOverlay');
      const notifCloseBtn = document.getElementById('notifCloseBtn');
      const notifMarkAllReadBtn = document.getElementById('notifMarkAllRead');
      const notifBadge = document.getElementById('shellNotifBadge');

      function getDeviceId() {
        let id = localStorage.getItem('bp_device_id');
        if (!id) {
          id = 'dev_' + (typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2));
          try { localStorage.setItem('bp_device_id', id); } catch (_) { }
        }
        return id;
      }

      function autoMarkAllRead() {
        const devId = getDeviceId();
        if (notifBadge) {
          notifBadge.style.display = 'none';
          notifBadge.textContent = '';
          notifBadge.classList.remove('has-unread');
        }
        document.querySelectorAll('#notifPanelBody .notif-item.unread').forEach(function (el) {
          el.classList.remove('unread');
        });
        const csrf = window.csrfToken || (document.querySelector('meta[name="csrf-token"]') ? document.querySelector('meta[name="csrf-token"]').getAttribute('content') : '');
        fetch('/api/notifications/mark-all-read', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrf
          },
          body: JSON.stringify({ device_id: devId })
        }).then(function () {
          checkBadge();
        }).catch(function () {});
      }

      window.openNotifPanel = function () {
        if (notifPanel) notifPanel.classList.add('open');
        if (notifOverlay) notifOverlay.classList.add('show');
        loadNotifs();
        autoMarkAllRead();
      };

      window.closeNotifPanel = function () {
        if (notifPanel) notifPanel.classList.remove('open');
        if (notifOverlay) notifOverlay.classList.remove('show');
        autoMarkAllRead();
      };

      window.handleShellNotifClick = function (link) {
        closeNotifPanel();
        if (!link || link === '#') return;
        if (link.startsWith('/plan-view')) {
          switchTab('plan', link);
        } else if (link.startsWith('/my-hub')) {
          switchTab('hub', link);
        } else if (link.startsWith('/master-bank')) {
          switchTab('bank', link);
        } else if (link.startsWith('/submit-form')) {
          switchTab('singer', link);
        } else {
          window.location.href = link;
        }
      };

      if (notifBtn) {
        notifBtn.addEventListener('click', function (e) {
          e.preventDefault();
          if (notifPanel && notifPanel.classList.contains('open')) {
            closeNotifPanel();
          } else {
            openNotifPanel();
          }
        });
      }

      if (notifCloseBtn) notifCloseBtn.addEventListener('click', closeNotifPanel);

      function loadNotifs() {
        const body = document.getElementById('notifPanelBody');
        if (!body) return;
        body.innerHTML = '<div class="notif-loading">Loading notifications...</div>';
        const devId = getDeviceId();
        fetch('/api/notifications?device_id=' + encodeURIComponent(devId))
          .then(function (r) { return r.json(); })
          .then(function (data) {
            const items = data.notifications || [];
            if (items.length === 0) {
              body.innerHTML = '<div class="notif-empty"><p>No new notifications.<br>You are all caught up!</p></div>';
              return;
            }
            body.innerHTML = items.map(function (n) {
              const isRead = n.isRead || n.is_read;
              const title = n.title || 'Notification';
              const text = n.body || n.message || '';
              const link = n.link || '';
              let iconSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>';
              if (n.type === 'session_audio_published') {
                iconSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';
              } else if (n.type === 'deadline_reminder') {
                iconSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
              } else if (n.type === 'schedule_published') {
                iconSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>';
              }
              return (
                '<div class="notif-item ' + (isRead ? '' : 'unread') + '"' +
                (link ? ' data-link="' + escapeHtml(link) + '" style="cursor:pointer;" onclick="handleShellNotifClick(this.getAttribute(\'data-link\'))"' : '') + '>' +
                '<div class="notif-item-icon" style="flex-shrink:0; width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:rgba(217,119,6,0.12); color:#d97706; margin-right:10px;">' + iconSvg + '</div>' +
                '<div class="notif-item-content" style="flex:1; min-width:0;">' +
                '<div class="notif-item-title">' + escapeHtml(title) + '</div>' +
                '<div class="notif-item-body">' + escapeHtml(text) + '</div>' +
                '</div>' +
                '</div>'
              );
            }).join('');

            // Automatically clear unread markers from newly rendered items when panel is active
            setTimeout(function () {
              document.querySelectorAll('#notifPanelBody .notif-item.unread').forEach(function (el) {
                el.classList.remove('unread');
              });
              if (notifBadge) {
                notifBadge.style.display = 'none';
                notifBadge.textContent = '';
                notifBadge.classList.remove('has-unread');
              }
            }, 50);
          })
          .catch(function () {
            body.innerHTML = '<div class="notif-loading">Failed to load notifications</div>';
          });
      }

      function escapeHtml(str) {
        if (!str) return '';
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
      }

      if (notifMarkAllReadBtn) {
        notifMarkAllReadBtn.addEventListener('click', autoMarkAllRead);
      }

      // Check badge count
      function checkBadge() {
        if (notifPanel && notifPanel.classList.contains('open')) {
          if (notifBadge) notifBadge.style.display = 'none';
          return;
        }
        const devId = getDeviceId();
        fetch('/api/notifications/unread-count?device_id=' + encodeURIComponent(devId))
          .then(function (r) { return r.json(); })
          .then(function (d) {
            const count = d.count || 0;
            if (notifBadge) {
              if (count > 0 && !(notifPanel && notifPanel.classList.contains('open'))) {
                notifBadge.textContent = count > 99 ? '99+' : count;
                notifBadge.style.display = 'flex';
                notifBadge.classList.add('has-unread');
              } else {
                notifBadge.style.display = 'none';
                notifBadge.textContent = '';
                notifBadge.classList.remove('has-unread');
              }
            }
          })
          .catch(function () {});
      }
      checkBadge();
      setInterval(checkBadge, 60000);
    })();
  </script>

</body>

</html>