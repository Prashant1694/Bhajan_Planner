  <!-- Early Anti-FOUC Theme Initialization & Resilient Navigation Handlers -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('bp-theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var isDark = t === 'dark' || (t !== 'light' && prefersDark);
        if (isDark) {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.classList.add('dark');
          if (document.body) {
            document.body.setAttribute('data-theme', 'dark');
            document.body.classList.add('dark');
          }
          var ms = document.querySelectorAll('meta[name="theme-color"]');
          ms.forEach(function (m) { m.setAttribute('content', '#12100E'); });
        } else {
          document.documentElement.removeAttribute('data-theme');
          document.documentElement.classList.remove('dark');
          if (document.body) {
            document.body.removeAttribute('data-theme');
            document.body.classList.remove('dark');
          }
          var ms = document.querySelectorAll('meta[name="theme-color"]');
          ms.forEach(function (m) { m.setAttribute('content', '#FAF7F2'); });
        }
      } catch (e) {}
    })();

    window.applyTheme = function (isDark) {
      try {
        if (isDark) {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.classList.add('dark');
          if (document.body) {
            document.body.setAttribute('data-theme', 'dark');
            document.body.classList.add('dark');
          }
          localStorage.setItem('bp-theme', 'dark');
          var ms = document.querySelectorAll('meta[name="theme-color"]');
          ms.forEach(function (m) { m.setAttribute('content', '#12100E'); });
        } else {
          document.documentElement.removeAttribute('data-theme');
          document.documentElement.classList.remove('dark');
          if (document.body) {
            document.body.removeAttribute('data-theme');
            document.body.classList.remove('dark');
          }
          localStorage.setItem('bp-theme', 'light');
          var ms = document.querySelectorAll('meta[name="theme-color"]');
          ms.forEach(function (m) { m.setAttribute('content', '#FAF7F2'); });
        }
        var btns = document.querySelectorAll('.theme-toggle, #themeToggle, #shellThemeToggle, #topbarThemeToggle, #themeToggleBtn, .admin-theme-toggle-btn');
        btns.forEach(function (btn) {
          btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
          btn.setAttribute('data-tooltip', isDark ? 'Switch to Light' : 'Switch to Dark');
          btn.setAttribute('title', isDark ? 'Switch to Light' : 'Switch to Dark');
        });
        window.dispatchEvent(new CustomEvent('themechange', { detail: { isDark: isDark } }));
      } catch (e) {}
    };

    window.toggleTheme = function (e) {
      if (e) {
        if (e.preventDefault) e.preventDefault();
        if (e.stopPropagation) e.stopPropagation();
      }
      var now = Date.now();
      if (window._lastThemeToggle && (now - window._lastThemeToggle < 250)) return;
      window._lastThemeToggle = now;
      var stored = null;
      try { stored = localStorage.getItem('bp-theme'); } catch (_) {}
      var isDark = stored === 'dark' || (stored !== 'light' && (document.documentElement.getAttribute('data-theme') === 'dark' || document.documentElement.classList.contains('dark')));
      window.applyTheme(!isDark);
      if (window.haptics && typeof window.haptics.light === 'function') {
        window.haptics.light();
      }
      if (typeof triggerToast === 'function') {
        triggerToast(!isDark ? 'Switched to Dark Sanctum Theme' : 'Switched to Ivory Prasanthi Theme');
      }
    };

    // Delegated click handler on document for resilient theme toggle clicks
    document.addEventListener('click', function (e) {
      var themeBtn = e.target && e.target.closest ? e.target.closest('#shellThemeToggle, #topbarThemeToggle, .theme-toggle, .admin-theme-toggle-btn') : null;
      if (themeBtn) {
        window.toggleTheme(e);
      }
    });

    window.toggleShellSidebar = function () {
      var s = document.getElementById('shellSidebar');
      var o = document.getElementById('shellSidebarOverlay');
      if (s) s.classList.toggle('open');
      if (o) o.classList.toggle('open');
    };
    window.closeShellSidebar = function () {
      var s = document.getElementById('shellSidebar');
      var o = document.getElementById('shellSidebarOverlay');
      if (s) s.classList.remove('open');
      if (o) o.classList.remove('open');
    };
    window.handleNavClick = function (tab, url, evt) {
      if (evt && evt.preventDefault) evt.preventDefault();
      window.closeShellSidebar();
      var links = document.querySelectorAll(".desktop-nav .nav-link, #desktopNav .nav-link");
      links.forEach(function (el) {
        var isMatch = el.getAttribute("data-tab") === tab && !el.getAttribute("data-route");
        el.classList.toggle("active", isMatch);
        el.setAttribute("aria-current", isMatch ? "page" : "false");
      });
      if (window.AppShell && typeof window.AppShell.switchTab === "function") {
        window.AppShell.switchTab(tab, url);
        return false;
      }
      window.__pendingNavTab = tab;
      setTimeout(function () {
        if (!window.AppShell || typeof window.AppShell.switchTab !== "function") {
          window.location.href = url || '/';
        }
      }, 250);
      return false;
    };
    window.handleDeepLink = function (route, parentTab, evt) {
      if (evt && evt.preventDefault) evt.preventDefault();
      window.closeShellSidebar();
      var links = document.querySelectorAll(".desktop-nav .nav-link, #desktopNav .nav-link");
      links.forEach(function (el) {
        var r = el.getAttribute("data-route");
        var isMatch = Boolean(r && (route === r || route.startsWith(r + "/")));
        el.classList.toggle("active", isMatch);
        el.setAttribute("aria-current", isMatch ? "page" : "false");
      });
      if (window.AppShell && typeof window.AppShell.navigate === "function") {
        window.AppShell.navigate(route);
        return false;
      }
      window.__pendingNavRoute = { route: route, tab: parentTab };
      setTimeout(function () {
        if (!window.AppShell || typeof window.AppShell.navigate !== "function") {
          window.location.href = route;
        }
      }, 250);
      return false;
    };
  </script>
</head>

