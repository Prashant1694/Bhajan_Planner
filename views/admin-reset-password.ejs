<div class="admin-form-wrapper">
  <div class="admin-page-header">
    <div>
      <h1>Reset Password</h1>
      <p>Set a new password for <%= admin.display_name %>.</p>
    </div>
    <a href="/admin/admin-users" class="back-btn">← Back</a>
  </div>

  <% if (error) { %>
    <div class="admin-error"><%= error %></div>
  <% } %>

  <div class="admin-form-card">
    <div class="admin-card-body">
      <form method="POST" action="/admin/admin-users/<%= admin.id %>/reset-password">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="field full">
          <label for="resetAdminPassword">New Password</label>
          <input id="resetAdminPassword" type="password" name="password" required>
        </div>
        <div class="admin-actions">
          <a href="/admin/admin-users" class="secondary-btn">Cancel</a>
          <button type="submit" class="primary-btn">Reset Password</button>
        </div>
      </form>
    </div>
  </div>
</div>