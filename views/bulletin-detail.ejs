<div class="prasanthi-border"></div>
<div class="bulletin-detail-container">
  <a href="<%= (typeof _embed !== 'undefined' && _embed) ? '/bulletins?_embed=1' : '/bulletins' %>" class="bulletin-back-link" onclick="handleBulletinBack(event, '/bulletins')">&larr; Back to Updates</a>

  <div class="bulletin-detail-card">
    <div class="bulletin-detail-meta">
      <% const catInfo = CATEGORY_INFO[bulletin.category] || CATEGORY_INFO.announcement; const isNew = bulletin.published_at
        && (Date.now() - new Date(bulletin.published_at).getTime()) < 5 * 24 * 60 * 60 * 1000; %>
        <span class="bulletin-category-badge" style="background:<%= catInfo.color %>">
          <%= catInfo.label %>
        </span>
        <% if (isNew) { %><span class="bulletin-new-badge">NEW</span><% } %>
        <% if (bulletin.is_pinned) { %><span class="bulletin-pin-badge">Pinned</span><% } %>
    </div>

    <h1>
      <%= bulletin.title %>
    </h1>

    <div class="bulletin-card-date" style="margin-bottom: 20px;">
      <% if (bulletin.published_at) { %>
        Published <%= new Date(bulletin.published_at).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric',
          month: 'long', year: 'numeric' }) %>
      <% } %>
    </div>

    <div class="bulletin-detail-content">
      <%- formatContent(bulletin.content) %>
    </div>
  </div>

  <div style="text-align: center; margin-top: 24px;">
    <a href="<%= (typeof _embed !== 'undefined' && _embed) ? '/?_embed=1' : '/' %>" class="bulletin-back-link" onclick="handleHomeDirect(event)">Back to Home</a>
  </div>
</div>

<script>
  function handleBulletinBack(event, fallbackUrl) {
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    if (window.triggerHaptic) window.triggerHaptic('light');

    const inIframe = (window.self !== window.top);
    const target = fallbackUrl || '/bulletins';
    const targetEmbed = target.includes('_embed') ? target : (target + (target.includes('?') ? '&' : '?') + '_embed=1');

    if (inIframe) {
      if (window.history && window.history.length > 1) {
        window.history.back();
        setTimeout(function() {
          if (window.location.pathname.startsWith('/bulletins/')) {
            window.location.href = targetEmbed;
          }
        }, 300);
        return;
      }
      window.location.href = targetEmbed;
      return;
    }

    if (window.history && window.history.length > 1) {
      window.history.back();
      setTimeout(function() {
        if (window.location.pathname.startsWith('/bulletins/')) {
          window.location.href = target;
        }
      }, 300);
    } else {
      window.location.href = target;
    }
  }

  function handleHomeDirect(event) {
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    if (window.triggerHaptic) window.triggerHaptic('light');

    const inIframe = (window.self !== window.top);
    if (inIframe) {
      window.location.href = '/?_embed=1';
    } else {
      window.location.href = '/';
    }
  }
</script>