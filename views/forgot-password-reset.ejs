<div class="container">

<h2
style="text-align:center;color:var(--primary);">

Set New Password

</h2>

<% if(error){ %>

<div class="error">

<%= error %>

</div>

<% } %>

<form
method="POST"
action="/forgot-password/reset">

<div class="form-group">

<label>

New Password

</label>

<input
type="password"
name="password"
required>

</div>

<div class="form-group">

<label>

Confirm Password

</label>

<input
type="password"
name="confirmPassword"
required>

</div>

<button
class="submit-btn">

Update Password

</button>

</form>

</div>
