<div class="container" style="max-width: 760px; margin: 24px auto; padding: 0 16px;">
  <div class="edit-nav-bar" style="margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between;">
    <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: center;">
      <a href="/admin/date/<%= s.session_date %>" class="btn-table-action">&larr; Back to Session</a>
      <a href="/admin" class="btn-table-action">Admin Dashboard</a>
    </div>
    <span class="deity-pill"><%= s.deity %></span>
  </div>

  <div class="admin-card" style="padding: 24px;">
    <div style="margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border-soft);">
      <h1 style="margin: 0 0 6px 0; font-family: var(--font-display, Georgia, serif); font-size: 22px; color: var(--ink);">
        Edit Bhajan Submission
      </h1>
      <p style="margin: 0; font-size: 13px; color: var(--ink-soft);">
        Modify singer assignment, deity, musical pitch, speed, or bhajan details for session <%= s.session_date %>.
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="adm-alert-error" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/admin/edit/<%= s.id %>" class="admin-edit-form">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

      <div class="adm-form-grid-2">
        <div class="form-group">
          <label for="editSessionDate">Session Date <span aria-hidden="true" style="color:var(--crimson,#e11d48);">*</span></label>
          <input id="editSessionDate" type="date" name="session_date" value="<%= s.session_date %>" required class="filter-input" />
        </div>

        <div class="form-group">
          <label for="editDeity">Deity <span aria-hidden="true" style="color:var(--crimson,#e11d48);">*</span></label>
          <input id="editDeity" type="text" name="deity" value="<%= s.deity %>" required class="filter-input" placeholder="e.g. Ganesha, Krishna" />
        </div>
      </div>

      <div class="adm-form-grid-2">
        <div class="form-group">
          <label for="editSingerName">Lead Singer Name <span aria-hidden="true" style="color:var(--crimson,#e11d48);">*</span></label>
          <input id="editSingerName" type="text" name="singer_name" value="<%= s.singer_name %>" required class="filter-input" />
        </div>

        <div class="form-group">
          <label for="editPartnerName">Accompanying Partner</label>
          <input id="editPartnerName" type="text" name="partner_name" value="<%= s.partner_name || '' %>" class="filter-input" placeholder="Optional partner" />
        </div>
      </div>

      <div class="form-group">
        <label for="editTitle">Bhajan Title <span aria-hidden="true" style="color:var(--crimson,#e11d48);">*</span></label>
        <input id="editTitle" type="text" name="title" value="<%= s.title %>" required class="filter-input" />
      </div>

      <div class="adm-form-grid-3">
        <div class="form-group">
          <label for="editScale">Singing Pitch / Scale</label>
          <input id="editScale" type="text" name="scale" value="<%= s.scale || '' %>" class="filter-input" placeholder="e.g. 2, 5, 1.5" />
        </div>

        <div class="form-group">
          <label for="editSpeed">Speed / Tempo <span aria-hidden="true" style="color:var(--crimson,#e11d48);">*</span></label>
          <select id="editSpeed" name="speed" required class="filter-input">
            <% const curSpeed = String(s.speed || 'medium').toLowerCase(); %>
            <option value="slow" <%= curSpeed === 'slow' ? 'selected' : '' %>>Slow</option>
            <option value="medium slow" <%= curSpeed === 'medium slow' ? 'selected' : '' %>>Medium Slow</option>
            <option value="medium" <%= curSpeed === 'medium' ? 'selected' : '' %>>Medium</option>
            <option value="medium fast" <%= curSpeed === 'medium fast' ? 'selected' : '' %>>Medium Fast</option>
            <option value="fast" <%= curSpeed === 'fast' ? 'selected' : '' %>>Fast</option>
          </select>
        </div>

        <div class="form-group">
          <label for="editRaga">Raag</label>
          <input id="editRaga" type="text" name="raga" value="<%= s.raga || '' %>" placeholder="e.g. Yaman Kalyani" class="filter-input" />
        </div>
      </div>

      <div class="adm-form-actions">
        <a href="/admin/date/<%= s.session_date %>" class="button secondary">Cancel</a>
        <button type="submit" class="button button-confirm">Save Changes</button>
      </div>
    </form>
  </div>
</div>
