<%
  function getDeityIcon(deity) {
    return '';
  }
%>

<link rel="stylesheet" href="/css/session-audio.css?v=6.1">
<style>
  .archive-session-audio-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(217, 119, 6, 0.1);
    color: #b45309;
    border: 1px solid rgba(217, 119, 6, 0.28);
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
    line-height: 1.3;
    white-space: nowrap;
  }
  .archive-session-audio-btn:hover {
    background: #d97706;
    color: #ffffff;
    border-color: #d97706;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(217, 119, 6, 0.25);
  }
  [data-theme="dark"] .archive-session-audio-btn {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border-color: rgba(245, 158, 11, 0.3);
  }
  [data-theme="dark"] .archive-session-audio-btn:hover {
    background: #d97706;
    color: #ffffff;
  }
</style>

<div class="archives-container container container-xl">
  <!-- Top Hero Banner -->
  <div class="archives-hero-banner no-print">
    <div class="archives-top-bar">
      <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
        <a href="<%= currentAdmin ? '/admin' : '/' %>" class="button secondary" data-haptic="light" style="padding: 7px 14px; font-size: 13px; border-radius: 10px; display: inline-flex; align-items: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <%= currentAdmin ? 'Dashboard' : 'Home' %>
        </a>
        <a href="/plan-view" class="button secondary" data-haptic="light" style="padding: 7px 14px; font-size: 13px; border-radius: 10px; display: inline-flex; align-items: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Live Plan
        </a>
        <a href="/master-bank" class="button secondary" data-haptic="light" style="padding: 7px 14px; font-size: 13px; border-radius: 10px; display: inline-flex; align-items: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          Master Bank
        </a>
      </div>
      <button type="button" class="button secondary" onclick="window.print()" title="Print Session Archives"
        data-haptic="medium"
        style="cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 7px 16px; font-size: 13px; border-radius: 10px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        <span>Print Archives</span>
      </button>
    </div>

    <h1 class="archives-title">Bhajan Archives</h1>
    <p class="archives-subtitle">
      Explore Gandhinagar bhajan session records, singer sequences, deities, and musical catalogs across past sessions.
    </p>

    <div class="archives-stats-strip">
      <span class="archives-stat-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span><strong><%= sessions.length %></strong> Sessions Cataloged</span>
      </span>
      <span class="archives-stat-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        <span><strong><%= totalBhajans || '0' %></strong> Bhajans Recorded</span>
      </span>
      <span class="archives-stat-pill" style="background: rgba(125, 47, 69, 0.08); color: var(--maroon); border-color: rgba(125, 47, 69, 0.2);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        <span>Live Search</span>
      </span>
    </div>
  </div>

  <% if (sessions.length === 0) { %>
    <div class="archive-no-match-card">
      <div class="archive-no-match-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </div>
      <div class="archive-no-match-title">No Session Archives Found</div>
      <p class="archive-no-match-desc">There are no published or past bhajan session records available right now.</p>
      <a href="<%= currentAdmin ? '/admin' : '/' %>" class="button primary" style="border-radius: 12px; padding: 10px 22px;">
        Return to Home
      </a>
    </div>
  <% } else { %>

    <!-- Search & Filter Card -->
    <div class="archives-filter-card no-print">
      <div class="archives-filter-grid">
        <!-- Text Search -->
        <div class="archive-search-box">
          <span class="archive-search-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </span>
          <input 
            type="search" 
            id="archiveSearchInput" 
            class="archive-search-input" 
            placeholder="Search by song title or devotee name..." 
            value="<%= initialSearch || '' %>" 
            autocomplete="off"
            aria-label="Search archived songs and singers"
          />
        </div>

        <!-- Date Filter -->
        <div>
          <input 
            type="date" 
            id="historyDateFilter" 
            class="archive-date-input" 
            value="<%= initialDate || '' %>"
            title="Filter by specific session date"
            aria-label="Filter by date"
          />
        </div>

        <!-- Clear Button -->
        <div>
          <button 
            type="button" 
            id="archiveClearBtn" 
            class="button secondary" 
            data-haptic="pop"
            style="padding: 10px 16px; border-radius: 12px; font-weight: 600; font-size: 13px; display: inline-flex; align-items: center; gap: 4px;"
            title="Reset search and filters">
            <span>Reset</span>
          </button>
        </div>
      </div>

      <!-- Live Search Results Meta -->
      <div class="archive-results-info" id="archiveResultsInfo">
        <span id="archiveResultsText">
          Showing <strong><%= Math.min(sessions.length, 12) %></strong> of <strong><%= sessions.length %></strong> sessions
        </span>
        <span id="archiveActiveFilterTag" style="display: none; background: rgba(217, 138, 43, 0.12); padding: 2px 8px; border-radius: 6px; font-size: 11.5px; font-weight: 600; color: var(--saffron-dk);">
          Filter active
        </span>
      </div>
    </div>

    <!-- Empty Search State -->
    <div id="archiveNoMatch" class="archive-no-match-card" style="display: none;">
      <div class="archive-no-match-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
      <div class="archive-no-match-title">No Matching Bhajan Archives</div>
      <p class="archive-no-match-desc">
        We couldn't find any session or song matching your search criteria. Try a different singer name, deity, or song title.
      </p>
      <button type="button" id="archiveResetEmptyBtn" class="button secondary" data-haptic="pop" style="border-radius: 12px; padding: 9px 20px;">
        Clear All Filters
      </button>
    </div>

    <!-- Initial Rendered Sessions (First 12) -->
    <div id="archiveSessionsList">
      <% const initialSessions = sessions.slice(0, 12); %>
      <% initialSessions.forEach((session, sIdx) => { %>
        <section class="archive-session-card history-session" data-date="<%= session.date %>">
          <div class="archive-session-header">
            <div class="archive-session-date-wrap">
              <h3 class="archive-session-title">
                <span><%= session.heading %></span>
              </h3>
              <span class="archive-session-badge">
                <%= session.bhajans.length %> bhajan<%= session.bhajans.length === 1 ? '' : 's' %>
              </span>
            </div>

            <div class="no-print" style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
              <% if (session.sessionAudio && session.sessionAudio.audio_url) { %>
                <button type="button" class="archive-session-audio-btn" 
                        data-start="0"
                        data-title="<%= (session.sessionAudio.title || 'Session Recording').replace(/"/g, '&quot;') %>"
                        data-singer="<%= (session.heading || '').replace(/"/g, '&quot;') %>"
                        data-url="<%= (session.sessionAudio.audio_url || '').replace(/"/g, '&quot;') %>"
                        onclick="window.playSessionAudioBtn(this)" 
                        title="Listen to full session audio recording" 
                        data-haptic="light">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                  <span>Listen Recording</span>
                </button>
              <% } %>
              <a href="/plan-view?session_date=<%= session.date %>" class="archive-session-link" title="Open in Live Plan view" data-haptic="light">
                <span>View Plan</span>
              </a>
            </div>
          </div>

          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th style="width: 48px; text-align: center;">#</th>
                  <th>Singer</th>
                  <th>Deity</th>
                  <th>Bhajan Title</th>
                  <th style="width: 100px;">Speed</th>
                  <th style="width: 90px;">Scale</th>
                </tr>
              </thead>
              <tbody>
                <% session.bhajans.forEach((s, i) => { %>
                  <tr class="archive-bhajan-row" 
                      data-title="<%= (s.title || '').toLowerCase() %>" 
                      data-singer="<%= (s.singer_name || '').toLowerCase() %>" 
                      data-deity="<%= (s.deity || '').toLowerCase() %>">
                    <td style="text-align: center; font-weight: 700; color: var(--muted);"><%= i + 1 %></td>
                    <td><strong><%= s.singer_name %></strong></td>
                    <td>
                      <span class="deity-pill">
                        <span><%= getDeityIcon(s.deity) %></span>
                        <span><%= s.deity %></span>
                      </span>
                    </td>
                    <td>
                      <% if (s.master_id) { %>
                        <a href="/bhajan/<%= s.master_id %>" class="bank-title-link" title="Open master catalog entry & lyrics">
                          <%= s.title %>
                        </a>
                      <% } else { %>
                        <span class="unlinked-bhajan-title" title="Catalog details not available">
                          <%= s.title %>
                        </span>
                      <% } %>
                      <% if (s.sheet_filename) { %>
                        <a href="/sheets/<%= encodeURIComponent(s.sheet_filename) %>" target="_blank"
                          rel="noopener noreferrer" class="sheet-link-pill"
                          style="margin-left: 6px; font-size: 11px;" title="Open official music sheet (PDF)">
                          Sheet
                        </a>
                      <% } %>
                      <% if (s.audioTimestamp && session.sessionAudio && session.sessionAudio.audio_url) { 
                        const startM = Math.floor(s.audioTimestamp.start_seconds / 60);
                        const startS = s.audioTimestamp.start_seconds % 60;
                        const timeFormatted = String(startM).padStart(2, '0') + ':' + String(startS).padStart(2, '0');
                      %>
                        <button type="button" class="btn-play-bhajan" 
                                style="margin-left: 6px;"
                                data-start="<%= s.audioTimestamp.start_seconds %>"
                                data-title="<%= (s.title || '').replace(/"/g, '&quot;') %>"
                                data-singer="<%= (s.singer_name || '').replace(/"/g, '&quot;') %>"
                                data-url="<%= (session.sessionAudio.audio_url || '').replace(/"/g, '&quot;') %>"
                                onclick="window.playSessionAudioBtn(this)" 
                                title="Play recording at <%= timeFormatted %>">
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                          <span><%= timeFormatted %></span>
                        </button>
                      <% } %>
                    </td>
                    <td><%= s.speed || '-' %></td>
                    <td><%= s.scale || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      <% }) %>
    </div>

    <!-- Dynamic Container for Loaded More / Dynamically Injected Search Results -->
    <div id="historyDynamicContainer"></div>

    <!-- Load More Past Sessions CTA -->
    <% if (sessions.length > 12) { %>
      <div id="historyLoadMoreContainer" class="no-print" style="text-align: center; margin: 32px 0 44px;">
        <button type="button" id="historyLoadMoreBtn" class="button secondary" data-haptic="medium"
          style="padding: 13px 32px; font-size: 15px; font-weight: 700; border-radius: 12px; box-shadow: var(--shadow-sm); display: inline-flex; align-items: center; gap: 8px;">
          <span>Load More Past Sessions</span>
          <span style="opacity: 0.8; font-weight: 500;">(<span id="historyRemainingCount"><%= sessions.length - 12 %></span> remaining)</span>
        </button>
      </div>
    <% } %>

  <% } %>
</div>

<!-- Raw Unrendered Sessions Data (13th session onwards) -->
<script id="remainingSessionsData" type="application/json">
  <%- JSON.stringify(sessions.slice(12)) %>
</script>

<script>
  (function () {
    var searchInput = document.getElementById('archiveSearchInput');
    var dateInput = document.getElementById('historyDateFilter');
    var clearBtn = document.getElementById('archiveClearBtn');
    var resetEmptyBtn = document.getElementById('archiveResetEmptyBtn');
    var noMatch = document.getElementById('archiveNoMatch');
    var loadMoreBtn = document.getElementById('historyLoadMoreBtn');
    var loadMoreContainer = document.getElementById('historyLoadMoreContainer');
    var remainingCount = document.getElementById('historyRemainingCount');
    var dynamicContainer = document.getElementById('historyDynamicContainer');
    var sessionsList = document.getElementById('archiveSessionsList');
    var resultsText = document.getElementById('archiveResultsText');
    var activeFilterTag = document.getElementById('archiveActiveFilterTag');

    var remainingSessions = [];
    try {
      var rawData = document.getElementById('remainingSessionsData');
      if (rawData) remainingSessions = JSON.parse(rawData.textContent);
    } catch (e) {
      console.warn('Failed to parse remaining session records:', e);
    }

    var currentIndex = 0;
    var BATCH_SIZE = 12;

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderSessionHtml(session) {
      var rows = session.bhajans.map(function (s, i) {
        var titleHtml = s.master_id
          ? '<a href="/bhajan/' + s.master_id + '" class="bank-title-link" title="Open master catalog entry & lyrics">' + escapeHtml(s.title) + '</a>'
          : '<span class="unlinked-bhajan-title" title="Catalog details not available">' + escapeHtml(s.title) + '</span>';
        
        if (s.sheet_filename) {
          titleHtml += ' <a href="/sheets/' + encodeURIComponent(s.sheet_filename) + '" target="_blank" rel="noopener noreferrer" class="sheet-link-pill" style="margin-left:6px; font-size:11px;" title="Open official music sheet (PDF)">Sheet</a>';
        }

        if (s.audioTimestamp && session.sessionAudio && session.sessionAudio.audio_url) {
          var startM = Math.floor(s.audioTimestamp.start_seconds / 60);
          var startS = s.audioTimestamp.start_seconds % 60;
          var timeFormatted = (startM < 10 ? '0' : '') + startM + ':' + (startS < 10 ? '0' : '') + startS;
          titleHtml += ' <button type="button" class="btn-play-bhajan" style="margin-left:6px;" data-start="' + s.audioTimestamp.start_seconds + '" data-title="' + escapeHtml(s.title || '') + '" data-singer="' + escapeHtml(s.singer_name || '') + '" data-url="' + escapeHtml(session.sessionAudio.audio_url || '') + '" onclick="window.playSessionAudioBtn(this)" title="Play recording at ' + timeFormatted + '"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg><span>' + timeFormatted + '</span></button>';
        }

        var tLower = (s.title || '').toLowerCase();
        var sLower = (s.singer_name || '').toLowerCase();
        var dLower = (s.deity || '').toLowerCase();

        return '<tr class="archive-bhajan-row" data-title="' + escapeHtml(tLower) + '" data-singer="' + escapeHtml(sLower) + '" data-deity="' + escapeHtml(dLower) + '">' +
          '<td style="text-align: center; font-weight: 700; color: var(--muted);">' + (i + 1) + '</td>' +
          '<td><strong>' + escapeHtml(s.singer_name) + '</strong></td>' +
          '<td><span class="deity-pill"><span>' + escapeHtml(s.deity) + '</span></span></td>' +
          '<td>' + titleHtml + '</td>' +
          '<td>' + escapeHtml(s.speed || '-') + '</td>' +
          '<td>' + escapeHtml(s.scale || '-') + '</td>' +
          '</tr>';
      }).join('');

      var audioBtnHtml = '';
      if (session.sessionAudio && session.sessionAudio.audio_url) {
        audioBtnHtml = '<button type="button" class="archive-session-audio-btn" data-start="0" data-title="' + escapeHtml(session.sessionAudio.title || 'Session Recording') + '" data-singer="' + escapeHtml(session.heading || '') + '" data-url="' + escapeHtml(session.sessionAudio.audio_url || '') + '" onclick="window.playSessionAudioBtn(this)" title="Listen to session audio recording" data-haptic="light"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg><span>Listen Recording</span></button>';
      }

      return '<section class="archive-session-card history-session" data-date="' + escapeHtml(session.date) + '">' +
        '<div class="archive-session-header">' +
          '<div class="archive-session-date-wrap">' +
            '<h3 class="archive-session-title"><span>' + escapeHtml(session.heading) + '</span></h3>' +
            '<span class="archive-session-badge">' + session.bhajans.length + ' bhajan' + (session.bhajans.length === 1 ? '' : 's') + '</span>' +
          '</div>' +
          '<div class="no-print" style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">' +
            audioBtnHtml +
            '<a href="/plan-view?session_date=' + encodeURIComponent(session.date) + '" class="archive-session-link" title="Open in Live Plan view" data-haptic="light">' +
              '<span>View Plan</span>' +
            '</a>' +
          '</div>' +
        '</div>' +
        '<div class="table-container">' +
          '<table>' +
            '<thead><tr><th style="width: 48px; text-align: center;">#</th><th>Singer</th><th>Deity</th><th>Bhajan Title</th><th style="width: 100px;">Speed</th><th style="width: 90px;">Scale</th></tr></thead>' +
            '<tbody>' + rows + '</tbody>' +
          '</table>' +
        '</div>' +
      '</section>';
    }

    function loadNextBatch() {
      if (currentIndex >= remainingSessions.length) return;
      var nextBatch = remainingSessions.slice(currentIndex, currentIndex + BATCH_SIZE);
      var html = nextBatch.map(renderSessionHtml).join('');
      if (dynamicContainer) dynamicContainer.insertAdjacentHTML('beforeend', html);
      currentIndex += nextBatch.length;

      var left = remainingSessions.length - currentIndex;
      if (left > 0) {
        if (remainingCount) remainingCount.textContent = left;
      } else {
        if (loadMoreContainer) loadMoreContainer.style.display = 'none';
      }
      filterArchives();
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', loadNextBatch);
    }

    // Unified Master Filtering Engine (Text Search + Date)
    function filterArchives() {
      var query = (searchInput ? searchInput.value : '').trim().toLowerCase();
      var dateVal = (dateInput ? dateInput.value : '').trim();

      var isFiltering = (query.length > 0) || (dateVal.length > 0);

      if (activeFilterTag) {
        activeFilterTag.style.display = isFiltering ? 'inline-block' : 'none';
      }

      // Render all remaining archived sessions once on first filter so complete history is searchable without duplicate DOM injection!
      if (isFiltering && remainingSessions.length > 0 && currentIndex < remainingSessions.length) {
        var remainingBatch = remainingSessions.slice(currentIndex);
        if (remainingBatch.length > 0 && dynamicContainer) {
          dynamicContainer.insertAdjacentHTML('beforeend', remainingBatch.map(renderSessionHtml).join(''));
        }
        currentIndex = remainingSessions.length;
      }

      var allSections = document.querySelectorAll('.history-session');
      var matchedSessionsCount = 0;
      var matchedBhajansCount = 0;

      allSections.forEach(function (sec) {
        var secDate = sec.getAttribute('data-date');
        if (dateVal && secDate !== dateVal) {
          sec.style.display = 'none';
          return;
        }

        var rows = sec.querySelectorAll('.archive-bhajan-row');
        var matchingRowsInSession = 0;

        rows.forEach(function (row) {
          if (!isFiltering) {
            row.style.display = '';
            matchingRowsInSession++;
            return;
          }

          var title = row.getAttribute('data-title') || '';
          var singer = row.getAttribute('data-singer') || '';

          var textMatch = !query || title.includes(query) || singer.includes(query);

          if (textMatch) {
            row.style.display = '';
            matchingRowsInSession++;
          } else {
            row.style.display = 'none';
          }
        });

        if (!isFiltering || matchingRowsInSession > 0) {
          sec.style.display = '';
          matchedSessionsCount++;
          matchedBhajansCount += matchingRowsInSession;
        } else {
          sec.style.display = 'none';
        }
      });

      // Update Load More CTA display
      if (loadMoreContainer) {
        if (isFiltering) {
          loadMoreContainer.style.display = 'none';
        } else {
          var left = remainingSessions.length - currentIndex;
          loadMoreContainer.style.display = left > 0 ? '' : 'none';
        }
      }

      // Update Empty State
      if (noMatch) {
        noMatch.style.display = (isFiltering && matchedSessionsCount === 0) ? 'block' : 'none';
      }

      // Update Results Counter Text
      if (resultsText) {
        if (isFiltering) {
          resultsText.innerHTML = 'Found <strong>' + matchedSessionsCount + '</strong> session' + (matchedSessionsCount === 1 ? '' : 's') +
            ' with <strong>' + matchedBhajansCount + '</strong> matching bhajan' + (matchedBhajansCount === 1 ? '' : 's');
        } else {
          var totalRendered = allSections.length;
          resultsText.innerHTML = 'Showing <strong>' + totalRendered + '</strong> archived sessions';
        }
      }
    }

    // Debounce Helper
    var searchTimer = null;
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () {
          filterArchives();
        }, 160);
      });
    }

    if (dateInput) {
      dateInput.addEventListener('change', filterArchives);
    }

    function resetAllFilters() {
      if (searchInput) searchInput.value = '';
      if (dateInput) dateInput.value = '';
      filterArchives();
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', resetAllFilters);
    }

    if (resetEmptyBtn) {
      resetEmptyBtn.addEventListener('click', resetAllFilters);
    }

    // Run initial filter on load if query or date was passed
    if ((searchInput && searchInput.value) || (dateInput && dateInput.value)) {
      filterArchives();
    }
  })();
</script>

