<%
  const safePrefillCat = typeof prefillCategory !== 'undefined' && prefillCategory ? prefillCategory : '';
  const shouldOpenComposer = typeof openNew !== 'undefined' && Boolean(openNew);
  const safeFromPage = typeof fromPage !== 'undefined' && fromPage ? fromPage : '';
  const singerNamePrefill = (typeof currentSinger !== 'undefined' && currentSinger && currentSinger.name) ? currentSinger.name : '';
%>
<div class="container user-reports-page" style="max-width: 900px; margin: 24px auto; padding: 0 20px 44px 20px;">

  <style>
    .user-reports-composer {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px 22px;
      margin-bottom: 24px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    }
    .ur-composer-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }
    .ur-cat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
      gap: 8px;
      margin-bottom: 16px;
    }
    .ur-cat-option {
      position: relative;
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 10px 12px;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: var(--paper);
      color: var(--ink);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: border-color 0.16s ease, background 0.16s ease, box-shadow 0.16s ease;
      user-select: none;
    }
    .ur-cat-option input {
      position: absolute;
      opacity: 0;
      width: 1px;
      height: 1px;
    }
    .ur-cat-option:hover {
      border-color: var(--saffron, #d97706);
    }
    .ur-cat-option.is-selected {
      border-color: var(--saffron-dk, #b45309);
      background: rgba(217, 119, 6, 0.12);
      color: var(--ink);
      box-shadow: 0 0 0 2px rgba(217, 119, 6, 0.16);
    }
    .ur-cat-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 7px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--saffron-dk, #b45309);
      flex-shrink: 0;
    }
    .ur-field-group {
      margin-bottom: 14px;
    }
    .ur-label {
      display: block;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--ink-soft, #475569);
      margin-bottom: 6px;
    }
    .ur-input,
    .ur-textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--ink);
      font-size: 13.5px;
      font-family: inherit;
      outline: none;
      box-sizing: border-box;
      transition: border-color 0.16s ease;
    }
    .ur-input:focus,
    .ur-textarea:focus {
      border-color: var(--saffron-dk, #b45309);
    }
    .ur-row-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      margin-bottom: 14px;
    }
    .ur-type-pill {
      font-size: 10.5px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 9999px;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }
    .ur-type-general {
      background: rgba(125, 47, 69, 0.12);
      color: #9f1239;
      border: 1px solid rgba(159, 18, 57, 0.25);
    }
    .ur-type-bhajan {
      background: rgba(217, 119, 6, 0.12);
      color: #b45309;
      border: 1px solid rgba(180, 83, 9, 0.25);
    }
    .ur-success-box {
      background: rgba(16, 185, 129, 0.09);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 10px;
      padding: 18px 20px;
      text-align: center;
    }
    .shell-detail-body .ur-standalone-back {
      display: none;
    }
    @media (max-width: 600px) {
      .ur-composer-head {
        flex-direction: column;
      }
      .ur-cat-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>

  <!-- Navigation Back (Smart Back Button) -->
  <div class="ur-standalone-back" style="margin-bottom: 20px;">
    <button type="button" onclick="if(window.AppShell){window.AppShell.back('/master-bank');}else if(window.history.length > 1){window.history.back();}else{window.location.href='/master-bank';}" style="background: none; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; color: var(--ink-soft, #475569); font-size: 13.5px; font-weight: 600; padding: 6px 10px; border-radius: 6px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Back
    </button>
  </div>

  <!-- Header Banner (Native Mandir Style) -->
  <div class="banner-hero" style="background: linear-gradient(135deg, #451a03 0%, #7d2f45 55%, #b45309 100%); color: #fff; padding: 24px 28px; border-radius: 14px; margin-bottom: 24px; box-shadow: 0 10px 25px -5px rgba(125, 47, 69, 0.32);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
      <div style="max-width: 540px;">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px; flex-wrap: wrap;">
          <h1 style="font-size: 22px; font-weight: 800; margin: 0; color: #ffffff;">Reports &amp; Feedback</h1>
          <span id="ticketCountBadge" style="display: none; background: var(--saffron-dk, #b45309); color: #fff; font-size: 11.5px; font-weight: 700; padding: 2px 10px; border-radius: 9999px;">0</span>
        </div>
        <p style="font-size: 13.5px; margin: 0; color: #f5eedb; line-height: 1.45;">
          Submit missing bhajan requests, app bugs, feature suggestions, or bhajan corrections, and track coordinator responses.
        </p>
      </div>
      <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <button
          type="button"
          id="toggleGeneralReportBtn"
          onclick="toggleGeneralReportComposer()"
          class="btn btn-primary"
          style="background: #ffffff; color: #7d2f45; border: none; padding: 9px 16px; border-radius: 8px; font-size: 13px; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>Submit Report / Feedback</span>
        </button>
        <a href="/master-bank" class="btn btn-secondary" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 13px; font-weight: 600;">
          Browse Master Bank
        </a>
      </div>
    </div>
  </div>

  <!-- General Report & Feedback Composer -->
  <section
    id="generalReportComposer"
    class="user-reports-composer"
    aria-label="Submit Report or Feedback"
    style="display: <%= shouldOpenComposer ? 'block' : 'none' %>;"
  >
    <div class="ur-composer-head">
      <div>
        <h2 style="font-size: 17px; font-weight: 800; color: var(--ink); margin: 0 0 4px 0;">
          Submit Report, Missing Bhajan, or Suggestion
        </h2>
        <p style="font-size: 12.5px; color: var(--muted); margin: 0;">
          Share anything with the Samiti admin team &mdash; missing bhajans, app issues, schedule/audio glitches, or new ideas.
        </p>
      </div>
      <button
        type="button"
        onclick="toggleGeneralReportComposer(false)"
        aria-label="Close report form"
        style="background: none; border: 1px solid var(--border); color: var(--ink-soft); border-radius: 6px; width: 30px; height: 30px; cursor: pointer; font-size: 18px; line-height: 1; flex-shrink: 0;"
      >&times;</button>
    </div>

    <form id="generalReportForm" onsubmit="submitGeneralReport(event)">
      <input type="hidden" id="genPageContext" value="<%= safeFromPage %>">

      <div class="ur-field-group">
        <span class="ur-label">What would you like to report? *</span>
        <div class="ur-cat-grid" id="genCategoryGrid">
          <label class="ur-cat-option <%= safePrefillCat === 'missing_bhajan' ? 'is-selected' : '' %>">
            <input type="checkbox" name="genCat" value="missing_bhajan" <%= safePrefillCat === 'missing_bhajan' ? 'checked' : '' %>>
            <span class="ur-cat-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            </span>
            <span>Missing Bhajan</span>
          </label>

          <label class="ur-cat-option <%= safePrefillCat === 'app_bug' ? 'is-selected' : '' %>">
            <input type="checkbox" name="genCat" value="app_bug" <%= safePrefillCat === 'app_bug' ? 'checked' : '' %>>
            <span class="ur-cat-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2l1.88 1.88"/><path d="M14.12 3.88L16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/><path d="M6.53 9C4.6 8.8 3 7.1 3 5"/><path d="M6 13H2"/><path d="M3 21c0-2.1 1.7-3.9 3.8-4"/><path d="M20.97 5c0 2.1-1.6 3.8-3.5 4"/><path d="M22 13h-4"/><path d="M17.2 17c2.1.1 3.8 1.9 3.8 4"/></svg>
            </span>
            <span>App Bug / Error</span>
          </label>

          <label class="ur-cat-option <%= safePrefillCat === 'suggestion' ? 'is-selected' : '' %>">
            <input type="checkbox" name="genCat" value="suggestion" <%= safePrefillCat === 'suggestion' ? 'checked' : '' %>>
            <span class="ur-cat-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
            </span>
            <span>Feature Suggestion</span>
          </label>

          <label class="ur-cat-option <%= safePrefillCat === 'session_audio' ? 'is-selected' : '' %>">
            <input type="checkbox" name="genCat" value="session_audio" <%= safePrefillCat === 'session_audio' ? 'checked' : '' %>>
            <span class="ur-cat-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </span>
            <span>Schedule / Audio</span>
          </label>

          <label class="ur-cat-option <%= safePrefillCat === 'account_notif' ? 'is-selected' : '' %>">
            <input type="checkbox" name="genCat" value="account_notif" <%= safePrefillCat === 'account_notif' ? 'checked' : '' %>>
            <span class="ur-cat-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </span>
            <span>Login / Notifications</span>
          </label>

          <label class="ur-cat-option <%= safePrefillCat === 'general_other' ? 'is-selected' : '' %>">
            <input type="checkbox" name="genCat" value="general_other" <%= safePrefillCat === 'general_other' ? 'checked' : '' %>>
            <span class="ur-cat-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span>Other Feedback</span>
          </label>
        </div>
      </div>

      <div class="ur-field-group">
        <label for="genReportSubject" id="genReportSubjectLabel" class="ur-label">Subject / Title</label>
        <input
          type="text"
          id="genReportSubject"
          class="ur-input"
          maxlength="200"
          placeholder="Short summary (or missing bhajan title)..."
        >
      </div>

      <div class="ur-field-group">
        <label for="genReportDescription" class="ur-label">Details *</label>
        <textarea
          id="genReportDescription"
          class="ur-textarea"
          rows="3"
          maxlength="2000"
          required
          placeholder="Describe what happened, what bhajan is missing, or how we can improve the app..."
        ></textarea>
      </div>

      <div class="ur-field-group">
        <label for="genReportSuggestion" id="genReportSuggestionLabel" class="ur-label">
          Additional Details / Lyrics / Suggested Improvement <span style="font-weight: 400; color: var(--muted);">(Optional)</span>
        </label>
        <textarea
          id="genReportSuggestion"
          class="ur-textarea"
          rows="2"
          maxlength="2000"
          placeholder="Optional: paste lyrics, raga/scale info, device model, or expected behaviour..."
        ></textarea>
      </div>

      <div class="ur-row-2">
        <div>
          <label for="genReporterName" class="ur-label">Your Name <span style="font-weight: 400; color: var(--muted);">(Optional)</span></label>
          <input
            type="text"
            id="genReporterName"
            class="ur-input"
            maxlength="80"
            value="<%= singerNamePrefill %>"
            placeholder="Your name"
          >
        </div>
        <div>
          <label for="genReporterContact" class="ur-label">Phone or Email <span style="font-weight: 400; color: var(--muted);">(Optional)</span></label>
          <input
            type="text"
            id="genReporterContact"
            class="ur-input"
            maxlength="100"
            placeholder="So coordinators can reach you if needed"
          >
        </div>
      </div>

      <div id="genReportError" style="display: none; background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; padding: 10px 12px; border-radius: 8px; font-size: 13px; margin-bottom: 12px;"></div>

      <div style="display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap;">
        <button
          type="button"
          onclick="toggleGeneralReportComposer(false)"
          class="btn btn-secondary"
          style="padding: 9px 16px; border-radius: 8px; font-size: 13px; font-weight: 600;"
        >Cancel</button>
        <button
          type="submit"
          id="submitGeneralReportBtn"
          class="btn btn-primary"
          style="padding: 9px 20px; border-radius: 8px; font-size: 13.5px; font-weight: 700;"
        >Submit Report</button>
      </div>
    </form>

    <div id="genReportSuccess" class="ur-success-box" style="display: none;">
      <div style="font-size: 15px; font-weight: 800; color: var(--success-text, #15803d); margin-bottom: 6px;">
        Report Submitted! Sai Ram.
      </div>
      <p style="font-size: 13px; color: var(--ink-soft); margin: 0 0 12px 0;">
        Your ticket code is saved on this device so you can track coordinator updates below:
      </p>
      <div style="display: inline-flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--border); padding: 6px 12px; border-radius: 8px; margin-bottom: 14px;">
        <strong id="genCreatedTicketCode" style="font-family: monospace; font-size: 15px; letter-spacing: 0.5px; color: var(--ink);">REP-0000</strong>
        <button type="button" id="copyGenTicketBtn" onclick="copyGenTicketCode()" class="btn btn-secondary" style="padding: 4px 10px; font-size: 12px; border-radius: 6px;">
          Copy Code
        </button>
      </div>
      <div>
        <button type="button" onclick="resetGeneralReportComposer()" class="btn btn-secondary" style="padding: 7px 14px; font-size: 12.5px; border-radius: 7px;">
          Submit Another Report
        </button>
      </div>
    </div>
  </section>

  <!-- Ticket Search Box -->
  <div style="background: var(--surface); padding: 16px 20px; border-radius: 10px; border: 1px solid var(--border); margin-bottom: 24px; box-shadow: 0 1px 3px rgba(15,23,42,0.04);">
    <form id="searchTicketForm" onsubmit="lookupTicket(event)" style="display: flex; gap: 10px; align-items: center;">
      <div style="flex: 1; position: relative;">
        <label for="ticketCodeInput" class="sr-only">Lookup a ticket code</label>
        <input
          type="text"
          id="ticketCodeInput"
          aria-label="Lookup a ticket code"
          placeholder="Lookup a ticket code (e.g. REP-7890)..."
          style="width: 100%; height: 38px; padding: 8px 14px 8px 34px; border-radius: 6px; border: 1px solid var(--border); font-size: 13px; text-transform: uppercase; font-family: monospace; font-weight: 600; outline: none; background: var(--surface); color: var(--ink);"
        >
        <span style="position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--muted); display: flex; align-items: center;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
      </div>
      <button type="submit" class="btn btn-primary" style="height: 38px; padding: 0 18px; font-size: 13px; font-weight: 700; border-radius: 6px;">Lookup</button>
    </form>
  </div>

  <!-- Tickets Loading -->
  <div id="ticketsLoading" style="text-align: center; padding: 40px 0; color: var(--muted);">
    <div style="width: 32px; height: 32px; border: 3px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 12px auto;"></div>
    <div style="font-size: 13.5px;">Loading your reported tickets...</div>
  </div>

  <div id="ticketsList" style="display: none; flex-direction: column; gap: 14px;"></div>

  <!-- Empty State -->
  <div id="emptyTicketsState" style="display: none; background: var(--surface); padding: 48px 24px; border-radius: 10px; border: 1px dashed var(--border); text-align: center; color: var(--muted);">
    <div style="width: 48px; height: 48px; border-radius: 12px; background: var(--paper); color: var(--muted); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
    </div>
    <h3 style="font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 6px;">No Tickets Found</h3>
    <p style="font-size: 13.5px; max-width: 460px; margin: 0 auto 18px auto; line-height: 1.5; color: var(--muted);">
      You have not submitted any bhajan corrections, missing bhajan requests, or app feedback from this browser yet.
    </p>
    <div style="display: flex; justify-content: center; gap: 10px; flex-wrap: wrap;">
      <button type="button" onclick="toggleGeneralReportComposer(true)" class="btn btn-primary" style="padding: 9px 18px; font-size: 13px; border-radius: 6px; font-weight: 700;">
        + Submit a Report or Feedback
      </button>
      <a href="/master-bank" class="btn btn-secondary" style="display: inline-block; padding: 9px 18px; font-size: 13px; text-decoration: none; border-radius: 6px;">
        Explore Master Bhajan Bank
      </a>
    </div>
  </div>

</div>

<script>
(function () {
const CAT_LABELS = {
  lyrics: 'Lyrics',
  scale: 'Scale / Pitch',
  raga: 'Raga',
  deity: 'Deity',
  tempo: 'Tempo',
  sheet: 'Music Sheet',
  spelling: 'Typo',
  other: 'Other',
  missing_bhajan: 'Missing Bhajan',
  app_bug: 'App Bug',
  suggestion: 'Suggestion',
  session_audio: 'Schedule / Audio',
  account_notif: 'Login / Notifications',
  general_other: 'General Feedback'
};

function getCsrfToken() {
  var meta = document.querySelector('meta[name="csrf-token"]');
  return (meta && meta.getAttribute('content')) || window.csrfToken || '';
}

function syncSubjectPlaceholder() {
  var subjectLabel = document.getElementById('genReportSubjectLabel');
  var subjectInput = document.getElementById('genReportSubject');
  var descInput = document.getElementById('genReportDescription');
  var suggLabel = document.getElementById('genReportSuggestionLabel');
  if (!subjectInput || !descInput) return;

  var checked = Array.prototype.map.call(
    document.querySelectorAll('input[name="genCat"]:checked'),
    function (el) { return el.value; }
  );
  var primary = checked[0] || '';

  if (primary === 'missing_bhajan') {
    if (subjectLabel) subjectLabel.textContent = 'Missing Bhajan Name / Title';
    subjectInput.placeholder = 'Enter the title of the missing bhajan...';
    descInput.placeholder = 'Share any known lyrics, deity, raga, scale, or reference link...';
    if (suggLabel) suggLabel.innerHTML = 'Lyrics / Scale / Raga Details <span style="font-weight: 400; color: var(--muted);">(Optional)</span>';
  } else if (primary === 'app_bug') {
    if (subjectLabel) subjectLabel.textContent = 'Bug / Issue Summary';
    subjectInput.placeholder = 'e.g. Button not responding on Singer Hub...';
    descInput.placeholder = 'Which page were you on, what did you tap, and what happened?';
    if (suggLabel) suggLabel.innerHTML = 'Device / Browser / Steps to Reproduce <span style="font-weight: 400; color: var(--muted);">(Optional)</span>';
  } else if (primary === 'suggestion') {
    if (subjectLabel) subjectLabel.textContent = 'Feature / Improvement Idea';
    subjectInput.placeholder = 'Short title for your suggestion...';
    descInput.placeholder = 'Describe your idea and how it would help singers or coordinators...';
    if (suggLabel) suggLabel.innerHTML = 'Extra Notes <span style="font-weight: 400; color: var(--muted);">(Optional)</span>';
  } else {
    if (subjectLabel) subjectLabel.textContent = 'Subject / Title';
    subjectInput.placeholder = 'Short summary (or missing bhajan title)...';
    descInput.placeholder = 'Describe what happened, what bhajan is missing, or how we can improve the app...';
    if (suggLabel) suggLabel.innerHTML = 'Additional Details / Lyrics / Suggested Improvement <span style="font-weight: 400; color: var(--muted);">(Optional)</span>';
  }
}

function bindCategoryOptions() {
  var grid = document.getElementById('genCategoryGrid');
  if (!grid) return;
  var inputs = grid.querySelectorAll('input[name="genCat"]');
  inputs.forEach(function (inp) {
    inp.addEventListener('change', function () {
      var label = inp.closest('.ur-cat-option');
      if (label) {
        label.classList.toggle('is-selected', inp.checked);
      }
      syncSubjectPlaceholder();
    });
  });
  syncSubjectPlaceholder();
}

function toggleGeneralReportComposer(forceState) {
  var box = document.getElementById('generalReportComposer');
  if (!box) return;
  var show = typeof forceState === 'boolean' ? forceState : box.style.display === 'none';
  box.style.display = show ? 'block' : 'none';
  if (show) {
    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
}
window.toggleGeneralReportComposer = toggleGeneralReportComposer;

function resetGeneralReportComposer() {
  var form = document.getElementById('generalReportForm');
  var success = document.getElementById('genReportSuccess');
  var errBox = document.getElementById('genReportError');
  if (form) {
    form.reset();
    form.style.display = 'block';
    document.querySelectorAll('#genCategoryGrid .ur-cat-option').forEach(function (lbl) {
      var cb = lbl.querySelector('input[type="checkbox"]');
      lbl.classList.toggle('is-selected', Boolean(cb && cb.checked));
    });
    syncSubjectPlaceholder();
  }
  if (success) success.style.display = 'none';
  if (errBox) errBox.style.display = 'none';
}
window.resetGeneralReportComposer = resetGeneralReportComposer;

function copyGenTicketCode() {
  var codeEl = document.getElementById('genCreatedTicketCode');
  var btn = document.getElementById('copyGenTicketBtn');
  if (!codeEl) return;
  var code = codeEl.textContent.trim();
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(code).then(function () {
      if (btn) {
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = 'Copy Code'; }, 1800);
      }
    }).catch(function () {});
  }
}
window.copyGenTicketCode = copyGenTicketCode;

async function submitGeneralReport(e) {
  e.preventDefault();
  var btn = document.getElementById('submitGeneralReportBtn');
  var errBox = document.getElementById('genReportError');
  if (errBox) errBox.style.display = 'none';

  var checkedCats = Array.prototype.map.call(
    document.querySelectorAll('input[name="genCat"]:checked'),
    function (cb) { return cb.value; }
  );
  var subject = (document.getElementById('genReportSubject').value || '').trim();
  var desc = (document.getElementById('genReportDescription').value || '').trim();
  var suggestion = (document.getElementById('genReportSuggestion').value || '').trim();
  var reporterName = (document.getElementById('genReporterName').value || '').trim();
  var reporterContact = (document.getElementById('genReporterContact').value || '').trim();
  var pageContext = (document.getElementById('genPageContext').value || '').trim();

  if (checkedCats.length === 0 && !desc) {
    if (errBox) {
      errBox.textContent = 'Please select at least one category or describe your report.';
      errBox.style.display = 'block';
    }
    return;
  }

  if (!desc) {
    if (errBox) {
      errBox.textContent = 'Please provide details so coordinators know how to help.';
      errBox.style.display = 'block';
    }
    return;
  }

  if (!pageContext && document.referrer) {
    try {
      var refUrl = new URL(document.referrer);
      if (refUrl.origin === window.location.origin) {
        pageContext = refUrl.pathname;
      }
    } catch (_) {}
  }

  try {
    btn.disabled = true;
    btn.textContent = 'Submitting...';

    var devId = localStorage.getItem('bp_device_id') || '';
    var headers = { 'Content-Type': 'application/json' };
    var csrf = getCsrfToken();
    if (csrf) headers['X-CSRF-Token'] = csrf;

    var res = await fetch('/api/reports/submit', {
      method: 'POST',
      headers: headers,
      body: JSON.stringify({
        report_type: 'general',
        subject: subject,
        bhajan_title: subject,
        categories: checkedCats.length > 0 ? checkedCats : ['general_other'],
        description: desc,
        suggested_correction: suggestion,
        reporter_name: reporterName,
        reporter_contact: reporterContact,
        visitor_id: devId,
        page_context: pageContext
      })
    });

    var data = await res.json();
    if (!res.ok) {
      throw new Error(data.error || 'Failed to submit report.');
    }

    var ticketCode = data.ticket_code || (data.ticket && data.ticket.ticket_code) || '';
    if (ticketCode) {
      try {
        var stored = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
        if (!stored.includes(ticketCode)) {
          stored.unshift(ticketCode);
          localStorage.setItem('bp_my_report_tickets', JSON.stringify(stored));
        }
      } catch (_) {}
    }

    document.getElementById('genCreatedTicketCode').textContent = ticketCode || 'SAVED';
    document.getElementById('generalReportForm').style.display = 'none';
    document.getElementById('genReportSuccess').style.display = 'block';

    loadMyReports();
  } catch (err) {
    if (errBox) {
      errBox.textContent = err.message || 'Could not submit report. Please try again.';
      errBox.style.display = 'block';
    }
  } finally {
    btn.disabled = false;
    btn.textContent = 'Submit Report';
  }
}
window.submitGeneralReport = submitGeneralReport;

async function loadMyReports() {
  const loading = document.getElementById('ticketsLoading');
  const container = document.getElementById('ticketsList');
  const empty = document.getElementById('emptyTicketsState');
  const countBadge = document.getElementById('ticketCountBadge');

  let storedTickets = [];
  try {
    storedTickets = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
  } catch (_) {}

  const devId = localStorage.getItem('bp_device_id') || '';

  try {
    const params = new URLSearchParams();
    if (storedTickets.length > 0) {
      params.set('tickets', storedTickets.join(','));
    }
    if (devId) {
      params.set('visitor_id', devId);
    }

    const res = await fetch('/api/reports/my-reports?' + params.toString());
    const data = await res.json();

    loading.style.display = 'none';

    if (!data.reports || data.reports.length === 0) {
      empty.style.display = 'block';
      container.style.display = 'none';
      if (countBadge) countBadge.style.display = 'none';
      return;
    }

    empty.style.display = 'none';
    if (countBadge) {
      countBadge.textContent = data.reports.length + (data.reports.length === 1 ? ' ticket' : ' tickets');
      countBadge.style.display = 'inline-block';
    }

    try {
      const currentList = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
      let updated = false;
      data.reports.forEach(r => {
        if (r.ticket_code && !currentList.includes(r.ticket_code)) {
          currentList.push(r.ticket_code);
          updated = true;
        }
      });
      if (updated) {
        localStorage.setItem('bp_my_report_tickets', JSON.stringify(currentList));
      }
    } catch (_) {}

    container.innerHTML = '';
    container.style.display = 'flex';

    var csrf = getCsrfToken();
    data.reports.forEach(ticket => {
      renderTicketCard(ticket, container);
      if (ticket.admin_response && !ticket.user_viewed_reply) {
        fetch('/api/reports/ticket/' + ticket.ticket_code + '/seen', {
          method: 'POST',
          headers: csrf ? { 'X-CSRF-Token': csrf } : {}
        }).catch(() => {});
      }
    });

  } catch (err) {
    loading.style.display = 'none';
    container.innerHTML = `<div style="background:#fee2e2; color:#b91c1c; padding:16px; border-radius:8px;">Error loading tickets: ${escapeHtml(err.message)}</div>`;
    container.style.display = 'block';
  }
}

function renderTicketCard(t, container) {
  let badgeHtml = '<span style="background: var(--warning-light); color: var(--warning-text); border: 1px solid var(--warning-border); padding: 3px 9px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase;">Pending Review</span>';
  if (t.status === 'under_review') {
    badgeHtml = '<span style="background: var(--info-light); color: #0369a1; border: 1px solid var(--info-border); padding: 3px 9px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase;">Under Review</span>';
  } else if (t.status === 'resolved') {
    badgeHtml = '<span style="background: var(--success-light); color: var(--success-text); border: 1px solid var(--success-border); padding: 3px 9px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase;">Resolved</span>';
  } else if (t.status === 'closed') {
    badgeHtml = '<span style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 3px 9px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase;">Closed</span>';
  }

  const isGeneral = t.report_type === 'general';
  const typePill = isGeneral
    ? '<span class="ur-type-pill ur-type-general">General / App</span>'
    : '<span class="ur-type-pill ur-type-bhajan">Songbook</span>';

  const card = document.createElement('div');
  card.style = 'background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px; box-shadow: 0 1px 3px rgba(15,23,42,0.04);';

  const catPills = (t.categories || []).map(cat =>
    `<span style="background: var(--paper); border: 1px solid var(--border); color: var(--ink-soft); font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600;">${escapeHtml(CAT_LABELS[cat] || cat)}</span>`
  ).join(' ');

  let adminReplyHtml = '';
  if (t.admin_response) {
    adminReplyHtml = `
      <div style="margin-top: 14px; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); border-left: 4px solid #16a34a; border-radius: 6px; padding: 12px 14px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
          <div style="font-size: 12px; font-weight: 700; color: var(--success-text);">
            Response from Coordinator ${escapeHtml(t.reviewed_by || 'Admin')}:
          </div>
          <div style="font-size: 11px; color: var(--muted);">${new Date(t.reviewed_at || t.updated_at).toLocaleDateString()}</div>
        </div>
        <div style="font-size: 13px; color: var(--ink); line-height: 1.5; white-space: pre-wrap;">${escapeHtml(t.admin_response)}</div>
      </div>
    `;
  }

  card.innerHTML = `
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <span style="font-family: monospace; font-size: 12px; font-weight: 700; background: #292524; color: #fef3c7; padding: 2px 8px; border-radius: 4px; letter-spacing: 0.5px;">${escapeHtml(t.ticket_code)}</span>
        ${typePill}
        <span style="font-size: 12px; color: var(--muted);">${new Date(t.created_at).toLocaleDateString()}</span>
      </div>
      <div>${badgeHtml}</div>
    </div>

    <h3 style="font-size: 16px; font-weight: 700; color: var(--ink); margin: 0 0 8px 0;">
      ${t.master_id ? `<a href="/bhajan/${t.master_id}" style="color: var(--saffron-dk); text-decoration: none;">${escapeHtml(t.bhajan_title)} &rarr;</a>` : escapeHtml(t.bhajan_title)}
    </h3>

    <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px;">
      ${catPills}
    </div>

    <div style="font-size: 13px; color: var(--ink-soft); line-height: 1.5; background: var(--paper); padding: 10px 12px; border-radius: 6px; margin-bottom: 10px; border-left: 3px solid var(--border); white-space: pre-wrap;">${escapeHtml(t.description)}</div>

    ${t.suggested_correction ? `
      <div style="font-size: 12.5px; color: var(--success-text); background: var(--success-light); border: 1px solid var(--success-border); padding: 8px 12px; border-radius: 6px; margin-bottom: 10px;">
        <strong>${isGeneral ? 'Details / Suggestion:' : 'Suggested fix:'}</strong> ${escapeHtml(t.suggested_correction)}
      </div>
    ` : ''}

    ${adminReplyHtml}
  `;

  container.appendChild(card);
}

async function lookupTicket(e) {
  e.preventDefault();
  const input = document.getElementById('ticketCodeInput');
  const code = input.value.trim().toUpperCase();
  if (!code) return;

  const container = document.getElementById('ticketsList');
  const empty = document.getElementById('emptyTicketsState');
  const loading = document.getElementById('ticketsLoading');

  loading.style.display = 'block';
  container.style.display = 'none';
  empty.style.display = 'none';

  try {
    const res = await fetch('/api/reports/ticket/' + encodeURIComponent(code));
    const data = await res.json();
    loading.style.display = 'none';

    if (!res.ok || !data || !data.ticket_code) {
      alert('Ticket "' + code + '" not found. Please verify the code.');
      loadMyReports();
      return;
    }

    container.innerHTML = '';
    container.style.display = 'flex';
    renderTicketCard(data, container);

    try {
      const stored = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
      if (!stored.includes(data.ticket_code)) {
        stored.unshift(data.ticket_code);
        localStorage.setItem('bp_my_report_tickets', JSON.stringify(stored));
      }
    } catch (_) {}

  } catch (err) {
    loading.style.display = 'none';
    alert('Lookup failed: ' + err.message);
  }
}

window.lookupTicket = lookupTicket;

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function initUserReportsPage() {
  bindCategoryOptions();
  loadMyReports();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initUserReportsPage);
} else {
  initUserReportsPage();
}
})();
</script>
