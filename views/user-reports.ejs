<div class="container" style="max-width: 900px; margin: 24px auto; padding: 0 20px 40px 20px;">
  
  <!-- Navigation Back (Smart Back Button) -->
  <div style="margin-bottom: 20px;">
    <button type="button" onclick="if(window.history.length > 1){window.history.back();}else{window.location.href='/master-bank';}" style="background: none; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; color: #475569; font-size: 13.5px; font-weight: 600; padding: 6px 10px; border-radius: 6px; transition: all 0.2s;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Back
    </button>
  </div>

  <!-- Header Banner (Native Indigo Style) -->
  <div class="banner-hero" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); color: #fff; padding: 24px 28px; border-radius: 14px; margin-bottom: 24px; box-shadow: 0 10px 25px -5px rgba(67, 56, 202, 0.35);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
          <h1 style="font-size: 22px; font-weight: 800; margin: 0; color: #ffffff;">My Bhajan Correction Tickets</h1>
          <span id="ticketCountBadge" style="display: none; background: #4f46e5; color: #fff; font-size: 11.5px; font-weight: 700; padding: 2px 10px; border-radius: 9999px;">0</span>
        </div>
        <p style="font-size: 13.5px; margin: 0; color: #cbd5e1;">
          Showing reports submitted from your device. Track review status, coordinator updates, and verified corrections.
        </p>
      </div>
      <a href="/master-bank" class="btn btn-secondary" style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.25); padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 600;">
        Browse Master Bank
      </a>
    </div>
  </div>

  <!-- Ticket Search Box -->
  <div style="background: #ffffff; padding: 16px 20px; border-radius: 10px; border: 1px solid var(--border); margin-bottom: 24px; box-shadow: 0 1px 3px rgba(15,23,42,0.04);">
    <form id="searchTicketForm" onsubmit="lookupTicket(event)" style="display: flex; gap: 10px; align-items: center;">
      <div style="flex: 1; position: relative;">
        <input
          type="text"
          id="ticketCodeInput"
          placeholder="Lookup a ticket code (e.g. REP-7890)..."
          style="width: 100%; height: 38px; padding: 8px 14px 8px 34px; border-radius: 6px; border: 1px solid var(--border); font-size: 13px; text-transform: uppercase; font-family: monospace; font-weight: 600; outline: none;"
        >
        <span style="position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: #94a3b8; display: flex; align-items: center;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
      </div>
      <button type="submit" class="btn btn-primary" style="height: 38px; padding: 0 18px; font-size: 13px; font-weight: 700; border-radius: 6px;">Lookup</button>
    </form>
  </div>

  <!-- Tickets Loading -->
  <div id="ticketsLoading" style="text-align: center; padding: 40px 0; color: #64748b;">
    <div style="width: 32px; height: 32px; border: 3px solid #cbd5e1; border-top-color: #4f46e5; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 12px auto;"></div>
    <div style="font-size: 13.5px;">Loading your reported tickets...</div>
  </div>

  <div id="ticketsList" style="display: none; flex-direction: column; gap: 14px;"></div>

  <!-- Empty State -->
  <div id="emptyTicketsState" style="display: none; background: #ffffff; padding: 48px 24px; border-radius: 10px; border: 1px dashed var(--border); text-align: center; color: #64748b;">
    <div style="width: 48px; height: 48px; border-radius: 12px; background: #f8fafc; color: #64748b; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
    </div>
    <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin-bottom: 6px;">No Tickets Found</h3>
    <p style="font-size: 13.5px; max-width: 440px; margin: 0 auto 18px auto; line-height: 1.5;">
      You have not reported any bhajan issues from this browser yet, or your previous tickets were on a different device.
    </p>
    <a href="/master-bank" class="btn btn-primary" style="display: inline-block; padding: 9px 18px; font-size: 13px; text-decoration: none; border-radius: 6px;">
      Explore Master Bhajan Bank
    </a>
  </div>

</div>

<script>
const CAT_LABELS = {
  lyrics: 'Lyrics',
  scale: 'Scale / Pitch',
  raga: 'Raga',
  deity: 'Deity',
  tempo: 'Tempo',
  sheet: 'Music Sheet',
  spelling: 'Typo',
  other: 'Other'
};

async function loadMyReports() {
  const loading = document.getElementById('ticketsLoading');
  const container = document.getElementById('ticketsList');
  const empty = document.getElementById('emptyTicketsState');
  const countBadge = document.getElementById('ticketCountBadge');

  // Retrieve ticket codes stored in localStorage
  let storedTickets = [];
  try {
    storedTickets = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
  } catch (_) {}

  const devId = localStorage.getItem('bp_device_id') || '';

  try {
    const params = new URLSearchParams();
    if (storedTickets.length > 0) {
      params.set('tickets', storedTickets.join(','));
    }
    if (devId) {
      params.set('visitor_id', devId);
    }

    const res = await fetch('/api/reports/my-reports?' + params.toString());
    const data = await res.json();

    loading.style.display = 'none';

    if (!data.reports || data.reports.length === 0) {
      empty.style.display = 'block';
      container.style.display = 'none';
      if (countBadge) countBadge.style.display = 'none';
      return;
    }

    if (countBadge) {
      countBadge.textContent = data.reports.length + (data.reports.length === 1 ? ' ticket' : ' tickets');
      countBadge.style.display = 'inline-block';
    }

    // Keep localStorage synchronized with any returned tickets
    try {
      const currentList = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
      let updated = false;
      data.reports.forEach(r => {
        if (r.ticket_code && !currentList.includes(r.ticket_code)) {
          currentList.push(r.ticket_code);
          updated = true;
        }
      });
      if (updated) {
        localStorage.setItem('bp_my_report_tickets', JSON.stringify(currentList));
      }
    } catch (_) {}

    container.innerHTML = '';
    container.style.display = 'flex';

    data.reports.forEach(ticket => {
      renderTicketCard(ticket, container);
      // If admin responded and not seen, mark seen in background
      if (ticket.admin_response && !ticket.user_viewed_reply) {
        fetch('/api/reports/ticket/' + ticket.ticket_code + '/seen', { method: 'POST' }).catch(() => {});
      }
    });

  } catch (err) {
    loading.style.display = 'none';
    container.innerHTML = `<div style="background:#fee2e2; color:#b91c1c; padding:16px; border-radius:8px;">Error loading tickets: ${err.message}</div>`;
    container.style.display = 'block';
  }
}

function renderTicketCard(t, container) {
  let badgeHtml = '<span style="background: var(--warning-light); color: var(--warning-text); border: 1px solid var(--warning-border); padding: 3px 9px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase;">Pending Review</span>';
  if (t.status === 'under_review') {
    badgeHtml = '<span style="background: var(--info-light); color: #0369a1; border: 1px solid var(--info-border); padding: 3px 9px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase;">Under Review</span>';
  } else if (t.status === 'resolved') {
    badgeHtml = '<span style="background: var(--success-light); color: var(--success-text); border: 1px solid var(--success-border); padding: 3px 9px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase;">Resolved</span>';
  } else if (t.status === 'closed') {
    badgeHtml = '<span style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 3px 9px; border-radius: 9999px; font-size: 11px; font-weight: 700; text-transform: uppercase;">Closed</span>';
  }

  const card = document.createElement('div');
  card.style = 'background: #ffffff; border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px; box-shadow: 0 1px 3px rgba(15,23,42,0.04);';

  const catPills = (t.categories || []).map(cat => 
    `<span style="background: #f8fafc; border: 1px solid var(--border); color: #475569; font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600;">${CAT_LABELS[cat] || cat}</span>`
  ).join(' ');

  let adminReplyHtml = '';
  if (t.admin_response) {
    adminReplyHtml = `
      <div style="margin-top: 14px; background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 4px solid #16a34a; border-radius: 6px; padding: 12px 14px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
          <div style="font-size: 12px; font-weight: 700; color: #166534;">
            Response from Coordinator ${escapeHtml(t.reviewed_by || 'Admin')}:
          </div>
          <div style="font-size: 11px; color: #15803d;">${new Date(t.reviewed_at || t.updated_at).toLocaleDateString()}</div>
        </div>
        <div style="font-size: 13px; color: #14532d; line-height: 1.5; white-space: pre-wrap;">${escapeHtml(t.admin_response)}</div>
      </div>
    `;
  }

  card.innerHTML = `
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-family: monospace; font-size: 12px; font-weight: 700; background: #1e293b; color: #f8fafc; padding: 2px 8px; border-radius: 4px; letter-spacing: 0.5px;">${t.ticket_code}</span>
        <span style="font-size: 12px; color: #64748b;">${new Date(t.created_at).toLocaleDateString()}</span>
      </div>
      <div>${badgeHtml}</div>
    </div>

    <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 8px 0;">
      ${t.master_id ? `<a href="/bhajan/${t.master_id}" style="color: #4f46e5; text-decoration: none;">${escapeHtml(t.bhajan_title)} &rarr;</a>` : escapeHtml(t.bhajan_title)}
    </h3>

    <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px;">
      ${catPills}
    </div>

    <div style="font-size: 13px; color: #334155; line-height: 1.5; background: #f8fafc; padding: 10px 12px; border-radius: 6px; margin-bottom: 10px; border-left: 3px solid #cbd5e1;">
      ${escapeHtml(t.description)}
    </div>

    ${t.suggested_correction ? `
      <div style="font-size: 12.5px; color: #166534; background: #f0fdf4; padding: 8px 12px; border-radius: 6px; margin-bottom: 10px;">
        <strong>Suggested fix:</strong> ${escapeHtml(t.suggested_correction)}
      </div>
    ` : ''}

    ${adminReplyHtml}
  `;

  container.appendChild(card);
}

async function lookupTicket(e) {
  e.preventDefault();
  const input = document.getElementById('ticketCodeInput');
  const code = input.value.trim().toUpperCase();
  if (!code) return;

  const container = document.getElementById('ticketsList');
  const empty = document.getElementById('emptyTicketsState');
  const loading = document.getElementById('ticketsLoading');

  loading.style.display = 'block';
  container.style.display = 'none';
  empty.style.display = 'none';

  try {
    const res = await fetch('/api/reports/ticket/' + encodeURIComponent(code));
    const data = await res.json();
    loading.style.display = 'none';

    if (!res.ok || !data || !data.ticket_code) {
      alert('Ticket "' + code + '" not found. Please verify the code.');
      loadMyReports();
      return;
    }

    container.innerHTML = '';
    container.style.display = 'flex';
    renderTicketCard(data, container);

    // Save looked-up ticket to localStorage so it stays in their list
    try {
      const stored = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
      if (!stored.includes(data.ticket_code)) {
        stored.unshift(data.ticket_code);
        localStorage.setItem('bp_my_report_tickets', JSON.stringify(stored));
      }
    } catch (_) {}

  } catch (err) {
    loading.style.display = 'none';
    alert('Lookup failed: ' + err.message);
  }
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

document.addEventListener('DOMContentLoaded', loadMyReports);
</script>
