                <span class="ls-rec-pill" id="lsRecStatusPill" style="display:none;">
                  <span class="ls-rec-dot"></span>
                  <span id="lsRecStatsText">REC 00:00 · 0 MB</span>
                </span>
              </div>

              <div class="ls-lc-ssd-formats">
