        <button type="button" class="ls-btn ls-btn-go-live" id="lsGuardSaveStemsBtn">Save Stems to Downloads &amp; Stay</button>
        <button type="button" class="ls-btn ls-btn-stop" id="lsGuardConfirmLeaveBtn">Discard &amp; Refresh Anyway</button>
      </div>
    </div>
  </dialog>
