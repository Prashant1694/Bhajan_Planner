            <span class="ls-slider-val" id="lsDawMasterTrimVal">0 dB</span>
          </div>

          <div class="ls-daw-master-options">
            <label class="ls-daw-check-label">
              <input type="checkbox" id="lsDawApplyFxCheck" checked>
              Apply Studio Mastering FX Bus
            </label>
            <label class="ls-daw-check-label">
              <input type="checkbox" id="lsDawNoiseGateCheck">
              Noise Gate (-48 dB)
            </label>
            <label class="ls-daw-check-label">
