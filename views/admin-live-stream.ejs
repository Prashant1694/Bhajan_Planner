<%
  const studioJsonFn = typeof safeJson === "function"
    ? safeJson
    : function (v) {
        return JSON.stringify(v)
          .replace(/</g, "\\u003c")
          .replace(/>/g, "\\u003e")
          .replace(/&/g, "\\u0026")
          .replace(/\u2028/g, "\\u2028")
          .replace(/\u2029/g, "\\u2029");
      };
%>

<div class="ls-studio-wrap">
  <!-- UNIFIED TOP COMMAND BAR -->
  <header class="ls-daw-topbar">
    <div class="ls-hero-title-group">
      <div class="ls-status-orb" id="lsStatusOrb"></div>
      <div class="ls-title-stack">
        <h1 class="ls-hero-title">Live Stream Broadcast Studio</h1>
        <p class="ls-hero-sub" id="lsStatusText">Offline — Ready to Connect Interface</p>
      </div>
    </div>

    <!-- Integrated Segmented Mode Switcher -->
    <nav class="ls-studio-tabs" aria-label="Studio Mode">
      <button type="button" class="ls-tab-btn is-active" id="lsTabLiveBtn">1. Live Console</button>
      <button type="button" class="ls-tab-btn" id="lsTabDawBtn">2. Multitrack DAW</button>
    </nav>

    <div class="ls-telemetry-strip">
      <span class="ls-stat-chip" id="lsHwInfoPill">Idle</span>
      <span class="ls-stat-chip live-active">
        <span class="ls-chip-dot"></span>
        Listeners <strong id="lsListenerCount"><%= streamState.listenerCount || 0 %></strong>
      </span>
      <span class="ls-stat-chip ls-mono-chip" id="lsElapsedTime">00:00</span>
      <span class="ls-stat-chip ls-mono-chip" id="lsBytesSent">0.00 MB</span>
    </div>
  </header>

  <div class="ls-warning-banner" id="lsStudioNotice" style="display:none;"></div>

  <div class="ls-warning-banner" id="lsMonoWarning" style="display:none;">
    <strong>Mono Input Detected:</strong> Windows gave Chrome only <strong>1 mono channel</strong>. Set Windows Sound Recording Format to <strong>2 channel, 24-bit, 48000 Hz</strong> and uncheck Exclusive Mode to separate Ch 1 Instruments &amp; Ch 2 Vocals cleanly.
  </div>

  <!-- COMPACT UTILITY DRAWERS (SETUP GUIDE & LOCAL TEST SOURCE) -->
  <div class="ls-utility-drawers">
    <details class="ls-setup-details">
      <summary>
        <span>Hardware &amp; Audition WASAPI Guide</span>
        <span class="ls-badge-pill">Mode A</span>
      </summary>
      <div class="ls-setup-body">
        <div class="ls-setup-step">
          <strong>1. Windows Sound (One-Time)</strong>
          Open <code>mmsys.cpl</code> &rarr; Recording &rarr; Behringer USB Audio &rarr; Advanced: pick <strong>2 ch, 24-bit, 48000 Hz</strong> and disable exclusive control.
        </div>
        <div class="ls-setup-step">
          <strong>2. Simultaneous Capture</strong>
          Record dry 24-bit Ch1 + Ch2 stems directly to your local SSD while streaming live at up to 320 kbps MP3.
        </div>
        <div class="ls-setup-step">
          <strong>3. Zero-Feedback Monitor</strong>
          Turn <strong>Earphone Monitor: ON</strong> and pick headphones to dial EQ, De-Esser &amp; Hall Reverb live.
        </div>
      </div>
    </details>

    <details class="ls-setup-details">
      <summary>
        <span>Local Test Audio Source (No Gear Needed)</span>
        <span class="ls-channel-tag" id="lsTestFileStatus">No test file loaded</span>
      </summary>
      <div class="ls-test-source-body">
        <input type="file" id="lsTestFileInput" accept="audio/*" class="ls-input">
        <label class="ls-checkbox-line">
          <input type="checkbox" id="lsTestFileLoopCheck" checked>
          Loop
        </label>
        <button type="button" class="ls-btn ls-btn-primary" id="lsUseTestFileBtn" disabled>Play Test File</button>
        <button type="button" class="ls-btn" id="lsTestFilePauseBtn" style="display:none;">Pause File</button>
      </div>
    </details>
  </div>

  <!-- ======================================================================
       TAB 1: LIVE CONSOLE & SSD RECORDER
       ====================================================================== -->
  <div id="lsTabLivePane">
    <!-- I/O, Preset & Earphone Monitor Ribbon -->
    <section class="ls-io-ribbon">
      <div class="ls-io-grid">
        <div class="ls-field">
          <label for="lsAudioInputSelect">Audio Interface / Line In</label>
          <div class="ls-inline-ctrl">
            <select class="ls-select" id="lsAudioInputSelect"></select>
            <button type="button" class="ls-btn" id="lsRefreshDevicesBtn" title="Detect or refresh devices">Refresh</button>
            <button type="button" class="ls-btn ls-btn-primary" id="lsSoundcheckBtn">Soundcheck</button>
          </div>
        </div>

        <div class="ls-field">
          <label for="lsInputMode">Routing Matrix</label>
          <div class="ls-inline-ctrl">
            <select class="ls-select" id="lsInputMode">
              <option value="split">Mode A · 2-Ch Split (Ch1 Inst / Ch2 Vocal)</option>
              <option value="stereo">Mode B · Stereo Master Pass-Through</option>
            </select>
            <button type="button" class="ls-btn" id="lsSwapBtn" title="Swap Ch 1 and Ch 2 inputs">Swap 1↔2</button>
          </div>
        </div>

        <div class="ls-field">
          <label for="lsPresetSelect">Studio Rack Preset</label>
          <div class="ls-inline-ctrl">
            <select class="ls-select" id="lsPresetSelect"></select>
            <button type="button" class="ls-btn" id="lsSavePresetBtn">Save</button>
            <button type="button" class="ls-btn" id="lsDeletePresetBtn" disabled>Del</button>
          </div>
        </div>
      </div>

      <div class="ls-monitor-box">
        <button type="button" class="ls-btn" id="lsMonitorToggleBtn">Earphone Monitor: OFF</button>
        <div class="ls-mon-fader">
          <span class="ls-slider-label">Monitor Level</span>
          <input type="range" class="ls-range" id="lsMonitorVol" min="0" max="100" value="80">
          <span class="ls-slider-val" id="lsMonitorVolVal">80%</span>
        </div>
        <div class="ls-field ls-mon-output">
          <select class="ls-select" id="lsMonitorOutputSelect" aria-label="Earphone Output Device"></select>
        </div>
      </div>
    </section>

    <!-- 2-COLUMN CONSOLE WORKSPACE -->
    <div class="ls-main-grid">
      <!-- LEFT COLUMN: CHANNEL STRIPS + MASTER BUS -->
      <div class="ls-col-stack">
        <!-- DUAL-BUS CHANNEL STRIPS -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">Dual-Bus Console Strips <span class="ls-badge-pill">48 kHz DSP</span></h2>
            <span class="ls-channel-tag">Auto-centered stereo sum</span>
          </div>

          <div class="ls-channels-grid" id="lsChannelsGrid">
            <!-- CH 1: INSTRUMENTS -->
            <div class="ls-channel-strip ls-strip-inst">
              <div class="ls-channel-head">
                <div>
                  <div class="ls-channel-name">CH 1 · Instruments</div>
                  <div class="ls-channel-tag">Harmonium, Tabla, Manjira</div>
                </div>
                <span class="ls-clip-pill" id="lsInstClip">CLIP</span>
              </div>
              <div class="ls-meter-bar-bg">
                <div class="ls-meter-fill" id="lsInstMeterFill"></div>
              </div>
              <div class="ls-btn-row ls-strip-switches">
                <button type="button" class="ls-btn ls-btn-mini" id="lsInstMuteBtn">Mute</button>
                <button type="button" class="ls-btn ls-btn-mini" id="lsInstSoloBtn">Solo PFL</button>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">Input Gain</span>
                <input type="range" class="ls-range" id="lsInstGain" min="0" max="200" value="100">
                <span class="ls-slider-val" id="lsInstGainVal">100%</span>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">Low Cut HPF</span>
                <input type="range" class="ls-range" id="lsInstHpf" min="20" max="200" value="45">
                <span class="ls-slider-val" id="lsInstHpfVal">45 Hz</span>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">Low (90 Hz)</span>
                <input type="range" class="ls-range" id="lsInstLow" min="-12" max="12" step="0.5" value="1.5">
                <span class="ls-slider-val" id="lsInstLowVal">1.5 dB</span>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">Mid (450 Hz)</span>
                <input type="range" class="ls-range" id="lsInstMid" min="-12" max="12" step="0.5" value="0">
                <span class="ls-slider-val" id="lsInstMidVal">0 dB</span>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">High (4.5k)</span>
                <input type="range" class="ls-range" id="lsInstHigh" min="-12" max="12" step="0.5" value="-1">
                <span class="ls-slider-val" id="lsInstHighVal">-1 dB</span>
              </div>
            </div>

            <!-- CH 2: VOCALS -->
            <div class="ls-channel-strip ls-strip-vocal">
              <div class="ls-channel-head">
                <div>
                  <div class="ls-channel-name">CH 2 · Vocals</div>
                  <div class="ls-channel-tag">Lead &amp; Chorus Singers</div>
                </div>
                <span class="ls-clip-pill" id="lsVocalClip">CLIP</span>
              </div>
              <div class="ls-meter-bar-bg">
                <div class="ls-meter-fill" id="lsVocalMeterFill"></div>
              </div>
              <div class="ls-btn-row ls-strip-switches">
                <button type="button" class="ls-btn ls-btn-mini" id="lsVocalMuteBtn">Mute</button>
                <button type="button" class="ls-btn ls-btn-mini" id="lsVocalSoloBtn">Solo PFL</button>
                <button type="button" class="ls-btn ls-btn-mini is-toggled" id="lsVocalCompBtn">Vocal Comp: ON</button>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">Vocal Gain</span>
                <input type="range" class="ls-range" id="lsVocalGain" min="0" max="200" value="112">
                <span class="ls-slider-val" id="lsVocalGainVal">112%</span>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">Low Cut HPF</span>
                <input type="range" class="ls-range" id="lsVocalHpf" min="20" max="240" value="85">
                <span class="ls-slider-val" id="lsVocalHpfVal">85 Hz</span>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">Warmth (220)</span>
                <input type="range" class="ls-range" id="lsVocalLow" min="-12" max="12" step="0.5" value="0.5">
                <span class="ls-slider-val" id="lsVocalLowVal">0.5 dB</span>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">Clarity (3.2k)</span>
                <input type="range" class="ls-range" id="lsVocalMid" min="-12" max="12" step="0.5" value="2.5">
                <span class="ls-slider-val" id="lsVocalMidVal">2.5 dB</span>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">Air (9 kHz)</span>
                <input type="range" class="ls-range" id="lsVocalHigh" min="-12" max="12" step="0.5" value="1.5">
                <span class="ls-slider-val" id="lsVocalHighVal">1.5 dB</span>
              </div>
              <div class="ls-slider-row">
                <span class="ls-slider-label">De-Esser (6.5k)</span>
                <input type="range" class="ls-range" id="lsVocalDeesser" min="0" max="12" step="0.5" value="2.5">
                <span class="ls-slider-val" id="lsVocalDeesserVal">-2.5 dB</span>
              </div>
              <div class="ls-gr-row">
                <span>Comp GR</span>
                <div class="ls-gr-track"><div class="ls-gr-fill" id="lsVocalGrBar"></div></div>
                <span class="ls-gr-val" id="lsVocalGrVal">0.0 dB</span>
              </div>
            </div>
          </div>

          <!-- MANDIR HALL REVERB SEND -->
          <div class="ls-reverb-bar">
            <div class="ls-reverb-label">
              <span class="ls-channel-name">Mandir Hall Reverb</span>
              <span class="ls-channel-tag">Stereo Convolution Send</span>
            </div>
            <div class="ls-slider-row ls-slider-compact">
              <span class="ls-slider-label">Reverb Mix</span>
              <input type="range" class="ls-range" id="lsReverbWet" min="0" max="45" step="1" value="14">
              <span class="ls-slider-val" id="lsReverbWetVal">14%</span>
            </div>
            <div class="ls-slider-row ls-slider-compact">
              <span class="ls-slider-label">Hall Decay</span>
              <input type="range" class="ls-range" id="lsReverbDecay" min="0.5" max="2.6" step="0.1" value="1.4">
              <span class="ls-slider-val" id="lsReverbDecayVal">1.4s</span>
            </div>
          </div>
        </section>

        <!-- MASTER BUS & LIVE RTA SPECTRUM -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">Master Bus EQ, Glue &amp; Limiter</h2>
            <div class="ls-btn-row">
              <span class="ls-clip-pill" id="lsMasterClip">MASTER CLIP</span>
              <button type="button" class="ls-btn ls-btn-mini" id="lsMasterBypassBtn">EQ Active</button>
              <button type="button" class="ls-btn ls-btn-mini is-toggled" id="lsGlueCompBtn">Glue Comp: ON</button>
              <button type="button" class="ls-btn ls-btn-mini is-toggled" id="lsLimiterBtn">Limiter: ON (-1.5dB)</button>
            </div>
          </div>

          <div class="ls-eq-canvas-wrap">
            <canvas id="lsEqSpectrumCanvas" width="600" height="126"></canvas>
          </div>

          <div class="ls-master-meters">
            <div class="ls-meter-bar-bg">
              <div class="ls-meter-fill" id="lsMasterMeterFill"></div>
            </div>
            <div class="ls-gr-row">
              <span>Limiter GR</span>
              <div class="ls-gr-track"><div class="ls-gr-fill" id="lsLimiterGrBar"></div></div>
              <span class="ls-gr-val" id="lsLimiterGrVal">0.0 dB</span>
            </div>
          </div>

          <div class="ls-eq-bands-grid">
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">80 Hz</div>
              <div class="ls-eq-db" id="lsMaster80Val">0.5 dB</div>
              <input type="range" class="ls-range" id="lsMaster80" min="-12" max="12" step="0.5" value="0.5">
            </div>
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">250 Hz</div>
              <div class="ls-eq-db" id="lsMaster250Val">-1.5 dB</div>
              <input type="range" class="ls-range" id="lsMaster250" min="-12" max="12" step="0.5" value="-1.5">
            </div>
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">1 kHz</div>
              <div class="ls-eq-db" id="lsMaster1kVal">0 dB</div>
              <input type="range" class="ls-range" id="lsMaster1k" min="-12" max="12" step="0.5" value="0">
            </div>
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">3.5 kHz</div>
              <div class="ls-eq-db" id="lsMaster3k5Val">1.5 dB</div>
              <input type="range" class="ls-range" id="lsMaster3k5" min="-12" max="12" step="0.5" value="1.5">
            </div>
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">10 kHz</div>
              <div class="ls-eq-db" id="lsMaster10kVal">1 dB</div>
              <input type="range" class="ls-range" id="lsMaster10k" min="-12" max="12" step="0.5" value="1">
            </div>
          </div>

          <div class="ls-slider-row ls-slider-compact" style="margin-top:8px;">
            <span class="ls-slider-label">Master Out</span>
            <input type="range" class="ls-range" id="lsMasterGain" min="0" max="160" value="100">
            <span class="ls-slider-val" id="lsMasterGainVal">100%</span>
          </div>
        </section>
      </div>

      <!-- RIGHT COLUMN: ON-AIR STREAM + NOW SINGING + SSD/R2 PUBLISH -->
      <div class="ls-col-stack">
        <!-- ON AIR BROADCAST CONTROL -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">Broadcast Control</h2>
            <span class="ls-badge-pill">Up to 320 kbps MP3</span>
          </div>

          <div class="ls-field" style="margin-bottom:10px;">
            <label for="lsStreamTitle">Session Title</label>
            <input type="text" class="ls-input" id="lsStreamTitle" value="Thursday Evening Bhajan Satsang" maxlength="120">
          </div>

          <div class="ls-form-row">
            <div class="ls-field">
              <label for="lsBitrateSelect">Stream Quality</label>
              <select class="ls-select" id="lsBitrateSelect">
                <option value="320" selected>320 kbps Stereo (HQ)</option>
                <option value="256">256 kbps Stereo (High)</option>
                <option value="192">192 kbps Stereo (Balanced)</option>
                <option value="128">128 kbps Stereo (Low Wi-Fi)</option>
              </select>
            </div>
            <div class="ls-field">
              <label for="lsAccessModeSelect">Audience</label>
              <select class="ls-select" id="lsAccessModeSelect">
                <option value="public" selected>Public (All Visitors)</option>
                <option value="singers_only">Signed-In Singers Only</option>
              </select>
            </div>
          </div>

          <div class="ls-check-stack">
            <label class="ls-checkbox-line">
              <input type="checkbox" id="lsNotifyDevoteesCheck" checked>
              Push notify devotees on Go Live
            </label>
            <label class="ls-checkbox-line">
              <input type="checkbox" id="lsBackupRecordCheck" checked>
              Keep in-browser 320 kbps MP3 fallback copy
            </label>
          </div>

          <div class="ls-btn-row ls-transport-actions">
            <button type="button" class="ls-btn ls-btn-go-live" id="lsGoLiveBtn">Go Live Now</button>
            <button type="button" class="ls-btn ls-btn-stop" id="lsStopBtn" disabled>End Stream</button>
            <button type="button" class="ls-btn" id="lsBroadcastMuteBtn">Mute</button>
          </div>

          <div class="ls-backup-box" id="lsBackupBox" style="display:none;">
            <div>
              <strong>Browser Master Backup Ready</strong>
              <div class="ls-hero-sub" id="lsBackupSizeText"></div>
            </div>
            <a class="ls-btn ls-btn-primary" id="lsBackupDownloadLink" href="#" download="bhajan-live.mp3" style="text-decoration:none;">Download</a>
          </div>
        </section>

        <!-- NOW SINGING QUEUE SYNC -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">"Now Singing" Live Sync</h2>
            <button type="button" class="ls-btn ls-btn-mini" id="lsClearNowSingingBtn">Clear</button>
          </div>

          <div class="ls-date-bar">
            <input type="date" class="ls-input" id="lsSessionDateInput" value="<%= sessionDate %>" aria-label="Session Date">
            <button type="button" class="ls-btn" id="lsLoadDateBhajansBtn">Load Session</button>
          </div>

          <div class="ls-now-singing-banner">
            <span class="ls-channel-tag">On Player:</span>
            <strong id="lsNowSingingCurrent"><%= streamState.nowSinging ? (streamState.nowSinging.title + (streamState.nowSinging.singerName ? ' — ' + streamState.nowSinging.singerName : '')) : 'None selected' %></strong>
          </div>

          <div class="ls-bhajan-list" id="lsBhajanPickerList"></div>
        </section>

        <!-- MULTITRACK SSD RECORDER & R2 CLOUD PUBLISH -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">SSD Recorder &amp; Cloudflare R2</h2>
            <span class="ls-badge-pill"><%= r2Status && r2Status.configured ? ('R2 · ' + (r2Status.bucketName || 'Ready')) : 'R2 Keys Missing' %></span>
          </div>

          <div class="ls-subpanel">
            <div class="ls-channel-head">
              <div>
                <div class="ls-channel-name">Direct-to-SSD Capture</div>
                <div class="ls-channel-tag" id="lsRecFolderLabel">No SSD folder chosen (downloads on stop)</div>
              </div>
              <span class="ls-rec-pill" id="lsRecStatusPill" style="display:none;">
                <span class="ls-rec-dot"></span>
                <span id="lsRecStatsText">REC 00:00 · 0 MB</span>
              </span>
            </div>

            <div class="ls-form-row">
              <div class="ls-field">
                <label for="lsDryBitDepthSelect">Dry Stems Format</label>
                <select class="ls-select" id="lsDryBitDepthSelect">
                  <option value="24" selected>24-bit / 48 kHz WAV</option>
                  <option value="32">32-bit Float / 48 kHz</option>
                  <option value="16">16-bit / 48 kHz WAV</option>
                </select>
              </div>
              <div class="ls-field">
                <label for="lsPublishBitrateSelect">R2 Publish MP3</label>
                <select class="ls-select" id="lsPublishBitrateSelect">
                  <option value="112" selected>112 kbps (~50 MB/hr)</option>
                  <option value="128">128 kbps Stereo</option>
                  <option value="192">192 kbps Stereo</option>
                  <option value="320">320 kbps Stereo</option>
                </select>
              </div>
            </div>

            <div class="ls-inline-checks">
              <label class="ls-checkbox-line"><input type="checkbox" id="lsRecDryCh1Check" checked> Ch1 Dry WAV</label>
              <label class="ls-checkbox-line"><input type="checkbox" id="lsRecDryCh2Check" checked> Ch2 Dry WAV</label>
              <label class="ls-checkbox-line"><input type="checkbox" id="lsRecMasterCheck" checked> Master MP3</label>
            </div>

            <div class="ls-btn-row">
              <button type="button" class="ls-btn" id="lsPickSsdFolderBtn">Choose Folder</button>
              <button type="button" class="ls-btn ls-btn-primary" id="lsStartRecOnlyBtn">Start Rec</button>
              <button type="button" class="ls-btn ls-btn-go-live ls-btn-sm" id="lsRecordAndLiveBtn">Rec + Go Live</button>
              <button type="button" class="ls-btn ls-btn-stop ls-btn-sm" id="lsStopRecBtn" disabled>Stop Rec</button>
            </div>

            <div id="lsFallbackDownloadsList" class="ls-fallback-links"></div>
          </div>

          <div class="ls-subpanel" style="margin-top:12px;">
            <div class="ls-channel-head">
              <div>
                <div class="ls-channel-name">Cloudflare R2 Publish</div>
                <div class="ls-channel-tag" id="lsR2SourceLabel">Waiting for session MP3 or DAW mix</div>
              </div>
              <button type="button" class="ls-btn-mini" id="lsExportAuditionCsvBtn">Audition CSV</button>
            </div>

            <div class="ls-form-row">
              <div class="ls-field">
                <label for="lsR2KeyInput">R2 Object Key</label>
                <input type="text" class="ls-input" id="lsR2KeyInput" value="recordings/<%= sessionDate %>-session.mp3">
              </div>
              <div class="ls-field">
                <label for="lsR2TitleInput">Session Title</label>
                <input type="text" class="ls-input" id="lsR2TitleInput" value="Bhajan Session – <%= sessionDate %>">
              </div>
            </div>

            <div class="ls-field" style="margin-bottom:10px;">
              <label for="lsR2CustomFileInput">Custom MP3 File Override</label>
              <input type="file" id="lsR2CustomFileInput" accept="audio/mpeg,.mp3" class="ls-input">
            </div>

            <div class="ls-ts-header">
              <span class="ls-slider-label">Bhajan Timestamps (<span id="lsTsCount">0</span>)</span>
              <button type="button" class="ls-btn-mini" id="lsAddManualTsBtn">+ Timestamp</button>
            </div>
            <div class="ls-ts-list" id="lsTimestampsList"></div>

            <label class="ls-checkbox-line" style="margin-bottom:10px;">
              <input type="checkbox" id="lsR2NotifyDevoteesCheck" checked>
              Notify devotees when audio publishes
            </label>

            <div class="ls-progress-track" id="lsR2ProgressWrap" style="display:none;">
              <div class="ls-progress-fill" id="lsR2ProgressFill"></div>
            </div>
            <div class="ls-hero-sub" id="lsR2StatusText" style="margin-bottom:8px;"></div>

            <button type="button" class="ls-btn ls-btn-primary" id="lsPublishR2Btn" style="width:100%;" disabled>
              Upload MP3 to Cloudflare R2 &amp; Publish
            </button>
          </div>
        </section>
      </div>
    </div>
  </div><!-- /#lsTabLivePane -->

  <!-- ======================================================================
       TAB 2: UNIFIED MODERN MULTITRACK DAW WORKSPACE
       ====================================================================== -->
  <div id="lsTabDawPane" style="display:none;">
    <div class="ls-daw-shell">
      <!-- ZONE 1: DAW TRANSPORT, EDIT TOOLS, TRACK OPS & MEDIA LOADERS -->
      <div class="ls-daw-transport-bar">
        <div class="ls-btn-row">
          <button type="button" class="ls-btn ls-btn-primary" id="lsDawPlayBtn">Play</button>
          <button type="button" class="ls-btn" id="lsDawStopBtn">Stop</button>
          <span class="ls-daw-timecode" id="lsDawTimecode">00:00.0 / 00:00</span>
        </div>

        <div class="ls-btn-row ls-tool-cluster">
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawSplitBtn" title="Split clip at playhead (S)">Split</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawSetInBtn" title="Mark start of range (I)">In</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawSetOutBtn" title="Mark end of range (O)">Out</button>
          <button type="button" class="ls-btn ls-btn-go-live ls-btn-sm" id="lsDawRippleCutBtn" title="Ripple delete selected range">Ripple Cut</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawDeleteClipBtn" title="Delete clip and crossfade">Del Clip</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawAddMarkerBtn">+ Marker</button>
        </div>

        <div class="ls-btn-row ls-tool-cluster">
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawAddTrackBtn">+ Track</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawDeleteTrackBtn">Del Track</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawSelectMasterBtn">Master FX</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawUndoBtn" disabled>Undo</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawRedoBtn" disabled>Redo</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawZoomOutBtn">-</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawZoomInBtn">+</button>
          <button type="button" class="ls-btn ls-btn-mini" id="lsDawZoomFitBtn">Fit</button>
        </div>

        <div class="ls-btn-row">
          <button type="button" class="ls-btn ls-btn-primary ls-btn-sm" id="lsDawAutoLoadRecBtn" disabled>Load Recording</button>
          <label class="ls-btn ls-btn-mini" style="cursor:pointer;">
            Open File
            <input type="file" id="lsDawSingleFileInput" accept="audio/*" style="display:none;">
          </label>
          <label class="ls-btn ls-btn-mini" style="cursor:pointer;">
            + Join Clip
            <input type="file" id="lsDawAppendFileInput" accept="audio/*" style="display:none;">
          </label>
        </div>
      </div>

      <details class="ls-daw-stems-drawer">
        <summary>Import Dual Dry Stems (Ch 1 Instruments + Ch 2 Vocals WAV)</summary>
        <div class="ls-daw-stems-row">
          <div class="ls-field">
            <label for="lsDawFileCh1Input">Track 1 · Ch 1 Dry WAV</label>
            <input type="file" id="lsDawFileCh1Input" accept="audio/*" class="ls-input">
          </div>
          <div class="ls-field">
            <label for="lsDawFileCh2Input">Track 2 · Ch 2 Dry WAV</label>
            <input type="file" id="lsDawFileCh2Input" accept="audio/*" class="ls-input">
          </div>
          <button type="button" class="ls-btn ls-btn-primary" id="lsDawLoadStemsBtn">Load 2-Track Stems</button>
        </div>
      </details>

      <input type="file" id="lsDawTrackFileInput" accept="audio/*" style="display:none;">

      <!-- Timeline Status Bar -->
      <div class="ls-daw-infobar">
        <span id="lsDawStatusText">Load recorded stems or any audio file to edit, mix &amp; master.</span>
        <strong id="lsDawSelectionLabel">Drag waveform to select cut range</strong>
      </div>

      <!-- ZONE 2: ARRANGEMENT TIMELINE -->
      <div class="ls-daw-workspace">
        <div class="ls-daw-track-headers" id="lsDawTrackHeaders">
          <div class="ls-daw-track-box is-selected">
            <div class="ls-channel-name">Track 1 · Instruments</div>
            <input type="range" class="ls-range" id="lsDawTrack1Gain" min="0" max="180" value="100">
            <div class="ls-btn-row">
              <button type="button" class="ls-btn-mini" id="lsDawTrack1Mute">M</button>
              <button type="button" class="ls-btn-mini" id="lsDawTrack1Solo">S</button>
            </div>
          </div>
          <div class="ls-daw-track-box">
            <div class="ls-channel-name">Track 2 · Vocals</div>
            <input type="range" class="ls-range" id="lsDawTrack2Gain" min="0" max="180" value="100">
            <div class="ls-btn-row">
              <button type="button" class="ls-btn-mini" id="lsDawTrack2Mute">M</button>
              <button type="button" class="ls-btn-mini" id="lsDawTrack2Solo">S</button>
            </div>
          </div>
        </div>
        <div class="ls-daw-canvas-scroll" id="lsDawCanvasWrap">
          <canvas id="lsDawCanvas"></canvas>
        </div>
      </div>

      <!-- ZONE 3: MODULAR PER-TRACK & MASTER EFFECTS RACK -->
      <div class="ls-fx-rack-panel" id="lsDawFxRackPanel">
        <div class="ls-fx-rack-header">
          <div class="ls-fx-rack-title-wrap">
            <h3 class="ls-card-title">
              Track Effects &amp; Mastering Rack
              <span class="ls-badge-pill" id="lsDawFxActiveTrackLabel">Track 1 · Instruments</span>
            </h3>
            <span class="ls-channel-tag">Per-track modular insert chain · Real-time live preview &amp; offline mixdown</span>
          </div>
          <div class="ls-btn-row">
            <select class="ls-select ls-select-sm" id="lsDawFxTrackSelect"></select>
            <select class="ls-select ls-select-sm" id="lsDawAddFxSelect">
              <option value="eq">+ 5-Band Parametric EQ</option>
              <option value="filter">+ HPF / LPF Filter</option>
              <option value="compressor">+ Dynamics Compressor</option>
              <option value="deesser">+ Vocal De-Esser</option>
              <option value="reverb">+ Mandir Hall Reverb</option>
              <option value="delay">+ Stereo Echo / Delay</option>
              <option value="saturation">+ Tape / Tube Warmth</option>
              <option value="limiter">+ Brickwall Limiter</option>
            </select>
            <button type="button" class="ls-btn ls-btn-primary ls-btn-sm" id="lsDawAddFxBtn">+ Add Effect</button>
            <button type="button" class="ls-btn ls-btn-sm" id="lsDawImportLiveFxBtn">Import Live Mixer FX</button>
          </div>
        </div>

        <div class="ls-fx-rack-grid">
          <div class="ls-fx-slot-list" id="lsDawFxSlotList"></div>
          <div class="ls-fx-editor" id="lsDawFxEditorPane">
            <div class="ls-hero-sub">Select an effect slot or click <strong>+ Add Effect</strong> to shape this track's tone.</div>
          </div>
        </div>
      </div>

      <!-- ZONE 4: CLIP INSPECTOR & FINAL MASTERING RENDER -->
      <div class="ls-daw-bottom-dock">
        <div class="ls-daw-dock-pane" id="lsDawInspectorBox">
          <div class="ls-channel-head">
            <div class="ls-channel-name">Clip Inspector: <span id="lsDawSelectedClipLabel">None</span></div>
          </div>
          <div class="ls-slider-row">
            <span class="ls-slider-label">Clip Gain</span>
            <input type="range" class="ls-range" id="lsDawClipGain" min="-18" max="12" step="0.5" value="0">
            <span class="ls-slider-val" id="lsDawClipGainVal">0 dB</span>
          </div>
          <div class="ls-slider-row">
            <span class="ls-slider-label">Fade In</span>
            <input type="range" class="ls-range" id="lsDawClipFadeIn" min="0" max="8" step="0.1" value="0">
            <span class="ls-slider-val" id="lsDawClipFadeInVal">0s</span>
          </div>
          <div class="ls-slider-row">
            <span class="ls-slider-label">Fade Out</span>
            <input type="range" class="ls-range" id="lsDawClipFadeOut" min="0" max="8" step="0.1" value="0">
            <span class="ls-slider-val" id="lsDawClipFadeOutVal">0s</span>
          </div>
          <div class="ls-slider-row">
            <span class="ls-slider-label">Crossfade</span>
            <input type="range" class="ls-range" id="lsDawClipCrossfade" min="0" max="2" step="0.05" value="0">
            <span class="ls-slider-val" id="lsDawClipCrossfadeVal">0s</span>
          </div>
          <div class="ls-trim-row">
            <div class="ls-field">
              <label for="lsDawTrimStart">Start (s)</label>
              <input type="number" step="0.1" min="0" class="ls-input" id="lsDawTrimStart" value="0">
            </div>
            <div class="ls-field">
              <label for="lsDawTrimEnd">End (s)</label>
              <input type="number" step="0.1" min="0" class="ls-input" id="lsDawTrimEnd" value="0">
            </div>
            <button type="button" class="ls-btn" id="lsDawApplyTrimBtn">Apply Trim</button>
          </div>
        </div>

        <div class="ls-daw-dock-pane">
          <div class="ls-channel-head">
            <div class="ls-channel-name">Master Export &amp; Cloudflare R2 Delivery</div>
            <span class="ls-badge-pill">112k Default</span>
          </div>

          <div class="ls-daw-master-options">
            <label class="ls-daw-check-label">
              <input type="checkbox" id="lsDawApplyFxCheck" checked>
              Apply Studio Mastering FX Bus
            </label>
            <label class="ls-daw-check-label">
              <input type="checkbox" id="lsDawNoiseGateCheck">
              Noise Gate (-48 dB)
            </label>
            <label class="ls-daw-check-label">
              Loudness:
              <select class="ls-select ls-select-sm" id="lsDawLufsSelect">
                <option value="-14" selected>-14 LUFS (Streaming)</option>
                <option value="-16">-16 LUFS (Dynamic)</option>
                <option value="off">Off</option>
              </select>
            </label>
            <span class="ls-loudness-pill" id="lsDawLoudnessReport" style="display:none;"></span>
          </div>

          <div class="ls-progress-track" id="lsDawRenderProgressWrap" style="display:none;">
            <div class="ls-progress-fill" id="lsDawRenderProgressFill"></div>
          </div>

          <div class="ls-btn-row" style="margin-top:10px;">
            <button type="button" class="ls-btn ls-btn-primary" id="lsDawRenderBtn" disabled>Render Edited MP3</button>
            <button type="button" class="ls-btn ls-btn-go-live ls-btn-sm" id="lsDawRenderPublishBtn" disabled>Render &amp; Upload R2</button>
            <a class="ls-btn" id="lsDawDownloadRenderedBtn" href="#" download="edited-session.mp3" style="display:none;text-decoration:none;">Download MP3</a>
          </div>

          <div class="ls-kbd-hints">
            <strong>Space</strong> Play/Pause · <strong>S</strong> Split · <strong>I</strong>/<strong>O</strong> In/Out · <strong>M</strong> Mute · <strong>Ctrl+Z</strong> Undo · <strong>Ctrl+Y</strong> Redo
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.__LIVE_STUDIO_BOOT__ = {
    sessionDate: <%- studioJsonFn(sessionDate) %>,
    bhajans: <%- studioJsonFn(scheduledBhajans) %>,
    presets: <%- studioJsonFn(presets) %>,
    streamState: <%- studioJsonFn(streamState) %>,
    r2Status: <%- studioJsonFn(typeof r2Status !== "undefined" ? r2Status : { configured: false }) %>
  };
</script>
<script src="/js/live-stream-wav-utils.js?v=3.0"></script>
<script src="/js/live-stream-dsp.js?v=3.0"></script>
<script src="/js/live-stream-recorder.js?v=3.0"></script>
<script src="/js/live-stream-daw-engine.js?v=3.0"></script>
<script src="/js/live-stream-daw-ui.js?v=3.0"></script>
<script src="/js/live-stream-studio.js?v=3.0"></script>
