<% const studioJsonFn=typeof safeJson==="function" ? safeJson : function (v) { return JSON.stringify(v)
  .replace(/</g, "\\u003c" ) .replace( />/g, "\\u003e")
.replace(/&/g, "\\u0026")
.replace(/\u2028/g, "\\u2028")
.replace(/\u2029/g, "\\u2029");
};
%>

<div class="ls-studio-wrap">
  <!-- UNIFIED STUDIO HEADER & MODE SWITCHER -->
  <header class="ls-daw-topbar">
    <div class="ls-hero-title-group">
      <div class="ls-brand-emblem" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="2.2" />
          <path
            d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48 0a6 6 0 0 1 0-8.49m11.31-2.83a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14" />
        </svg>
      </div>
      <div class="ls-status-orb" id="lsStatusOrb"></div>
      <div class="ls-title-stack">
        <h1 class="ls-hero-title">Live Stream Broadcast Studio</h1>
        <p class="ls-hero-sub" id="lsStatusText">Offline — Ready to Connect Interface</p>
      </div>
    </div>

    <!-- Segmented Console / Multitrack DAW Switcher -->
    <nav class="ls-studio-tabs" aria-label="Studio Mode">
      <button type="button" class="ls-tab-btn is-active" id="lsTabLiveBtn">1. Live Console</button>
      <button type="button" class="ls-tab-btn" id="lsTabDawBtn">2. Multitrack DAW</button>
    </nav>

    <!-- Telemetry Strip -->
    <div class="ls-telemetry-strip">
      <span class="ls-stat-chip" id="lsHwInfoPill">Idle</span>
      <span class="ls-stat-chip<%= streamState && streamState.isLive ? ' live-active' : '' %>" id="lsListenerChip">
        <span class="ls-chip-dot"></span>
        Listeners <strong id="lsListenerCount">
          <%= streamState.listenerCount || 0 %>
        </strong>
      </span>
      <span class="ls-stat-chip ls-mono-chip" id="lsElapsedTime" title="Broadcast / Session Duration">00:00</span>
      <span class="ls-stat-chip ls-mono-chip" id="lsBytesSent" title="Streamed / Recorded Data">0.00 MB</span>
      <button type="button" class="ls-btn-mini ls-theme-quick-btn admin-theme-toggle-btn" id="lsStudioThemeToggleBtn"
        title="Toggle Light / Dark Theme" aria-label="Toggle Light or Dark Theme">
        <span class="ls-icon-moon" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </span>
        <span class="ls-icon-sun" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
        </span>
      </button>
    </div>
  </header>

  <!-- LOCAL-FIRST WORKSTATION RESOURCE & COST MONITOR -->
  <div class="ls-resource-strip" id="lsResourceStrip" aria-label="Local Workstation Resource Monitor">
    <div class="ls-resource-metrics">
      <span class="ls-res-item">DSP/CPU: <strong id="lsResEngineLoad">Idle</strong></span>
      <span class="ls-res-item">RAM: <strong id="lsResHeap">--</strong></span>
      <span class="ls-res-item">XRuns: <strong id="lsResXruns">0</strong></span>
      <span class="ls-res-item">SSD Free: <strong id="lsResDiskFree">Checking...</strong></span>
      <span class="ls-res-item">R2 Queue: <strong id="lsResPendingUploads">0 queued</strong></span>
    </div>
    <span class="ls-badge-pill ls-badge-blue" title="All DSP, mixing, recording & mastering runs locally on laptop">
      Local Workstation · Zero Cloud DSP Cost
    </span>
  </div>

  <div class="ls-warning-banner" id="lsStudioNotice" style="display:none;"></div>

  <div class="ls-warning-banner" id="lsMonoWarning" style="display:none;">
    <strong>Mono Input Detected:</strong> Windows gave Chrome only <strong>1 mono channel</strong>. Set Windows Sound
    Recording Format to <strong>2 channel, 24-bit, 48000 Hz</strong> and disable Exclusive Mode, OR select <strong>Local Native ASIO Bridge</strong>.
  </div>

  <!-- ======================================================================
       TAB 1: LIVE BROADCAST CONSOLE & SSD RECORDER
       ====================================================================== -->
  <div id="lsTabLivePane">
    <!-- Hardware I/O, Capture Backend, Routing Matrix, Preset Rack & Earphone Monitor -->
    <details class="ls-io-ribbon" id="lsIoRibbonDetails" open aria-label="Audio Hardware and Routing">
      <summary class="ls-io-summary">
        <span class="ls-io-summary-left">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="6" width="20" height="12" rx="2" />
            <circle cx="8" cy="12" r="2" />
            <circle cx="16" cy="12" r="2" />
          </svg>
          <span>Audio Hardware, Routing Matrix &amp; Studio Rack</span>
        </span>
        <span class="ls-io-summary-right">
          <span class="ls-badge-pill ls-badge-blue" id="lsIoSummaryTag">Mode A · 2-Ch Split</span>
          <span class="ls-io-chevron" aria-hidden="true">▾</span>
        </span>
      </summary>
      <div class="ls-io-body">
      <div class="ls-io-grid">
        <div class="ls-field">
          <label for="lsAudioInputSelect">Capture Driver &amp; Audio Interface</label>
          <div class="ls-inline-ctrl">
            <select class="ls-select" id="lsCaptureBackendSelect" style="max-width:168px;" title="Capture Backend">
              <option value="wasapi" selected>Browser WASAPI (Shared)</option>
              <option value="asio">Audio Bridge · Exclusive / ASIO (17940)</option>
            </select>
            <select class="ls-select" id="lsAudioInputSelect" aria-label="Audio Input Device"></select>
            <button type="button" class="ls-btn" id="lsRefreshDevicesBtn"
              title="Detect or refresh devices">Refresh</button>
            <button type="button" class="ls-btn ls-is-hidden" id="lsOpenAsioPanelBtn"
              title="Open native ASIO Driver Control Panel">ASIO Panel</button>
            <button type="button" class="ls-btn ls-btn-primary" id="lsSoundcheckBtn"
              title="Engage audio engine for live monitoring &amp; meters">Start Audio Soundcheck</button>
          </div>
        </div>

        <div class="ls-field">
          <label for="lsInputMode">Routing Matrix (In 1 = Vocals · In 2 = Inst)</label>
          <div class="ls-inline-ctrl">
            <select class="ls-select" id="lsInputMode">
              <option value="split" selected>Mode A · 2-Ch Split (In1 Vocal / In2 Inst)</option>
              <option value="stereo">Mode B · Stereo Master Pass-Through</option>
            </select>
            <button type="button" class="ls-btn" id="lsSwapBtn" title="Swap Ch 1 and Ch 2 inputs">Swap 1↔2</button>
          </div>
        </div>

        <div class="ls-field">
          <label for="lsPresetSelect">Studio Rack Preset</label>
          <div class="ls-inline-ctrl">
            <select class="ls-select" id="lsPresetSelect"></select>
            <button type="button" class="ls-btn" id="lsSavePresetBtn"
              title="Save current console settings">Save</button>
            <button type="button" class="ls-btn" id="lsExportPresetBtn"
              title="Export preset JSON">Exp</button>
            <label class="ls-btn" style="cursor:pointer;margin:0;" title="Import preset JSON">
              Imp
              <input type="file" id="lsImportPresetFileInput" accept="application/json,.json" style="display:none;">
            </label>
            <button type="button" class="ls-btn" id="lsDeletePresetBtn" disabled
              title="Delete custom preset">Del</button>
          </div>
        </div>
      </div>

      <div class="ls-monitor-box">
        <button type="button" class="ls-btn" id="lsMonitorToggleBtn">Earphone Monitor: OFF</button>
        <div class="ls-mon-fader">
          <span class="ls-slider-label">Monitor Level</span>
          <input type="range" class="ls-range" id="lsMonitorVol" min="0" max="100" value="80">
          <span class="ls-slider-val" id="lsMonitorVolVal">80%</span>
        </div>
        <div class="ls-field ls-mon-output">
          <select class="ls-select" id="lsMonitorOutputSelect" aria-label="Earphone Output Device"></select>
        </div>
      </div>
      </div>
    </details>

    <!-- COMPACT UTILITY DRAWERS -->
    <div class="ls-utility-drawers">
      <details class="ls-setup-details" id="lsSoundcheckDrawer">
        <summary>
          <span>Dual-Input Hardware Soundcheck &amp; ASIO Bridge</span>
          <span class="ls-badge-pill" id="lsScSummaryBadge">Check I/O</span>
        </summary>
        <div class="ls-soundcheck-grid">
          <div class="ls-sc-stat-card">
            <div class="ls-sc-stat-label">Interface &amp; Driver</div>
            <div class="ls-sc-stat-val" id="lsScDeviceName">Not engaged</div>
            <div class="ls-channel-tag" id="lsScFormat">48 kHz · 2 ch pending</div>
            <div class="ls-channel-tag" id="lsScConnBadge">Disconnected</div>
          </div>
          <div class="ls-sc-stat-card">
            <div class="ls-sc-stat-label">Channel Isolation / Corr</div>
            <div class="ls-sc-stat-val" id="lsScCorrBadge">--</div>
            <div class="ls-channel-tag" id="lsScNoiseBadge">Noise Floor: -- dBFS</div>
            <div class="ls-channel-tag" id="lsScCh1Stats">In 1 (Vocals): -- dBFS</div>
            <div class="ls-channel-tag" id="lsScCh2Stats">In 2 (Inst): -- dBFS</div>
          </div>
          <div class="ls-sc-stat-card" style="grid-column: span 2;">
            <div class="ls-sc-stat-label">3-Stage Verification Wizard &amp; Hardware Buffer</div>
            <div class="ls-btn-row" style="margin-top:4px;flex-wrap:wrap;gap:6px;">
              <button type="button" class="ls-btn-mini ls-btn-primary" id="lsScStage1Btn">1. Test Vocals (In 1)</button>
              <button type="button" class="ls-btn-mini" id="lsScStage2Btn">2. Test Inst (In 2)</button>
              <button type="button" class="ls-btn-mini" id="lsScStage3Btn">3. Test Both</button>
              <select class="ls-select" id="lsHwSampleRateSelect" style="max-width:112px;height:28px;font-size:11px;" title="Target Hardware Sample Rate">
                <option value="48000" selected>48000 Hz</option>
                <option value="44100">44100 Hz</option>
              </select>
              <select class="ls-select" id="lsHwBufferSelect" style="max-width:128px;height:28px;font-size:11px;" title="AudioWorklet Latency Mode">
                <option value="interactive" selected>Low Latency</option>
                <option value="balanced">Balanced</option>
                <option value="playback">Safe Buffer</option>
              </select>
              <label class="ls-checkbox-line" style="font-size:10.5px;">
                <input type="checkbox" id="lsScSingleOkCheck"> Allow 1-Ch Mode
              </label>
            </div>
            <div class="ls-hero-sub" id="lsScStatusText" style="margin-top:4px;">
              Engage Soundcheck, speak into Vocals (In 1), then play Instruments (In 2). For Windows Bridge, run <code>python scripts/local_asio_bridge.py</code>.
            </div>
          </div>
        </div>
      </details>

      <details class="ls-setup-details">
        <summary>
          <span>Local Test Audio Source (No Gear Needed)</span>
          <span class="ls-channel-tag" id="lsTestFileStatus">No test file loaded</span>
        </summary>
        <div class="ls-test-source-body">
          <input type="file" id="lsTestFileInput" accept="audio/*" class="ls-input" aria-label="Load local test audio">
          <label class="ls-checkbox-line">
            <input type="checkbox" id="lsTestFileLoopCheck" checked>
            Loop
          </label>
          <button type="button" class="ls-btn ls-btn-primary" id="lsUseTestFileBtn" disabled>Play Test File</button>
          <button type="button" class="ls-btn" id="lsTestFilePauseBtn" style="display:none;">Pause File</button>
        </div>
      </details>
    </div>

    <!-- 2-COLUMN CONSOLE CONTROL ROOM -->
    <div class="ls-main-grid">
      <!-- LEFT PRIMARY CONSOLE: MASTER BUS EQ + VERTICAL MIXER + CHANNEL PROCESSOR -->
      <div class="ls-col-stack">
        <!-- MASTER BUS EQ, GLUE & LIMITER -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">
              <span class="ls-title-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="4" y1="21" x2="4" y2="14" />
                  <line x1="4" y1="10" x2="4" y2="3" />
                  <line x1="12" y1="21" x2="12" y2="12" />
                  <line x1="12" y1="8" x2="12" y2="3" />
                  <line x1="20" y1="21" x2="20" y2="16" />
                  <line x1="20" y1="12" x2="20" y2="3" />
                  <line x1="1" y1="14" x2="7" y2="14" />
                  <line x1="9" y1="8" x2="15" y2="8" />
                  <line x1="17" y1="16" x2="23" y2="16" />
                </svg>
              </span>
              <span>Master Bus EQ, Glue &amp; Limiter</span>
            </h2>
            <div class="ls-btn-row">
              <span class="ls-clip-pill" id="lsMasterClip">MASTER CLIP</span>
              <button type="button" class="ls-btn-mini" id="lsMasterBypassBtn">EQ Active</button>
              <button type="button" class="ls-btn-mini is-toggled" id="lsGlueCompBtn">Glue Comp: ON</button>
              <button type="button" class="ls-btn-mini is-toggled" id="lsLimiterBtn">Limiter: ON (-1.0 dBTP)</button>
            </div>
          </div>

          <!-- Adaptive Master EQ Curve + Vertical Master Stereo Meter Bay -->
          <div class="ls-master-scope-layout">
            <div class="ls-eq-canvas-wrap">
              <canvas id="lsEqSpectrumCanvas" width="720" height="164"></canvas>
            </div>

            <div class="ls-master-meter-bay">
              <div class="ls-master-stats-col">
                <div class="ls-stat-mini-block">
                  <span class="ls-stat-mini-label">LUFS (ST)</span>
                  <span class="ls-stat-mini-val" id="lsMasterLufsVal">-∞ LUFS</span>
                </div>
                <div class="ls-stat-mini-block">
                  <span class="ls-stat-mini-label">True Peak</span>
                  <span class="ls-stat-mini-val is-green" id="lsMasterPeakVal">-∞ dBTP</span>
                </div>
                <div class="ls-stat-mini-block">
                  <span class="ls-stat-mini-label">Stereo RMS</span>
                  <span class="ls-stat-mini-val" id="lsMasterRmsVal">-∞ dB</span>
                </div>
                <div class="ls-stat-mini-block">
                  <span class="ls-stat-mini-label">Limiter GR</span>
                  <span class="ls-stat-mini-val" id="lsLimiterGrVal">0.0 dB</span>
                </div>
                <div class="ls-gr-track" style="margin-top:2px;">
                  <div class="ls-gr-fill" id="lsLimiterGrBar"></div>
                </div>
              </div>

              <div class="ls-vmeter-wrap">
                <div class="ls-vstrip-scale">
                  <span>+6</span><span>0</span><span>-6</span><span>-12</span><span>-24</span><span>-∞</span>
                </div>
                <div class="ls-vmeter-pair">
                  <div class="ls-vmeter-track" title="Master Left">
                    <div class="ls-vmeter-fill" id="lsMasterMeterFill" data-meter-orient="vertical"></div>
                  </div>
                  <div class="ls-vmeter-track" title="Master Right">
                    <div class="ls-vmeter-fill" id="lsMasterMeterFillR" data-meter-orient="vertical"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="ls-eq-bands-grid">
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">80 Hz</div>
              <div class="ls-eq-db" id="lsMaster80Val">0.5 dB</div>
              <input type="range" class="ls-range" id="lsMaster80" min="-12" max="12" step="0.5" value="0.5">
            </div>
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">250 Hz</div>
              <div class="ls-eq-db" id="lsMaster250Val">-1.5 dB</div>
              <input type="range" class="ls-range" id="lsMaster250" min="-12" max="12" step="0.5" value="-1.5">
            </div>
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">1 kHz</div>
              <div class="ls-eq-db" id="lsMaster1kVal">0 dB</div>
              <input type="range" class="ls-range" id="lsMaster1k" min="-12" max="12" step="0.5" value="0">
            </div>
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">3.5 kHz</div>
              <div class="ls-eq-db" id="lsMaster3k5Val">1.5 dB</div>
              <input type="range" class="ls-range" id="lsMaster3k5" min="-12" max="12" step="0.5" value="1.5">
            </div>
            <div class="ls-eq-band-box">
              <div class="ls-eq-freq">10 kHz</div>
              <div class="ls-eq-db" id="lsMaster10kVal">1 dB</div>
              <input type="range" class="ls-range" id="lsMaster10k" min="-12" max="12" step="0.5" value="1">
            </div>
          </div>

          <div class="ls-slider-row ls-slider-compact" style="margin-top:9px;">
            <span class="ls-slider-label">Master Out</span>
            <input type="range" class="ls-range" id="lsMasterGain" min="0" max="160" value="100">
            <span class="ls-slider-val" id="lsMasterGainVal">100%</span>
          </div>
        </section>

        <!-- VERTICAL DUAL-BUS MIXING CONSOLE + TABBED CHANNEL PROCESSOR -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">Dual-Bus Mixing Console <span class="ls-badge-pill">48 kHz DSP</span></h2>
            <span class="ls-channel-tag">Select any strip to inspect EQ &amp; dynamics</span>
          </div>

          <div class="ls-live-pins-bar" id="lsLiveDetectedPinsBar" role="status" aria-live="polite">
            <span class="ls-live-pins-empty">Live Hardware Inputs: Not probed yet — click Start Audio Soundcheck, Refresh, or Detect</span>
          </div>

          <div class="ls-console-mixer-row">
            <!-- LEFT: VERTICAL CHANNEL STRIPS -->
            <div class="ls-vstrips-deck" id="lsChannelsGrid">
              <!-- CH 1: VOCALS -->
              <div class="ls-vstrip ls-strip-vocal is-active-strip" data-proc-tab="vocal">
                <div class="ls-vstrip-head">
                  <span class="ls-vstrip-icon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                    </svg>
                  </span>
                  <span class="ls-vstrip-num" id="lsVocalStripPinTag">CH 1 · UNPROBED</span>
                  <div class="ls-channel-name">Vocals</div>
                  <div class="ls-channel-tag">Lead · Chorus</div>
                </div>

                <div class="ls-vstrip-input-route" title="Select Hardware Input Channel for Vocals">
                  <span class="ls-route-arrow" aria-hidden="true">&#8594;</span>
                  <select class="ls-select ls-vstrip-route-select" id="lsVocalInputChannelSelect" aria-label="Vocals Hardware Input Channel">
                    <option value="none" selected>None (Probing...)</option>
                  </select>
                  <button type="button" class="ls-vstrip-detect-btn" id="lsVocalDetectInputBtn"
                    title="Speak into your microphone to auto-detect and select its physical channel">Detect</button>
                </div>
                <div class="ls-vstrip-route-live" id="lsVocalRouteLiveBadge">&#9675; Not probed</div>

                <span class="ls-clip-pill" id="lsVocalClip">CLIP</span>

                <div class="ls-vstrip-switches">
                  <button type="button" class="ls-btn-mini" id="lsVocalMuteBtn" title="Mute Vocals">M</button>
                  <button type="button" class="ls-btn-mini" id="lsVocalSoloBtn" title="Solo PFL Vocals">S</button>
                  <button type="button" class="ls-btn-mini" id="lsVocalPolarityBtn" title="Polarity Invert">&#216;</button>
                  <button type="button" class="ls-btn-mini" id="lsVocalGateBtn" title="Toggle Hysteresis Gate">G</button>
                  <button type="button" class="ls-btn-mini ls-vstrip-comp-btn is-toggled" id="lsVocalCompBtn"
                    title="Toggle Vocal Compressor">Comp: ON</button>
                </div>

                <div class="ls-rotary-block">
                  <div class="ls-rotary-wrap" title="Drag vertically to Pan Vocals (double-click to center)">
                    <svg class="ls-rotary-svg" data-rotary-for="lsVocalPan" viewBox="0 0 40 40" role="slider" aria-label="Vocals Pan Dial">
                      <circle class="ls-rotary-cap" cx="20" cy="20" r="14" />
                      <path class="ls-rotary-track" d="M 9.4 30.6 A 15 15 0 1 1 30.6 30.6" />
                      <path class="ls-rotary-arc" d="" />
                      <line class="ls-rotary-needle" x1="20" y1="20" x2="20" y2="8" />
                    </svg>
                  </div>
                  <div class="ls-vstrip-mini-row">
                    <span class="ls-slider-label">Pan</span>
                    <input type="range" class="ls-range" id="lsVocalPan" min="-100" max="100" value="0" aria-label="Vocals Pan">
                    <span class="ls-slider-val" id="lsVocalPanVal">C</span>
                  </div>
                </div>

                <div class="ls-vstrip-db-tag">
                  <span>Pk <strong id="lsVocalPeakVal">-∞ dB</strong></span>
                  <span id="lsVocalRmsVal">-∞ dB</span>
                </div>

                <div class="ls-vstrip-readout" id="lsVocalGainVal">+1.0 dB</div>

                <div class="ls-vstrip-fader-bay">
                  <div class="ls-vstrip-scale">
                    <span>+6</span><span>0</span><span>-6</span><span>-12</span><span>-24</span><span>-36</span><span>-∞</span>
                  </div>
                  <input type="range" class="ls-vrange" id="lsVocalGain" min="0" max="200" value="112"
                    aria-label="Vocals Gain">
                  <div class="ls-vmeter-track ls-vstrip-meter">
                    <div class="ls-vmeter-fill" id="lsVocalMeterFill" data-meter-orient="vertical"></div>
                  </div>
                </div>
              </div>

              <!-- CH 2: INSTRUMENTS -->
              <div class="ls-vstrip ls-strip-inst" data-proc-tab="inst">
                <div class="ls-vstrip-head">
                  <span class="ls-vstrip-icon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 18V5l12-2v13" />
                      <circle cx="6" cy="18" r="3" />
                      <circle cx="18" cy="16" r="3" />
                    </svg>
                  </span>
                  <span class="ls-vstrip-num" id="lsInstStripPinTag">CH 2 · UNPROBED</span>
                  <div class="ls-channel-name">Instruments</div>
                  <div class="ls-channel-tag">Harmonium · Tabla</div>
                </div>

