              <button type="button" class="ls-btn-mini" id="lsDawZoomFitBtn" title="Zoom Out Full Session (\)">Fit</button>
              <button type="button" class="ls-btn-mini" id="lsDawTrackHeightBtn" title="Track Height (Alt+= / Alt+-)">Lane H</button>
              <button type="button" class="ls-btn-mini" id="lsDawWaveScaleBtn" title="Visual Waveform Scale">Wave ×1</button>
            </div>

            <div class="ls-au-master-strip-meter" title="DAW Master Output L / R Level">
