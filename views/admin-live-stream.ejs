              <input type="number" id="lsDawCustomCeilingInput" class="ls-input" step="0.1" min="-3.0" max="-0.1" value="-1.0"
                style="width:58px;height:24px;padding:2px 5px;" title="Custom True-Peak Ceiling (dBTP)" aria-label="Custom Ceiling dBTP">
            </span>
            <label class="ls-daw-check-label" title="Prevents excessive brickwall limiting that crushes natural devotional dynamics">
              <input type="checkbox" id="lsDawProtectDynamicsCheck" checked>
              Smart Dynamics Guard
