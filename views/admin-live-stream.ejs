              </div>
            </div>
            <div class="ls-daw-canvas-scroll" id="lsDawCanvasWrap">
              <canvas id="lsDawCanvas"></canvas>
            </div>
            <div id="lsDawContextMenu" class="ls-au-context-menu ls-is-hidden" role="menu"></div>
          </div>

          <!-- Audition Console Mixer View (Alt+2) -->
          <div class="ls-au-mixer-view ls-is-hidden" id="lsDawMixerView" aria-label="Multitrack Mixer Console">
            <div class="ls-au-mixer-strips" id="lsDawMixerStrips"></div>
          </div>

          <!-- Docked Audition CC Transport, J-K-L Shuttle & Master Stereo Meter -->
