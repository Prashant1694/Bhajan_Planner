                    <option value="112" selected>112 kbps (~50 MB/hr)</option>
                    <option value="128">128 kbps Stereo</option>
                    <option value="192">192 kbps Stereo</option>
                    <option value="320">320 kbps Stereo</option>
                  </select>
                </div>
              </div>

              <details class="ls-setup-details ls-ssd-opts-drawer">
                <summary title="Toggle stem tracks and post-recording behavior">
                  <span>Stem Options</span>
                  <svg class="ls-drawer-chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
                </summary>
                <div class="ls-ssd-opts-body">
                  <div class="ls-inline-checks">
                    <label class="ls-checkbox-line"><input type="checkbox" id="lsRecDryCh1Check" checked> Ch1 Dry WAV</label>
                    <label class="ls-checkbox-line"><input type="checkbox" id="lsRecDryCh2Check" checked> Ch2 Dry WAV</label>
                    <label class="ls-checkbox-line"><input type="checkbox" id="lsRecMasterCheck" checked> Master MP3</label>
