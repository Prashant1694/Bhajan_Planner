    sessionDate: <%- studioJsonFn(sessionDate) %>,
    bhajans: <%- studioJsonFn(scheduledBhajans) %>,
    presets: <%- studioJsonFn(presets) %>,
    streamState: <%- studioJsonFn(streamState) %>,
    r2Status: <%- studioJsonFn(typeof r2Status !== "undefined" ? r2Status : { configured: false }) %>
  };
</script>
