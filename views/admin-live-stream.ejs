            </div>
            <div class="ls-btn-row" style="margin-bottom:8px;">
              <button type="button" class="ls-btn-mini" id="lsDawSlipBackBtn" title="Slip audio -50ms (Shift -250ms)">Slip ◀</button>
              <button type="button" class="ls-btn-mini" id="lsDawSlipFwdBtn" title="Slip audio +50ms (Shift +250ms)">Slip ▶</button>
              <button type="button" class="ls-btn-mini" id="lsDawNudgeBackBtn" title="Nudge clip -25ms (Shift -250ms)">◀ Nudge</button>
              <button type="button" class="ls-btn-mini" id="lsDawNudgeFwdBtn" title="Nudge clip +25ms (Shift +250ms)">Nudge ▶</button>
              <button type="button" class="ls-btn-mini" id="lsDawNormClipBtn" title="Normalize clip gain to -1 dBTP">Norm</button>
            </div>
            <div class="ls-slider-row">
              <span class="ls-slider-label">Clip Gain</span>
              <input type="range" class="ls-range" id="lsDawClipGain" min="-18" max="12" step="0.5" value="0">
              <span class="ls-slider-val" id="lsDawClipGainVal">0 dB</span>
            </div>
            <div class="ls-slider-row">
              <span class="ls-slider-label">Fade In</span>
              <input type="range" class="ls-range" id="lsDawClipFadeIn" min="0" max="8" step="0.1" value="0">
              <span class="ls-slider-val" id="lsDawClipFadeInVal">0s</span>
            </div>
            <div class="ls-slider-row">
              <span class="ls-slider-label">Fade Out</span>
              <input type="range" class="ls-range" id="lsDawClipFadeOut" min="0" max="8" step="0.1" value="0">
              <span class="ls-slider-val" id="lsDawClipFadeOutVal">0s</span>
            </div>
            <div class="ls-slider-row">
              <span class="ls-slider-label">Crossfade</span>
              <input type="range" class="ls-range" id="lsDawClipCrossfade" min="0" max="2" step="0.05" value="0">
              <span class="ls-slider-val" id="lsDawClipCrossfadeVal">0s</span>
            </div>
            <div class="ls-trim-row">
              <div class="ls-field">
                <label for="lsDawTrimStart">Start (s)</label>
                <input type="number" step="0.1" min="0" class="ls-input" id="lsDawTrimStart" value="0">
              </div>
              <div class="ls-field">
                <label for="lsDawTrimEnd">End (s)</label>
                <input type="number" step="0.1" min="0" class="ls-input" id="lsDawTrimEnd" value="0">
              </div>
              <button type="button" class="ls-btn ls-btn-sm" id="lsDawApplyTrimBtn">Trim</button>
            </div>
            <div class="ls-au-session-timing">
              <div class="ls-field">
                <label for="lsDawRulerModeSelect">Time Format</label>
                <select class="ls-select ls-select-sm" id="lsDawRulerModeSelect" aria-label="Ruler Display Mode">
                  <option value="time" selected>Decimal (mm:ss.t)</option>
                  <option value="bars">Bars : Beats</option>
                  <option value="samples">Samples (48k)</option>
                </select>
              </div>
              <div class="ls-field">
                <label for="lsDawBpmInput">Tempo (BPM)</label>
                <input type="number" id="lsDawBpmInput" class="ls-input" min="30" max="240" value="96" aria-label="Project Tempo BPM">
              </div>
            </div>
          </div>
        </aside>

        <div class="ls-au-editor-column">
          <input type="file" id="lsDawTrackFileInput" accept="audio/*" style="display:none;">

          <!-- Audition CC Top Zoom Navigator Overview -->
          <div class="ls-au-navigator-wrap" title="Zoom Navigator — Click or drag viewport to scrub across session">
            <canvas id="lsDawNavigatorCanvas" height="24"></canvas>
          </div>

          <!-- Multitrack Arrangement View (Alt+1) -->
          <div class="ls-daw-workspace" id="lsDawMultitrackView">
            <div class="ls-daw-track-headers" id="lsDawTrackHeaders">
              <div class="ls-daw-tracks-corner"><span>TRACKS · MIX</span><span>2 TRK</span></div>
              <div class="ls-daw-track-box is-selected">
                <div class="ls-au-track-main">
                  <div class="ls-channel-name">Track 1 · Vocals</div>
                  <input type="range" class="ls-range" id="lsDawTrack1Gain" min="0" max="180" value="100">
                  <div class="ls-btn-row">
                    <button type="button" class="ls-btn-mini" id="lsDawTrack1Mute">M</button>
                    <button type="button" class="ls-btn-mini" id="lsDawTrack1Solo">S</button>
                  </div>
                </div>
                <div class="ls-daw-track-meter"><div class="ls-daw-track-meter-fill"></div></div>
              </div>
              <div class="ls-daw-track-box">
                <div class="ls-au-track-main">
                  <div class="ls-channel-name">Track 2 · Instruments</div>
                  <input type="range" class="ls-range" id="lsDawTrack2Gain" min="0" max="180" value="100">
                  <div class="ls-btn-row">
                    <button type="button" class="ls-btn-mini" id="lsDawTrack2Mute">M</button>
                    <button type="button" class="ls-btn-mini" id="lsDawTrack2Solo">S</button>
                  </div>
                </div>
                <div class="ls-daw-track-meter"><div class="ls-daw-track-meter-fill"></div></div>
              </div>
            </div>
            <div class="ls-daw-canvas-scroll" id="lsDawCanvasWrap">
              <canvas id="lsDawCanvas"></canvas>
            </div>
            <div id="lsDawContextMenu" class="ls-au-context-menu ls-is-hidden" role="menu"></div>
          </div>

          <!-- Audition Console Mixer View (Alt+2) -->
          <div class="ls-au-mixer-view ls-is-hidden" id="lsDawMixerView" aria-label="Multitrack Mixer Console">
            <div class="ls-au-mixer-strips" id="lsDawMixerStrips"></div>
          </div>
        </div>

        <!-- COL 4: RIGHT CONTEXTUAL TRACK & FX INSPECTOR -->
        <aside class="ls-cosmic-inspector" id="lsDawRightInspector" aria-label="Selected Channel Inspector">
          <div class="ls-au-panel-tabs" role="tablist">
            <button type="button" class="ls-au-panel-tab is-active" data-daw-insp-tab="track">Track</button>
            <button type="button" class="ls-au-panel-tab" data-daw-insp-tab="fx">FX Chain</button>
            <button type="button" class="ls-au-panel-tab" data-daw-insp-tab="sends">Bus / Master</button>
          </div>

          <div class="ls-cosmic-insp-body">
            <div class="ls-insp-channel-selector">
              <button type="button" class="ls-btn-mini is-toggled" data-daw-sel-trk="track-1">1 · Vocals</button>
              <button type="button" class="ls-btn-mini" data-daw-sel-trk="track-2">2 · Instruments</button>
              <button type="button" class="ls-btn-mini" data-daw-sel-trk="master">Master</button>
            </div>

            <div class="ls-insp-card">
              <div class="ls-insp-card-head">
                <span class="ls-insp-ch-badge" id="lsDawInspChannelBadge">CH 1</span>
                <strong id="lsDawInspChannelTitle">Vocals</strong>
              </div>

              <div class="ls-field" id="lsDawInspInputRow">
                <label for="lsDawInspInputSelect">Hardware Input</label>
                <div class="ls-inline-ctrl">
                  <select class="ls-select ls-select-sm" id="lsDawInspInputSelect" aria-label="Inspector Track Input"></select>
                  <button type="button" class="ls-btn-mini" id="lsDawInspDetectBtn">Detect</button>
                </div>
              </div>

              <div class="ls-insp-mon-row" id="lsDawInspMonitorRow">
                <span class="ls-slider-label">Monitor</span>
                <div class="ls-seg-switch">
                  <button type="button" class="ls-seg-btn is-active" id="lsDawInspMonOffBtn">Off</button>
                  <button type="button" class="ls-seg-btn" id="lsDawInspMonInBtn">In</button>
                </div>
              </div>

              <div class="ls-slider-row">
                <span class="ls-slider-label">Gain</span>
                <input type="range" class="ls-range" id="lsDawInspGainRange" min="0" max="180" value="100">
                <span class="ls-slider-val" id="lsDawInspGainVal">+0.0 dB</span>
              </div>
              <div class="ls-slider-row ls-slider-compact" id="lsDawInspPanRow">
                <span class="ls-slider-label">Pan</span>
                <input type="range" class="ls-range" id="lsDawInspPanRange" min="-100" max="100" value="0">
                <span class="ls-slider-val" id="lsDawInspPanVal">C</span>
              </div>
            </div>

            <div class="ls-insp-fx-head">
              <span>Channel Processing &amp; FX</span>
              <button type="button" class="ls-btn-mini" id="lsDawInspOpenFxRackBtn">Open Graph</button>
            </div>
            <div class="ls-insp-fx-list" id="lsDawInspFxSummaryList"></div>
          </div>
        </aside>
      </div>

      <!-- ZONE 3: CONTEXTUAL LOWER WORKSPACE SWITCHER -->
      <div class="ls-daw-view-bar" id="lsDawWorkspaceViewBar" role="tablist" aria-label="DAW Lower Workspace">
        <span class="ls-daw-view-label">Plugin Visualizer &amp; Mastering Export Dock</span>
        <div class="ls-btn-row">
          <div class="ls-seg-switch">
            <button type="button" class="ls-seg-btn is-active" data-daw-view-btn="all">Split View</button>
            <button type="button" class="ls-seg-btn" data-daw-view-btn="fx">FX Graph Only</button>
            <button type="button" class="ls-seg-btn" data-daw-view-btn="master">Master &amp; R2 Only</button>
          </div>
          <button type="button" class="ls-btn-mini" id="lsDawCollapseLowerBtn" title="Collapse/Expand Lower Dock">Hide Dock</button>
        </div>
      </div>

      <!-- ZONE 4: PLUGIN VISUALIZER + MASTER EXPORT DOCK -->
      <div class="ls-daw-bottom-dock" id="lsDawLowerDock">
        <div class="ls-daw-dock-pane" id="lsDawFxEditorDockWrap">
          <div class="ls-fx-editor" id="lsDawFxEditorPane">
            <div class="ls-hero-sub">Select an effect slot in <strong>Effects Rack</strong> or add an effect to shape this track's sound.</div>
          </div>
        </div>

        <div class="ls-daw-dock-pane" id="lsDawMasterExportDockWrap">
          <div class="ls-card-header" style="margin-bottom:8px;padding-bottom:6px;">
            <span class="ls-card-title">Master Export &amp; Cloudflare R2 Delivery</span>
            <div class="ls-btn-row" style="gap:6px;">
              <select class="ls-select ls-select-sm" id="lsDawExportSampleRateSelect" aria-label="Export Sample Rate"
                title="Target Sample Rate (32-tap Blackman Sinc SRC)">
                <option value="48000" selected>48 kHz</option>
                <option value="44100">44.1 kHz</option>
              </select>
              <select class="ls-select ls-select-sm" id="lsDawExportFormatSelect" aria-label="Export Format">
                <option value="mp3_192" selected>MP3 192 kbps Stereo</option>
                <option value="mp3_320">MP3 320 kbps HQ</option>
                <option value="mp3_128">MP3 128 kbps Stereo</option>
                <option value="mp3_112">MP3 112 kbps (~50MB/hr)</option>
                <option value="wav_24">WAV 24-bit / 48 kHz</option>
                <option value="wav_16">WAV 16-bit (TPDF Dither)</option>
              </select>
            </div>
          </div>

          <div class="ls-slider-row" style="margin-bottom:7px;">
            <span class="ls-slider-label">Master Trim</span>
            <input type="range" class="ls-range" id="lsDawMasterTrimInput" min="-12" max="12" step="0.5" value="0">
            <span class="ls-slider-val" id="lsDawMasterTrimVal">0 dB</span>
          </div>

          <div class="ls-daw-master-options">
            <label class="ls-daw-check-label">
              <input type="checkbox" id="lsDawApplyFxCheck" checked>
              Apply Studio Mastering FX Bus
            </label>
            <label class="ls-daw-check-label">
              <input type="checkbox" id="lsDawNoiseGateCheck">
              Noise Gate (-48 dB)
            </label>
            <label class="ls-daw-check-label">
              Loudness:
              <select class="ls-select ls-select-sm" id="lsDawLufsSelect">
                <option value="-14" selected>-14 LUFS (Streaming / R2)</option>
                <option value="-16">-16 LUFS (Devotional / Podcast)</option>
                <option value="-18">-18 LUFS (Dynamic Acoustic)</option>
                <option value="-23">-23 LUFS (EBU R128)</option>
                <option value="custom">Custom Target...</option>
                <option value="off">Off (Ceiling Safety Only)</option>
              </select>
            </label>
            <span id="lsDawCustomLufsWrap" style="display:none;align-items:center;gap:6px;">
              <input type="number" id="lsDawCustomLufsInput" class="ls-input" step="0.5" min="-26" max="-8" value="-14"
                style="width:58px;height:24px;padding:2px 5px;" title="Custom Integrated LUFS Target" aria-label="Custom LUFS">
              <input type="number" id="lsDawCustomCeilingInput" class="ls-input" step="0.1" min="-3.0" max="-0.1" value="-1.0"
                style="width:58px;height:24px;padding:2px 5px;" title="Custom True-Peak Ceiling (dBTP)" aria-label="Custom Ceiling dBTP">
            </span>
            <label class="ls-daw-check-label" title="Prevents excessive brickwall limiting that crushes natural devotional dynamics">
              <input type="checkbox" id="lsDawProtectDynamicsCheck" checked>
              Smart Dynamics Guard
            </label>
            <span class="ls-loudness-pill" id="lsDawLoudnessReport" style="display:none;"></span>
          </div>

          <div class="ls-loudness-report-card" id="lsDawLoudnessReportCard" style="display:none;"></div>

          <div class="ls-progress-track" id="lsDawRenderProgressWrap" style="display:none;">
            <div class="ls-progress-fill" id="lsDawRenderProgressFill"></div>
          </div>

          <div class="ls-btn-row" style="margin-top:10px;">
            <button type="button" class="ls-btn ls-btn-sm" id="lsDawAnalyzeMixBtn" disabled
              title="Measure ITU-R BS.1770-4 Loudness &amp; True-Peak headroom before rendering">Measure Loudness</button>
            <button type="button" class="ls-btn ls-btn-primary" id="lsDawRenderBtn" disabled>Render Master Mix</button>
            <button type="button" class="ls-btn ls-btn-go-live ls-btn-sm" id="lsDawRenderPublishBtn" disabled>Render
              &amp; Upload R2</button>
            <a class="ls-btn" id="lsDawDownloadRenderedBtn" href="#" download="edited-session.mp3"
              style="display:none;text-decoration:none;">Download Export</a>
          </div>

          <div class="ls-kbd-hints">
            <strong>V</strong> Move · <strong>R</strong> Razor · <strong>Y</strong> Slip · <strong>T</strong> Time ·
            <strong>J</strong>/<strong>K</strong>/<strong>L</strong> Shuttle · <strong>Ctrl+K</strong> Split ·
            <strong>M</strong> Marker · <strong>=</strong>/<strong>-</strong>/<strong>\</strong>/<strong>;</strong> Zoom ·
            <strong>Ctrl+Alt+K</strong> All Shortcuts
          </div>
        </div>
      </div>
    </div>

    <!-- AUDITION CC KEYBOARD SHORTCUTS REFERENCE DIALOG -->
    <dialog id="lsDawShortcutsDialog" class="ls-au-shortcuts-dialog" aria-labelledby="lsAuShortcutsTitle">
      <div class="ls-au-shortcuts-card">
        <div class="ls-au-shortcuts-head">
          <h3 id="lsAuShortcutsTitle" class="ls-card-title">Adobe Audition CC Multitrack Shortcuts</h3>
          <button type="button" class="ls-btn-mini" id="lsDawCloseShortcutsBtn" aria-label="Close Shortcuts">✕</button>
        </div>
        <div class="ls-au-shortcuts-grid">
          <div class="ls-au-shortcut-col">
            <h4>Tools &amp; Views</h4>
            <ul>
              <li><strong>V</strong><span>Move Tool (Clips, Trims, Fades)</span></li>
              <li><strong>R</strong><span>Razor Tool (Shift+Click All Tracks)</span></li>
              <li><strong>Y</strong><span>Slip Tool (Slide Content Inside Clip)</span></li>
              <li><strong>T</strong><span>Time Selection Tool (Top Edge Moves)</span></li>
              <li><strong>S</strong><span>Toggle Snapping</span></li>
              <li><strong>Alt+1 / Alt+2</strong><span>Multitrack / Console Mixer</span></li>
              <li><strong>Ctrl+Alt+K / ?</strong><span>Open Shortcuts Cheat-Sheet</span></li>
            </ul>
          </div>
          <div class="ls-au-shortcut-col">
            <h4>Transport &amp; Shuttle</h4>
            <ul>
              <li><strong>Space</strong><span>Play / Pause</span></li>
              <li><strong>Shift+Space / Ctrl+R</strong><span>Record Armed Tracks</span></li>
              <li><strong>J</strong><span>Shuttle Rewind (-1×, -2×, -4×)</span></li>
              <li><strong>K</strong><span>Shuttle Stop / Pause</span></li>
              <li><strong>L</strong><span>Shuttle Forward (1×, 1.5×, 2×, 3×)</span></li>
              <li><strong>Home / End</strong><span>Jump Playhead Start / End</span></li>
              <li><strong>Ctrl+L</strong><span>Toggle Loop Region</span></li>
            </ul>
          </div>
          <div class="ls-au-shortcut-col">
            <h4>Editing, Markers &amp; Zoom</h4>
            <ul>
              <li><strong>Ctrl+K / Ctrl+Shift+K</strong><span>Split Selected / All Tracks</span></li>
              <li><strong>Del / Shift+Bksp</strong><span>Delete Clip / Ripple Delete</span></li>
              <li><strong>M / [ / ]</strong><span>Add Marker · Prev / Next Marker</span></li>
              <li><strong>I / O / G</strong><span>Set In · Set Out · Clear Selection</span></li>
              <li><strong>= / - / \ / ;</strong><span>Zoom In · Out · Full · Selection</span></li>
              <li><strong>Alt+= / Alt+-</strong><span>Expand / Shrink Track Height</span></li>
              <li><strong>Ctrl+Z / Ctrl+Y</strong><span>Undo / Redo Edit History</span></li>
            </ul>
          </div>
        </div>
      </div>
    </dialog>
  </div>

  <!-- ======================================================================
       SCREEN-FREEZING REFRESH / LEAVE PROTECTION DIALOG
       ====================================================================== -->
  <dialog id="lsRefreshGuardDialog" class="ls-refresh-guard-dialog" aria-modal="true"
    aria-labelledby="lsRefreshGuardTitle" aria-describedby="lsRefreshGuardDesc">
    <div class="ls-refresh-guard-card">
      <div class="ls-refresh-guard-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
          <line x1="12" y1="9" x2="12" y2="13" />
          <line x1="12" y1="17" x2="12.01" y2="17" />
        </svg>
      </div>
      <h2 id="lsRefreshGuardTitle" class="ls-refresh-guard-title">Recording / Session Work Is Active</h2>
      <p id="lsRefreshGuardDesc" class="ls-refresh-guard-desc">
        Refreshing or leaving this page will interrupt the live audio engine. The workspace is frozen until you choose an action below.
      </p>
      <div id="lsRefreshGuardMeta" class="ls-refresh-guard-meta"></div>
      <div id="lsRefreshGuardActions" class="ls-refresh-guard-actions">
        <button type="button" class="ls-btn ls-btn-primary" id="lsGuardStayBtn">Stay in Studio (Keep Recording Safe)</button>
        <button type="button" class="ls-btn ls-btn-go-live" id="lsGuardSaveStemsBtn">Save Stems to Downloads &amp; Stay</button>
        <button type="button" class="ls-btn ls-btn-stop" id="lsGuardConfirmLeaveBtn">Discard &amp; Refresh Anyway</button>
      </div>
    </div>
  </dialog>
</div>

