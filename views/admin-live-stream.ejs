                  <span class="ls-slider-label">Hall Decay</span>
                  <input type="range" class="ls-range" id="lsReverbDecay" min="0.5" max="3.2" step="0.1" value="1.4">
                  <span class="ls-slider-val" id="lsReverbDecayVal">1.4s</span>
                </div>
                <div class="ls-slider-row">
                  <span class="ls-slider-label">Pre-Delay</span>
                  <input type="range" class="ls-range" id="lsReverbPreDelay" min="0" max="100" step="2" value="20">
                  <span class="ls-slider-val" id="lsReverbPreDelayVal">20 ms</span>
                </div>
                <div class="ls-slider-row">
                  <span class="ls-slider-label">HF Damping</span>
                  <input type="range" class="ls-range" id="lsReverbTone" min="2000" max="16000" step="250" value="7600">
                  <span class="ls-slider-val" id="lsReverbToneVal">7.6k Hz</span>
                </div>
                <div class="ls-slider-row">
                  <span class="ls-slider-label">Room Size</span>
                  <input type="range" class="ls-range" id="lsReverbRoomSize" min="15" max="100" step="5" value="62">
                  <span class="ls-slider-val" id="lsReverbRoomSizeVal">62%</span>
                </div>
                <div class="ls-slider-row">
                  <span class="ls-slider-label">Stereo Width</span>
                  <input type="range" class="ls-range" id="lsReverbWidth" min="0" max="150" step="5" value="110">
                  <span class="ls-slider-val" id="lsReverbWidthVal">110%</span>
                </div>
                <div class="ls-slider-row ls-slider-compact" style="margin-top:4px;">
                  <span class="ls-slider-label">Custom IR</span>
                  <div class="ls-inline-ctrl" style="gap:4px;">
                    <label class="ls-btn-mini" style="cursor:pointer;margin:0;" title="Load Custom Mandir .wav Impulse Response">
                      Load .WAV IR
                      <input type="file" id="lsReverbCustomIrInput" accept=".wav,audio/wav" style="display:none;">
                    </label>
                    <button type="button" class="ls-btn-mini" id="lsReverbIrResetBtn">Built-in</button>
                  </div>
                  <span class="ls-slider-val" id="lsReverbIrStatus">Synth IR</span>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- RIGHT CONTROL-ROOM COLUMN: BROADCAST CONTROL, NOW SINGING & SSD/R2 -->
      <div class="ls-col-stack">
        <!-- BROADCAST CONTROL -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">
              <span class="ls-title-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9" />
                  <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5" />
                  <circle cx="12" cy="12" r="2" />
                  <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5" />
                  <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19" />
                </svg>
              </span>
              <span>Broadcast Control</span>
            </h2>
            <span class="ls-badge-pill">Up to 320 kbps</span>
          </div>

          <div class="ls-field" style="margin-bottom:9px;">
            <label for="lsStreamTitle">Session Title</label>
            <input type="text" class="ls-input" id="lsStreamTitle" value="Thursday Evening Bhajan Satsang"
              maxlength="120">
          </div>

          <div class="ls-form-row">
            <div class="ls-field">
              <label for="lsBitrateSelect">Stream Quality</label>
              <select class="ls-select" id="lsBitrateSelect">
                <option value="320" selected>320 kbps Stereo (HQ)</option>
                <option value="256">256 kbps Stereo (High)</option>
                <option value="192">192 kbps Stereo (Balanced)</option>
                <option value="128">128 kbps Stereo (Low Wi-Fi)</option>
              </select>
            </div>
            <div class="ls-field">
              <label for="lsAccessModeSelect">Audience</label>
              <select class="ls-select" id="lsAccessModeSelect">
                <option value="public" selected>Public (All Visitors)</option>
                <option value="singers_only">Signed-In Singers Only</option>
              </select>
            </div>
          </div>

          <div class="ls-check-stack">
            <label class="ls-checkbox-line">
              <input type="checkbox" id="lsNotifyDevoteesCheck" checked>
              Push notify devotees on Go Live
            </label>
            <label class="ls-checkbox-line">
              <input type="checkbox" id="lsBackupRecordCheck" checked>
              Keep in-browser 320 kbps MP3 fallback copy
            </label>
          </div>

          <div class="ls-btn-row ls-transport-actions">
            <button type="button" class="ls-btn ls-btn-go-live" id="lsGoLiveBtn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="7" />
              </svg>
              <span>Go Live Now</span>
            </button>
            <button type="button" class="ls-btn ls-btn-stop" id="lsStopBtn" disabled>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                <rect x="5" y="5" width="14" height="14" rx="2" />
              </svg>
              <span>End Stream</span>
            </button>
            <button type="button" class="ls-btn" id="lsBroadcastMuteBtn">Mute</button>
          </div>

          <div class="ls-backup-box" id="lsBackupBox" style="display:none;">
            <div>
              <strong>Browser Master Backup Ready</strong>
              <div class="ls-hero-sub" id="lsBackupSizeText"></div>
            </div>
            <a class="ls-btn ls-btn-primary" id="lsBackupDownloadLink" href="#" download="bhajan-live.mp3"
              style="text-decoration:none;">Download</a>
          </div>
        </section>

        <!-- NOW SINGING QUEUE SYNC -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">Now Singing / Live Sync</h2>
            <button type="button" class="ls-btn-mini" id="lsClearNowSingingBtn">Clear</button>
          </div>

          <div class="ls-date-bar">
            <input type="date" class="ls-input" id="lsSessionDateInput" value="<%= sessionDate %>"
              aria-label="Session Date">
            <button type="button" class="ls-btn" id="lsLoadDateBhajansBtn">Load Session</button>
          </div>

          <div class="ls-now-singing-banner">
            <span class="ls-channel-tag">On Player:</span>
            <strong id="lsNowSingingCurrent">
              <%= streamState.nowSinging ? (streamState.nowSinging.title + (streamState.nowSinging.singerName ? ' — ' +
                streamState.nowSinging.singerName : '' )) : 'None selected' %>
            </strong>
          </div>

          <div class="ls-bhajan-list" id="lsBhajanPickerList"></div>
        </section>

        <!-- SSD RECORDER & CLOUDFLARE R2 PUBLISHING -->
        <section class="ls-card">
          <div class="ls-card-header">
            <h2 class="ls-card-title">SSD Recording &amp; Cloudflare R2</h2>
            <span class="ls-badge-pill <%= r2Status && r2Status.configured ? 'ls-badge-blue' : '' %>">
              <%= r2Status && r2Status.configured ? ('R2 · ' + (r2Status.bucketName || ' Ready')) : 'R2 Keys Missing' %>
            </span>
          </div>

          <div class="ls-subtabs-bar" role="tablist" aria-label="Recording and Publishing Mode"
            style="margin-bottom:9px;">
            <button type="button" class="ls-subtab-btn is-active" data-rec-tab-btn="ssd">SSD Capture</button>
            <button type="button" class="ls-subtab-btn" data-rec-tab-btn="r2">Cloudflare R2 Publish</button>
          </div>

          <div class="ls-subpanel" data-rec-pane="ssd">
            <div class="ls-channel-head"
              style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;">
              <div>
                <div class="ls-channel-name">Direct-to-SSD Capture</div>
                <div class="ls-channel-tag" id="lsRecFolderLabel">Default SSD Vault active (BhajanPlanner/Recordings) — or Choose Folder</div>
              </div>
              <span class="ls-rec-pill" id="lsRecStatusPill" style="display:none;">
                <span class="ls-rec-dot"></span>
                <span id="lsRecStatsText">REC 00:00 · 0 MB</span>
              </span>
            </div>

            <div class="ls-form-row">
              <div class="ls-field">
                <label for="lsDryBitDepthSelect">Dry Stems Format</label>
                <select class="ls-select" id="lsDryBitDepthSelect">
                  <option value="24" selected>24-bit / 48 kHz WAV</option>
                  <option value="32">32-bit Float / 48 kHz</option>
                  <option value="16">16-bit / 48 kHz WAV</option>
                </select>
              </div>
              <div class="ls-field">
                <label for="lsPublishBitrateSelect">R2 Publish MP3</label>
                <select class="ls-select" id="lsPublishBitrateSelect">
                  <option value="112" selected>112 kbps (~50 MB/hr)</option>
                  <option value="128">128 kbps Stereo</option>
                  <option value="192">192 kbps Stereo</option>
                  <option value="320">320 kbps Stereo</option>
                </select>
              </div>
            </div>

            <div class="ls-inline-checks">
              <label class="ls-checkbox-line"><input type="checkbox" id="lsRecDryCh1Check" checked> Ch1 Dry WAV</label>
              <label class="ls-checkbox-line"><input type="checkbox" id="lsRecDryCh2Check" checked> Ch2 Dry WAV</label>
              <label class="ls-checkbox-line"><input type="checkbox" id="lsRecMasterCheck" checked> Master MP3</label>
            </div>
            <div class="ls-inline-checks">
              <label class="ls-checkbox-line"><input type="checkbox" id="lsAutoOpenDawCheck" checked> Auto-open DAW on Stop</label>
              <label class="ls-checkbox-line"><input type="checkbox" id="lsAutoUploadRefCheck"> Auto-upload Live Ref</label>
              <label class="ls-checkbox-line"><input type="checkbox" id="lsAutoExportDownloadsCheck" checked> Auto-save copy to Downloads if no folder chosen</label>
            </div>

            <div id="lsVaultRecoveryBanner" class="ls-vault-recovery-banner ls-is-hidden" role="status">
              <div class="ls-vault-recovery-head">
                <strong>SSD Vault Recording Found</strong>
                <span id="lsVaultRecoveryText"></span>
              </div>
              <div class="ls-vault-recovery-actions">
                <button type="button" class="ls-btn ls-btn-mini ls-btn-primary" id="lsVaultRecoverDawBtn">Open in DAW</button>
                <button type="button" class="ls-btn ls-btn-mini" id="lsVaultDownloadBtn">Save Stems</button>
                <button type="button" class="ls-btn ls-btn-mini" id="lsVaultDeleteBtn" title="Remove cached stems from Default SSD Vault">Clear Vault</button>
              </div>
            </div>

            <div class="ls-ssd-btn-grid">
              <button type="button" class="ls-btn ls-btn-sm" id="lsPickSsdFolderBtn">Choose Folder</button>
              <button type="button" class="ls-btn ls-btn-sm ls-btn-primary" id="lsStartRecOnlyBtn">Start Rec</button>
              <button type="button" class="ls-btn ls-btn-go-live ls-btn-sm" id="lsRecordAndLiveBtn">Rec + Go
                Live</button>
              <button type="button" class="ls-btn ls-btn-stop ls-btn-sm" id="lsStopRecBtn" disabled>Stop Rec</button>
            </div>

            <div id="lsFallbackDownloadsList" class="ls-fallback-links"></div>
          </div>

          <div class="ls-subpanel ls-is-hidden" data-rec-pane="r2">
            <div class="ls-channel-head"
              style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;">
              <div>
                <div class="ls-channel-name">Cloudflare R2 Publish</div>
                <div class="ls-channel-tag" id="lsR2SourceLabel">Waiting for session MP3 or DAW mix</div>
              </div>
              <button type="button" class="ls-btn-mini" id="lsExportAuditionCsvBtn"
                title="Export Audition markers CSV">Audition CSV</button>
            </div>

            <div class="ls-form-row">
              <div class="ls-field">
                <label for="lsR2KeyInput">R2 Object Key</label>
                <input type="text" class="ls-input" id="lsR2KeyInput" value="recordings/<%= sessionDate %>-session.mp3">
              </div>
              <div class="ls-field">
                <label for="lsR2TitleInput">Session Title</label>
                <input type="text" class="ls-input" id="lsR2TitleInput" value="Bhajan Session – <%= sessionDate %>">
              </div>
            </div>

            <div class="ls-field" style="margin-bottom:9px;">
              <label for="lsR2CustomFileInput">Custom MP3 / WAV Master Override</label>
              <input type="file" id="lsR2CustomFileInput" accept="audio/mpeg,.mp3,audio/wav,.wav" class="ls-input">
            </div>

            <div class="ls-ts-header">
              <span class="ls-slider-label">Bhajan Timestamps (<span id="lsTsCount">0</span>)</span>
              <button type="button" class="ls-btn-mini" id="lsAddManualTsBtn">+ Timestamp</button>
            </div>
            <div class="ls-ts-list" id="lsTimestampsList"></div>

            <label class="ls-checkbox-line" style="margin:8px 0 9px;">
              <input type="checkbox" id="lsR2NotifyDevoteesCheck" checked>
              Notify devotees when audio publishes
            </label>

            <div class="ls-progress-track" id="lsR2ProgressWrap" style="display:none;">
              <div class="ls-progress-fill" id="lsR2ProgressFill"></div>
            </div>
            <div class="ls-hero-sub" id="lsR2StatusText" style="margin-bottom:7px;"></div>

            <button type="button" class="ls-btn ls-btn-primary" id="lsPublishR2Btn" style="width:100%;" disabled>
              Upload Master to Cloudflare R2 &amp; Publish
            </button>
            <div style="display:flex;gap:6px;margin-top:6px;">
              <button type="button" class="ls-btn ls-btn-mini" id="lsBackupDryStemsR2Btn" style="flex:1;" disabled>
                Backup Dry WAV Stems
              </button>
              <button type="button" class="ls-btn ls-btn-mini" id="lsRetryQueuedUploadsBtn" style="flex:1;" disabled>
                Retry Queued (<span id="lsQueuedCountBadge">0</span>)
              </button>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div><!-- /#lsTabLivePane -->

  <!-- ======================================================================
       TAB 2: ADOBE AUDITION CC MULTITRACK WORKSTATION
       ====================================================================== -->
  <div id="lsTabDawPane" style="display:none;">
    <div class="ls-daw-shell ls-au-workstation">
      <!-- ZONE 1: AUDITION CC COMMAND & TOOL BAR -->
      <div class="ls-au-command-bar" role="toolbar" aria-label="Audition Multitrack Tools and Commands">
        <div class="ls-au-cmd-left">
          <div class="ls-seg-switch ls-au-mode-switch" role="tablist" aria-label="Workspace View Mode">
            <button type="button" class="ls-seg-btn is-active" id="lsDawModeMultitrackBtn" title="Multitrack Editor (Alt+1)">Multitrack</button>
            <button type="button" class="ls-seg-btn" id="lsDawModeMixerBtn" title="Console Mixer View (Alt+2)">Mixer</button>
          </div>
          <button type="button" class="ls-btn-mini ls-au-bay-toggle" id="lsAuToggleLeftBayBtn" title="Show/Hide Left Files &amp; Rack Panel">Panels</button>

          <div class="ls-au-tool-palette" role="group" aria-label="Editing Tools">
            <button type="button" class="ls-au-tool-btn" id="lsDawToolMoveBtn" data-daw-tool="move" title="Move Tool (V) · Drag clips, edges &amp; fades">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3l14 9-6.5 1.7L9 20z" /></svg>
              <span class="ls-au-key-cap">V</span>
            </button>
            <button type="button" class="ls-au-tool-btn" id="lsDawToolRazorBtn" data-daw-tool="razor" title="Razor Selected Clips Tool (R) · Shift+Click All Tracks">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true"><rect x="4" y="6" width="16" height="10" rx="1.5" /><line x1="12" y1="2" x2="12" y2="22" /></svg>
              <span class="ls-au-key-cap">R</span>
            </button>
            <button type="button" class="ls-au-tool-btn" id="lsDawToolSlipBtn" data-daw-tool="slip" title="Slip Tool (Y) · Slide audio content inside clip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true"><polyline points="7 8 3 12 7 16" /><polyline points="17 8 21 12 17 16" /><line x1="3" y1="12" x2="21" y2="12" /></svg>
              <span class="ls-au-key-cap">Y</span>
            </button>
            <button type="button" class="ls-au-tool-btn is-active" id="lsDawToolTimeBtn" data-daw-tool="time" title="Time Selection Tool (T) · Header acts as Move Tool">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true"><path d="M8 4h8M8 20h8M12 4v16" /></svg>
              <span class="ls-au-key-cap">T</span>
            </button>
            <button type="button" class="ls-btn-mini is-toggled" id="lsDawSnapBtn" title="Toggle Snapping (S)">Snap</button>
          </div>
        </div>

        <div class="ls-au-edit-cluster">
          <button type="button" class="ls-btn-mini" id="lsDawSplitBtn" title="Split Clip at Playhead (Ctrl+K)">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="3" x2="12" y2="21" /><polyline points="8 7 4 12 8 17" /><polyline points="16 7 20 12 16 17" /></svg>
            <span>Split</span>
          </button>
          <button type="button" class="ls-btn-mini" id="lsDawJoinClipsBtn" title="Merge / Join Selected Clips (Ctrl+J)">Join</button>
          <button type="button" class="ls-btn-mini" id="lsDawSetInBtn" title="Set Time Selection In Point (I)">In</button>
          <button type="button" class="ls-btn-mini" id="lsDawSetOutBtn" title="Set Time Selection Out Point (O)">Out</button>
          <button type="button" class="ls-btn ls-btn-primary ls-btn-sm" id="lsDawRippleCutBtn" title="Ripple Delete Selection (Shift+Backspace)">Ripple Cut</button>
          <button type="button" class="ls-btn-mini" id="lsDawRangeNormBtn" title="Normalize selected range to -1.0 dBTP">Norm Range</button>
          <button type="button" class="ls-btn-mini" id="lsDawCutClipBtn" title="Cut selected clip(s) (Ctrl+X)">Cut</button>
          <button type="button" class="ls-btn-mini" id="lsDawCopyClipBtn" title="Copy selected clip(s) (Ctrl+C)">Copy</button>
          <button type="button" class="ls-btn-mini" id="lsDawPasteClipBtn" title="Paste clipboard at playhead (Ctrl+V)">Paste</button>
          <button type="button" class="ls-btn-mini" id="lsDawDupClipBtn" title="Duplicate selected clip (Ctrl+D)">Dup</button>
          <button type="button" class="ls-btn-mini" id="lsDawDeleteClipBtn" title="Ripple Delete Clip (Shift+Delete)">Del Clip</button>
        </div>

        <div class="ls-au-cmd-right">
          <button type="button" class="ls-btn-mini" id="lsDawUndoBtn" disabled title="Undo (Ctrl+Z)">Undo</button>
          <button type="button" class="ls-btn-mini" id="lsDawRedoBtn" disabled title="Redo (Ctrl+Y)">Redo</button>
          <div class="ls-daw-history-wrap">
            <button type="button" class="ls-btn-mini" id="lsDawHistoryBtn" title="Edit History Timeline">History</button>
            <div class="ls-daw-history-popover ls-is-hidden" id="lsDawHistoryMenu"></div>
          </div>
          <button type="button" class="ls-btn-mini" id="lsDawAddTrackBtn" title="Add Audio Track">+ Track</button>
          <button type="button" class="ls-btn-mini" id="lsDawDeleteTrackBtn" title="Delete Selected Track">Del Trk</button>
          <button type="button" class="ls-btn-mini" id="lsDawSelectMasterBtn" title="Inspect Master Bus Rack">Master</button>
          <button type="button" class="ls-btn-mini" id="lsDawAutoToggleBtn" title="Toggle Track Keyframe Automation">Auto</button>
          <select class="ls-select ls-select-sm" id="lsDawAutoLaneSelect" style="display:none;max-width:130px;" aria-label="Automation Lane">
            <option value="gain" selected>Track Volume (%)</option>
            <option value="pan">Stereo Pan</option>
            <option value="clipGain">Clip Gain (dB)</option>
            <option value="eqPresenceDb">EQ Presence (dB)</option>
            <option value="compThreshold">Comp Threshold (dB)</option>
            <option value="reverbSend">Reverb Send (%)</option>
            <option value="fxWetDry">Plugin Rack Mix (%)</option>
          </select>
          <button type="button" class="ls-btn-mini" id="lsDawAutoClearBtn" style="display:none;" title="Clear active automation lane">Clear</button>
          <button type="button" class="ls-btn-mini" id="lsDawShortcutsBtn" title="Adobe Audition CC Keyboard Shortcuts (Ctrl+Alt+K)">⌨ Keys</button>
        </div>
      </div>

      <!-- ZONE 2: DOCKED UPPER SPLIT (LEFT FILES/RACK/PROPS BAY + CENTER TIMELINE/MIXER) -->
      <div class="ls-au-main-split" id="lsAuMainSplit">
        <aside class="ls-au-left-bay" id="lsAuLeftBay" aria-label="Audition Workspace Panels">
          <div class="ls-au-panel-tabs" role="tablist">
            <button type="button" class="ls-au-panel-tab is-active" data-au-left-tab="files">Files</button>
            <button type="button" class="ls-au-panel-tab" data-au-left-tab="fx">Effects Rack</button>
            <button type="button" class="ls-au-panel-tab" data-au-left-tab="props">Properties</button>
          </div>

          <!-- PANEL A: FILES / MEDIA BIN & PROJECT IO -->
          <div class="ls-au-left-pane" id="lsAuFilesPane" data-au-left-pane="files">
            <div class="ls-au-io-actions">
              <button type="button" class="ls-btn ls-btn-primary ls-btn-sm" id="lsDawAutoLoadRecBtn" disabled title="Load last SSD/stream recording stems">Load Recording</button>
              <label class="ls-btn-mini ls-btn-upload" style="cursor:pointer;" title="Replace project with an audio file">
                <span>Open File</span>
                <input type="file" id="lsDawSingleFileInput" accept="audio/*" style="display:none;">
              </label>
              <label class="ls-btn-mini ls-btn-upload" style="cursor:pointer;" title="Append an audio clip onto timeline">
                <span>+ Join</span>
                <input type="file" id="lsDawAppendFileInput" accept="audio/*" style="display:none;">
              </label>
            </div>
            <div class="ls-au-proj-actions">
              <button type="button" class="ls-btn-mini" id="lsDawSaveProjectBtn" title="Save DAW Project (Ctrl+S)">Save Proj</button>
              <button type="button" class="ls-btn-mini" id="lsDawLoadProjectBtn" title="Reload saved session project">Load Proj</button>
              <label class="ls-btn-mini" style="cursor:pointer;" title="Import offline project.json">
                <span>Open .json</span>
                <input type="file" id="lsDawImportProjectInput" accept="application/json,.json" style="display:none;">
              </label>
            </div>

            <div class="ls-au-bin-head">
              <span>Session Media Bin</span>
              <span class="ls-channel-tag">Drag or Insert</span>
            </div>
            <div class="ls-au-media-list" id="lsDawMediaBinList">
              <div class="ls-au-empty-note">No audio files loaded yet. Open a recording or drop audio onto any track.</div>
            </div>

            <details class="ls-daw-stems-drawer">
              <summary>
                <span>Import Dual Dry Stems (Ch1+Ch2)</span>
                <span class="ls-channel-tag">WAV Pair</span>
              </summary>
              <div class="ls-daw-stems-row">
                <div class="ls-field">
                  <label for="lsDawFileCh1Input">Track 1 · Ch 1 Vocals</label>
                  <input type="file" id="lsDawFileCh1Input" accept="audio/*" class="ls-input">
                </div>
                <div class="ls-field">
                  <label for="lsDawFileCh2Input">Track 2 · Ch 2 Instruments</label>
                  <input type="file" id="lsDawFileCh2Input" accept="audio/*" class="ls-input">
                </div>
                <button type="button" class="ls-btn ls-btn-primary ls-btn-sm" id="lsDawLoadStemsBtn">Load Stems</button>
              </div>
            </details>
