              </button>
              <button type="button" class="ls-btn-mini" id="lsDawShuttleFwdBtn" title="Shuttle Fast-Forward (L — tap to accelerate)">L ▶▶</button>
              <button type="button" class="ls-btn-mini" id="lsDawNextMarkerBtn" title="Next Marker (])">Mrk ▶</button>
              <button type="button" class="ls-btn-mini" id="lsDawGoEndBtn" title="Move Playhead to End (End)">▶|</button>
