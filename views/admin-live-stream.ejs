            <div class="ls-au-transport-btns">
              <button type="button" class="ls-btn-mini" id="lsDawGoStartBtn" title="Move Playhead to Start (Home)">|◀</button>
              <button type="button" class="ls-btn-mini" id="lsDawPrevMarkerBtn" title="Previous Marker ([)">◀ Mrk</button>
              <button type="button" class="ls-btn-mini" id="lsDawShuttleRevBtn" title="Shuttle Rewind (J — tap to accelerate)">◀◀ J</button>
              <button type="button" class="ls-btn" id="lsDawStopBtn" title="Stop (K)">
