          <div class="ls-loudness-report-card" id="lsDawLoudnessReportCard" style="display:none;"></div>

          <div class="ls-progress-track" id="lsDawRenderProgressWrap" style="display:none;">
            <div class="ls-progress-fill" id="lsDawRenderProgressFill"></div>
          </div>

          <div class="ls-btn-row" style="margin-top:10px;">
