      <!-- RIGHT RACK: 3. BROADCAST CONTROL & SSD / CLOUDFLARE R2 VAULT -->
      <div class="ls-lc-right-rack">
        <section class="ls-card ls-broadcast-card" data-live-section="broadcast">
          <div class="ls-card-header">
            <h2 class="ls-card-title">
              <span class="ls-title-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9" />
                  <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5" />
                  <circle cx="12" cy="12" r="2" />
                  <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5" />
                  <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19" />
                </svg>
              </span>
              <span>Broadcast Control</span>
            </h2>
            <span class="ls-badge-pill">Up to 320 kbps</span>
          </div>

          <div class="ls-field" style="margin-bottom:8px;">
            <label for="lsStreamTitle">Session Title</label>
            <input type="text" class="ls-input" id="lsStreamTitle" value="Thursday Evening Bhajan Satsang" maxlength="120">
          </div>

          <div class="ls-form-row">
            <div class="ls-field">
              <label for="lsBitrateSelect">Stream Quality</label>
              <select class="ls-select" id="lsBitrateSelect">
                <option value="320" selected>320 kbps Stereo (HQ)</option>
                <option value="256">256 kbps Stereo (High)</option>
                <option value="192">192 kbps Stereo (Balanced)</option>
                <option value="128">128 kbps Stereo (Low Wi-Fi)</option>
              </select>
            </div>
            <div class="ls-field">
              <label for="lsAccessModeSelect">Audience</label>
              <select class="ls-select" id="lsAccessModeSelect">
                <option value="public" selected>Public (All Visitors)</option>
                <option value="singers_only">Signed-In Singers Only</option>
              </select>
            </div>
          </div>

          <div class="ls-check-stack">
            <label class="ls-checkbox-line">
              <input type="checkbox" id="lsNotifyDevoteesCheck" checked>
              Push notify devotees on Go Live
            </label>
            <label class="ls-checkbox-line">
              <input type="checkbox" id="lsBackupRecordCheck" checked>
              Keep in-browser 320 kbps MP3 fallback copy
            </label>
          </div>

          <div class="ls-btn-row ls-transport-actions">
            <button type="button" class="ls-btn ls-btn-go-live" id="lsGoLiveBtn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="7" />
              </svg>
              <span>Go Live Now</span>
            </button>
            <button type="button" class="ls-btn ls-btn-stop" id="lsStopBtn" disabled>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                <rect x="5" y="5" width="14" height="14" rx="2" />
              </svg>
              <span>End Stream</span>
            </button>
            <button type="button" class="ls-btn" id="lsBroadcastMuteBtn">Mute</button>
          </div>

          <div class="ls-backup-box" id="lsBackupBox" style="display:none;">
            <div>
              <strong>Browser Master Backup Ready</strong>
              <div class="ls-hero-sub" id="lsBackupSizeText"></div>
            </div>
            <a class="ls-btn ls-btn-primary" id="lsBackupDownloadLink" href="#" download="bhajan-live.mp3"
              style="text-decoration:none;">Download</a>
          </div>
        </section>

        <!-- SSD RECORDING & CLOUDFLARE R2 PUBLISHING -->
        <section class="ls-card ls-lc-bottom-bar" data-live-section="vault" aria-label="SSD Recording and Cloudflare R2">
          <div class="ls-lc-bottom-head">
            <div class="ls-lc-bottom-title">
              <span class="ls-title-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <line x1="6" y1="16" x2="10" y2="16" />
                  <circle cx="17" cy="16" r="1.5" />
                </svg>
              </span>
              <h2 class="ls-card-title">SSD Recording &amp; R2</h2>
              <span class="ls-badge-pill <%= r2Status && r2Status.configured ? 'ls-badge-blue' : '' %>">
                <%= r2Status && r2Status.configured ? ('R2 · ' + (r2Status.bucketName || 'Ready')) : 'R2 Keys Missing' %>
              </span>
