                    <option value="24" selected>24-bit / 48 kHz WAV</option>
                    <option value="32">32-bit Float / 48 kHz</option>
                    <option value="16">16-bit / 48 kHz WAV</option>
                  </select>
                </div>
                <div class="ls-field">
                  <label for="lsPublishBitrateSelect">R2 Publish MP3</label>
