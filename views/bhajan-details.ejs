<!-- ======================================================== -->
<!-- CLIENT SCRIPTS (FONT RESIZE, ALIGN, COPY, MODALS)        -->
<!-- ======================================================== -->
<script>
(function() {
  const DEFAULT_SIZE = 20;
  const MIN_SIZE = 14;
  const MAX_SIZE = 36;
  let currentSize = DEFAULT_SIZE;

  // Restore saved preference
  try {
    const saved = localStorage.getItem('bp_bhajan_lyrics_font_size');
    if (saved) {
      const parsed = parseInt(saved, 10);
      if (!isNaN(parsed) && parsed >= MIN_SIZE && parsed <= MAX_SIZE) {
        currentSize = parsed;
      }
    }
  } catch (e) {}

  function applySize(size) {
    currentSize = Math.max(MIN_SIZE, Math.min(MAX_SIZE, size));

    // Update CSS variables on document & container
    document.documentElement.style.setProperty('--lyrics-font-size', currentSize + 'px');
    
    const container = document.getElementById('lyricsContainer');
    if (container) {
      container.style.setProperty('--lyrics-font-size', currentSize + 'px');
      container.style.fontSize = currentSize + 'px';
      
      // Enforce on all lyrics lines directly for instant, flawless rendering
      const lines = container.querySelectorAll('.lyrics-line');
      for (let i = 0; i < lines.length; i++) {
        lines[i].style.fontSize = currentSize + 'px';
      }
    }

    const display = document.getElementById('fontSizeDisplay');
    if (display) {
      display.textContent = currentSize + 'px';
      display.title = 'Current font size: ' + currentSize + 'px';
    }

    const btnDec = document.getElementById('fontDec');
    const btnInc = document.getElementById('fontInc');
    if (btnDec) btnDec.disabled = (currentSize <= MIN_SIZE);
    if (btnInc) btnInc.disabled = (currentSize >= MAX_SIZE);

    try {
      localStorage.setItem('bp_bhajan_lyrics_font_size', String(currentSize));
    } catch (e) {}
  }

  // Expose global controller
  window.changeLyricsFontSize = function(delta) {
    if (delta === 0) {
      applySize(DEFAULT_SIZE);
    } else {
      applySize(currentSize + delta);
    }
  };

  // Alignment Toggle (Default is Left Aligned)
  let isLeftAligned = true;

  // Restore saved alignment preference
  try {
    const savedAlign = localStorage.getItem('bp_bhajan_lyrics_alignment');
    if (savedAlign === 'center') {
      isLeftAligned = false;
    }
  } catch (e) {}

  function applyAlignment(leftAligned) {
    isLeftAligned = !!leftAligned;
    const container = document.getElementById('lyricsContainer');
    const alignBtn = document.getElementById('toggleAlignBtn');
    const alignIcon = document.getElementById('alignIcon');
    const alignText = document.getElementById('alignText');

    const centerSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="10" x2="6" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/><line x1="21" y1="14" x2="3" y2="14"/><line x1="18" y1="18" x2="6" y2="18"/></svg>';
    const leftSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="17" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/><line x1="21" y1="14" x2="3" y2="14"/><line x1="17" y1="18" x2="3" y2="18"/></svg>';

    if (container) {
      if (!isLeftAligned) {
        container.classList.add('align-center');
        container.style.textAlign = 'center';
        const lines = container.querySelectorAll('.lyrics-line');
        for (let i = 0; i < lines.length; i++) {
          lines[i].style.textAlign = 'center';
        }
        const stanzas = container.querySelectorAll('.lyrics-stanza');
        for (let s = 0; s < stanzas.length; s++) {
          stanzas[s].style.textAlign = 'center';
        }
      } else {
        container.classList.remove('align-center');
        container.style.textAlign = 'left';
        const lines = container.querySelectorAll('.lyrics-line');
        for (let i = 0; i < lines.length; i++) {
          lines[i].style.textAlign = 'left';
        }
        const stanzas = container.querySelectorAll('.lyrics-stanza');
        for (let s = 0; s < stanzas.length; s++) {
          stanzas[s].style.textAlign = 'left';
        }
      }
    }

    if (alignBtn) {
      alignBtn.classList.toggle('active', !isLeftAligned);
      alignBtn.title = isLeftAligned ? 'Center align lyrics text' : 'Left align lyrics text';
    }
    if (alignText) {
      alignText.textContent = isLeftAligned ? 'Center' : 'Left';
    }
    if (alignIcon) {
      alignIcon.innerHTML = isLeftAligned ? centerSvg : leftSvg;
    }

    try {
      localStorage.setItem('bp_bhajan_lyrics_alignment', isLeftAligned ? 'left' : 'center');
    } catch (e) {}
  }

  window.toggleLyricsAlignment = function() {
    applyAlignment(!isLeftAligned);
  };

  // Copy Lyrics to Clipboard
  window.copyBhajanLyrics = async function() {
    const rawDataElem = document.getElementById('rawBhajanData');
    const lyricsElem = document.getElementById('rawLyricsText');
    const copyBtn = document.getElementById('copyLyricsBtn');
    const copyBtnText = document.getElementById('copyBtnText');

    if (!lyricsElem || !lyricsElem.value.trim()) return;

    const title = rawDataElem ? rawDataElem.getAttribute('data-title') : '';
    const deity = rawDataElem ? rawDataElem.getAttribute('data-deity') : '';
    const lyrics = lyricsElem.value.trim();

    const formatted = (title ? title : 'Bhajan') + (deity ? ' (' + deity + ')' : '') + '\n\n' + lyrics + '\n\n— Sri Sathya Sai Seva Organisation, Gandhinagar';

    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(formatted);
      } else {
        lyricsElem.style.display = 'block';
        lyricsElem.select();
        document.execCommand('copy');
        lyricsElem.style.display = 'none';
      }

      if (copyBtn) copyBtn.classList.add('copied');
      if (copyBtnText) copyBtnText.textContent = 'Copied!';

      setTimeout(function() {
        if (copyBtn) copyBtn.classList.remove('copied');
        if (copyBtnText) copyBtnText.textContent = 'Copy';
      }, 2000);
    } catch (err) {
      alert('Could not copy lyrics to clipboard.');
    }
  };

  // Frame Toggle
  let isFrameActive = true;
  try {
    const savedFrame = localStorage.getItem('bp_bhajan_lyrics_floral_frame');
    if (savedFrame !== null) {
      isFrameActive = (savedFrame === 'true');
    }
  } catch (e) {}

  function applyFrameState(active) {
    isFrameActive = active;
    const viewport = document.getElementById('lyricsViewport');
    const btn = document.getElementById('toggleFrameBtn');
    const text = document.getElementById('frameText');
    if (viewport) {
      viewport.classList.toggle('floral-frame-active', isFrameActive);
    }
    if (btn) {
      btn.classList.toggle('active', isFrameActive);
    }
    if (text) text.textContent = isFrameActive ? 'Frame' : 'Clean';
    try {
      localStorage.setItem('bp_bhajan_lyrics_floral_frame', String(isFrameActive));
    } catch (e) {}
  }

  window.toggleFloralFrame = function() {
    applyFrameState(!isFrameActive);
  };

  // -------------------------------------------------------------
  // REPORT ISSUE / SUGGEST CORRECTION MODAL CONTROLLER
  // -------------------------------------------------------------
  window.openReportModal = function() {
    const modal = document.getElementById('reportModal');
    if (!modal) return;
    document.getElementById('reportFormBody').style.display = 'block';
    document.getElementById('reportSuccessBody').style.display = 'none';
    modal.style.display = 'flex';
  };

  window.closeReportModal = function() {
    const modal = document.getElementById('reportModal');
    if (modal) modal.style.display = 'none';
  };

  window.handleBhajanReportSubmit = async function(e) {
    e.preventDefault();
    const btn = document.getElementById('submitReportBtn');
    const masterId = document.getElementById('reportMasterId').value;
    const bhajanTitle = document.getElementById('reportBhajanTitle').value;
    const desc = document.getElementById('reportDescription').value;
    const suggestion = document.getElementById('reportSuggestion').value;
    const reporterName = document.getElementById('reporterName').value;
    const reporterContact = document.getElementById('reporterContact').value;

    const checkedCats = [];
    const catCheckboxes = document.querySelectorAll('input[name="reportCat"]:checked');
    catCheckboxes.forEach(cb => checkedCats.push(cb.value));

    if (checkedCats.length === 0 && (!desc || !desc.trim())) {
      alert('Please select at least one issue category above, or provide details in the description.');
      return;
    }

    try {
      btn.disabled = true;
      btn.textContent = 'Submitting...';

      const devId = localStorage.getItem('bp_device_id') || '';
      const res = await fetch('/api/reports/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          master_id: masterId,
          bhajan_title: bhajanTitle,
          categories: checkedCats,
          description: desc,
          suggested_correction: suggestion,
          reporter_name: reporterName,
          reporter_contact: reporterContact,
          visitor_id: devId
        })
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to submit report');

      // Save ticket code into localStorage for easy tracking
      try {
        const stored = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
        if (data.ticket && data.ticket.ticket_code && !stored.includes(data.ticket.ticket_code)) {
          stored.unshift(data.ticket.ticket_code);
          localStorage.setItem('bp_my_report_tickets', JSON.stringify(stored));
        }
      } catch (_) {}

      // Show success screen
      document.getElementById('createdTicketCode').textContent = data.ticket.ticket_code;
      document.getElementById('reportFormBody').style.display = 'none';
      document.getElementById('reportSuccessBody').style.display = 'block';

      // Reset form
      document.getElementById('bhajanReportForm').reset();
    } catch (err) {
      alert('Error submitting report: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Submit Report';
    }
  };

  // Check if admin has responded to any past reports from this device
  async function checkReportNotifications() {
    try {
      let storedTickets = [];
      try {
        storedTickets = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
      } catch (_) {}

      const devId = localStorage.getItem('bp_device_id') || '';
      if (storedTickets.length === 0 && !devId) return;

      const p = [];
      if (storedTickets.length > 0) p.push('tickets=' + encodeURIComponent(storedTickets.join(',')));
      if (devId) p.push('visitor_id=' + encodeURIComponent(devId));

      const res = await fetch('/api/reports/my-reports?' + p.join('&'));
      const data = await res.json();

      if (data && data.has_unread_reply) {
        const dot = document.getElementById('unreadReplyDot');
        if (dot) dot.style.display = 'block';
      }
    } catch (_) {}
  }

  // -------------------------------------------------------------
  // SONGBOOK / REPERTOIRE CONTROLLER
  // -------------------------------------------------------------
  let isSongbookBookmarked = false;
  let isSingerLoggedIn = false;

  async function checkSongbookStatus() {
    try {
      const res = await fetch('/api/singer/songbook/check/<%= bhajan.id %>');
      const data = await res.json();
      isSingerLoggedIn = Boolean(data.loggedIn);
      isSongbookBookmarked = Boolean(data.bookmarked);

      const btn = document.getElementById('songbookBtn');
      const icon = document.getElementById('songbookIcon');
      const text = document.getElementById('songbookBtnText');
      const removeBtn = document.getElementById('sbRemoveBtn');
      const scaleInput = document.getElementById('sbCustomScale');
      const notesInput = document.getElementById('sbNotes');

      if (isSongbookBookmarked && data.bookmark) {
        if (icon) icon.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="#7c3aed" stroke="#7c3aed" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
        if (text) text.textContent = 'In Songbook';
        if (btn) {
          btn.classList.add('bookmarked');
        }
        if (removeBtn) removeBtn.style.display = 'inline-block';
        if (scaleInput && data.bookmark.custom_scale) scaleInput.value = data.bookmark.custom_scale;
        if (notesInput && data.bookmark.notes) notesInput.value = data.bookmark.notes;
      } else {
        if (icon) icon.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
        if (text) text.textContent = 'Songbook';
        if (btn) {
          btn.classList.remove('bookmarked');
        }
        if (removeBtn) removeBtn.style.display = 'none';
      }
    } catch (_) {}
  }

  window.openSongbookModal = function() {
    const modal = document.getElementById('songbookModal');
    const authNotice = document.getElementById('songbookAuthNotice');
    const form = document.getElementById('songbookForm');

    if (!isSingerLoggedIn) {
      if (authNotice) authNotice.style.display = 'block';
      if (form) form.style.display = 'none';
    } else {
      if (authNotice) authNotice.style.display = 'none';
      if (form) form.style.display = 'block';
    }

    if (modal) modal.style.display = 'flex';
  };

  window.closeSongbookModal = function() {
    const modal = document.getElementById('songbookModal');
    if (modal) modal.style.display = 'none';
  };

  window.handleSongbookFormSubmit = async function(e) {
    e.preventDefault();
    const btn = document.getElementById('sbSaveBtn');
    const masterId = document.getElementById('sbMasterId').value;
    const customScale = document.getElementById('sbCustomScale').value;
    const notes = document.getElementById('sbNotes').value;

    try {
      btn.disabled = true;
      btn.textContent = 'Saving...';

      let endpoint = isSongbookBookmarked ? '/api/singer/songbook/update' : '/api/singer/songbook/toggle';

      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ master_id: masterId, custom_scale: customScale, notes: notes })
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to save');

      await checkSongbookStatus();
      closeSongbookModal();
    } catch (err) {
      alert('Error: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save to Songbook';
    }
  };

  window.handleSongbookRemove = async function() {
    if (!confirm('Remove this bhajan from your Songbook?')) return;
    try {
      const res = await fetch('/api/singer/songbook/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ master_id: '<%= bhajan.id %>' })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to remove');

      await checkSongbookStatus();
      closeSongbookModal();
    } catch (err) {
      alert('Error: ' + err.message);
    }
  };

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { 
      applySize(currentSize);
      applyFrameState(isFrameActive);
      applyAlignment(isLeftAligned);
      checkReportNotifications();
      checkSongbookStatus();
    });
  } else {
    applySize(currentSize);
    applyFrameState(isFrameActive);
    applyAlignment(isLeftAligned);
    checkReportNotifications();
    checkSongbookStatus();
  }
})();
</script>
