<%
  function getWesternScale(indianScale) {
    if (!indianScale || indianScale === '-' || indianScale === 'Not specified') return '-';
    const match = indianScale.toString().trim().match(/^([\d\.]+)\s*([PMpm])?.*$/);
    if (!match) return '-';
    const numMap = {'1':0, '1.5':1, '2':2, '2.5':3, '3':4, '4':5, '4.5':6, '5':7, '5.5':8, '6':9, '6.5':10, '7':11};
    if (numMap[match[1]] === undefined) return '-';
    let index = numMap[match[1]];
    if ((match[2] || '').toUpperCase() === 'M') index = (index + 5) % 12;
    return ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"][index];
  }

  const hasLyrics = bhajan.lyrics && bhajan.lyrics.trim().length > 0;
  const westM = getWesternScale(bhajan.shruti);
  const westF = getWesternScale(bhajan.shruti_female);

  // Split lyrics into paragraphs/stanzas
  const stanzas = hasLyrics 
    ? bhajan.lyrics.trim().split(/\r?\n\s*\r?\n/).filter(Boolean)
    : [];

  // Calculate total non-empty lyrics lines for dynamic full-frame print layout
  const totalLyricsLines = stanzas.reduce((acc, st) => {
    return acc + st.split(/\r?\n/).filter(l => l.trim().length > 0).length;
  }, 0);

  let printDensityClass = 'print-spacious';
  if (totalLyricsLines > 22) {
    printDensityClass = 'print-compact';
  } else if (totalLyricsLines > 13) {
    printDensityClass = 'print-medium';
  }
%>

<div class="zen-detail-stage bhajan-detail-page <%= printDensityClass %>">
  <!-- Prasanthi Sanctum Top Border -->
  <div class="prasanthi-border no-print" aria-hidden="true"></div>

  <!-- Floating Sacred Ambient Light Orbs -->
  <div class="sacred-orbs-canvas no-print" aria-hidden="true">
    <div class="sacred-orb sacred-orb-1"></div>
    <div class="sacred-orb sacred-orb-2"></div>
    <div class="sacred-orb sacred-orb-3"></div>
    <div class="sacred-orb sacred-orb-4"></div>
    <div class="sacred-grid-texture"></div>
  </div>

  <div class="detail-container zen-detail-container">

    <!-- Top Breadcrumb & Navigation -->
    <nav class="detail-nav-bar no-print" aria-label="Breadcrumb navigation">
      <a href="/master-bank" class="detail-back-btn zen-glass-panel" id="backToBankBtn" onclick="if(window.AppShell){event.preventDefault();window.AppShell.back('/master-bank');}else if(window.history.length>1){event.preventDefault();window.history.back();}">
        <span class="back-arrow">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </span>
        <span>Master Bhajan Bank</span>
      </a>

      <div class="detail-breadcrumbs zen-glass-panel">
        <a href="/master-bank" class="crumb-home-link" title="Return to Master Bank">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px; margin-right:4px;">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span>Master Bank</span>
        </a>
        <span class="crumb-sep">/</span>
        <% if (bhajan.deity) { %>
          <span class="crumb-deity"><%= bhajan.deity %></span>
          <span class="crumb-sep">/</span>
        <% } %>
        <span class="crumb-current" title="<%= bhajan.title %>"><%= bhajan.title %></span>
      </div>
    </nav>

    <!-- Sacred Header Hero Card -->
    <header class="detail-hero-card zen-glass-panel">
      <div class="hero-card-sheen" aria-hidden="true"></div>
      <div class="detail-hero-content">
        <div class="hero-pre-badge-row">
          <span class="hero-catalog-chip">#<%= bhajan.id %></span>
          <% if (bhajan.level) { %>
            <span class="hero-sub-chip">Level <%= bhajan.level %></span>
          <% } %>
          <span class="hero-sub-chip sanctuary-badge">Prasanthi Repertoire</span>
        </div>

        <h1 class="detail-bhajan-title" id="bhajanTitleDisplay"><%= bhajan.title %></h1>

        <div class="detail-badge-strip">
          <% if (bhajan.deity) { %>
            <% bhajan.deity.split(',').map(d => d.trim()).filter(Boolean).forEach(d => { %>
              <span class="hero-pill deity-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
                <span><%= d %></span>
              </span>
            <% }); %>
          <% } %>
          <% if (bhajan.tempo) { %>
            <span class="hero-pill tempo-pill">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span><%= bhajan.tempo %></span>
            </span>
          <% } %>
          <% if (bhajan.raga && bhajan.raga !== '-' && bhajan.raga !== 'Not specified') { %>
            <span class="hero-pill raga-pill">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
              <span>Raag <%= bhajan.raga %></span>
            </span>
          <% } %>
          <% if (bhajan.language) { %>
            <span class="hero-pill lang-pill">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" x2="22" y1="12" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
              <span><%= bhajan.language %></span>
            </span>
          <% } %>
          <% if (bhajan.sheet_filename) { %>
            <a href="/sheets/<%= encodeURIComponent(bhajan.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="hero-pill sheet-pill" title="Open official PDF music notation & sheet">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span>Music Sheet ↗</span>
            </a>
          <% } %>
        </div>
      </div>
    </header>

    <!-- ======================================================== -->
    <!-- 1. TOP SECTION: SACRED BHAJAN LYRICS (FIRST AT TOP)       -->
    <!-- ======================================================== -->
    <section class="lyrics-section-card zen-glass-panel" id="lyricsSection" aria-label="Bhajan Lyrics">
      
      <!-- Lyrics Action Toolbar: Segmented Modern Glass Controls -->
      <div class="lyrics-toolbar">
        <div class="lyrics-controls-group">

          <!-- Segment 1: Reading & Appearance Settings -->
          <div class="segmented-control-cluster typography-cluster">
            <!-- Tactile Font Size Adjustment (+ / - / Reset) -->
            <div class="font-size-adjuster font-size-pill" role="group" aria-label="Adjust font size">
              <button type="button" id="fontDec" class="font-btn" onclick="changeLyricsFontSize(-2)" title="Decrease font size" aria-label="Decrease font size">A−</button>
              <span id="fontSizeDisplay" class="font-size-indicator" title="Current text size">20px</span>
              <button type="button" id="fontInc" class="font-btn" onclick="changeLyricsFontSize(2)" title="Increase font size" aria-label="Increase font size">A+</button>
              <button type="button" id="fontReset" class="font-btn font-reset-btn" onclick="changeLyricsFontSize(0)" title="Reset font size to default (20px)" aria-label="Reset font size">↺</button>
            </div>

            <!-- Floral Frame Toggle -->
            <button type="button" id="toggleFrameBtn" class="tool-btn active" onclick="toggleFloralFrame()" title="Toggle decorative frame">
              <span class="btn-icon" id="frameIcon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
              </span>
              <span class="btn-text" id="frameText">Frame</span>
            </button>

            <!-- Alignment Toggle (Default Left-Aligned) -->
            <button type="button" id="toggleAlignBtn" class="tool-btn" onclick="toggleLyricsAlignment()" title="Toggle text alignment (Left / Center)">
              <span class="btn-icon" id="alignIcon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="21" y1="6" x2="3" y2="6"/><line x1="15" y1="12" x2="3" y2="12"/><line x1="17" y1="18" x2="3" y2="18"/></svg>
              </span>
              <span class="btn-text" id="alignText">Center</span>
            </button>
          </div>

          <!-- Segment 2: Quick Devotional Actions -->
          <div class="segmented-control-cluster actions-cluster">
            <!-- Copy Lyrics Button -->
            <button type="button" id="copyLyricsBtn" class="tool-btn copy-btn" onclick="copyBhajanLyrics()" title="Copy full lyrics to clipboard">
              <span class="btn-icon" id="copyIcon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              </span>
              <span class="btn-text" id="copyBtnText">Copy</span>
            </button>

            <!-- Print Button -->
            <button type="button" onclick="window.print()" class="tool-btn print-btn no-print" title="Print lyrics sheet">
              <span class="btn-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
              </span>
              <span class="btn-text">Print</span>
            </button>

            <% if (bhajan.sheet_filename) { %>
              <!-- Official Music Sheet Button -->
              <a href="/sheets/<%= encodeURIComponent(bhajan.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="tool-btn sheet-btn no-print" title="Open official reference music sheet (PDF)">
                <span class="btn-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                </span>
                <span class="btn-text">Music Sheet</span>
              </a>
            <% } %>

            <!-- Schedule This Bhajan Button -->
            <a href="/submit-form?prefill_title=<%= encodeURIComponent(bhajan.title) %>&prefill_deity=<%= encodeURIComponent(bhajan.deity || '') %>&prefill_scale=<%= encodeURIComponent(bhajan.shruti || '') %>&prefill_speed=<%= encodeURIComponent(bhajan.tempo || '') %>&master_id=<%= bhajan.id %>" class="tool-btn schedule-tool-btn no-print" title="Schedule this bhajan for the upcoming session">
              <span class="btn-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
              </span>
              <span class="btn-text">Schedule</span>
            </a>

            <!-- Add to My Songbook Button -->
            <button type="button" id="songbookBtn" onclick="openSongbookModal()" class="tool-btn songbook-btn no-print" title="Save this bhajan to your personal Songbook repertoire">
              <span class="btn-icon" id="songbookIcon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </span>
              <span class="btn-text" id="songbookBtnText">Songbook</span>
            </button>

            <!-- Report Issue / Suggest Correction Button -->
            <button type="button" onclick="openReportModal()" class="tool-btn report-btn no-print" title="Report incorrect lyrics, scale, or details">
              <span class="btn-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg>
              </span>
              <span class="btn-text">Report</span>
            </button>

            <!-- Track Reports Button -->
            <a href="/my-reports" class="tool-btn track-btn no-print" id="trackReportsLink" title="Track your reported issues & admin replies">
              <span class="btn-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/></svg>
              </span>
              <span class="btn-text">My Reports</span>
              <span id="unreadReplyDot" class="unread-reply-dot" style="display:none;"></span>
            </a>
          </div>

        </div>
      </div>

      <!-- Devotional Lyrics Reading Area (Sacred Golden Floral Frame) -->
      <div class="lyrics-parchment floral-frame-active" id="lyricsViewport">
        <!-- Botanical Corner Embellishments: Top-Left & Bottom-Right -->
        <img src="/images/corner-floral-tl.svg" class="parchment-corner corner-tl" alt="" aria-hidden="true" />
        <img src="/images/corner-floral-br.svg" class="parchment-corner corner-br" alt="" aria-hidden="true" />
        
        <!-- Sacred Central Watermark Glow -->
        <div class="parchment-watermark" aria-hidden="true"></div>

        <% if (hasLyrics) { %>
          <div class="lyrics-container" id="lyricsContainer">
            <% stanzas.forEach((stanza, sIdx) => { %>
              <div class="lyrics-stanza <%= sIdx === 0 ? 'first-stanza' : '' %>" data-stanza-idx="<%= sIdx + 1 %>">
                <% stanza.split(/\r?\n/).forEach(line => { %>
                  <% if (line.trim().length > 0) { %>
                    <div class="lyrics-line"><%= line.trim() %></div>
                  <% } %>
                <% }) %>
              </div>
              <% if (sIdx < stanzas.length - 1) { %>
                <div class="stanza-ornament" aria-hidden="true">✦ ✦ ✦</div>
              <% } %>
            <% }) %>
          </div>
        <% } else { %>
          <div class="lyrics-empty-state">
            <span class="empty-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </span>
            <h3>Lyrics Currently Being Transcribed</h3>
            <p>The lyrics for this bhajan are being formatted. Pitch, harmonium, and raga references are provided below.</p>
          </div>
        <% } %>
      </div>

      <!-- Hidden Raw Data Elements for Clipboard & Scripts (Safe against quotes/escapes) -->
      <div id="rawBhajanData" 
           data-title="<%= bhajan.title %>" 
           data-deity="<%= bhajan.deity || '' %>" 
           style="display:none;" 
           aria-hidden="true">
        <textarea id="rawLyricsText"><%= bhajan.lyrics || '' %></textarea>
      </div>
    </section>

    <!-- ======================================================== -->
    <!-- 2. BOTTOM SECTION: ACCOMPANIMENT & MUSICAL DETAILS       -->
    <!-- ======================================================== -->
    <section class="metadata-section-card zen-glass-panel" id="accompanimentSection" aria-label="Musical Accompaniment & Specifications">
      <div class="meta-section-header">
        <div class="meta-header-icon-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18V5l12-2v13"></path>
            <circle cx="6" cy="18" r="3"></circle>
            <circle cx="18" cy="16" r="3"></circle>
          </svg>
        </div>
        <div>
          <h2 class="meta-section-title">Musical Accompaniment &amp; Singing Guide</h2>
          <p class="meta-section-sub">Standard references for harmonium, keyboard, tabla, and vocalists</p>
        </div>
      </div>

      <div class="meta-specs-grid">
        
        <!-- Male Scale / Shruti -->
        <div class="spec-tile spec-tile-pitch">
          <div class="spec-tile-icon-box pitch-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="12" x="2" y="6" rx="2"></rect><line x1="6" x2="6" y1="6" y2="12"></line><line x1="10" x2="10" y1="6" y2="12"></line><line x1="14" x2="14" y1="6" y2="12"></line><line x1="18" x2="18" y1="6" y2="12"></line></svg>
          </div>
          <div class="spec-tile-info">
            <span class="spec-label">Male Scale / Shruti</span>
            <div class="spec-value-row">
              <% if (bhajan.shruti && bhajan.shruti !== '-' && bhajan.shruti !== 'Not specified') { %>
                <strong class="pitch-indian"><%= bhajan.shruti %></strong>
                <% if (westM !== '-') { %>
                  <span class="pitch-western">Key of <%= westM %></span>
                <% } %>
                <button type="button" class="spec-drone-btn" onclick="window.playTanpuraPitch('<%= (westM && westM !== "-") ? westM : bhajan.shruti %>');" title="Audition Tanpura drone in pitch <%= (westM && westM !== "-") ? westM : bhajan.shruti %>" aria-label="Play Tanpura in male pitch">
                  <span class="drone-btn-icon"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg></span>
                  <span class="drone-btn-text">Drone</span>
                </button>
              <% } else { %>
                <span class="muted-note">Not specified</span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Female Scale / Shruti -->
        <div class="spec-tile spec-tile-pitch">
          <div class="spec-tile-icon-box pitch-icon-box female-pitch-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="12" x="2" y="6" rx="2"></rect><line x1="6" x2="6" y1="6" y2="12"></line><line x1="10" x2="10" y1="6" y2="12"></line><line x1="14" x2="14" y1="6" y2="12"></line><line x1="18" x2="18" y1="6" y2="12"></line></svg>
          </div>
          <div class="spec-tile-info">
            <span class="spec-label">Female Scale / Shruti</span>
            <div class="spec-value-row">
              <% if (bhajan.shruti_female && bhajan.shruti_female !== '-' && bhajan.shruti_female !== 'Not specified') { %>
                <strong class="pitch-indian"><%= bhajan.shruti_female %></strong>
                <% if (westF !== '-') { %>
                  <span class="pitch-western">Key of <%= westF %></span>
                <% } %>
                <button type="button" class="spec-drone-btn" onclick="window.playTanpuraPitch('<%= (westF && westF !== "-") ? westF : bhajan.shruti_female %>');" title="Audition Tanpura drone in pitch <%= (westF && westF !== "-") ? westF : bhajan.shruti_female %>" aria-label="Play Tanpura in female pitch">
                  <span class="drone-btn-icon"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg></span>
                  <span class="drone-btn-text">Drone</span>
                </button>
              <% } else { %>
                <span class="muted-note">Same as male or −5 semitones</span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Deity Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon-box deity-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="12 6 15 11 20 12 16 16 17 21 12 18 7 21 8 16 4 12 9 11 12 6"></polygon></svg>
          </div>
          <div class="spec-tile-info">
            <span class="spec-label">Deity / Aspect</span>
            <span class="spec-value highlight-val"><%= bhajan.deity || 'Not specified' %></span>
          </div>
        </div>

        <!-- Speed / Tempo Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon-box tempo-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="spec-tile-info">
            <span class="spec-label">Speed / Tempo</span>
            <span class="spec-value">
              <% if (bhajan.tempo) { %>
                <span class="tempo-tag-badge"><%= bhajan.tempo %></span>
              <% } else { %>
                <span class="muted-note">Not specified</span>
              <% } %>
            </span>
          </div>
        </div>

        <!-- Classical Raag Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon-box raga-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
          </div>
          <div class="spec-tile-info">
            <span class="spec-label">Classical Raag</span>
            <span class="spec-value raga-title-val"><%= (bhajan.raga && bhajan.raga !== '-' && bhajan.raga !== 'Not specified') ? bhajan.raga : 'Not specified' %></span>
          </div>
        </div>

        <!-- Language Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon-box lang-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" x2="22" y1="12" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </div>
          <div class="spec-tile-info">
            <span class="spec-label">Devotional Language</span>
            <span class="spec-value"><%= bhajan.language || 'Not specified' %></span>
          </div>
        </div>

        <!-- Difficulty Level Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon-box level-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          </div>
          <div class="spec-tile-info">
            <span class="spec-label">Difficulty / Level</span>
            <span class="spec-value"><%= bhajan.level ? `Level ${bhajan.level}` : 'Standard' %></span>
          </div>
        </div>

        <!-- Master Bank ID Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon-box id-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10v10H7z"/></svg>
          </div>
          <div class="spec-tile-info">
            <span class="spec-label">Master Catalog ID</span>
            <span class="spec-value mono-id">#<%= bhajan.id %></span>
          </div>
        </div>

        <% if (bhajan.sheet_filename) { %>
          <!-- Official Music Sheet Reference Spec Tile -->
          <div class="spec-tile spec-tile-sheet">
            <div class="spec-tile-icon-box sheet-icon-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div class="spec-tile-info">
              <span class="spec-label">Official Music Sheet</span>
              <span class="spec-value">
                <a href="/sheets/<%= encodeURIComponent(bhajan.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="spec-sheet-link" title="Open <%= bhajan.sheet_filename %> in new tab">
                  <%= bhajan.sheet_filename %> ↗
                </a>
              </span>
            </div>
          </div>
        <% } %>

        <% if (bhajan.raga_notes) { 
          // Parse raga notes intelligently into swaras, western scale, commentary, and footnote
          let rText = (bhajan.raga_notes || '').trim();
          let rFootnote = '';
          const footMatch = rText.match(/(\*[^*]+)$/);
          if (footMatch && (footMatch[1].toLowerCase().includes('octave') || footMatch[1].toLowerCase().includes('lower') || footMatch[1].toLowerCase().includes('notes'))) {
            rFootnote = footMatch[0].trim().replace(/^\*\s*/, '');
            rText = rText.substring(0, rText.length - footMatch[0].length).trim();
          }
          rText = rText.replace(/^Notes:\s*/i, '').trim();
          // Fix concatenated words like SIn the Key of C:
          rText = rText.replace(/([a-zA-Z0-9])In the Key of/i, '$1 In the Key of');
          
          let swarasRaw = rText;
          let westernRaw = '';
          let westernKey = 'Key of C';
          const keyMatch = rText.match(/(?:In\s+the\s+Key\s+of\s+([A-Ga-g#♭b]+):?|Key\s+of\s+([A-Ga-g#♭b]+):?)/i);
          if (keyMatch) {
            swarasRaw = rText.substring(0, keyMatch.index).trim();
            westernKey = keyMatch[1] ? ('Key of ' + keyMatch[1].toUpperCase()) : 'Key of C';
            westernRaw = rText.substring(keyMatch.index + keyMatch[0].length).trim();
          }

          let commentary = '';
          const swaraStartMatch = swarasRaw.search(/(?:^|\s)([nNrgmdsNRGMDS][123]?\s+[nNrgmdsNRGMDS][123]?\s+[nNrgmdsNRGMDS])/);
          if (swaraStartMatch > 0) {
            commentary = swarasRaw.substring(0, swaraStartMatch).trim();
            swarasRaw = swarasRaw.substring(swaraStartMatch).trim();
          }

          const swaraTokens = swarasRaw.split(/\s+/).filter(Boolean);
          const westernTokens = westernRaw.split(/\s+/).filter(Boolean);
        %>
          <!-- Dedicated Raag Singing & Swara Notes -->
          <div class="spec-tile spec-tile-full-width raga-master-tile">
            <div class="raga-master-box">
              <div class="raga-master-head">
                <div class="raga-master-icon-wrap">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"></path>
                    <circle cx="6" cy="18" r="3"></circle>
                    <circle cx="18" cy="16" r="3"></circle>
                  </svg>
                </div>
                <div class="raga-master-title-area">
                  <div class="raga-master-badge-row">
                    <span class="raga-master-badge">Raag Swara Notes &amp; Scale Details</span>
                    <span class="raga-master-subbadge">Melodic Framework</span>
                  </div>
                  <h4 class="raga-master-heading">Arohana &bull; Avarohana Sequence</h4>
                </div>
              </div>

              <% if (commentary) { %>
                <div class="raga-master-commentary">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                  <span><%= commentary %></span>
                </div>
              <% } %>

              <div class="raga-master-sections">
                <!-- Indian Classical Swara Sequence -->
                <div class="raga-sequence-card swara-sequence-card">
                  <div class="raga-sequence-header">
                    <span class="sequence-title">Indian Swaras</span>
                    <span class="sequence-sub">Classical Notation</span>
                  </div>
                  <div class="swara-chips-flow">
                    <% if (swaraTokens.length > 0) { %>
                      <% swaraTokens.forEach(tok => { 
                        const m = tok.match(/^([a-zA-Z]+)(\d+)?$/);
                        const note = m ? m[1] : tok;
                        const sub = m && m[2] ? m[2] : '';
                      %>
                        <span class="musical-swara-pill">
                          <span class="swara-note"><%= note %></span><% if (sub) { %><sub class="swara-sub"><%= sub %></sub><% } %>
                        </span>
                      <% }) %>
                    <% } else { %>
                      <span class="swara-fallback-text"><%= swarasRaw %></span>
                    <% } %>
                  </div>
                </div>

                <!-- Western Key Equivalent -->
                <% if (westernRaw) { %>
                  <div class="raga-sequence-card western-sequence-card">
                    <div class="raga-sequence-header">
                      <span class="sequence-title western-title"><%= westernKey %></span>
                      <span class="sequence-sub">Harmonium &bull; Piano Notes</span>
                    </div>
                    <div class="western-chips-flow">
                      <% westernTokens.forEach(tok => { %>
                        <span class="musical-western-pill"><%= tok %></span>
                      <% }) %>
                    </div>
                  </div>
                <% } %>
              </div>

              <% if (rFootnote) { %>
                <div class="raga-master-footnote">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                  <span><%= rFootnote %></span>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

      </div>
    </section>

    <!-- Bottom Navigation & Action Strip -->
    <div class="detail-footer-nav no-print">
      <a href="/master-bank" class="footer-nav-btn secondary-btn" onclick="if(window.AppShell){event.preventDefault();window.AppShell.back('/master-bank');}else if(window.history.length>1){event.preventDefault();window.history.back();}">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Master Bhajan Bank</span>
      </a>
      <button type="button" onclick="(document.getElementById('shellDetailBody') || window).scrollTo({ top: 0, behavior: 'smooth' })" class="footer-nav-btn text-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
        <span>Back to Top</span>
      </button>
    </div>

  </div>
</div>

