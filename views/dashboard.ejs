  <!-- Scripts -->
  <script>
    // Hide standalone navigation and header when running inside the app-shell iframe
    (function () {
      if (window.self !== window.top) {
        var sh = document.getElementById('standaloneHeaderWrap');
        if (sh) sh.style.display = 'none';
      }
    })();

    // Theme synchronization with parent shell and localStorage
    (function () {
      try {
        var t = localStorage.getItem('bp-theme');
        if (t === 'dark' || document.documentElement.getAttribute('data-theme') === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (_) { }
    })();

    var themeBtn = document.getElementById('themeToggleBtn');
    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var isDark = document.documentElement.classList.toggle('dark');
        try {
          var mode = isDark ? 'dark' : 'light';
          localStorage.setItem('bp-theme', mode);
          document.documentElement.setAttribute('data-theme', mode);
          if (window.top && window.top !== window.self) {
            window.top.document.documentElement.setAttribute('data-theme', mode);
            window.top.document.documentElement.classList.toggle('dark', isDark);
          }
        } catch (_) { }
        triggerToast(isDark ? 'Switched to Night Velvet Glass' : 'Switched to Ivory Prasanthi Glass');
      });
    }

    // Toast Notification Dispatcher
    var toastTimeout;
    function triggerToast(message) {
      clearTimeout(toastTimeout);
      var toast = document.getElementById('toastNotification');
      var msgSpan = document.getElementById('toastMsg');
      if (!toast || !msgSpan) return;
      msgSpan.textContent = message;

      toast.style.transform = 'translate(-50%, 0)';
      toast.style.opacity = '1';

      toastTimeout = setTimeout(function () {
        toast.style.transform = 'translate(-50%, 80px)';
        toast.style.opacity = '0';
      }, 3000);
    }
  </script>