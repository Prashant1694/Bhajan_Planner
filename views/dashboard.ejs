<!-- Google Fonts: Inter, Plus Jakarta Sans & Fraunces (Matching App Typography) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
  rel="stylesheet">

<!-- Dedicated Glass Dashboard Stylesheet -->
<link rel="stylesheet" href="/css/dashboard-glass.css?v=2.2">

<div class="zen-glass-stage">

  <!-- ================= AMBIENT SACRED GLOW ORBS (BACKGROUND) ================= -->
  <div class="sacred-orbs-canvas">
    <!-- Orb 1: Saffron Core (Top Left) -->
    <div class="sacred-orb sacred-orb-1"></div>
    <!-- Orb 2: Deep Prasanthi Maroon/Rose (Top Right) -->
    <div class="sacred-orb sacred-orb-2"></div>
    <!-- Orb 3: Radiant Golden Aura (Center Mid) -->
    <div class="sacred-orb sacred-orb-3"></div>
    <!-- Orb 4: Sanctum Amber (Bottom Right) -->
    <div class="sacred-orb sacred-orb-4"></div>
    <!-- Subtle Grid Overlay -->
    <div class="sacred-grid-texture"></div>
  </div>

  <!-- Content Layer Wrapper -->
  <div class="zen-stage-content">

    <!-- ================= 1. PRASANTHI TOP STRIP ================= -->
    <div class="prasanthi-border"></div>

    <!-- ================= 2. EXECUTIVE GLOBAL TOP HEADER (Standalone Mode) ================= -->
    <% if (typeof isEmbed==='undefined' || !isEmbed) { %>
      <div id="standaloneHeaderWrap"
        style="background: rgba(255,255,255,0.45); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border-bottom: 1px solid rgba(255,255,255,0.6); position: sticky; top: 4px; z-index: 40;">
        <div class="zen-max-container"
          style="padding-top: 12px; padding-bottom: 12px; display: flex; align-items: center; justify-content: space-between;">

          <!-- Left: Logo & Organisation Brand -->
          <a href="/" style="display: flex; align-items: center; gap: 14px; text-decoration: none;">
            <div
              style="width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(135deg, #f59e0b, #d97706); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(217,119,6,0.3); flex-shrink: 0;">
              <img src="/images/logo.png" alt="Lotus Logo" style="width: 30px; height: 30px; object-fit: contain;">
            </div>
            <div>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span
                  style="font-family: 'Fraunces', Georgia, serif; font-weight: 700; font-size: 19px; letter-spacing: -0.01em; color: inherit;">Bhajan
                  Planner</span>
                <span
                  style="font-size: 10px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; padding: 2px 10px; border-radius: 9999px; background: rgba(245,158,11,0.15); color: #b45309; border: 1px solid rgba(245,158,11,0.3);">
                  SSSO • Gandhinagar
                </span>
              </div>
              <p style="font-size: 11px; margin: 2px 0 0; color: #78716c; font-weight: 500;">Sri Sathya Sai Seva
                Organisations, Gujarat</p>
            </div>
          </a>

          <!-- Right: Profile & Actions -->
          <div style="display: flex; align-items: center; gap: 10px;">
            <!-- Dark Mode Toggle Button -->
            <button id="themeToggleBtn" aria-label="Toggle Night Mode" class="glass-chip"
              style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,0.7); cursor: pointer; color: inherit; background: transparent;">
              <svg class="zen-svg-icon" viewBox="0 0 24 24">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </button>

            <!-- User Profile Pill -->
            <div
              style="display: flex; align-items: center; gap: 10px; padding-left: 12px; border-left: 1px solid rgba(0,0,0,0.08);">
              <div class="devotee-avatar-circle">
                <% if (typeof currentSinger !=='undefined' && currentSinger) { %>
                  <%= (currentSinger.name || 'S' ).charAt(0).toUpperCase() %>
                    <% } else if (typeof currentAdmin !=='undefined' && currentAdmin) { %>
                      <%= (currentAdmin.display_name || currentAdmin.username || 'A' ).charAt(0).toUpperCase() %>
                        <% } else { %>
                          B
                          <% } %>
              </div>
              <span style="font-size: 12.5px; font-weight: 600;">
                <% if (typeof currentSinger !=='undefined' && currentSinger) { %>
                  <%= currentSinger.name.split(' ')[0] %>
              <% } else if (typeof currentAdmin !== ' undefined' && currentAdmin) { %>
                    <%= (currentAdmin.display_name || currentAdmin.username || 'Admin'
                      ).split(' ')[0] %>
              <% } else { %>
                Bangaru
              <% } %>
            </span>
          </div>
        </div>

      </div>
    </div>
    <% } %>

    <!-- ================= 3. HERO STAGE WITH ORIGINAL EMBLEMS ================= -->
    <section class="zen-hero-wrap">
      <div class="zen-max-container">
        
        <!-- Large Frosted Glass Hero Banner -->
        <div class="glass-panel zen-hero-banner">
          
          <!-- Subtle Inner Golden Sheen -->
          <div style="position: absolute; top: -100px; left: -100px; width: 320px; height: 320px; background: radial-gradient(circle, rgba(251,191,36,0.2), transparent 70%); border-radius: 50%; pointer-events: none;"></div>

          <!-- Left: Original Sri Sathya Sai Lotus Emblem (Free-Standing & Larger) -->
          <div class="zen-free-emblem-wrap" title="Sri Sathya Sai Lotus Emblem">
            <img src="/images/logo.png" alt="Sri Sathya Sai Lotus Emblem" class="zen-free-emblem" onerror="this.style.display=' none'">
            </div>

            <!-- Center: Headline & Organisation Pill -->
            <div class="zen-hero-center">
              <div class="zen-org-badge">
                <span class="zen-beacon-pulse"></span>
                <span>Sri Sathya Sai Seva Organisations, Gandhinagar</span>
              </div>
              <h1 class="zen-hero-title">
                Bhajan Planner
              </h1>
              <p class="zen-hero-subtitle" style="font-family: 'Fraunces', Georgia, serif; font-style: italic; font-size: clamp(13px, 1.8vw, 15px); color: #78716c; max-width: 680px; line-height: 1.55; margin-top: 6px;">
                &ldquo;Bhajan must spread good-will, love, ecstasy; it must cleanse the polluted atmosphere; it must invite all to share in the joy and peace.&rdquo;
                <span style="font-style: normal; font-weight: 600; font-size: 11.5px; opacity: 0.85; margin-left: 6px; white-space: nowrap;">&mdash; Baba</span>
              </p>
            </div>

            <!-- Right: Original 100th Birthday Emblem (Free-Standing & Larger) -->
            <div class="zen-free-emblem-wrap" title="Sri Sathya Sai 100th Birthday Emblem">
              <img src="/images/logo_birthday.png" alt="Sri Sathya Sai 100th Birthday Emblem" class="zen-free-emblem"
                onerror="this.style.display='none'">
            </div>

          </div>

          <!-- Devotee Command Status Bar -->
          <div class="devotee-bar-wrap">
            <% if (typeof currentSinger !=='undefined' && currentSinger) { %>
              <div class="glass-panel devotee-greeting-pill" id="devoteeGreetingBar">
                <div class="devotee-avatar-circle">
                  <%= (currentSinger.name || 'S' ).charAt(0).toUpperCase() %>
                </div>
                <span>Sai Ram, <strong>
                    <%= currentSinger.name %>
                  </strong></span>
                <span style="opacity: 0.4;">•</span>
                <a href="/my-hub"
                  style="color: #b45309; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;"
                  data-haptic="light">
                  <span>My Hub</span>
                  <svg class="zen-svg-icon" style="width: 14px; height: 14px;" viewBox="0 0 24 24">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
              <% } else if (typeof currentAdmin !=='undefined' && currentAdmin) { %>
                <div class="glass-panel devotee-greeting-pill" id="devoteeGreetingBar">
                  <div class="devotee-avatar-circle">A</div>
                  <span>Sai Ram, <strong>
                      <%= currentAdmin.display_name || currentAdmin.displayName || 'Admin' %>
                    </strong></span>
                  <span style="opacity: 0.4;">•</span>
                  <a href="/admin"
                    style="color: #b45309; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;"
                    data-haptic="light">
                    <span>Control Tower</span>
                    <svg class="zen-svg-icon" style="width: 14px; height: 14px;" viewBox="0 0 24 24">
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
                <% } else { %>
                  <div class="glass-panel devotee-greeting-pill" id="devoteeGreetingBar" style="display:none;">
                    <div class="devotee-avatar-circle" id="devoteeAvatarChar">S</div>
                    <span id="devoteeGreetingText">Sai Ram, Devotee</span>
                    <span style="opacity: 0.4;">•</span>
                    <a href="/my-hub"
                      style="color: #b45309; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;"
                      data-haptic="light">
                      <span>My Hub</span>
                      <svg class="zen-svg-icon" style="width: 14px; height: 14px;" viewBox="0 0 24 24">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </a>
                  </div>
                  <script>
                    (function () {
                      try {
                        var bar = document.getElementById('devoteeGreetingBar');
                        var txt = document.getElementById('devoteeGreetingText');
                        var av = document.getElementById('devoteeAvatarChar');
                        var sName = localStorage.getItem('bp_singer_name');
                        var aName = localStorage.getItem('bp_admin_name');
                        var name = sName || aName;
                        if (bar && txt && name) {
                          txt.innerHTML = 'Sai Ram, <strong>' + name + '</strong>';
                          if (av) av.textContent = name.charAt(0).toUpperCase();
                          bar.style.display = 'inline-flex';
                        }
                      } catch (_) { }
                    })();
                  </script>
                  <% } %>
          </div>

        </div>
        </section>

        <!-- ================= 4. MAIN CONTENT BODY ================= -->
        <main class="zen-main-stack">

          <% const sessionList=(typeof upcomingSessions !=='undefined' && Array.isArray(upcomingSessions) &&
            upcomingSessions.length> 0)
            ? upcomingSessions
            : (typeof upcomingSession !== 'undefined' && upcomingSession ? [upcomingSession] : []);
            const primarySession = sessionList[0] || null;
            const subCount = primarySession ? (primarySession.submissionCount || 0) : 0;
            const openSlots = Math.max(0, 8 - subCount);
            const slotPercent = Math.min(100, Math.round((subCount / 8) * 100));
            %>

            <!-- 4.1 UPCOMING SESSION SPOTLIGHT -->
            <% if (primarySession) { %>
              <section id="session-spotlight" class="glass-panel zen-spotlight-card">
                <div class="zen-spotlight-accent-strip"></div>

                <div class="zen-spotlight-body">

                  <!-- Header Row -->
                  <div class="zen-spotlight-top-row">
                    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                      <% if (primarySession.isLiveNow) { %>
                        <span class="zen-status-badge status-live">
                          <span class="zen-beacon-pulse"
                            style="background: #f43f5e; box-shadow: 0 0 6px #f43f5e;"></span>
                          Live Plan Active
                        </span>
                        <% } else if (primarySession.isOpen) { %>
                          <span class="zen-status-badge status-open">
                            <span class="zen-beacon-pulse"
                              style="background: #10b981; box-shadow: 0 0 6px #10b981;"></span>
                            Submissions Open
                          </span>
                          <% } else if (primarySession.opensAt8pmToday) { %>
                            <span class="zen-status-badge status-wait">
                              <span class="zen-beacon-pulse"></span>
                              Opens 8:00 PM Today
                            </span>
                            <% } else { %>
                              <span class="zen-status-badge status-closed">
                                Submissions Closed
                              </span>
                              <% } %>
                                <span style="font-size: 12.5px; font-weight: 600; color: #78716c;">Official Samiti
                                  Congregation</span>
                    </div>

                    <div class="glass-chip zen-date-pill">
                      <svg class="zen-svg-icon" style="width: 15px; height: 15px; color: #d97706;" viewBox="0 0 24 24">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                        <line x1="16" x2="16" y1="2" y2="6" />
                        <line x1="8" x2="8" y1="2" y2="6" />
                        <line x1="3" x2="21" y1="10" y2="10" />
                      </svg>
                      <span>
                        <%= primarySession.formattedDate %> &bull; 7:30 PM &ndash; 8:30 PM
                      </span>
                    </div>
                  </div>

                  <!-- Title & Session Details -->
                  <div class="zen-session-info-row">
                    <div>
                      <h2 class="zen-session-title">
                        <%= primarySession.label %>
                      </h2>
                      <p class="zen-session-desc">
                        <% if (primarySession.isLiveNow) { %>
                          Bhajan sequence finalized. Follow live schedule during the session.
                          <% } else if (primarySession.opensAt8pmToday) { %>
                            Submissions for this session will open today at <strong>8:00 PM</strong>.
                            <% } else { %>
                              Official Mandir bhajan session. <strong>
                                <%= subCount %> bhajans
                              </strong> currently registered for this slot sequence.
                              <% } %>
                      </p>
                    </div>

                    <!-- CTAs -->
                    <div class="zen-session-ctas">
                      <% if (!primarySession.isClosedForSubmissions && primarySession.isOpen) { %>
                        <a href="/submit-form?session_date=<%= primarySession.date %>" class="glass-btn-primary"
                          data-haptic="light">
                          <svg class="zen-svg-icon" viewBox="0 0 24 24">
                            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                            <line x1="12" x2="12" y1="19" y2="22"></line>
                          </svg>
                          <span>Mark Bhajan Slot</span>
                        </a>
                        <% } %>
                          <a href="/plan-view?session_date=<%= primarySession.date %>" class="glass-btn-secondary"
                            data-haptic="light">
                            <svg class="zen-svg-icon" viewBox="0 0 24 24">
                              <line x1="10" x2="21" y1="6" y2="6" />
                              <line x1="10" x2="21" y1="12" y2="12" />
                              <line x1="10" x2="21" y1="18" y2="18" />
                              <polyline points="3 6 4 7 6 5" />
                              <polyline points="3 12 4 13 6 11" />
                              <polyline points="3 18 4 19 6 17" />
                            </svg>
                            <span>Follow Live Sequence</span>
                          </a>
                    </div>
                  </div>


                </div>
              </section>
              <% } else { %>
                <section class="glass-panel" style="padding: 32px 36px;">
                  <div
                    style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; border-radius: 9999px; font-size: 11.5px; font-weight: 700; background: rgba(120,113,108,0.15); color: #57534e;">
                    No Active Session
                  </div>
                  <h2
                    style="font-family: 'Fraunces', Georgia, serif; font-size: 24px; font-weight: 700; margin: 12px 0 6px;">
                    Next Session Scheduling Soon</h2>
                  <p style="font-size: 13.5px; color: #78716c; margin: 0 0 16px;">Upcoming Thursday and special festival
                    schedules will appear here automatically.</p>
                  <a href="/plan-view" class="glass-btn-secondary" style="display: inline-flex;">
                    <span>View Latest Plan</span>
                  </a>
                </section>
                <% } %>

                  <!-- 4.2 ANNOUNCEMENTS & BULLETINS -->
                  <section class="glass-panel" style="padding: 32px 36px;">
                    <div class="zen-card-header">
                      <div class="zen-card-header-left">
                        <div class="zen-icon-box">
                          <svg class="zen-svg-icon" viewBox="0 0 24 24">
                            <path d="m3 11 18-5v12L3 14v-3z" />
                            <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
                          </svg>
                        </div>
                        <div>
                          <h3 class="zen-card-title">Announcements &amp; Bulletins</h3>
                          <p class="zen-card-subtitle">Official circulars from Gandhinagar Samiti coordinators</p>
                        </div>
                      </div>
                      <a href="/bulletins"
                        style="font-size: 12.5px; font-weight: 700; color: #b45309; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                        <span>View All</span>
                        <svg class="zen-svg-icon" style="width: 14px; height: 14px;" viewBox="0 0 24 24">
                          <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                      </a>
                    </div>

                    <!-- Bulletins Feed -->
                    <div>
                      <% if (typeof bulletins !=='undefined' && bulletins && bulletins.length> 0) { %>
                        <% bulletins.slice(0, 3).forEach(function(b) { %>
                          <a href="/bulletins/<%= b.id %>" class="zen-bulletin-item" data-haptic="light">
                            <div style="flex: 1;">
                              <div style="display: flex; align-items: center; gap: 8px;">
                                <span
                                  style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; padding: 2px 8px; border-radius: 9999px; background: rgba(245,158,11,0.15); color: #92400e; border: 1px solid rgba(245,158,11,0.3);">
                                  <%= (typeof CATEGORY_INFO !=='undefined' && CATEGORY_INFO[b.category]) ?
                                    CATEGORY_INFO[b.category].label : (b.category || 'Event' ) %>
                                </span>
                                <span style="font-size: 11.5px; color: #a8a29e; font-weight: 500;">
                                  <%= b.formattedDate || 'Recent' %>
                                </span>
                              </div>
                              <h4 class="zen-bulletin-title">
                                <%= b.title %>
                              </h4>
                              <p class="zen-bulletin-desc">
                                <%= b.summary || (b.body ? b.body.substring(0, 140) + '...' : '' ) %>
                              </p>
                            </div>
                            <div style="display: flex; align-items: center; gap: 4px; color: #a8a29e; flex-shrink: 0;">
                              <span style="font-size: 12px; font-weight: 600;">Read</span>
                              <svg class="zen-svg-icon" style="width: 15px; height: 15px;" viewBox="0 0 24 24">
                                <path d="m9 18 6-6-6-6" />
                              </svg>
                            </div>
                          </a>
                          <% }); %>
                            <% } else { %>
                              <!-- Seeded Devotional Bulletins -->
                              <a href="/bulletins" class="zen-bulletin-item">
                                <div style="flex: 1;">
                                  <div style="display: flex; align-items: center; gap: 8px;">
                                    <span
                                      style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; padding: 2px 8px; border-radius: 9999px; background: rgba(245,158,11,0.15); color: #92400e; border: 1px solid rgba(245,158,11,0.3);">Event</span>
                                    <span style="font-size: 11.5px; color: #a8a29e; font-weight: 500;">2 Sept</span>
                                  </div>
                                  <h4 class="zen-bulletin-title">Special Birthday Sadhana Saptah &amp; Akhanda Bhajan
                                    Schedule</h4>
                                  <p class="zen-bulletin-desc">Devotees and lead singers are requested to review the
                                    special slot allocation norms for the centenary celebrations.</p>
                                </div>
                                <div
                                  style="display: flex; align-items: center; gap: 4px; color: #a8a29e; flex-shrink: 0;">
                                  <span style="font-size: 12px; font-weight: 600;">Read</span>
                                  <svg class="zen-svg-icon" style="width: 15px; height: 15px;" viewBox="0 0 24 24">
                                    <path d="m9 18 6-6-6-6" />
                                  </svg>
                                </div>
                              </a>
                              <a href="/bulletins" class="zen-bulletin-item">
                                <div style="flex: 1;">
                                  <div style="display: flex; align-items: center; gap: 8px;">
                                    <span
                                      style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; padding: 2px 8px; border-radius: 9999px; background: rgba(16,185,129,0.15); color: #065f46; border: 1px solid rgba(16,185,129,0.3);">Protocol</span>
                                    <span style="font-size: 11.5px; color: #a8a29e; font-weight: 500;">28 Aug</span>
                                  </div>
                                  <h4 class="zen-bulletin-title">Harmonium Scale Consistency for Prashanti Mandir
                                    Bhajans</h4>
                                  <p class="zen-bulletin-desc">Please ensure your registered singing key matches
                                    standard Safed/Kali scales to allow comfortable chorus accompaniment.</p>
                                </div>
                                <div
                                  style="display: flex; align-items: center; gap: 4px; color: #a8a29e; flex-shrink: 0;">
                                  <span style="font-size: 12px; font-weight: 600;">Read</span>
                                  <svg class="zen-svg-icon" style="width: 15px; height: 15px;" viewBox="0 0 24 24">
                                    <path d="m9 18 6-6-6-6" />
                                  </svg>
                                </div>
                              </a>
                              <% } %>
                    </div>
                  </section>

                  <!-- 4.3 THE SPIRIT OF BHAJAN (Wisdom Sanctuary) -->
                  <section class="glass-panel" style="padding: 36px 40px; position: relative; overflow: hidden;">

                    <!-- Bhagawan's Sacred Quote -->
                    <div class="zen-quote-box">
                      <div class="glass-chip zen-quote-icon">
                        <svg class="zen-svg-icon" style="width: 22px; height: 22px;" viewBox="0 0 24 24">
                          <path
                            d="M3 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2H4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2h4c0 4-2 6-5 7v1zM15 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2h-4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2h4c0 4-2 6-5 7v1z" />
                        </svg>
                      </div>
                      <blockquote class="zen-quote-text">
                        &ldquo;A tune without feeling is an infliction. The heart of singing lies in the union of Bhava
                        (Feeling), Raga (Melody), and Taala (Rhythm). One voice, one beat &ndash; oneness with
                        Bhagawan.&rdquo;
                      </blockquote>
                      <div class="zen-quote-author">
                        &mdash; Bhagwan Sri Sathya Sai Baba
                      </div>
                    </div>

                    <!-- The 3 Pillars (BHA - RA - TA) -->
                    <div class="zen-pillars-grid">

                      <div class="glass-chip zen-pillar-card">
                        <div class="zen-pillar-badge">BHA</div>
                        <div>
                          <h4 class="zen-pillar-title">Bhava (Feeling)</h4>
                          <p class="zen-pillar-desc">Heartfelt love and sacred devotion vibrating from the core of the
                            soul.</p>
                        </div>
                      </div>

                      <div class="glass-chip zen-pillar-card">
                        <div class="zen-pillar-badge">RA</div>
                        <div>
                          <h4 class="zen-pillar-title">Raga (Melody)</h4>
                          <p class="zen-pillar-desc">Sweet, uplifting notes in faithful alignment with authentic mandir
                            scales.</p>
                        </div>
                      </div>

                      <div class="glass-chip zen-pillar-card">
                        <div class="zen-pillar-badge">TA</div>
                        <div>
                          <h4 class="zen-pillar-title">Taala (Rhythm)</h4>
                          <p class="zen-pillar-desc">Synchronized steady beat uniting the whole congregation as one
                            prayer.</p>
                        </div>
                      </div>

                    </div>

                    <!-- Singer's Code of Conduct Grid -->
                    <div>
                      <h4
                        style="font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: #a8a29e; text-align: center; margin: 0 0 16px;">
