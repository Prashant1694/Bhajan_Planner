<div class="session-unified-page">

  <!-- Toast Notification Container -->
  <div id="catcherToast" style="display:none; position:fixed; top:24px; right:24px; z-index:9999; background:linear-gradient(135deg, #16a34a, #15803d); color:#fff; padding:12px 22px; border-radius:12px; font-size:13.5px; font-weight:700; box-shadow:0 8px 24px rgba(0,0,0,0.2); transition:all 0.3s ease;">
  </div>

  <!-- EXECUTIVE HEADER -->
  <header class="session-unified-header">
    <div class="session-header-top-row">
      <div class="session-header-identity">
        <div class="session-date-tile" style="background:#fee2e2; border-color:#ef4444; color:#ef4444; display:flex; align-items:center; justify-content:center;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="session-title-block">
          <h1>Missing Bhajan Catcher</h1>
          <div class="session-tags-row">
            <span class="session-tag <%= totalMissing === 0 ? 'session-tag-regular' : 'session-tag-festival' %>">
              <%= totalMissing === 0 ? '100% Synchronized' : `${totalMissing} Unlinked Submissions` %>
            </span>
            <% if (totalPages > 1) { %>
              <span class="session-tag session-tag-regular">Batch <%= currentPage %> of <%= totalPages %> (50 / batch)</span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Quick Nav Buttons -->
      <div class="session-primary-actions" style="max-width:320px;">
        <a href="/master-bank" class="sec-tool-btn" style="height:42px; min-height:42px; flex-direction:row; gap:6px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span>Master Bank</span>
        </a>
        <a href="/admin" class="sec-tool-btn" style="height:42px; min-height:42px; flex-direction:row; gap:6px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Dashboard</span>
        </a>
      </div>
    </div>

    <!-- Metrics Deck -->
    <div class="session-metrics-deck" style="margin-top:14px;">
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-card-icon" style="color:#ef4444;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <div class="metric-card-data">
            <span class="metric-card-val total-missing-count"><%= totalMissing %></span>
            <span class="metric-card-lbl">Missing From Master</span>
          </div>
        </div>
        <div class="metric-card">
          <div class="metric-card-icon" style="color:#0284c7;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <div class="metric-card-data">
            <span class="metric-card-val"><%= missingBhajans ? missingBhajans.length : 0 %></span>
            <span class="metric-card-lbl">In Current Batch</span>
          </div>
        </div>
        <div class="metric-card">
          <div class="metric-card-icon" style="color:#64748b;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <div class="metric-card-data">
            <span class="metric-card-val"><%= currentPage %> / <%= totalPages || 1 %></span>
            <span class="metric-card-lbl">Batch Page</span>
          </div>
        </div>
        <div class="metric-card">
          <div class="metric-card-icon" style="color:#16a34a;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div class="metric-card-data">
            <span class="metric-card-val"><%= typeof masterTotalCount !== 'undefined' ? masterTotalCount : 0 %></span>
            <span class="metric-card-lbl">Master Bank Songs</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN WORKSPACE -->
  <main class="session-unified-workspace view-mode-table">

    <!-- Workspace Controls Bar -->
    <div class="workspace-header-bar">
      <div class="workspace-filter-box">
        <input type="text" id="missingSearchInput" onkeyup="filterMissingBhajans()"
               placeholder="Filter this batch of <%= missingBhajans ? missingBhajans.length : 0 %> bhajans..."
               class="workspace-search-input" aria-label="Filter missing bhajans">

        <span class="workspace-meta-text">
          Showing #<%= startIndex %> to #<%= endIndex %> of <%= totalMissing %>
        </span>
      </div>

      <!-- Pagination Buttons -->
      <% if (totalPages > 1) { %>
        <div class="workspace-view-controls">
          <div class="view-switcher-pill">
            <% if (currentPage > 1) { %>
              <a href="/admin/missing-bhajans?page=<%= currentPage - 1 %>" class="view-switch-btn" style="text-decoration:none;">&larr; Prev</a>
            <% } %>
            <span class="view-switch-btn active" style="cursor:default;">Page <%= currentPage %> / <%= totalPages %></span>
            <% if (currentPage < totalPages) { %>
              <a href="/admin/missing-bhajans?page=<%= currentPage + 1 %>" class="view-switch-btn" style="text-decoration:none;">Next &rarr;</a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Missing Songs Cards Stream -->
    <div id="missingListContainer" class="adm-missing-list">
      <% if (missingBhajans && missingBhajans.length > 0) { %>
        <div class="session-cards-stream adm-missing-stream">
          <% missingBhajans.forEach(function(item, idx) { %>
            <article class="session-track-card missing-card-item adm-missing-card"
                     data-title="<%= item.submittedTitle.toLowerCase() %>"
                     data-submitted-title="<%= item.submittedTitle %>"
                     style="display:flex; flex-direction:column; gap:10px;">

              <!-- Card Header Row -->
              <div class="track-card-header adm-missing-head" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
                <div class="card-seq-badge-wrap" style="display:flex; align-items:center; gap:10px; flex:1; min-width:220px;">
                  <span class="card-seq-num adm-missing-seq">
                    #<%= startIndex + idx %>
                  </span>
                  <span class="card-bhajan-title adm-missing-title"><%= item.submittedTitle %></span>
                </div>
                <% if (isSuperAdmin) { %>
                  <button type="button" class="card-touch-btn btn-edit mb-add-new-btn" style="white-space:nowrap;">
                    + Add as New
                  </button>
                <% } %>
              </div>

              <!-- Simple Search & Link Control -->
              <div class="mb-link-search-box" style="display:flex; flex-direction:column; gap:8px;">
                <div style="display:flex; align-items:center; gap:8px; position:relative;">
                  <input type="text"
                         class="workspace-search-input mb-master-search-input"
                         placeholder="Search Master Bank by bhajan name, deity, or raag..."
                         aria-label="Search Master Bank for <%= item.submittedTitle %>"
                         style="width:100%; max-width:none; padding-right:34px;">
                  <button type="button"
                          class="mb-clear-search-btn"
                          aria-label="Clear search"
                          title="Clear search"
                          style="display:none; position:absolute; right:8px; top:50%; transform:translateY(-50%); background:transparent; border:none; color:var(--text-light); font-size:18px; line-height:1; cursor:pointer; padding:4px 6px;">&times;</button>
                </div>
                <div class="mb-search-results" style="display:none; flex-direction:column; gap:6px;"></div>
              </div>

            </article>
          <% }); %>
        </div>

      <% } else { %>
        <div class="adm-empty-synced">
          <div class="adm-empty-synced-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3>100% Synchronized!</h3>
          <p class="adm-muted-note">
            Every single bhajan submitted in past sessions matches a canonical record in the Master Database.
          </p>
        </div>
      <% } %>
    </div>

  </main>

  <!-- ADD MISSING BHAJAN MODAL (Super Admin Only) -->
  <% if (isSuperAdmin) { %>
  <div id="missingBhajanModal" class="session-modal-overlay">
    <div class="session-modal-card" style="max-width:480px;">
      <div class="session-modal-header">
        <h3>Add to Master Database</h3>
        <button type="button" class="sec-tool-btn" style="width:30px; min-height:30px; padding:0; border-radius:50%;" onclick="closeMissingBhajanModal()" aria-label="Close modal">&times;</button>
      </div>
      <div class="session-modal-body" style="display:flex; flex-direction:column; gap:12px;">
        <div>
          <label for="mbTitle" style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Bhajan Title</label>
          <input type="text" id="mbTitle" required class="workspace-search-input" style="width:100%; max-width:none;">
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <div>
            <label for="mbDeity" style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Deity</label>
            <select id="mbDeity" class="workspace-search-input" style="width:100%; max-width:none;">
              <option value="Ganesha">Ganesha</option>
              <option value="Guru">Guru</option>
              <option value="Mata">Mata</option>
              <option value="SarvaDharma">SarvaDharma</option>
              <option value="Sai">Sai</option>
              <option value="Shiva">Shiva</option>
              <option value="Krishna">Krishna</option>
              <option value="Rama">Rama</option>
              <option value="Narayana">Narayana</option>
              <option value="Vitthala">Vitthala</option>
              <option value="Hanuman">Hanuman</option>
            </select>
          </div>
          <div>
            <label for="mbTempo" style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Tempo</label>
            <select id="mbTempo" class="workspace-search-input" style="width:100%; max-width:none;">
              <option value="Slow">Slow</option>
              <option value="Medium" selected>Medium</option>
              <option value="Fast">Fast</option>
            </select>
          </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <div>
            <label for="mbShruti" style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Shruti (Male)</label>
            <input type="text" id="mbShruti" placeholder="e.g. C#" class="workspace-search-input" style="width:100%; max-width:none;">
          </div>
          <div>
            <label for="mbShrutiFemale" style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Shruti (Female)</label>
            <input type="text" id="mbShrutiFemale" placeholder="e.g. G#" class="workspace-search-input" style="width:100%; max-width:none;">
          </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <div>
            <label for="mbRaga" style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Raga</label>
            <input type="text" id="mbRaga" placeholder="e.g. Yaman" class="workspace-search-input" style="width:100%; max-width:none;">
          </div>
          <div>
            <label for="mbLevel" style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Difficulty Level</label>
            <select id="mbLevel" class="workspace-search-input" style="width:100%; max-width:none;">
              <option value="Easy">Easy</option>
              <option value="Medium" selected>Medium</option>
              <option value="Advanced">Advanced</option>
            </select>
          </div>
        </div>
      </div>
      <div class="session-modal-footer" style="display:flex; justify-content:flex-end; gap:8px; padding:12px 18px; border-top:1px solid var(--border);">
        <button type="button" class="sec-tool-btn" style="min-height:36px; padding:0 14px;" onclick="closeMissingBhajanModal()">Cancel</button>
        <button type="button" class="cmd-btn cmd-btn-share" style="height:36px; padding:0 18px;" onclick="liveSaveMissingBhajan()">Save to Master Bank</button>
      </div>
    </div>
  </div>
  <% } %>

</div>

<script>
  const IS_SUPERADMIN_MISSING_CATCHER = <%= isSuperAdmin ? 'true' : 'false' %>;
  let _activeMissingTitle = '';

  function showToast(msg, type) {
    const toast = document.getElementById('catcherToast');
    if (!toast) return;
    toast.textContent = msg;
    toast.style.background = (type === 'error') ? 'linear-gradient(135deg, #dc2626, #b91c1c)' : 'linear-gradient(135deg, #16a34a, #15803d)';
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 2800);
  }

  function liveRemoveCard(submittedTitle) {
    const targetLower = (submittedTitle || '').toLowerCase();
    const cards = document.querySelectorAll('.missing-card-item');
    cards.forEach(card => {
      if (card.getAttribute('data-title') === targetLower) {
        card.style.transition = 'all 0.3s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95)';
        setTimeout(() => {
          card.remove();
          if (document.querySelectorAll('.missing-card-item').length === 0) {
            const container = document.getElementById('missingListContainer');
            if (container) {
              container.innerHTML = `
                <div style="background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:40px 20px; text-align:center;">
                  <div style="width:48px; height:48px; border-radius:12px; background:#ecfdf5; color:#16a34a; display:flex; align-items:center; justify-content:center; margin:0 auto 12px auto;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  </div>
                  <h3 style="color:#16a34a; margin-bottom:8px;">Batch Completed!</h3>
                  <p style="color:#64748b; margin-bottom:18px;">All bhajans in this batch have been reconciled.</p>
                  <a href="/admin/missing-bhajans" class="cmd-btn cmd-btn-share" style="display:inline-flex; text-decoration:none; height:38px; padding:0 22px;">
                    Continue to Next Batch &rarr;
                  </a>
                </div>
              `;
            }
          }
        }, 300);

        const badgeEls = document.querySelectorAll('.total-missing-count');
        badgeEls.forEach(el => {
          const current = parseInt(el.textContent, 10) || 0;
          if (current > 0) el.textContent = current - 1;
        });

        const sidebarBadge = document.querySelector('.missing-catcher-badge');
        if (sidebarBadge) {
          const cur = parseInt(sidebarBadge.textContent, 10) || 0;
          if (cur <= 1) {
            sidebarBadge.style.display = 'none';
          } else {
            sidebarBadge.textContent = cur - 1;
          }
        }
      }
    });
  }

  function liveReconcile(submittedTitle, action, masterBhajanId, masterTitle, triggerBtn) {
    if (triggerBtn) {
      triggerBtn.disabled = true;
      triggerBtn.textContent = 'Linking...';
    }
    fetch('/api/admin/reconcile-bhajan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ submitted_title: submittedTitle, action, master_bhajan_id: masterBhajanId })
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          showToast('Linked "' + submittedTitle + '" to "' + (masterTitle || data.masterTitle || '') + '"');
          liveRemoveCard(submittedTitle);
        } else {
          if (triggerBtn) {
            triggerBtn.disabled = false;
            triggerBtn.textContent = 'Link with This';
          }
          showToast('Error: ' + (data.error || 'Unknown error'), 'error');
        }
      })
      .catch(err => {
        if (triggerBtn) {
          triggerBtn.disabled = false;
          triggerBtn.textContent = 'Link with This';
        }
        showToast('Request failed: ' + err.message, 'error');
      });
  }

  function openMissingBhajanModal(title) {
    if (!IS_SUPERADMIN_MISSING_CATCHER || !document.getElementById('missingBhajanModal')) return;
    _activeMissingTitle = title;
    document.getElementById('mbTitle').value = title;
    document.getElementById('missingBhajanModal').classList.add('show');
  }

  function closeMissingBhajanModal() {
    const modal = document.getElementById('missingBhajanModal');
    if (modal) modal.classList.remove('show');
  }

  function liveSaveMissingBhajan() {
    if (!IS_SUPERADMIN_MISSING_CATCHER) {
      showToast('Forbidden: Only Super Admins can add Master Bank bhajans.', 'error');
      return;
    }
    const title = document.getElementById('mbTitle').value;
    const data = {
      title: title,
      deity: document.getElementById('mbDeity').value,
      tempo: document.getElementById('mbTempo').value,
      raga: document.getElementById('mbRaga').value,
      shruti: document.getElementById('mbShruti').value,
      shruti_female: document.getElementById('mbShrutiFemale').value,
      level: document.getElementById('mbLevel').value
    };

    fetch('/api/add-master-bhajan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
      .then(res => res.json())
      .then(result => {
        if (result.success) {
          closeMissingBhajanModal();
          showToast('Added "' + title + '" to Master Database!');
          liveRemoveCard(_activeMissingTitle || title);
        } else {
          showToast('Error: ' + (result.error || 'Failed to add'), 'error');
        }
      })
      .catch(err => showToast('Request failed: ' + err.message, 'error'));
  }

  function filterMissingBhajans() {
    const query = (document.getElementById('missingSearchInput').value || '').toLowerCase().trim();
    const cards = document.querySelectorAll('.missing-card-item');
    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      card.style.display = (!query || title.includes(query)) ? 'flex' : 'none';
    });
  }

  function renderMasterSearchResults(resultsEl, submittedTitle, results, query) {
    resultsEl.textContent = '';
    resultsEl.style.display = 'flex';

    if (!results || results.length === 0) {
      const emptyRow = document.createElement('div');
      emptyRow.style.cssText = 'display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; background:var(--surface-raised); padding:10px 14px; border-radius:10px; border:1px solid var(--border);';
      const msg = document.createElement('span');
      msg.style.cssText = 'font-size:12.5px; color:var(--text-light);';
      msg.textContent = 'No matching bhajans found in Master Bank for "' + query + '".';
      emptyRow.appendChild(msg);
      if (IS_SUPERADMIN_MISSING_CATCHER) {
        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'cmd-btn cmd-btn-add';
        addBtn.style.cssText = 'height:32px; font-size:12px; padding:0 14px;';
        addBtn.textContent = '+ Add to Master Bank';
        addBtn.addEventListener('click', () => openMissingBhajanModal(submittedTitle));
        emptyRow.appendChild(addBtn);
      } else {
        const note = document.createElement('span');
        note.style.cssText = 'font-size:12px; color:var(--text-light); font-style:italic;';
        note.textContent = 'Only Super Admins can add new bhajans.';
        emptyRow.appendChild(note);
      }
      resultsEl.appendChild(emptyRow);
      return;
    }

    results.forEach((m) => {
      const row = document.createElement('div');
      row.style.cssText = 'display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; background:var(--surface-raised); border:1px solid var(--border); border-radius:10px; padding:9px 12px;';

      const info = document.createElement('div');
      info.style.cssText = 'display:flex; align-items:center; gap:8px; flex-wrap:wrap; flex:1; min-width:200px;';

      if (m.deity) {
        const deityPill = document.createElement('span');
        deityPill.className = 'card-deity-pill';
        deityPill.style.fontSize = '11px';
        deityPill.textContent = m.deity;
        info.appendChild(deityPill);
      }

      const titleEl = document.createElement('strong');
      titleEl.style.cssText = 'font-size:13.5px; color:var(--text);';
      titleEl.textContent = m.title;
      info.appendChild(titleEl);

      if (m.raga) {
        const ragaEl = document.createElement('span');
        ragaEl.style.cssText = 'font-size:11.5px; color:var(--text-light);';
        ragaEl.textContent = '• Raag: ' + m.raga;
        info.appendChild(ragaEl);
      }

      const shrutiText = [m.shruti, m.shruti_female].filter(Boolean).join(' / ');
      if (shrutiText) {
        const shrutiEl = document.createElement('span');
        shrutiEl.style.cssText = 'font-size:11.5px; color:var(--text-light);';
        shrutiEl.textContent = '• Scale: ' + shrutiText;
        info.appendChild(shrutiEl);
      }

      const linkBtn = document.createElement('button');
      linkBtn.type = 'button';
      linkBtn.className = 'cmd-btn cmd-btn-share';
      linkBtn.style.cssText = 'height:32px; font-size:12px; padding:0 14px; white-space:nowrap;';
      linkBtn.textContent = 'Link with This';
      linkBtn.addEventListener('click', () => liveReconcile(submittedTitle, 'link', m.id, m.title, linkBtn));

      row.appendChild(info);
      row.appendChild(linkBtn);
      resultsEl.appendChild(row);
    });
  }

  // Bind simple per-card Master Bank search and "+ Add as New" actions
  document.querySelectorAll('.missing-card-item').forEach((card) => {
    const submittedTitle = card.dataset.submittedTitle || '';
    const searchInput = card.querySelector('.mb-master-search-input');
    const clearBtn = card.querySelector('.mb-clear-search-btn');
    const resultsEl = card.querySelector('.mb-search-results');
    const addNewBtn = card.querySelector('.mb-add-new-btn');

    if (addNewBtn) {
      addNewBtn.addEventListener('click', () => openMissingBhajanModal(submittedTitle));
    }

    if (!searchInput || !resultsEl) return;

    let debounceTimer = null;
    let activeAbort = null;

    const runSearch = () => {
      const q = (searchInput.value || '').trim();
      if (clearBtn) clearBtn.style.display = q ? 'block' : 'none';

      if (q.length < 2) {
        if (activeAbort) activeAbort.abort();
        resultsEl.style.display = 'none';
        resultsEl.textContent = '';
        return;
      }

      if (activeAbort) activeAbort.abort();
      activeAbort = new AbortController();

      fetch('/api/admin/master-bhajans/search?q=' + encodeURIComponent(q), {
        signal: activeAbort.signal
      })
        .then(res => res.json())
        .then(data => {
          if (data && Array.isArray(data.results)) {
            renderMasterSearchResults(resultsEl, submittedTitle, data.results, q);
          }
        })
        .catch(err => {
          if (err && err.name === 'AbortError') return;
          showToast('Search failed: ' + err.message, 'error');
        });
    };

    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(runSearch, 150);
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.style.display = 'none';
        if (activeAbort) activeAbort.abort();
        resultsEl.style.display = 'none';
        resultsEl.textContent = '';
        searchInput.focus();
      });
    }
  });
</script>
