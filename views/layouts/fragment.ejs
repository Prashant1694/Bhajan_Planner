<div class="shell-fragment-root"
     data-page-title="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'Bhajan Planner' %>"
     data-page-css="<%= typeof pageCSS !== 'undefined' && pageCSS ? pageCSS : '' %>"
     data-page-js="<%= typeof pageJS !== 'undefined' && pageJS ? pageJS : '' %>"
