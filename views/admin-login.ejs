<%# Admin Login — vertically & horizontally centered with bokeh bg effect %>
<%# All styles live in style.css (.login-fullscreen, .login-card, .bokeh-*) %>

<div class="login-fullscreen">

  <%# Animated bokeh orbs (appear subtly; intensify on hover of the whole area) %>
  <span class="bokeh bokeh-1" aria-hidden="true"></span>
  <span class="bokeh bokeh-2" aria-hidden="true"></span>
  <span class="bokeh bokeh-3" aria-hidden="true"></span>

  <div class="container login-card">

    <h2 class="login-heading">
      Admin Login
    </h2>

    <% if (error) { %>
      <div class="alert-error">
        <%= error %>
      </div>
    <% } %>

    <form method="post" action="/admin-login" target="_top">

      <div class="form-group">
        <label for="username">User ID</label>
        <input
          id="username"
          type="text"
          name="username"
          value="<%= typeof username !== 'undefined' ? username : '' %>"
          required
          autocomplete="username"
        />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          id="password"
          type="password"
          name="password"
          required
          autocomplete="current-password"
        />
      </div>

      <button
        type="submit"
        class="submit-btn"
        style="width:100%; margin-top:8px;">
        Login
      </button>

    </form>

    <div class="forgot-password">
      <a href="/forgot-password">Forgot Password?</a>
    </div>

    <% if (googleClientId) { %>

      <div class="login-divider">
        <span>or</span>
      </div>

      <div id="google-signin-button"></div>

      <p id="google-login-error" class="google-login-error"></p>

    <% } %>

    <div style="text-align:center; margin-top:20px;">
      <a
        href="/"
        style="color:var(--muted); text-decoration:none; font-size:14px;">
        ← Back to Home
      </a>
    </div>

  </div><%# /.container.login-card %>

</div><%# /.login-fullscreen %>


<% if (googleClientId) { %>
<script>

async function handleGoogleCredential(response) {
  const errorEl = document.getElementById('google-login-error');
  errorEl.textContent = '';
  try {
    const result = await fetch('/auth/google', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ credential: response.credential })
    });
    const data = await result.json();
    if (!result.ok || !data.success) {
      errorEl.textContent = data.error || 'Google login failed.';
      return;
    }
    if (window.top && window.top !== window) {
      window.top.location.href = data.redirect || '/admin';
    } else {
      window.location.href = data.redirect || '/admin';
    }
  } catch (err) {
    console.error(err);
    errorEl.textContent = 'Google login failed. Please try again.';
  }
}

window.addEventListener('load', () => {
  google.accounts.id.initialize({
    client_id: <%- JSON.stringify(googleClientId) %>,
    callback: handleGoogleCredential,
    auto_select: false
  });
  google.accounts.id.renderButton(
    document.getElementById('google-signin-button'),
    { type: 'standard', theme: 'outline', size: 'large', text: 'signin_with', shape: 'rectangular', width: 320 }
  );
});

</script>
<% } %>

<script src="https://accounts.google.com/gsi/client" async defer></script>
