<div class="container" style="max-width: 560px; margin: 60px auto; padding: 0 16px; text-align: center;">
  <div class="card-elevated" style="background: #ffffff; border: 1px solid var(--border); border-radius: 14px; padding: 48px 32px; box-shadow: 0 4px 16px rgba(15,23,42,0.05);">
    <div style="width: 56px; height: 56px; border-radius: 12px; background: #eef2ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </div>
    <h2 style="font-size: 22px; font-weight: 800; color: #0f172a; margin-bottom: 12px;">Bhajan Not Found</h2>
    <p style="color: #64748b; font-size: 14.5px; line-height: 1.6; margin-bottom: 28px;">
      <%= typeof message !== 'undefined' ? message : 'The requested bhajan could not be found or has been deactivated.' %>
    </p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="/master-bank" class="btn btn-primary" style="padding: 10px 20px; font-weight: 600; text-decoration: none; border-radius: 6px;">
        Master Bhajan Bank
      </a>
      <a href="/" class="btn btn-secondary" style="padding: 10px 20px; font-weight: 600; text-decoration: none; border-radius: 6px;">
        Home
      </a>
    </div>
  </div>
</div>
