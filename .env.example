# ============================================================
# SUPER ADMIN — created on first run if no super_admin exists
# ============================================================
SUPER_ADMIN_USER=your_username
SUPER_ADMIN_PASS=your_strong_password
SUPER_ADMIN_DISPLAY_NAME=Your Name
SUPER_ADMIN_GOOGLE_EMAIL=your_email@gmail.com

# ============================================================
# SESSION & SECURITY (minimum 32 characters required)
# ============================================================
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars
CSRF_SECRET=replace_with_a_distinct_random_string_at_least_32_chars
NODE_ENV=development
TZ=Asia/Kolkata

# ============================================================
# GOOGLE SIGN-IN (optional — leave blank to disable)
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id_here

# ============================================================
# SERVER
# ============================================================
PORT=8000

# ============================================================
# DATABASE PATH (Railway: set to /data/bhajans.db with a Volume)
# ============================================================
# DB_PATH=./bhajans.db

# ============================================================
# WEB PUSH NOTIFICATIONS (generate with: npx web-push generate-vapid-keys)
# ============================================================
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your_email@example.com

# ============================================================
# CLOUDFLARE R2 AUDIO STORAGE (S3-compatible audio recordings)
# ============================================================
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=bhajan-recordings
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev